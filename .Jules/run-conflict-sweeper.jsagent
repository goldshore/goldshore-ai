// .Jules/run-conflict-sweeper.jsagent
const fs = require('fs');
const { execSync } = require('child_process');

console.log('Running Jules Conflict Sweeper...');

// Helper to run command and log
function run(cmd) {
    try {
        console.log(`> ${cmd}`);
        execSync(cmd, { stdio: 'inherit' });
    } catch (e) {
        console.error(`Command failed: ${cmd}`);
        throw e;
    }
}

// 1. Detect Lockfile Conflict
// Lockfile churn makes PRs hard to merge. Default policy:
// - if the branch did not change package manifests, keep main's lockfile
// - regenerate only when package manifests changed or FORCE_REGENERATE_LOCKFILE is set
// Shared implementation lives in scripts/repair-pnpm-lock.mjs.

const lockfile = 'pnpm-lock.yaml';

let hasConflict = false;
if (fs.existsSync(lockfile)) {
    const content = fs.readFileSync(lockfile, 'utf8');
    if (content.includes('<<<<<<<')) {
        hasConflict = true;
        console.log('Detected conflict markers in pnpm-lock.yaml');
    }
}

if (hasConflict || process.env.FORCE_REGENERATE_LOCKFILE) {
    console.log('Repairing pnpm lockfile through repository policy...');
    try {
        const command = process.env.FORCE_REGENERATE_LOCKFILE
            ? 'pnpm lockfile:regenerate'
            : 'pnpm lockfile:repair';
        run(command);

        console.log('✅ Lockfile repaired.');
    } catch (e) {
        console.error('❌ Failed to repair lockfile.');
        process.exit(1);
    }
} else {
    console.log('No lockfile conflict detected. Skipping repair.');
}
