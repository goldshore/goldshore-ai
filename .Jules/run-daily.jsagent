#!/usr/bin/env node
/**
 * Jules Daily Guardian Runner
 *
 * Default mode checks the current branch only. Set JULES_SWEEP_BRANCHES=1 to
 * inspect remote branches. The runner does not deploy or delete user code.
 */

const { execFileSync, execSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const MAX_BRANCH_AGE_DAYS = Number(process.env.JULES_MAX_BRANCH_AGE_DAYS || 90);
const REQUIRED_APPS = ["gs-api", "gs-web"];
const ALLOWED_APP_DIRS = new Set(REQUIRED_APPS);
const IGNORE_DIRS = new Set([
  ".git",
  ".turbo",
  ".wrangler",
  ".astro",
  "archive",
  "coverage",
  "dist",
  "build",
  "node_modules",
]);

function commandName(file) {
  return file;
}

function sh(file, args = [], options = {}) {
  try {
    const execOptions = {
      cwd: process.cwd(),
      encoding: "utf8",
      stdio: "pipe",
      maxBuffer: 1024 * 1024 * 20,
      ...options,
    };

    if (process.platform === "win32" && file === "pnpm") {
      const pnpmPs1 = path.join(process.env.APPDATA || "", "npm", "pnpm.ps1");
      if (fs.existsSync(pnpmPs1)) {
        return execFileSync(
          "powershell.exe",
          ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", pnpmPs1, ...args],
          execOptions,
        ).trim();
      }
      return execSync(["pnpm", ...args].join(" "), execOptions).trim();
    }

    return execFileSync(commandName(file), args, execOptions).trim();
  } catch (error) {
    if (options.allowFail) {
      return {
        ok: false,
        out: String(error.stdout || ""),
        err: String(error.stderr || error.message || ""),
      };
    }
    throw error;
  }
}

function run(file, args = []) {
  try {
    return { ok: true, out: sh(file, args) };
  } catch (error) {
    return {
      ok: false,
      out: String(error.stdout || ""),
      err: String(error.stderr || error.message || ""),
    };
  }
}

function hasScript(scriptName) {
  try {
    const pkg = JSON.parse(fs.readFileSync("package.json", "utf8"));
    return Boolean(pkg.scripts && pkg.scripts[scriptName]);
  } catch {
    return false;
  }
}

function listRemoteBranches() {
  sh("git", ["fetch", "--all", "--prune"]);
  const raw = sh("git", ["for-each-ref", "--format=%(refname:short)", "refs/remotes/origin"]);
  return raw
    .split(/\r?\n/)
    .map((branch) => branch.replace(/^origin\//, ""))
    .filter((branch) => branch && branch !== "HEAD");
}

function branchAgeDays(branch) {
  const ts = Number(sh("git", ["log", "-1", "--format=%ct", `origin/${branch}`]));
  return Math.floor((Date.now() - ts * 1000) / (1000 * 60 * 60 * 24));
}

function shouldSkipBranch(branch) {
  if (branch === "main" || branch === "develop" || branch.startsWith("release/")) {
    return false;
  }
  return branchAgeDays(branch) > MAX_BRANCH_AGE_DAYS;
}

function prioritySort(branches) {
  const score = (branch) => {
    if (branch === "main") return 0;
    if (branch.startsWith("release/")) return 1;
    if (branch === "develop") return 2;
    return 3;
  };

  return branches.sort((a, b) => {
    const diff = score(a) - score(b);
    if (diff !== 0) return diff;
    const ta = Number(sh("git", ["log", "-1", "--format=%ct", `origin/${a}`], { allowFail: true }).out || 0);
    const tb = Number(sh("git", ["log", "-1", "--format=%ct", `origin/${b}`], { allowFail: true }).out || 0);
    return tb - ta;
  });
}

function checkoutSweepBranch(branch) {
  sh("git", ["checkout", "-B", `jules/${branch.replace(/[^\w.-]+/g, "-")}`, `origin/${branch}`]);
}

function scanForNestedWorkspaceRoots(root) {
  const findings = [];
  const markers = new Set(["pnpm-workspace.yaml", "turbo.json"]);

  function scan(dir) {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      if (!entry.isDirectory() || IGNORE_DIRS.has(entry.name)) continue;

      const fullPath = path.join(dir, entry.name);
      for (const marker of markers) {
        const markerPath = path.join(fullPath, marker);
        if (fs.existsSync(markerPath)) {
          findings.push(`Nested workspace marker: ${path.relative(root, markerPath)}`);
        }
      }
      scan(fullPath);
    }
  }

  scan(root);
  return findings;
}

function checkWorkspaceContract() {
  const findings = [];
  const appsDir = path.join(process.cwd(), "apps");

  if (!fs.existsSync(appsDir)) {
    return ["Missing apps directory"];
  }

  const appDirs = fs
    .readdirSync(appsDir, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name)
    .sort();

  for (const app of REQUIRED_APPS) {
    const appPath = path.join(appsDir, app);
    if (!fs.existsSync(appPath)) {
      findings.push(`Missing required app: apps/${app}`);
    }
  }

  for (const app of appDirs) {
    if (!ALLOWED_APP_DIRS.has(app)) {
      findings.push(`Unexpected app directory: apps/${app}`);
    }
  }

  const workspacePath = path.join(process.cwd(), "pnpm-workspace.yaml");
  if (fs.existsSync(workspacePath)) {
    const workspace = fs.readFileSync(workspacePath, "utf8");
    for (const stale of ["apps/*", "apps/gs-admin", "apps/gs-agent", "apps/gs-control", "apps/gs-gateway", "apps/gs-mail"]) {
      if (workspace.includes(stale)) {
        findings.push(`pnpm-workspace.yaml contains stale app pattern: ${stale}`);
      }
    }
  }

  findings.push(...scanForNestedWorkspaceRoots(process.cwd()));
  return findings;
}

function checkWrangler() {
  const findings = [];
  const wranglerPath = path.join(process.cwd(), "apps", "gs-api", "wrangler.toml");

  if (!fs.existsSync(wranglerPath)) {
    return ["Missing apps/gs-api/wrangler.toml"];
  }

  const content = fs.readFileSync(wranglerPath, "utf8");
  for (const key of ["name", "main", "compatibility_date"]) {
    if (!new RegExp(`^\\s*${key}\\s*=`, "m").test(content)) {
      findings.push(`apps/gs-api/wrangler.toml missing ${key}`);
    }
  }

  if (!content.includes('name = "gs-api"')) {
    findings.push('apps/gs-api/wrangler.toml must keep Worker name "gs-api" until extraction is explicit');
  }

  return findings;
}

function checkGitHygiene() {
  const findings = [];
  const warnings = [];
  const gitignore = fs.existsSync(".gitignore") ? fs.readFileSync(".gitignore", "utf8") : "";

  if (!gitignore.includes(".claude/settings.local.json")) {
    findings.push(".gitignore must ignore .claude/settings.local.json");
  }

  const ignoredTracked = run("git", ["ls-files", "-ci", "--exclude-standard"]);
  if (ignoredTracked.ok && ignoredTracked.out) {
    warnings.push(`Tracked ignored files detected:\n${ignoredTracked.out}`);
  }

  return {
    ok: findings.length === 0,
    out: warnings.join("\n"),
    err: findings.join("\n"),
  };
}

function runChecks() {
  const results = {};
  const runHeavy = process.argv.includes("--heavy") || process.env.JULES_RUN_HEAVY === "1";

  results.pnpm = run("pnpm", ["-v"]);
  results.install = run("pnpm", ["install", "--frozen-lockfile"]);
  results.validate = run("node", ["scripts/lint-naming.mjs"]);
  results.lint = runHeavy && hasScript("lint") ? run("pnpm", ["lint"]) : { ok: true, out: "Skipped; pass --heavy or set JULES_RUN_HEAVY=1" };
  results.test = runHeavy && hasScript("test") ? run("pnpm", ["test"]) : { ok: true, out: "Skipped; pass --heavy or set JULES_RUN_HEAVY=1" };
  results.build = runHeavy && hasScript("build") ? run("pnpm", ["build"]) : { ok: true, out: "Skipped; pass --heavy or set JULES_RUN_HEAVY=1" };
  results.workspace = checkWorkspaceContract();
  results.wrangler = checkWrangler();
  results.git = checkGitHygiene();
  return results;
}

function printResults(label, results) {
  console.log(`\n=== ${label} ===`);
  for (const [name, value] of Object.entries(results)) {
    if (Array.isArray(value)) {
      console.log(`${name}: ${value.length === 0 ? "pass" : "fail"}`);
      for (const item of value) console.log(`  - ${item}`);
      continue;
    }
    console.log(`${name}: ${value.ok ? "pass" : "fail"}`);
    if (!value.ok) {
      const excerpt = [value.err, value.out].filter(Boolean).join("\n").slice(0, 3000);
      if (excerpt) console.log(excerpt);
    }
  }
}

function hasFailures(results) {
  return Object.values(results).some((value) => {
    if (Array.isArray(value)) return value.length > 0;
    return value && value.ok === false;
  });
}

function main() {
  if (process.argv.includes("--check-only") || process.env.JULES_SWEEP_BRANCHES !== "1") {
    const results = runChecks();
    printResults("current branch", results);
    process.exit(hasFailures(results) ? 1 : 0);
  }

  const startRef = sh("git", ["rev-parse", "--abbrev-ref", "HEAD"]);
  let failed = false;

  try {
    for (const branch of prioritySort(listRemoteBranches())) {
      if (shouldSkipBranch(branch)) continue;
      checkoutSweepBranch(branch);
      const results = runChecks();
      printResults(branch, results);
      if (hasFailures(results)) failed = true;
    }
  } finally {
    sh("git", ["checkout", startRef], { allowFail: true });
  }

  process.exit(failed ? 1 : 0);
}

main();
