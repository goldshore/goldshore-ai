---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { GSButton } from '@goldshore/ui';

const title = 'Integration API Keys';
---

<AdminLayout title="API Keys | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl gs-heading gs-text-accent">Integration API Keys</h1>
        <p class="text-lg gs-text-subtle mt-2">Securely store and manage third-party API credentials</p>
      </div>
      <div class="flex gap-3">
        <GSButton variant="secondary" id="refresh-keys">Refresh</GSButton>
        <GSButton variant="primary" id="add-key">Add API Key</GSButton>
      </div>
    </div>

    <!-- Integrations List -->
    <div class="gs-card space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold">Integrations</h2>
        <div class="flex gap-2">
          <input
            type="text"
            id="search-integrations"
            placeholder="Search integrations..."
            class="px-3 py-2 border border-gs-border rounded text-sm gs-text-accent bg-gs-bg"
          />
          <select
            id="filter-status"
            class="px-3 py-2 border border-gs-border rounded text-sm gs-text-accent bg-gs-bg"
          >
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="expired">Expired</option>
            <option value="rotated">Recently Rotated</option>
            <option value="missing">Missing Keys</option>
          </select>
        </div>
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="py-8 text-center">
        <p class="gs-text-subtle">Loading integrations...</p>
      </div>

      <!-- Integrations Table -->
      <div id="integrations-list" class="overflow-x-auto" style="display: none;">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-gs-border gs-text-subtle text-xs font-semibold uppercase">
            <tr>
              <th class="px-4 py-3">Integration</th>
              <th class="px-4 py-3">Provider</th>
              <th class="px-4 py-3">Key Status</th>
              <th class="px-4 py-3">Created By</th>
              <th class="px-4 py-3">Expires</th>
              <th class="px-4 py-3">Rotations</th>
              <th class="px-4 py-3">Actions</th>
            </tr>
          </thead>
          <tbody id="integrations-tbody" class="divide-y divide-gs-border">
            <!-- Populated by JavaScript -->
          </tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="py-8 text-center gs-empty-state" style="display: none;">
        <p>No integrations configured yet. Add your first API key to get started.</p>
      </div>
    </div>

    <!-- Key Details Modal -->
    <div
      id="key-modal"
      class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
      style="display: none;"
    >
      <div class="bg-gs-bg border border-gs-border rounded-lg p-8 max-w-2xl w-full mx-4 space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-2xl font-semibold" id="modal-title">API Key Details</h3>
          <button
            class="text-gs-text-subtle hover:text-gs-text-accent"
            onclick="document.getElementById('key-modal').style.display='none'"
          >
            ✕
          </button>
        </div>

        <!-- Key Info Section -->
        <div id="key-info" class="space-y-4">
          <!-- Populated by JavaScript -->
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-3 justify-end border-t border-gs-border pt-4">
          <GSButton variant="secondary" id="modal-close">Close</GSButton>
          <GSButton variant="secondary" id="copy-prefix">Copy Prefix</GSButton>
          <GSButton variant="secondary" id="test-key">Test Key</GSButton>
          <GSButton variant="primary" id="rotate-key">Rotate Key</GSButton>
        </div>

        <!-- Audit Trail Section -->
        <div class="border-t border-gs-border pt-4 space-y-3">
          <h4 class="font-semibold text-sm">Audit Trail</h4>
          <div id="audit-trail" class="max-h-64 overflow-y-auto space-y-2 text-xs gs-text-subtle">
            <!-- Populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>

    <!-- Rotation Modal -->
    <div
      id="rotation-modal"
      class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
      style="display: none;"
    >
      <div class="bg-gs-bg border border-gs-border rounded-lg p-8 max-w-2xl w-full mx-4 space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-2xl font-semibold">Rotate API Key</h3>
          <button
            class="text-gs-text-subtle hover:text-gs-text-accent"
            onclick="document.getElementById('rotation-modal').style.display='none'"
          >
            ✕
          </button>
        </div>

        <!-- Current Key Info -->
        <div class="bg-gs-surface p-4 rounded space-y-2 text-sm">
          <p class="gs-text-subtle">Current Key (will be replaced):</p>
          <p class="font-mono" id="current-key-prefix">sk_live_*****</p>
          <p class="text-xs gs-text-subtle">Rotation #<span id="rotation-count">0</span></p>
        </div>

        <!-- New Key Input -->
        <div class="space-y-2">
          <label class="text-sm font-semibold">New API Key</label>
          <textarea
            id="new-key-value"
            placeholder="Paste your new API key here..."
            class="w-full px-3 py-2 border border-gs-border rounded bg-gs-bg gs-text-accent font-mono text-sm"
            rows="4"
          ></textarea>
          <p class="text-xs gs-text-subtle">
            Your new key will replace the current one. The old key will be revoked after a 7-day grace period.
          </p>
        </div>

        <!-- Grace Period Info -->
        <div class="bg-gs-warning bg-opacity-10 border border-gs-warning border-opacity-20 p-4 rounded text-sm space-y-2">
          <p class="font-semibold gs-text-warning">⚠ Grace Period</p>
          <p class="gs-text-subtle">
            Old keys remain active for 7 days after rotation to prevent service interruptions. You can revoke immediately if needed.
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-3 justify-end">
          <GSButton
            variant="secondary"
            onclick="document.getElementById('rotation-modal').style.display='none'"
          >
            Cancel
          </GSButton>
          <GSButton variant="primary" id="confirm-rotation">Confirm Rotation</GSButton>
        </div>
      </div>
    </div>

    <!-- Add Key Modal -->
    <div
      id="add-key-modal"
      class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
      style="display: none;"
    >
      <div class="bg-gs-bg border border-gs-border rounded-lg p-8 max-w-2xl w-full mx-4 space-y-6">
        <div class="flex items-center justify-between">
          <h3 class="text-2xl font-semibold">Add API Key</h3>
          <button
            class="text-gs-text-subtle hover:text-gs-text-accent"
            onclick="document.getElementById('add-key-modal').style.display='none'"
          >
            ✕
          </button>
        </div>

        <!-- Integration Selection -->
        <div class="space-y-2">
          <label class="text-sm font-semibold">Integration</label>
          <select
            id="select-integration"
            class="w-full px-3 py-2 border border-gs-border rounded gs-text-accent bg-gs-bg"
          >
            <option value="">Select an integration...</option>
            <option value="stripe">Stripe</option>
            <option value="meta">Meta (Facebook/Instagram)</option>
            <option value="google_ads">Google Ads</option>
            <option value="google_gsc">Google Search Console</option>
            <option value="zapier">Zapier</option>
            <option value="whatsapp">WhatsApp Business</option>
          </select>
        </div>

        <!-- Key Type Selection -->
        <div class="space-y-2">
          <label class="text-sm font-semibold">Key Type</label>
          <select
            id="select-key-type"
            class="w-full px-3 py-2 border border-gs-border rounded gs-text-accent bg-gs-bg"
          >
            <option value="apiKey">API Key</option>
            <option value="apiSecret">API Secret</option>
            <option value="webhook_secret">Webhook Secret</option>
            <option value="oauth_token">OAuth Token</option>
          </select>
        </div>

        <!-- Key Value Input -->
        <div class="space-y-2">
          <label class="text-sm font-semibold">Key Value</label>
          <textarea
            id="new-key-input"
            placeholder="Paste your API key here..."
            class="w-full px-3 py-2 border border-gs-border rounded bg-gs-bg gs-text-accent font-mono text-sm"
            rows="4"
          ></textarea>
        </div>

        <!-- Optional Expiry -->
        <div class="space-y-2">
          <label class="text-sm font-semibold">Expires At (Optional)</label>
          <input
            type="datetime-local"
            id="key-expires-at"
            class="w-full px-3 py-2 border border-gs-border rounded gs-text-accent bg-gs-bg text-sm"
          />
          <p class="text-xs gs-text-subtle">Leave blank for no expiration. For OAuth tokens, set to token expiry date.</p>
        </div>

        <!-- Test Before Adding -->
        <div class="flex gap-3">
          <input type="checkbox" id="test-before-add" />
          <label for="test-before-add" class="text-sm gs-text-subtle">Test key before saving</label>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-3 justify-end border-t border-gs-border pt-4">
          <GSButton
            variant="secondary"
            onclick="document.getElementById('add-key-modal').style.display='none'"
          >
            Cancel
          </GSButton>
          <GSButton variant="primary" id="save-key">Add Key</GSButton>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const API_BASE = '/api/integrations';

    // Utility: Format date for display
    const formatDate = (isoDate) => {
      if (!isoDate) return 'Never';
      return new Date(isoDate).toLocaleDateString() + ' ' + new Date(isoDate).toLocaleTimeString();
    };

    // Utility: Get status badge class
    const getStatusBadgeClass = (secret) => {
      if (!secret.expires_at) return 'bg-gs-success/20 gs-text-success';

      const expiresAt = new Date(secret.expires_at);
      const now = new Date();
      const daysUntilExpiry = Math.ceil((expiresAt - now) / (1000 * 60 * 60 * 24));

      if (daysUntilExpiry < 0) return 'bg-gs-error/20 gs-text-error';
      if (daysUntilExpiry < 7) return 'bg-gs-warning/20 gs-text-warning';
      return 'bg-gs-success/20 gs-text-success';
    };

    // Load integrations
    const loadIntegrations = async () => {
      const loading = document.getElementById('loading-state');
      const list = document.getElementById('integrations-list');
      const tbody = document.getElementById('integrations-tbody');
      const empty = document.getElementById('empty-state');

      loading.style.display = 'block';
      list.style.display = 'none';
      empty.style.display = 'none';

      try {
        const res = await fetch(`${API_BASE}/keys`);
        const data = await res.json();

        loading.style.display = 'none';

        if (!data.data || data.data.length === 0) {
          empty.style.display = 'block';
          return;
        }

        tbody.innerHTML = data.data.map((secret) => `
          <tr class="hover:bg-gs-surface cursor-pointer" onclick="openKeyModal('${secret.id}')">
            <td class="px-4 py-3 font-mono text-xs">${secret.integration_id}</td>
            <td class="px-4 py-3">${secret.metadata?.provider || 'Unknown'}</td>
            <td class="px-4 py-3">
              <span class="inline-block px-3 py-1 rounded text-xs font-medium ${getStatusBadgeClass(secret)}">
                ${secret.expires_at ? 'Active' : 'Permanent'}
              </span>
            </td>
            <td class="px-4 py-3 text-xs gs-text-subtle">${secret.created_by || 'Unknown'}</td>
            <td class="px-4 py-3 text-xs gs-text-subtle">${formatDate(secret.expires_at)}</td>
            <td class="px-4 py-3 text-xs">${secret.rotation_count}</td>
            <td class="px-4 py-3">
              <button class="text-xs bg-gs-primary/20 hover:bg-gs-primary/30 text-gs-primary px-2 py-1 rounded">
                Manage
              </button>
            </td>
          </tr>
        `).join('');

        list.style.display = 'block';
      } catch (error) {
        console.error('Error loading integrations:', error);
        loading.innerHTML = '<p class="text-gs-error">Error loading integrations</p>';
      }
    };

    // Open key details modal
    const openKeyModal = async (secretId) => {
      try {
        const res = await fetch(`${API_BASE}/keys/${secretId}`);
        const data = await res.json();
        const secret = data.data;

        document.getElementById('modal-title').textContent = `${secret.integration_id} - ${secret.key_type}`;

        document.getElementById('key-info').innerHTML = `
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-xs gs-text-subtle font-semibold">Key Prefix</p>
              <p class="font-mono text-sm">${secret.key_prefix}</p>
            </div>
            <div>
              <p class="text-xs gs-text-subtle font-semibold">Key Type</p>
              <p class="text-sm">${secret.key_type}</p>
            </div>
            <div>
              <p class="text-xs gs-text-subtle font-semibold">Created</p>
              <p class="text-sm">${formatDate(secret.created_at)}</p>
            </div>
            <div>
              <p class="text-xs gs-text-subtle font-semibold">Expires</p>
              <p class="text-sm">${formatDate(secret.expires_at)}</p>
            </div>
            <div>
              <p class="text-xs gs-text-subtle font-semibold">Rotations</p>
              <p class="text-sm">${secret.rotation_count}</p>
            </div>
            <div>
              <p class="text-xs gs-text-subtle font-semibold">Last Rotation</p>
              <p class="text-sm">${formatDate(secret.rotated_at)}</p>
            </div>
          </div>
        `;

        // Audit trail (simplified for now)
        document.getElementById('audit-trail').innerHTML = `
          <div class="py-2">
            <p>✓ Created by ${secret.created_by} on ${formatDate(secret.created_at)}</p>
            ${secret.rotated_at ? `<p>↻ Last rotated on ${formatDate(secret.rotated_at)}</p>` : ''}
          </div>
        `;

        // Store current secret ID for rotation
        document.getElementById('current-key-prefix').textContent = secret.key_prefix;
        document.getElementById('rotation-count').textContent = secret.rotation_count;
        window.currentSecretId = secretId;

        document.getElementById('key-modal').style.display = 'flex';
      } catch (error) {
        console.error('Error loading key details:', error);
      }
    };

    // Rotate key
    document.getElementById('rotate-key')?.addEventListener('click', () => {
      document.getElementById('key-modal').style.display = 'none';
      document.getElementById('rotation-modal').style.display = 'flex';
    });

    // Confirm rotation
    document.getElementById('confirm-rotation')?.addEventListener('click', async () => {
      const newValue = document.getElementById('new-key-value').value.trim();

      if (!newValue) {
        alert('Please enter a new key value');
        return;
      }

      try {
        const res = await fetch(`${API_BASE}/keys/${window.currentSecretId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'rotate', new_value: newValue }),
        });

        const data = await res.json();

        if (data.success) {
          alert('Key rotated successfully');
          document.getElementById('rotation-modal').style.display = 'none';
          document.getElementById('new-key-value').value = '';
          loadIntegrations();
        } else {
          alert('Error rotating key: ' + (data.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error rotating key:', error);
        alert('Error rotating key');
      }
    });

    // Add key
    document.getElementById('add-key')?.addEventListener('click', () => {
      document.getElementById('add-key-modal').style.display = 'flex';
    });

    // Save new key
    document.getElementById('save-key')?.addEventListener('click', async () => {
      const integrationId = document.getElementById('select-integration').value;
      const keyType = document.getElementById('select-key-type').value;
      const value = document.getElementById('new-key-input').value.trim();
      const expiresAt = document.getElementById('key-expires-at').value;

      if (!integrationId || !value) {
        alert('Please fill in all required fields');
        return;
      }

      try {
        const res = await fetch(`${API_BASE}/keys`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            integration_id: integrationId,
            key_type: keyType,
            value,
            expires_at: expiresAt ? new Date(expiresAt).toISOString() : undefined,
          }),
        });

        const data = await res.json();

        if (data.success) {
          alert('Key added successfully');
          document.getElementById('add-key-modal').style.display = 'none';
          document.getElementById('new-key-input').value = '';
          loadIntegrations();
        } else {
          alert('Error adding key: ' + (data.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error adding key:', error);
        alert('Error adding key');
      }
    });

    // Refresh
    document.getElementById('refresh-keys')?.addEventListener('click', loadIntegrations);

    // Close modals
    document.getElementById('modal-close')?.addEventListener('click', () => {
      document.getElementById('key-modal').style.display = 'none';
    });

    // Initial load
    loadIntegrations();
  </script>
</AdminLayout>
