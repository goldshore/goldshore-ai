---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = true;
---
<AdminLayout title="Analytics" currentPath="/admin/analytics">
  <div class="analytics-container">
    <header class="analytics-header">
      <p class="eyebrow">Data Studio</p>
      <h1>AdSense Performance</h1>
    </header>

    <div class="iframe-wrapper">
      <iframe
        src="https://datastudio.google.com/embed/reporting/tDmimzrn-IM/page/1M"
        frameborder="0"
        style="border:0"
        allowfullscreen
        sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox">
      </iframe>
    </div>
  </div>
</AdminLayout>

<style>
  .analytics-container {
    padding: 32px 36px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .analytics-header h1 {
    font-size: 26px;
    font-weight: 700;
    color: rgba(226,232,240,0.97);
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(90,162,255,0.75);
    margin-bottom: 6px;
  }
  .iframe-wrapper {
    flex: 1;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(90, 162, 255, 0.1);
    background: rgba(11, 15, 24, 0.65);
  }
  iframe {
    width: 100%;
    height: 100%;
  }
</style>
