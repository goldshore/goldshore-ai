---
const next = Astro.url.searchParams.get('next') || '/';
const teamDomain = import.meta.env.PUBLIC_ACCESS_TEAM_DOMAIN || 'goldshore.cloudflareaccess.com';
const accessLogin = `https://${teamDomain}/cdn-cgi/access/login?redirect_url=${encodeURIComponent(new URL(next, Astro.url.origin).toString())}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in | Gold Shore Labs</title>
    <meta name="theme-color" content="#050b14" />
  </head>
  <body>
    <main class="portal">
      <section class="brand" aria-labelledby="brand-title">
        <img src="/logo.svg" alt="Gold Shore Labs Penrose logo" />
        <p class="eyebrow">Protected systems</p>
        <h1 id="brand-title">Gold Shore Labs</h1>
        <p>Secure access to administration, deployments, API operations, mail, and agent services.</p>
      </section>

      <section class="auth-card" aria-labelledby="signin-title">
        <span class="status"><i></i> Cloudflare Access protected</span>
        <h2 id="signin-title">Continue to the control plane</h2>
        <p>Authenticate with an approved identity provider. Access is evaluated by identity, team membership, device posture, and application policy.</p>
        <a class="primary" href={accessLogin}>Continue with approved identity provider</a>
        <p class="breakglass">Engineering break-glass access is available through the authorized GitHub identity provider.</p>
        <nav aria-label="Legal and support">
          <a href="https://goldshore.org/privacy">Privacy</a>
          <a href="https://goldshore.org/terms">Terms</a>
          <a href="mailto:security@goldshore.org">Security</a>
          <a href="mailto:support@goldshore.org">Support</a>
        </nav>
      </section>
    </main>
  </body>
</html>

<style>
  :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100dvh; color: #eef4f8; background: radial-gradient(circle at 18% 15%, rgba(21,111,135,.23), transparent 34%), radial-gradient(circle at 82% 85%, rgba(216,164,74,.13), transparent 30%), #050b14; }
  body::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .24; background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px); background-size: 40px 40px; }
  .portal { position: relative; min-height: 100dvh; display: grid; grid-template-columns: minmax(0,1.1fr) minmax(320px,.9fr); align-items: center; gap: clamp(2rem,7vw,8rem); max-width: 1180px; margin: auto; padding: clamp(2rem,6vw,6rem); }
  .brand img { width: min(360px, 80%); height: auto; margin-bottom: 3rem; }
  .eyebrow { color: #d8a44a; font: 700 .76rem/1.2 ui-monospace, monospace; letter-spacing: .2em; text-transform: uppercase; }
  h1 { margin: .5rem 0 1rem; font-size: clamp(2.8rem,7vw,6rem); line-height: .92; letter-spacing: -.06em; }
  .brand > p:last-child { max-width: 620px; color: #9fb1bf; font-size: 1.08rem; line-height: 1.75; }
  .auth-card { padding: clamp(1.6rem,4vw,3rem); border: 1px solid rgba(255,255,255,.1); border-radius: 24px; background: rgba(8,18,31,.82); box-shadow: 0 28px 80px rgba(0,0,0,.42); backdrop-filter: blur(18px); }
  .status { display: inline-flex; align-items: center; gap: .55rem; color: #a9bac7; font-size: .78rem; }
  .status i { width: .55rem; height: .55rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 16px rgba(52,211,153,.7); }
  h2 { margin: 1.35rem 0 .8rem; font-size: clamp(1.55rem,3vw,2.25rem); letter-spacing: -.035em; }
  .auth-card > p { color: #9fb1bf; line-height: 1.65; }
  .primary { display: flex; justify-content: center; align-items: center; min-height: 52px; margin: 1.7rem 0 1rem; border-radius: 12px; color: #071019; background: linear-gradient(135deg,#f2d38b,#d8a44a); font-weight: 800; text-decoration: none; box-shadow: 0 12px 34px rgba(216,164,74,.18); }
  .primary:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .primary:focus-visible, nav a:focus-visible { outline: 3px solid #67d9f2; outline-offset: 4px; }
  .breakglass { font-size: .78rem; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,.08); }
  nav a { color: #a9bac7; font-size: .78rem; text-decoration: none; }
  @media (max-width: 820px) { .portal { grid-template-columns: 1fr; gap: 2rem; } .brand img { margin-bottom: 1.5rem; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; } }
</style>
