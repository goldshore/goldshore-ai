---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { GSButton } from '@goldshore/ui';

const title = 'Zapier Integration';
---

<AdminLayout title="Zapier | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl gs-heading gs-text-accent">Zapier Dashboard</h1>
        <p class="text-lg gs-text-subtle mt-2">Manage automated workflows and task execution</p>
      </div>
      <div class="flex gap-3">
        <GSButton variant="secondary" id="refresh-zapier">Refresh</GSButton>
        <GSButton variant="primary" id="create-zap">Create Zap</GSButton>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Total Zaps</h2>
        <p id="total-zaps" class="text-3xl font-bold gs-text-accent">0</p>
        <p class="text-xs gs-text-subtle">Configured workflows</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Active Zaps</h2>
        <p id="active-zaps" class="text-3xl font-bold gs-text-success">0</p>
        <p class="text-xs gs-text-subtle">Running now</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Tasks Executed</h2>
        <p id="total-tasks" class="text-3xl font-bold gs-text-info">0</p>
        <p class="text-xs gs-text-subtle">Last 30 days</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">Active Zaps</h2>
      <div id="zaps-loading" class="py-8 text-center">
        <p class="gs-text-subtle">Loading Zaps...</p>
      </div>

      <div id="zaps-list" class="space-y-4" style="display: none;">
      </div>

      <div id="zaps-empty" class="py-8 text-center gs-empty-state" style="display: none;">
        <p>No Zaps configured. Create one to get started.</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">Connected Apps</h2>
      <div class="grid md:grid-cols-3 gap-4" id="connected-apps">
        <div class="p-4 border border-gs-border rounded text-center">
          <p class="text-sm gs-text-subtle">Loading apps...</p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      const loadZapierData = async () => {
        const loadingEl = document.getElementById('zaps-loading');
        const listEl = document.getElementById('zaps-list');
        const emptyEl = document.getElementById('zaps-empty');

        const totalZapsEl = document.getElementById('total-zaps');
        const activeZapsEl = document.getElementById('active-zaps');
        const totalTasksEl = document.getElementById('total-tasks');

        if (loadingEl) loadingEl.style.display = 'block';
        if (listEl) listEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = 'none';

        try {
          const response = await fetch('/api/integrations/manage?action=list');
          const data = await response.json();

          if (loadingEl) loadingEl.style.display = 'none';

          if (data.success && data.data?.integrations) {
            const zapierIntegration = Object.values(data.data.integrations).find((int) => int.type === 'zapier');

            if (zapierIntegration) {
              const zapier = zapierIntegration;
              const zaps = zapier.metadata?.zaps || [];

              if (totalZapsEl) totalZapsEl.textContent = zaps.length.toString();

              const active = zaps.filter((z) => z.status === 'on').length;
              if (activeZapsEl) activeZapsEl.textContent = active.toString();

              const totalTasks = zaps.reduce((sum, z) => sum + (z.taskCount || 0), 0);
              if (totalTasksEl) totalTasksEl.textContent = totalTasks.toString();

              if (zaps.length === 0) {
                if (emptyEl) emptyEl.style.display = 'block';
              } else {
                if (listEl) {
                  listEl.innerHTML = zaps.map((zap) => `
                    <div class="gs-card p-4 space-y-3 flex items-start justify-between">
                      <div class="flex-1">
                        <h3 class="font-semibold text-lg">${zap.title}</h3>
                        <p class="text-sm gs-text-subtle mt-1">Tasks: ${zap.taskCount || 0} | Last run: ${
                          zap.lastRun ? new Date(zap.lastRun).toLocaleDateString() : 'Never'
                        }</p>
                      </div>
                      <span class="inline-block px-3 py-1 rounded text-sm font-medium ${
                        zap.status === 'on'
                          ? 'bg-gs-success/20 gs-text-success'
                          : 'bg-gs-warning/20 gs-text-warning'
                      }">
                        ${zap.status === 'on' ? 'Active' : 'Inactive'}
                      </span>
                    </div>
                  `).join('');
                  if (listEl) listEl.style.display = 'block';
                }
              }
            }
          }
        } catch (error) {
          console.error('Error loading Zapier data:', error);
          if (loadingEl) loadingEl.textContent = 'Error loading data';
        }
      };

      document.getElementById('refresh-zapier')?.addEventListener('click', async () => {
        await loadZapierData();
      });

      document.getElementById('create-zap')?.addEventListener('click', () => {
        window.open('https://zapier.com', '_blank');
      });

      loadZapierData();
      setInterval(loadZapierData, 300000); // Refresh every 5 minutes
    });
  </script>
</AdminLayout>
