---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { GSButton } from '@goldshore/ui';

const title = 'Stripe Integration';
---

<AdminLayout title="Stripe | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl gs-heading gs-text-accent">Stripe Dashboard</h1>
        <p class="text-lg gs-text-subtle mt-2">Monitor payments, revenue, and customer transactions</p>
      </div>
      <div class="flex gap-3">
        <GSButton variant="secondary" id="refresh-stripe">Refresh Data</GSButton>
        <GSButton variant="primary" id="configure-stripe">Configure</GSButton>
      </div>
    </div>

    <div class="grid md:grid-cols-4 gap-6">
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Total Revenue</h2>
        <p id="total-revenue" class="text-3xl font-bold gs-text-success">$0</p>
        <p class="text-xs gs-text-subtle">Last 30 days</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Successful Charges</h2>
        <p id="successful-charges" class="text-3xl font-bold gs-text-info">0</p>
        <p class="text-xs gs-text-subtle">Completed transactions</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Failed Charges</h2>
        <p id="failed-charges" class="text-3xl font-bold gs-text-warning">0</p>
        <p class="text-xs gs-text-subtle">Needs attention</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">AOV</h2>
        <p id="avg-order-value" class="text-3xl font-bold gs-text-accent">$0.00</p>
        <p class="text-xs gs-text-subtle">Average per transaction</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">Refunds & Chargebacks</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <p class="text-sm font-semibold">Total Refunded</p>
          <p id="refunded-amount" class="text-2xl font-bold gs-text-warning">$0.00</p>
        </div>
        <div class="space-y-2">
          <p class="text-sm font-semibold">Customer Count</p>
          <p id="customer-count" class="text-2xl font-bold gs-text-info">0</p>
        </div>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">Recent Charges</h2>
      <div id="charges-loading" class="py-8 text-center">
        <p class="gs-text-subtle">Loading charges...</p>
      </div>

      <div id="charges-list" class="overflow-x-auto" style="display: none;">
        <table class="w-full text-sm">
          <thead class="border-b border-gs-border">
            <tr>
              <th class="text-left py-3 px-4">Date</th>
              <th class="text-left py-3 px-4">Amount</th>
              <th class="text-left py-3 px-4">Status</th>
              <th class="text-left py-3 px-4">Customer</th>
              <th class="text-left py-3 px-4">Description</th>
            </tr>
          </thead>
          <tbody id="charges-tbody">
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      const loadStripeData = async () => {
        const loadingEl = document.getElementById('charges-loading');
        const listEl = document.getElementById('charges-list');

        const totalRevenueEl = document.getElementById('total-revenue');
        const successfulChargesEl = document.getElementById('successful-charges');
        const failedChargesEl = document.getElementById('failed-charges');
        const avgOrderValueEl = document.getElementById('avg-order-value');
        const refundedAmountEl = document.getElementById('refunded-amount');
        const customerCountEl = document.getElementById('customer-count');

        if (loadingEl) loadingEl.style.display = 'block';
        if (listEl) listEl.style.display = 'none';

        try {
          const response = await fetch('/api/integrations/manage?action=list');
          const data = await response.json();

          if (loadingEl) loadingEl.style.display = 'none';

          if (data.success && data.data?.integrations) {
            const stripeIntegration = Object.values(data.data.integrations).find((int) => int.type === 'stripe');

            if (stripeIntegration) {
              const stripe = stripeIntegration;
              const metrics = stripe.metadata?.metrics || {};

              if (totalRevenueEl) totalRevenueEl.textContent = `$${metrics.totalRevenue?.toFixed(2) || 0}`;
              if (successfulChargesEl) successfulChargesEl.textContent = metrics.successfulCharges || 0;
              if (failedChargesEl) failedChargesEl.textContent = metrics.failedCharges || 0;
              if (avgOrderValueEl) avgOrderValueEl.textContent = `$${metrics.averageOrderValue?.toFixed(2) || 0}`;
              if (refundedAmountEl) refundedAmountEl.textContent = `$${metrics.refundedAmount?.toFixed(2) || 0}`;
              if (customerCountEl) customerCountEl.textContent = metrics.customerCount || 0;

              if (listEl) {
                const charges = stripe.metadata?.charges || [];
                if (charges.length > 0) {
                  const tbody = document.getElementById('charges-tbody');
                  if (tbody) {
                    tbody.innerHTML = charges.slice(0, 10).map((charge) => `
                      <tr class="border-b border-gs-border hover:bg-gs-surface">
                        <td class="py-3 px-4">${new Date(charge.created * 1000).toLocaleDateString()}</td>
                        <td class="py-3 px-4">$${(charge.amount / 100).toFixed(2)}</td>
                        <td class="py-3 px-4">
                          <span class="inline-block px-2 py-1 rounded text-xs ${
                            charge.status === 'succeeded'
                              ? 'bg-gs-success/20 gs-text-success'
                              : 'bg-gs-warning/20 gs-text-warning'
                          }">
                            ${charge.status}
                          </span>
                        </td>
                        <td class="py-3 px-4 gs-text-subtle">${charge.customer || 'N/A'}</td>
                        <td class="py-3 px-4">${charge.description || '-'}</td>
                      </tr>
                    `).join('');
                    if (listEl) listEl.style.display = 'block';
                  }
                }
              }
            }
          }
        } catch (error) {
          console.error('Error loading Stripe data:', error);
          if (loadingEl) loadingEl.textContent = 'Error loading data';
        }
      };

      document.getElementById('refresh-stripe')?.addEventListener('click', async () => {
        await loadStripeData();
      });

      document.getElementById('configure-stripe')?.addEventListener('click', () => {
        alert('Stripe configuration would open here');
      });

      loadStripeData();
      setInterval(loadStripeData, 300000); // Refresh every 5 minutes
    });
  </script>
</AdminLayout>
