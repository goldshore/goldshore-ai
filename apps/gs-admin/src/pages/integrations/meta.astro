---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { GSButton } from '@goldshore/ui';

const title = 'Meta Business API';
---

<AdminLayout title="Meta | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl gs-heading gs-text-accent">Meta Business API</h1>
        <p class="text-lg gs-text-subtle mt-2">Manage Facebook/Instagram ad campaigns and track performance</p>
      </div>
      <div class="flex gap-3">
        <GSButton variant="secondary" id="refresh-meta">Refresh Data</GSButton>
      </div>
    </div>

    <div class="grid md:grid-cols-4 gap-6">
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Total Spend</h2>
        <p id="total-spend" class="text-3xl font-bold gs-text-danger">$0.00</p>
        <p class="text-xs gs-text-subtle">Last 30 days</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Impressions</h2>
        <p id="total-impressions" class="text-3xl font-bold gs-text-info">0</p>
        <p class="text-xs gs-text-subtle">Ad impressions</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Clicks</h2>
        <p id="total-clicks" class="text-3xl font-bold gs-text-warning">0</p>
        <p class="text-xs gs-text-subtle">Link clicks</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Active Campaigns</h2>
        <p id="active-campaigns" class="text-3xl font-bold gs-text-success">0</p>
        <p class="text-xs gs-text-subtle">Running campaigns</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <div>
        <h2 class="text-2xl font-semibold">Campaigns</h2>
        <p class="text-sm gs-text-subtle mt-1">Current ad campaigns across all accounts</p>
      </div>

      <div id="campaigns-loading" class="py-8 text-center">
        <p class="gs-text-subtle">Loading campaigns...</p>
      </div>

      <table id="campaigns-table" class="gs-admin-table" style="display: none;">
        <thead>
          <tr>
            <th>Campaign Name</th>
            <th>Status</th>
            <th>Objective</th>
            <th>Spend</th>
            <th>Impressions</th>
            <th>Clicks</th>
            <th>Reach</th>
          </tr>
        </thead>
        <tbody id="campaigns-tbody">
        </tbody>
      </table>

      <div id="campaigns-empty" class="py-8 text-center gs-empty-state" style="display: none;">
        <p>No campaigns found. Create a campaign in Meta Ads Manager.</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <div>
        <h2 class="text-2xl font-semibold">Performance Over Time</h2>
        <p class="text-sm gs-text-subtle mt-1">Daily metrics for the last 30 days</p>
      </div>

      <div id="insights-loading" class="py-8 text-center">
        <p class="gs-text-subtle">Loading insights...</p>
      </div>

      <table id="insights-table" class="gs-admin-table" style="display: none;">
        <thead>
          <tr>
            <th>Date</th>
            <th>Spend</th>
            <th>Impressions</th>
            <th>Clicks</th>
            <th>Reach</th>
            <th>Avg CPC</th>
            <th>CTR</th>
          </tr>
        </thead>
        <tbody id="insights-tbody">
        </tbody>
      </table>

      <div id="insights-empty" class="py-8 text-center gs-empty-state" style="display: none;">
        <p>No performance data available.</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">Meta Business Configuration</h2>
      <div class="space-y-3">
        <label class="flex items-center gap-3 text-sm gs-text-subtle">
          <input type="checkbox" class="h-4 w-4" id="meta-connected" disabled />
          Connected to Meta Business API
        </label>
        <label class="text-sm gs-text-subtle">
          Business Account ID
          <input type="text" id="meta-account-id" class="gs-input mt-2 text-sm" readonly />
        </label>
        <label class="text-sm gs-text-subtle">
          Status
          <div id="meta-status" class="text-sm mt-2 font-semibold gs-text-warning">Checking...</div>
        </label>
      </div>
      <GSButton variant="secondary" id="configure-meta">Configure Meta API</GSButton>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      const loadMetaData = async () => {
        const loadingCampaigns = document.getElementById('campaigns-loading');
        const loadingInsights = document.getElementById('insights-loading');
        const tableCampaigns = document.getElementById('campaigns-table');
        const tableInsights = document.getElementById('insights-table');
        const emptyCampaigns = document.getElementById('campaigns-empty');
        const emptyInsights = document.getElementById('insights-empty');

        const totalSpendEl = document.getElementById('total-spend');
        const totalImpressionsEl = document.getElementById('total-impressions');
        const totalClicksEl = document.getElementById('total-clicks');
        const activeCampaignsEl = document.getElementById('active-campaigns');
        const statusEl = document.getElementById('meta-status');

        if (loadingCampaigns) loadingCampaigns.style.display = 'block';
        if (loadingInsights) loadingInsights.style.display = 'block';
        if (tableCampaigns) tableCampaigns.style.display = 'none';
        if (tableInsights) tableInsights.style.display = 'none';
        if (emptyCampaigns) emptyCampaigns.style.display = 'none';
        if (emptyInsights) emptyInsights.style.display = 'none';

        try {
          const response = await fetch('/api/integrations/meta');
          const data = await response.json();

          if (loadingCampaigns) loadingCampaigns.style.display = 'none';
          if (loadingInsights) loadingInsights.style.display = 'none';

          if (!data.success || !data.summary) {
            if (statusEl) statusEl.textContent = 'Not Connected';
            if (statusEl) statusEl.classList.remove('gs-text-warning');
            if (statusEl) statusEl.classList.add('gs-text-danger');
            if (emptyCampaigns) emptyCampaigns.style.display = 'block';
            if (emptyInsights) emptyInsights.style.display = 'block';
            return;
          }

          const { summary, insights } = data;

          // Update summary cards
          if (totalSpendEl) totalSpendEl.textContent = `$${summary.totalSpend.toFixed(2)}`;
          if (totalImpressionsEl) totalImpressionsEl.textContent = summary.totalImpressions.toLocaleString();
          if (totalClicksEl) totalClicksEl.textContent = summary.totalClicks.toLocaleString();
          if (activeCampaignsEl) activeCampaignsEl.textContent = summary.activeCampaigns.toString();

          if (statusEl) {
            statusEl.textContent = 'Connected';
            statusEl.classList.remove('gs-text-warning');
            statusEl.classList.add('gs-text-success');
          }

          // Populate insights table
          if (tableInsights && insights && insights.length > 0) {
            const insightsBody = document.getElementById('insights-tbody');
            if (insightsBody) {
              insightsBody.innerHTML = insights.map((insight) => {
                const date = new Date(insight.date).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                });

                return `
                  <tr>
                    <td class="font-semibold">${date}</td>
                    <td class="text-right">$${insight.spend.toFixed(2)}</td>
                    <td class="text-right">${insight.impressions.toLocaleString()}</td>
                    <td class="text-right">${insight.clicks.toLocaleString()}</td>
                    <td class="text-right">${insight.reach.toLocaleString()}</td>
                    <td class="text-right">$${insight.cpc.toFixed(2)}</td>
                    <td class="text-right">${insight.ctr.toFixed(2)}%</td>
                  </tr>
                `;
              }).join('');
            }
            if (tableInsights) tableInsights.style.display = 'table';
          }

          if (!insights || insights.length === 0) {
            if (emptyInsights) emptyInsights.style.display = 'block';
          }
        } catch (error) {
          console.error('Error loading Meta data:', error);
          if (statusEl) statusEl.textContent = 'Error';
          if (statusEl) statusEl.classList.remove('gs-text-warning');
          if (statusEl) statusEl.classList.add('gs-text-danger');
          if (emptyCampaigns) emptyCampaigns.style.display = 'block';
          if (emptyInsights) emptyInsights.style.display = 'block';
        }
      };

      document.getElementById('refresh-meta')?.addEventListener('click', loadMetaData);
      document.getElementById('configure-meta')?.addEventListener('click', () => {
        alert('Meta Business API OAuth configuration will be implemented here.');
      });

      loadMetaData();
      setInterval(loadMetaData, 60000); // Refresh every minute
    });
  </script>
</AdminLayout>
