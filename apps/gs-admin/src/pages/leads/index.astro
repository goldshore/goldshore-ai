---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { GSButton } from '@goldshore/ui';

const title = 'Leads Management';
---

<AdminLayout title="Leads | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl gs-heading gs-text-accent">Lead Management</h1>
        <p class="text-lg gs-text-subtle mt-2">Manage email subscriptions and B2B leads</p>
      </div>
      <div class="flex gap-3">
        <GSButton variant="secondary" id="export-leads">Export CSV</GSButton>
        <GSButton variant="primary" id="refresh-leads">Refresh</GSButton>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="gs-card space-y-3">
        <h2 class="text-xl font-semibold">Total Subscribers</h2>
        <p id="total-leads" class="text-3xl font-bold gs-text-info">0</p>
        <p class="text-sm gs-text-subtle">Active email subscriptions</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-xl font-semibold">This Month</h2>
        <p id="month-leads" class="text-3xl font-bold gs-text-success">0</p>
        <p class="text-sm gs-text-subtle">New subscriptions this month</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-xl font-semibold">Conversion Rate</h2>
        <p id="conversion-rate" class="text-3xl font-bold gs-text-warning">0%</p>
        <p class="text-sm gs-text-subtle">Estimated from traffic</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <div>
        <h2 class="text-2xl font-semibold">Recent Subscribers</h2>
        <p class="text-sm gs-text-subtle mt-1">Latest email subscriptions from footer form</p>
      </div>

      <div id="leads-loading" class="py-8 text-center">
        <p class="gs-text-subtle">Loading leads...</p>
      </div>

      <table id="leads-table" class="gs-admin-table" style="display: none;">
        <thead>
          <tr>
            <th>Email</th>
            <th>Subscribed</th>
            <th>Source</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="leads-tbody">
        </tbody>
      </table>

      <div id="leads-empty" class="py-8 text-center gs-empty-state" style="display: none;">
        <p>No leads yet. Email subscriptions will appear here.</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">Lead Management Tools</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="space-y-3">
          <h3 class="font-semibold">Email Campaign</h3>
          <p class="text-sm gs-text-subtle">Send updates to subscribers</p>
          <GSButton variant="secondary" id="send-campaign" disabled>Send Campaign</GSButton>
        </div>
        <div class="space-y-3">
          <h3 class="font-semibold">Unsubscribe Management</h3>
          <p class="text-sm gs-text-subtle">Manage unsubscribe requests</p>
          <GSButton variant="secondary" id="manage-unsubscribe" disabled>View Unsubscribed</GSButton>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      const loadLeads = async () => {
        const loadingEl = document.getElementById('leads-loading');
        const tableEl = document.getElementById('leads-table');
        const emptyEl = document.getElementById('leads-empty');
        const tbodyEl = document.getElementById('leads-tbody');
        const totalEl = document.getElementById('total-leads');
        const monthEl = document.getElementById('month-leads');

        if (loadingEl) loadingEl.style.display = 'block';
        if (tableEl) tableEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = 'none';

        try {
          const response = await fetch('/api/leads/list');
          const data = await response.json();

          if (loadingEl) loadingEl.style.display = 'none';

          if (!data.success || !data.leads || data.leads.length === 0) {
            if (emptyEl) emptyEl.style.display = 'block';
            if (totalEl) totalEl.textContent = '0';
            return;
          }

          const now = new Date();
          const monthAgo = new Date(now.getFullYear(), now.getMonth(), 1);
          const thisMonthCount = data.leads.filter(
            (lead) => new Date(lead.subscribed_at) >= monthAgo
          ).length;

          if (totalEl) totalEl.textContent = data.leads.length.toString();
          if (monthEl) monthEl.textContent = thisMonthCount.toString();

          // Populate table
          if (tbodyEl && data.leads.length > 0) {
            tbodyEl.innerHTML = data.leads.slice(0, 50).map((lead) => {
              const date = new Date(lead.subscribed_at);
              const dateStr = date.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: date.getFullYear() !== now.getFullYear() ? 'numeric' : undefined,
              });
              return `
                <tr>
                  <td class="font-mono text-sm">${escapeHtml(lead.email)}</td>
                  <td class="text-sm">${dateStr}</td>
                  <td class="text-sm">${escapeHtml(lead.source)}</td>
                  <td><span class="gs-status--ok">${escapeHtml(lead.status)}</span></td>
                  <td>
                    <button class="gs-link text-xs" onclick="removeLead('${lead.id}')">Remove</button>
                  </td>
                </tr>
              `;
            }).join('');
          }

          if (tableEl) tableEl.style.display = 'table';
        } catch (error) {
          console.error('Error loading leads:', error);
          if (emptyEl) emptyEl.style.display = 'block';
          if (emptyEl) emptyEl.textContent = 'Error loading leads. Please try again.';
        }
      };

      const escapeHtml = (text) => {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      };

      document.getElementById('refresh-leads')?.addEventListener('click', loadLeads);
      document.getElementById('export-leads')?.addEventListener('click', async () => {
        try {
          const response = await fetch('/api/leads/list');
          const data = await response.json();
          if (data.leads && data.leads.length > 0) {
            const csv = ['Email,Subscribed At,Source,Status'];
            data.leads.forEach((lead) => {
              csv.push(
                `"${lead.email}","${lead.subscribed_at}","${lead.source}","${lead.status}"`
              );
            });
            const blob = new Blob([csv.join('\n')], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `leads-${new Date().toISOString().split('T')[0]}.csv`;
            a.click();
            URL.revokeObjectURL(url);
          }
        } catch (error) {
          console.error('Error exporting leads:', error);
        }
      });

      loadLeads();
      setInterval(loadLeads, 30000); // Refresh every 30 seconds
    });
  </script>
</AdminLayout>
