---
import WebLayout from './WebLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';

const { title, page, canonicalPath, ogTitle, ogDescription } = Astro.props;
const currentSlug = page
  ? ((page.slug as string | undefined) ?? (page.id as string | undefined)?.replace(/\.(md|mdx)$/, ''))
  : undefined;
---

<WebLayout
  title={`${title} | Docs`}
  description="GoldShore developer documentation"
  canonicalPath={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
>
  <section class="gs-section docs-shell">
    <div class="sidebar-wrapper">
       <p class="docs-label">Documentation</p>
       <DocsSidebar currentSlug={currentSlug} />
    </div>
    <article class="docs-main">
      <h1>{title}</h1>
      <slot />
    </article>
  </section>
</WebLayout>

<style>
  .docs-shell { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items:start; padding-top:5rem; }

  .sidebar-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--gs-space-4);
    position:sticky;
    top:7rem;
  }
  .docs-label { margin:0; color:#d3743e; font:500 .67rem/1 'DM Mono',monospace; letter-spacing:.14em; text-transform:uppercase; }
  .docs-main { border:0; border-left:1px solid rgba(255,255,255,.08); border-radius:0; background:transparent; padding:0 0 5rem clamp(2rem,5vw,5rem); max-width:860px; }
  .docs-main[data-reveal] { opacity:1; transform:none; }
  .docs-main > h1 { margin:0 0 2.5rem; max-width:11ch; font:800 clamp(2.8rem,6vw,5.8rem)/.9 'Syne',sans-serif; letter-spacing:-.06em; text-transform:uppercase; }
  .docs-main :global(h2) { margin-top:3.5rem; font-family:'Syne',sans-serif; text-transform:uppercase; }
  .docs-main :global(code) { font-family:'DM Mono',monospace; }

  @media (max-width: 900px) {
    .docs-shell { grid-template-columns: 1fr; padding-top:2rem; }
    .sidebar-wrapper { position:static; }
    .docs-main { border-left:0; border-top:1px solid rgba(255,255,255,.08); padding:2rem 0 4rem; }
  }
</style>
