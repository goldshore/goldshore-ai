---
import BaseLayout from './BaseLayout.astro';
import FlowSection from '../components/FlowSection.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  sections?: Array<{
    title?: string;
    content: string;
  }>;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  canonicalPath?: string;
  description?: string;
}

const {
  eyebrow,
  title,
  lede,
  sections = [],
  primaryCta,
  secondaryCta,
  canonicalPath,
  description
} = Astro.props;

const standardizedTitle = `${title} | GoldShore`;
---

<BaseLayout title={standardizedTitle} description={description} canonicalPath={canonicalPath}>
  <main class="marketing-page">
    <section class="hero-section gs-shell-section">
      {eyebrow && <p class="gs-eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="page-intro">{lede}</p>}

      {(primaryCta || secondaryCta) && (
        <div class="hero-actions">
          {primaryCta && <a href={primaryCta.href} class="hero-button hero-button--primary">{primaryCta.label}</a>}
          {secondaryCta && <a href={secondaryCta.href} class="hero-button">{secondaryCta.label}</a>}
        </div>
      )}
    </section>

    {sections.map((section) => (
      <FlowSection title={section.title}>
        <div set:html={section.content} />
      </FlowSection>
    ))}

    <slot />
  </main>
</BaseLayout>

<style>
  .marketing-page {
    padding: 4.5rem 0 5rem;
  }
  h1 {
    margin: 0.75rem 0 1rem;
    font-size: clamp(2.5rem, 6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .page-intro {
    max-width: 60ch;
    color: var(--gs-text-dim);
    line-height: 1.75;
    font-size: 1.15rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
  .hero-button {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    border: 1px solid var(--gs-border);
    text-decoration: none;
    font-weight: 500;
  }
  .hero-button--primary {
    background: var(--gs-primary);
    color: #fff;
    border-color: var(--gs-primary);
  }
</style>
