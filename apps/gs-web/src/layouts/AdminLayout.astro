---
import '@goldshore/theme/styles/tokens.css';
import '@goldshore/theme/styles/base.css';
import '@goldshore/theme/styles/components.css';
import '@goldshore/theme/styles/layout.css';
import '../styles/admin-components.css';
import '../styles/admin-saas.css';
import Sidebar from '../components/Sidebar.astro';
import FloatingChatWidget from '../components/admin/FloatingChatWidget';
import { ADMIN_PERMISSIONS, type AdminPermission } from '@goldshore/auth';

interface Props {
  title: string;
  requiredPermission?: AdminPermission;
  description?: string;
}

const { title, requiredPermission, description = 'Protected GoldShore operations workspace for content, infrastructure, integrations, and customer workflows.' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://admin.goldshore.ai').toString();
const permissions = ADMIN_PERMISSIONS;
void requiredPermission;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="gs-admin-body gs-density-balanced">
    <div class="gs-admin-shell">
      <Sidebar permissions={permissions} />
      <main class="gs-admin-main">
        <button class="gs-admin-menu-toggle" id="admin-menu-toggle" type="button" aria-label="Open admin navigation">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg><span>Menu</span>
        </button>
        <slot />
      </main>
      <button class="gs-sidebar-scrim" id="sidebar-scrim" type="button" aria-label="Close admin navigation" tabindex="-1"></button>
      <FloatingChatWidget client:load />
    </div>
  </body>
</html>

<style>
  :root {
    --admin-text-on-dark: #f5f7fa;
    --admin-muted-on-dark: #9aa4ae;
    --admin-line-on-dark: rgba(255,255,255,.12);
    --admin-ui: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --admin-display: "Space Grotesk", var(--admin-ui);
  }
  body.gs-admin-body {
    margin: 0;
    min-height: 100dvh;
    font-family: var(--admin-ui);
  }
  .gs-admin-body h1,.gs-admin-body h2,.gs-admin-body h3 { font-family: var(--admin-display); letter-spacing: -.015em; }
  .gs-admin-shell { display: flex; min-height: 100dvh; }
  .gs-admin-main { flex: 1; min-width: 0; overflow-x: hidden; }
  .gs-admin-menu-toggle { display: none; }
  .gs-sidebar-scrim { display: none; }

  /* (pointer: coarse) as well as a width cap: a tablet in landscape reports
     well over 900px, so a width-only query left touch users on the desktop
     shell — a permanent 272px sidebar with no way to dismiss it, and the page
     content squeezed into whatever was left. */
  @media (max-width: 900px), (pointer: coarse) {
    .gs-admin-menu-toggle {
      display: inline-flex;
      position: fixed;
      top: 14px;
      left: 14px;
      z-index: 35;
      gap: 8px;
      align-items: center;
      border: 1px solid var(--admin-line-on-dark);
      border-radius: 6px;
      background: rgba(12,15,20,.92);
      color: var(--admin-text-on-dark);
      padding: 9px 12px;
      font: 650 .72rem var(--admin-ui);
      backdrop-filter: blur(12px);
    }
    .gs-admin-menu-toggle svg { width: 15px; fill: none; stroke: currentColor; stroke-width: 1.5; }
    /* A real element rather than body::after. The pseudo-element painted the
       same dim, but nothing could listen to it, so tapping outside the drawer
       — the ordinary way to dismiss one on touch — did nothing. */
    body.gs-sidebar-open .gs-sidebar-scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 30;
      border: 0;
      padding: 0;
      background: rgba(0,0,0,.62);
      cursor: pointer;
    }
  }
</style>

<script>
  import { initializeAdminLayout } from '../lib/admin-layout';

  const openButton = document.querySelector<HTMLButtonElement>('#admin-menu-toggle');
  const closeButton = document.querySelector<HTMLButtonElement>('#sidebar-close');
  const scrim = document.querySelector<HTMLButtonElement>('#sidebar-scrim');
  const closeSidebar = () => {
    document.body.classList.remove('gs-sidebar-open');
    openButton?.setAttribute('aria-expanded', 'false');
  };
  const openSidebar = () => {
    document.body.classList.add('gs-sidebar-open');
    openButton?.setAttribute('aria-expanded', 'true');
    closeButton?.focus();
  };
  openButton?.addEventListener('click', openSidebar);
  closeButton?.addEventListener('click', closeSidebar);
  scrim?.addEventListener('click', closeSidebar);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeSidebar();
  });
  document.querySelector('#admin-sidebar')?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeSidebar();
  });

  const root = document.documentElement;
  let raf = 0;
  window.addEventListener('pointermove', (event) => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      root.style.setProperty('--grid-hot-x', `${event.clientX}px`);
      root.style.setProperty('--grid-hot-y', `${event.clientY}px`);
      root.style.setProperty('--grid-shift-x', `${(event.clientX / window.innerWidth - .5) * 4}px`);
      root.style.setProperty('--grid-shift-y', `${(event.clientY / window.innerHeight - .5) * 4}px`);
    });
  }, { passive: true });

  const startLayout = () => void initializeAdminLayout();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startLayout, { once: true });
  else startLayout();
</script>
