---
import '@goldshore/theme/styles/tokens.css';
import '@goldshore/theme/styles/base.css';
import '@goldshore/theme/styles/components.css';
import '@goldshore/theme/styles/layout.css';
import '../styles/global.css';
import { WEB_META_CSP } from '../utils/csp';
import '../styles/goldshore-shell.css';
import PublicFooter from '../components/PublicFooter.astro';
import PublicHeader from '../components/PublicHeader.astro';

const { title, description, canonicalPath } = Astro.props;
const ogTitle = Astro.props.ogTitle ?? title;
const ogDescription = Astro.props.ogDescription ?? description;
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, Astro.url.origin).toString()
  : Astro.url.href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={WEB_META_CSP} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <link rel="icon" href="/assets/penrose-logo.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/penrose-logo.png" />
    <!-- Preconnect to external origins to speed up resource loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=DM+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="manifest" href="/site.webmanifest"/>
    <link rel="sitemap" href="/sitemap.xml" type="application/xml" />
    <meta name="google-adsense-account" content="ca-pub-5105781580031290" />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="gs-page-shell">
      <PublicHeader currentPath={Astro.url.pathname} />

      <main id="content" class="gs-page-content">
        <slot />
      </main>

      <PublicFooter />
    </div>

    <style is:global>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 1200;
        padding: 0.75rem 1rem;
        background: var(--gs-surface-strong);
        color: var(--gs-text);
        border-radius: 999px;
        border: 1px solid var(--gs-border);
        text-decoration: none;
      }

      .skip-link:focus {
        top: 1rem;
      }

      .gs-page-shell {
        min-height: 100vh;
        --gs-header-height: 72px;
        --gs-site-width: 1440px;
        --gs-site-gutter: clamp(1rem, 4vw, 4rem);
        --gs-site-columns: repeat(12, minmax(0, 1fr));
        scroll-padding-top: var(--gs-header-height);
      }

      .gs-page-content {
        min-height: calc(100vh - 220px);
      }

      .gs-page-content > * {
        scroll-margin-top: calc(var(--gs-header-height) + 1rem);
      }

      .header {
        position: sticky;
        top: 0;
        z-index: 1100;
        padding: 1rem clamp(1rem, 3vw, 3rem);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(6, 6, 10, 0.88);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        transition:
          padding 220ms ease,
          background 220ms ease,
          border-color 220ms ease;
      }

      .header.is-scrolled {
        padding-block: 0.68rem;
        background: rgba(6, 6, 10, 0.96);
        border-bottom-color: rgba(217, 106, 50, 0.34);
      }

      .header__inner {
        width: min(100%, var(--gs-site-width));
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: clamp(1rem, 2vw, 2rem);
      }

      .header-brand {
        display: flex;
        align-items: center;
        gap: 1rem;
        color: var(--gs-text);
        text-decoration: none;
        min-width: 0;
      }

      .header-brand__lockup {
        display: block;
        min-width: 0;
      }

      .header-brand__lockup strong {
        display: block;
        color: var(--gs-text);
        font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        line-height: 1.2;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .header-brand--mobile {
        flex: 1;
      }

      .header-brand__mobile-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }

      .desktop-nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: clamp(0.75rem, 1.5vw, 1.5rem);
        flex: 1;
      }

      .desktop-nav__links {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: clamp(0.25rem, 0.8vw, 0.75rem);
        flex-wrap: wrap;
      }

      .desktop-nav__links a,
      .menu-panel__links a {
        text-decoration: none;
        transition:
          color 160ms ease,
          border-color 160ms ease,
          background 160ms ease,
          transform 160ms ease;
      }

      .desktop-nav__links a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.6rem 0.85rem;
        border-radius: 6px;
        color: var(--gs-text);
        transition: all 160ms ease;
      }

      .desktop-nav__links a:hover,
      .desktop-nav__links a[aria-current='page'] {
        color: var(--gs-text);
        background: rgba(220, 120, 60, 0.12);
      }

      .header-login {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.72rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: var(--gs-text);
        font-weight: 500;
        white-space: nowrap;
        transition: all 160ms ease;
      }

      .header-login:hover,
      .header-login:focus-visible {
        color: var(--gs-text);
        border-color: rgba(220, 120, 60, 0.6);
        background: rgba(220, 120, 60, 0.08);
      }

      .header-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.82rem 1.2rem;
        border-radius: 6px;
        text-decoration: none;
        background: linear-gradient(135deg, rgba(220, 120, 60, 0.8), rgba(200, 100, 50, 0.8));
        border: 1px solid rgba(220, 120, 60, 0.9);
        color: #fff;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 10px 28px rgba(220, 120, 60, 0.25);
        transition: all 160ms ease;
      }

      .header-cta:hover,
      .header-cta:focus-visible {
        transform: translateY(-2px);
        background: linear-gradient(135deg, rgba(230, 130, 70, 0.9), rgba(210, 110, 60, 0.9));
        box-shadow: 0 14px 36px rgba(220, 120, 60, 0.35);
      }

      .menu-button,
      .menu-panel {
        display: none;
      }

      .menu-button {
        position: relative;
        z-index: 1102;
        width: 46px;
        height: 46px;
        place-items: center;
        gap: 4px;
        border-radius: 6px;
        border: 1px solid var(--gs-border);
        background: rgba(220, 120, 60, 0.08);
        cursor: pointer;
        transition: all 160ms ease;
      }

      .menu-button:hover {
        background: rgba(220, 120, 60, 0.14);
        border-color: rgba(220, 120, 60, 0.4);
      }

      .menu-button span {
        display: block;
        width: 18px;
        height: 1.5px;
        border-radius: 999px;
        background: var(--gs-text);
        transition: transform 160ms ease, opacity 160ms ease;
      }

      .header[data-menu-open='true'] .menu-button span:nth-child(1) {
        transform: translateY(5.5px) rotate(45deg);
      }

      .header[data-menu-open='true'] .menu-button span:nth-child(2) {
        opacity: 0;
      }

      .header[data-menu-open='true'] .menu-button span:nth-child(3) {
        transform: translateY(-5.5px) rotate(-45deg);
      }

      .menu-panel {
        position: fixed;
        inset: 0;
        padding: max(0.8rem, env(safe-area-inset-top)) 0.8rem 0.8rem;
        justify-items: end;
        background: rgba(5, 8, 14, 0);
        pointer-events: none;
        transition: background 180ms ease;
      }

      .menu-panel__inner {
        width: min(360px, 100%);
        min-height: calc(100vh - 1.6rem);
        padding: 0.95rem;
        display: grid;
        align-content: start;
        gap: 1rem;
        transform: translateX(100%);
        transition: transform 180ms ease;
        background: rgba(7, 14, 28, 0.97);
        border: 1px solid var(--gs-border);
        border-radius: 24px;
        box-shadow: -24px 0 80px rgba(0, 0, 0, 0.38);
      }

      .menu-panel__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .gs-logo-link--mobile {
        flex: 1;
      }

      .menu-close {
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid var(--gs-border);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.07);
        color: var(--gs-text);
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        flex-shrink: 0;
        transition: all 160ms ease;
      }

      .menu-close:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(220, 120, 60, 0.5);
      }

      .menu-panel__links {
        display: grid;
        gap: 0.45rem;
      }

      .menu-panel__links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0.95rem 1rem;
        border-radius: 6px;
        color: var(--gs-text-dim);
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.03);
        transition: all 160ms ease;
      }

      .menu-panel__links a:hover,
      .menu-panel__links a[aria-current='page'] {
        color: var(--gs-text);
        border-color: rgba(220, 120, 60, 0.5);
        background: rgba(220, 120, 60, 0.10);
      }

      .menu-panel__actions {
        display: grid;
        gap: 0.75rem;
      }

      .header-cta--mobile,
      .menu-secondary-link {
        width: 100%;
      }

      .menu-secondary-link {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 0.82rem 1.2rem;
        border-radius: 6px;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: var(--gs-text);
        transition: all 160ms ease;
      }

      .menu-secondary-link:hover {
        border-color: rgba(220, 120, 60, 0.6);
        background: rgba(220, 120, 60, 0.08);
      }

      .header[data-menu-open='true'] .menu-panel {
        pointer-events: auto;
        display: grid;
        background: rgba(5, 8, 14, 0.5);
      }

      .header[data-menu-open='true'] .menu-panel__inner {
        transform: translateX(0);
      }

      .gs-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding: 2rem clamp(1rem, 3vw, 2rem) 3rem;
      }

      .gs-footer__inner {
        width: min(100%, var(--gs-max-width));
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(260px, 1fr) minmax(360px, 1.5fr) auto;
        gap: 2rem;
        align-items: flex-start;
      }

      .footer-brand-copy {
        display: grid;
        gap: 1rem;
      }

      .footer-brand__logo {
        width: 55px;
        height: 55px;
        object-fit: contain;
      }

      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
      }

      .footer-coords {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        text-align: right;
        font-family: 'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.65rem;
        color: var(--gs-text-dim);
        letter-spacing: 0.09em;
      }

      .footer-coords__item {
        line-height: 1.2;
      }

      .gs-footer p {
        max-width: 42ch;
        color: var(--gs-text-dim);
        line-height: 1.7;
        margin: 0;
      }

      .gs-footer__links {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem 1.5rem;
        align-content: flex-start;
      }

      .gs-footer__links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        min-width: 44px;
        color: var(--gs-text-dim);
        text-decoration: none;
      }

      .gs-footer__links a:hover {
        color: var(--gs-text);
      }

      .gs-shell-section {
        width: min(calc(100% - (2 * var(--gs-site-gutter))), var(--gs-site-width));
        margin: 0 auto;
      }

      .gs-column-grid {
        display: grid;
        grid-template-columns: var(--gs-site-columns);
        column-gap: clamp(0.75rem, 1.5vw, 1.5rem);
      }

      .gs-column-grid > * {
        grid-column: 1 / -1;
        min-width: 0;
      }

      .gs-eyebrow {
        margin: 0;
        color: var(--gs-primary);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-size: 0.78rem;
      }

      @media (max-width: 1023px) {
        .desktop-nav {
          display: none;
        }

        .menu-button {
          display: inline-grid;
        }

        .gs-footer__inner {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .footer-brand-copy {
          max-width: 42rem;
        }

        .footer-coords {
          flex-direction: row;
          justify-content: flex-start;
          gap: 1rem;
          text-align: left;
        }
      }

      @media (max-width: 720px) {
        .header {
          padding-inline: 0.8rem;
        }

        .header-brand__lockup strong {
          font-size: 0.9rem;
        }

        .menu-panel__header {
          align-items: center;
        }

        .gs-footer__links {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 0.35rem 1rem;
        }
      }
    </style>
  </body>
</html>
