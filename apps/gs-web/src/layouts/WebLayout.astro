---
import Logo from '../components/brand/Logo.astro';
import '@goldshore/theme/styles/tokens.css';
import '@goldshore/theme/styles/base.css';
import '@goldshore/theme/styles/components.css';
import '@goldshore/theme/styles/layout.css';
import '../styles/global.css';
import { WEB_META_CSP } from '../utils/csp';
import '../styles/goldshore-shell.css';
import { primaryNavLinks, companyLinks } from '../config/navigation';

const { title, description, canonicalPath, ogTitle, ogDescription } = Astro.props;
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, 'https://goldshore.ai').toString()
  : Astro.url.href;
const navLinks = primaryNavLinks;
const footerLinks = companyLinks;
const currentPath = Astro.url.pathname;
const mobileNavId = 'mobile-navigation';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={WEB_META_CSP} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <!-- Preconnect to external origins to speed up resource loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=DM+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="manifest" href="/site.webmanifest"/>
    <meta name="google-adsense-account" content="ca-pub-5105781580031290" />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="gs-page-shell">
      <header class="header" data-menu-open="false">
        <div class="header__inner">
          <a href="/" class="header-brand" aria-label="Gold Shore home">
            <span class="header-brand__coords">40°42′45″N<br />74°00′21″W</span>
            <span class="header-brand__mark">GS·LAB·v2.84</span>
            <span class="header-brand__lockup"><strong>Gold Shore Labs</strong><em>GoldShore</em></span>
          </a>

          <nav class="desktop-nav" aria-label="Primary navigation">
            <div class="desktop-nav__links">
              {navLinks.map((link) => (
                <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
            <a href="https://admin.goldshore.ai" class="header-login" data-admin-access-link>Log in</a>
            <a href="/contact" class="header-cta">Get a Briefing</a>
          </nav>

          <button
            class="menu-button"
            type="button"
            aria-expanded="false"
            aria-controls={mobileNavId}
            aria-label="Open navigation"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>

        <nav id={mobileNavId} class="menu-panel" aria-label="Mobile navigation">
          <div class="menu-panel__inner">
            <div class="menu-panel__header">
              <a href="/" class="header-brand header-brand--mobile" aria-label="GoldShore home">
                <span class="header-brand__mark">GS·LAB</span>
                <span class="header-brand__lockup"><strong>Gold Shore Labs</strong><em>Institutional AI systems</em></span>
              </a>
              <button class="menu-close" type="button" aria-label="Close navigation">×</button>
            </div>

            <div class="menu-panel__links">
              {navLinks.map((link) => (
                <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </div>

            <div class="menu-panel__actions">
              <a href="/contact" class="header-cta header-cta--mobile">Get a Briefing</a>
              <a href="https://admin.goldshore.ai" class="menu-secondary-link" data-admin-access-link>Log in</a>
              <a href="/developer" class="menu-secondary-link">Open Developer Hub</a>
            </div>
          </div>
        </nav>
      </header>

      <main id="content" class="gs-page-content">
        <slot />
      </main>

      <footer class="gs-footer">
        <div class="gs-footer__inner">
          <div class="footer-brand-copy">
            <div class="footer-brand">
              <Logo class="gs-logo gs-logo--footer" title="Gold Shore" />
              <div class="brand-lockup brand-lockup--footer">
                <strong>Gold Shore</strong>
                <span>Operational AI, observability, and control systems</span>
              </div>
            </div>
            <p>
              Infrastructure for high-trust AI, risk tooling, and resilient operator systems.
            </p>
          </div>
          <div class="gs-footer__links">
            {footerLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      const menuGlobal = window;

      const bindMenu = () => {
        if (menuGlobal.__gsMenuBound) return;
        menuGlobal.__gsMenuBound = true;

        const header = document.querySelector('.header');
        const toggle = document.querySelector('.menu-button');
        const mobileNav = document.getElementById('mobile-navigation');

        if (
          !(header instanceof HTMLElement) ||
          !(toggle instanceof HTMLButtonElement) ||
          !(mobileNav instanceof HTMLElement)
        ) {
          return;
        }

        const setMenu = (isOpen) => {
          header.dataset.menuOpen = String(isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
          document.body.classList.toggle('menu-open', isOpen);
        };

        const handleToggle = () => {
          const next = header.dataset.menuOpen !== 'true';
          setMenu(next);
        };

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          if (target.closest('.menu-button')) {
            handleToggle();
            return;
          }

          if (target.closest('.menu-close')) {
            setMenu(false);
            return;
          }

          // Close on any link click inside the mobile nav panel
          if (target.closest('#mobile-navigation a')) {
            setMenu(false);
            return;
          }

          // Close on backdrop click
          if (target === mobileNav) {
            setMenu(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setMenu(false);
          }
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 960) {
            setMenu(false);
          }
        });

        document.addEventListener('astro:before-swap', () => {
          setMenu(false);
        });
      };

      const bindAdminAccessLinks = () => {
        document.querySelectorAll('[data-admin-access-link]').forEach((link) => {
          link.setAttribute('href', 'https://admin.goldshore.ai/');
        });
      };

      bindMenu();
      bindAdminAccessLinks();
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 1200;
        padding: 0.75rem 1rem;
        background: var(--gs-surface-strong);
        color: var(--gs-text);
        border-radius: 999px;
        border: 1px solid var(--gs-border);
        text-decoration: none;
      }

      .skip-link:focus {
        top: 1rem;
      }

      .gs-page-shell {
        min-height: 100vh;
      }

      .gs-page-content {
        min-height: calc(100vh - 220px);
      }

      .header {
        position: sticky;
        top: 0;
        z-index: 1100;
        padding: 1rem clamp(1rem, 3vw, 3rem);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        background: rgba(6, 6, 10, 0.88);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .header__inner {
        width: min(100%, 1440px);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
      }

      .header-brand {
        display: flex;
        align-items: center;
        gap: 1rem;
        color: var(--gs-text);
        text-decoration: none;
        min-width: 0;
      }

      .header-brand__coords {
        color: var(--gs-text-dim);
        font-family: 'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.52rem;
        letter-spacing: 0.09em;
        line-height: 1.35;
        text-transform: uppercase;
      }

      .header-brand__mark {
        flex-shrink: 0;
        padding: 0.48rem 0.64rem;
        border: 1px solid rgba(217, 106, 50, 0.28);
        color: var(--gs-primary);
        font-family: 'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.62rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .header-brand__lockup {
        display: block;
        min-width: 0;
      }

      .header-brand__lockup strong {
        display: block;
        color: var(--gs-text);
        font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        line-height: 1.2;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .header-brand__lockup em {
        display: block;
        color: var(--gs-text-dim);
        font-family: 'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.65rem;
        font-style: normal;
        letter-spacing: 0.09em;
        line-height: 1.35;
        text-transform: uppercase;
      }

      .header-brand--mobile {
        flex: 1;
      }

      .desktop-nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
        flex: 1;
      }

      .desktop-nav__links {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.25rem;
        flex-wrap: wrap;
      }

      .desktop-nav__links a,
      .menu-panel__links a {
        text-decoration: none;
        transition:
          color 160ms ease,
          border-color 160ms ease,
          background 160ms ease,
          transform 160ms ease;
      }

      .desktop-nav__links a {
        padding: 0.6rem 0.85rem;
        border-radius: 999px;
        color: var(--gs-text-dim);
      }

      .desktop-nav__links a:hover,
      .desktop-nav__links a[aria-current='page'] {
        color: var(--gs-text);
        background: rgba(217, 106, 50, 0.09);
      }

      .header-login {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1rem;
        border-radius: 999px;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: var(--gs-text-dim);
        font-weight: 500;
        white-space: nowrap;
        transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
      }

      .header-login:hover,
      .header-login:focus-visible {
        color: var(--gs-text);
        border-color: rgba(255, 255, 255, 0.28);
        background: rgba(255, 255, 255, 0.05);
      }

      .header-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.82rem 1.2rem;
        border-radius: 999px;
        text-decoration: none;
        background: linear-gradient(135deg, rgba(217, 106, 50, 0.42), rgba(217, 106, 50, 0.22));
        border: 1px solid rgba(217, 106, 50, 0.5);
        color: var(--gs-text);
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 18px 40px rgba(5, 12, 29, 0.26);
      }

      .header-cta:hover,
      .header-cta:focus-visible {
        transform: translateY(-1px);
        background: linear-gradient(135deg, rgba(217, 106, 50, 0.52), rgba(217, 106, 50, 0.30));
      }

      .menu-button,
      .menu-panel {
        display: none;
      }

      .menu-button {
        position: relative;
        z-index: 1102;
        width: 46px;
        height: 46px;
        place-items: center;
        gap: 4px;
        border-radius: 999px;
        border: 1px solid var(--gs-border);
        background: rgba(217, 106, 50, 0.08);
        cursor: pointer;
      }

      .menu-button span {
        display: block;
        width: 18px;
        height: 1.5px;
        border-radius: 999px;
        background: var(--gs-text);
        transition: transform 160ms ease, opacity 160ms ease;
      }

      .header[data-menu-open='true'] .menu-button span:nth-child(1) {
        transform: translateY(5.5px) rotate(45deg);
      }

      .header[data-menu-open='true'] .menu-button span:nth-child(2) {
        opacity: 0;
      }

      .header[data-menu-open='true'] .menu-button span:nth-child(3) {
        transform: translateY(-5.5px) rotate(-45deg);
      }

      .menu-panel {
        position: fixed;
        inset: 0;
        padding: max(0.8rem, env(safe-area-inset-top)) 0.8rem 0.8rem;
        justify-items: end;
        background: rgba(5, 8, 14, 0);
        pointer-events: none;
        transition: background 180ms ease;
      }

      .menu-panel__inner {
        width: min(360px, 100%);
        min-height: calc(100vh - 1.6rem);
        padding: 0.95rem;
        display: grid;
        align-content: start;
        gap: 1rem;
        transform: translateX(100%);
        transition: transform 180ms ease;
        background: rgba(7, 14, 28, 0.97);
        border: 1px solid var(--gs-border);
        border-radius: 24px;
        box-shadow: -24px 0 80px rgba(0, 0, 0, 0.38);
      }

      .menu-panel__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .gs-logo-link--mobile {
        flex: 1;
      }

      .menu-close {
        width: 2.5rem;
        height: 2.5rem;
        border: 0;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.07);
        color: var(--gs-text);
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        flex-shrink: 0;
      }

      .menu-panel__links {
        display: grid;
        gap: 0.45rem;
      }

      .menu-panel__links a {
        padding: 0.95rem 1rem;
        border-radius: 16px;
        color: var(--gs-text-dim);
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.03);
      }

      .menu-panel__links a:hover,
      .menu-panel__links a[aria-current='page'] {
        color: var(--gs-text);
        border-color: var(--gs-border);
        background: rgba(217, 106, 50, 0.08);
      }

      .menu-panel__actions {
        display: grid;
        gap: 0.75rem;
      }

      .header-cta--mobile,
      .menu-secondary-link {
        width: 100%;
      }

      .menu-secondary-link {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 0.82rem 1.2rem;
        border-radius: 999px;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--gs-text);
      }

      .header[data-menu-open='true'] .menu-panel {
        pointer-events: auto;
        display: grid;
        background: rgba(5, 8, 14, 0.5);
      }

      .header[data-menu-open='true'] .menu-panel__inner {
        transform: translateX(0);
      }

      .gs-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding: 2rem clamp(1rem, 3vw, 2rem) 3rem;
      }

      .gs-footer__inner {
        width: min(100%, var(--gs-max-width));
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        align-items: flex-start;
      }

      .footer-brand-copy {
        display: grid;
        gap: 1rem;
      }

      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
      }

      .gs-footer p {
        max-width: 42ch;
        color: var(--gs-text-dim);
        line-height: 1.7;
        margin: 0;
      }

      .gs-footer__links {
        display: grid;
        gap: 0.65rem;
      }

      .gs-footer__links a {
        color: var(--gs-text-dim);
        text-decoration: none;
      }

      .gs-footer__links a:hover {
        color: var(--gs-text);
      }

      .gs-shell-section {
        width: min(100% - 2rem, var(--gs-max-width));
        margin: 0 auto;
      }

      .gs-eyebrow {
        margin: 0;
        color: var(--gs-primary);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-size: 0.78rem;
      }

      @media (max-width: 960px) {
        .desktop-nav {
          display: none;
        }

        .menu-button {
          display: inline-grid;
        }
      }

      @media (max-width: 720px) {
        .header {
          padding-inline: 0.8rem;
        }

        .header-brand__coords {
          display: none;
        }

        .header-brand__lockup strong {
          font-size: 0.78rem;
        }

        .header-brand__lockup em {
          font-size: 0.58rem;
        }

        .menu-panel__header {
          align-items: center;
        }

        .gs-footer__inner {
          flex-direction: column;
        }
      }
    </style>
  </body>
</html>
