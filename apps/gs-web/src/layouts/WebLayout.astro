---
import Logo from '../components/brand/Logo.astro';
import '../styles/global.css';
import { WEB_META_CSP } from '../utils/csp';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
  { href: '/apps/risk-radar', label: 'Risk Radar' },
  { href: '/developer', label: 'Developer Hub' },
];

const footerLinks = [
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
  { href: '/apps/risk-radar', label: 'Risk Radar' },
  { href: '/developer', label: 'Developer Hub' },
];

const {
  title = 'GoldShore',
  description = 'GoldShore AI',
  currentPath = Astro.url.pathname,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = new URL('/logo.svg', Astro.site ?? Astro.url);
const mobileNavId = 'mobile-navigation';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={WEB_META_CSP} />
    <meta name="theme-color" content="#050507" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="gs-shell">
      <header class="gs-header" data-menu-open="false">
        <div class="gs-header__inner">
          <a href="/" class="gs-logo-link" aria-label="Gold Shore home">
            <Logo class="gs-logo" title="Gold Shore" variant="mark" />
            <div class="brand-lockup">
              <strong>GoldShore</strong>
              <span>Rapid prototypes for rapid systems</span>
            </div>
          </a>

          <nav class="gs-nav" aria-label="Primary navigation">
            <div class="gs-nav__links">
              {navLinks.map((link) => (
                <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </div>

            <span class="gs-header-status">Operational</span>
            <a href="/contact" class="gs-header-cta">Request Briefing</a>
          </nav>

          <button
            class="gs-nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls={mobileNavId}
            aria-label="Open navigation"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>

        <nav id={mobileNavId} class="gs-mobile-nav" aria-label="Mobile navigation">
          <div class="gs-mobile-nav__panel">
            <div class="gs-mobile-nav__header">
              <a href="/" class="gs-mobile-nav__brand" aria-label="GoldShore home">
                <Logo class="gs-logo" title="GoldShore" />
                <div class="brand-lockup">
                  <strong>GoldShore</strong>
                  <span>Rapid prototypes for rapid systems</span>
                </div>
              </a>
              <button class="gs-mobile-nav__close" type="button" aria-label="Close navigation">×</button>
            </div>

            <div class="gs-mobile-nav__links">
              {navLinks.map((link) => (
                <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </div>

            <div class="gs-mobile-nav__actions">
              <a href="/contact" class="gs-mobile-nav__cta gs-header-cta">Request Briefing</a>
              <a href="/developer" class="gs-mobile-nav__secondary">Open Developer Hub</a>
            </div>
          </div>
        </nav>
      </header>

      <main id="content" class="gs-page-content">
        <slot />
      </main>

      <footer class="gs-footer">
        <div class="gs-footer__inner">
          <div class="gs-footer__brand-copy">
            <div class="gs-footer__brand">
              <Logo class="gs-logo" title="Gold Shore" variant="mark" />
              <div class="brand-lockup brand-lockup--footer">
                <strong>GoldShore</strong>
                <span>Rapid prototypes for rapid systems</span>
              </div>
            </div>
            <p>
              Infrastructure for high-trust AI, risk tooling, and resilient operator systems.
            </p>
          </div>
          <div class="gs-footer__links">
            {footerLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      const root = document.documentElement;

      const bindMenu = () => {
        if (window.__gsMenuBound) return;
        window.__gsMenuBound = true;

        const header = document.querySelector('.gs-header');
        const toggle = document.querySelector('.gs-nav-toggle');
        const mobileNav = document.getElementById('mobile-navigation');

        if (
          !(header instanceof HTMLElement) ||
          !(toggle instanceof HTMLButtonElement) ||
          !(mobileNav instanceof HTMLElement)
        ) {
          return;
        }

        const setMenu = (isOpen) => {
          header.dataset.menuOpen = String(isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
          document.body.classList.toggle('menu-open', isOpen);
        };

        const handleToggle = () => setMenu(header.dataset.menuOpen !== 'true');

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          if (target.closest('.gs-nav-toggle')) {
            handleToggle();
            return;
          }

          if (target.closest('.gs-mobile-nav__close')) {
            setMenu(false);
            return;
          }

          if (target.closest('#mobile-navigation .gs-mobile-nav__links a') || target === mobileNav) {
            setMenu(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenu(false);
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 960) setMenu(false);
        });

        document.addEventListener('astro:before-swap', () => setMenu(false));
      };

      if (root.dataset.gsMenuBooted !== 'true') {
        root.dataset.gsMenuBooted = 'true';
        bindMenu();
      }
    </script>

    <style is:global>
      .gs-logo-link {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        text-decoration: none;
      }

      .gs-logo {
        width: clamp(24px, 3vw, 36px);
        height: auto;
        color: var(--gs-primary);
        flex-shrink: 0;
      }

      .gs-logo--lockup {
        width: clamp(200px, 18vw, 280px);
      }

      .gs-logo--footer {
        width: 28px;
      }

      .brand-lockup {
        display: grid;
        gap: 0.1rem;
      }

      .brand-lockup strong {
        font-size: 0.98rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .brand-lockup span {
        color: var(--gs-text-dim);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .brand-lockup--footer span {
        max-width: 28ch;
      }

      .gs-nav-toggle {
        position: relative;
        z-index: 1102;
        width: 46px;
        height: 46px;
        place-items: center;
        gap: 4px;
        border-radius: 999px;
        border: 1px solid var(--gs-border);
        background: rgba(255, 255, 255, 0.04);
        cursor: pointer;
      }

      .gs-nav-toggle span {
        display: block;
        width: 18px;
        height: 1.5px;
        border-radius: 999px;
        background: var(--gs-text);
        transition: transform 160ms ease, opacity 160ms ease;
      }

      .gs-header[data-menu-open='true'] .gs-nav-toggle span:nth-child(1) {
        transform: translateY(5.5px) rotate(45deg);
      }

      .gs-header[data-menu-open='true'] .gs-nav-toggle span:nth-child(2) {
        opacity: 0;
      }

      .gs-header[data-menu-open='true'] .gs-nav-toggle span:nth-child(3) {
        transform: translateY(-5.5px) rotate(-45deg);
      }

      @media (max-width: 960px) {
        .gs-nav {
          display: none;
        }

        .gs-nav-toggle {
          display: inline-grid;
        }
      }
    </style>
  </body>
</html>


