---
import '@goldshore/theme/styles/tokens.css';
import '@goldshore/theme/styles/base.css';
import '@goldshore/theme/styles/components.css';
import '@goldshore/theme/styles/layout.css';
import '../styles/global.css';
import { WEB_META_CSP } from '../utils/csp';
import '../styles/goldshore-shell.css';
import PublicFooter from '../components/PublicFooter.astro';
import PublicHeader from '../components/PublicHeader.astro';

const { title, description, canonicalPath } = Astro.props;
const ogTitle = Astro.props.ogTitle ?? title;
const ogDescription = Astro.props.ogDescription ?? description;
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, Astro.url.origin).toString()
  : Astro.url.href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={WEB_META_CSP} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <link rel="icon" href="/assets/penrose-logo.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/penrose-logo.png" />
    <!-- Preconnect to external origins to speed up resource loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300&family=DM+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="manifest" href="/site.webmanifest"/>
    <link rel="sitemap" href="/sitemap.xml" type="application/xml" />
    <meta name="google-adsense-account" content="ca-pub-5105781580031290" />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="gs-page-shell gs-shell-v284">
      <PublicHeader currentPath={Astro.url.pathname} />
      <main id="content" class="gs-page-content"><slot /></main>
      <PublicFooter />
    </div>
    <script>
      import '../scripts/theme-navigation';
      import '../scripts/page-motion';
    </script>
  </body>
</html>
