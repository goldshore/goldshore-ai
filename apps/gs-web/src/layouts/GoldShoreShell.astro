---
import '../styles/global.css';
import '../styles/public-theme.css';
import { primaryNavLinks, platformLinks, serviceLinks, companyLinks } from '../config/navigation';

const navLinks = primaryNavLinks;

const footerColumns = [
  { title: 'Platform', links: platformLinks },
  { title: 'Services', links: serviceLinks },
  { title: 'Company', links: companyLinks },
];

const {
  title = 'GoldShore',
  description = 'GoldShore AI',
  canonicalPath = Astro.url.pathname,
  ogTitle = title,
  ogDescription = description,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, 'https://goldshore.ai').toString();
const socialImageUrl = new URL('/logo.png', 'https://goldshore.ai').toString();
const normalizePath = (path: string) => {
  const normalized = path.startsWith('/') ? path : `/${path}`;
  return normalized === '/' ? '/' : `${normalized.replace(/\/+$/, '')}/`;
};
const activePath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => {
  const normalizedHref = normalizePath(href);
  return normalizedHref === '/'
    ? activePath === '/'
    : activePath === normalizedHref || activePath.startsWith(normalizedHref);
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:site_name" content="GoldShore" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#06060a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
    <meta name="google-adsense-account" content="ca-pub-5105781580031290" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Gold Shore Labs',
      alternateName: 'GoldShore',
      url: 'https://goldshore.ai',
      logo: 'https://goldshore.ai/logo.png',
      sameAs: [],
    })}></script>
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="gs-page-shell gs-shell-v284">
      <header class="topbar" data-menu-open="false">
        <div class="topbar-inner">
          <a class="brand-text" href="/" aria-label="GoldShore home">GoldShore</a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Toggle menu"><span></span><span></span><span></span></button>
          <nav class="main-nav" aria-label="Primary navigation">
            {navLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
            <a href="https://admin.goldshore.ai" class="nav-login" data-admin-access-link>Access →</a>
            <a href="/contact/" class="nav-cta">Request Briefing</a>
          </nav>
        </div>
        <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation">
          {navLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
          <a href="https://admin.goldshore.ai" data-admin-access-link>Access →</a>
          <a href="/contact/">Request Briefing</a>
        </nav>
      </header>

      <main id="content" class="gs-page-content"><slot /></main>

      <footer class="site-footer">
        <div class="footer-brand">
          <h2>GoldShore</h2>
          <p>Applied Intelligence · Digital Systems · Consulting</p>
          <p>Institutional AI systems, risk tooling, and resilient operator infrastructure. Cross-sector. Full-stack. Built to last.</p>
        </div>
        {footerColumns.map((column) => (
          <div>
            <h3>{column.title}</h3>
            {column.links.map((link) => <p><a href={link.href}>{link.label}</a></p>)}
          </div>
        ))}
        <div class="footer-meta-block">
          <span>40°42′45″N</span>
          <span>74°00′21″W</span>
          <span>GS·LAB·V2.84</span>
        </div>
        <small>© 2026 Gold Shore Labs. All rights reserved. goldshore.ai · <a href="/legal/privacy">Privacy</a> · <a href="/legal/">Security</a> · <a href="/legal/terms">Terms</a></small>
      </footer>
    </div>

    <script is:inline>
      const bindMenu = () => {
        if (window.__gsMenuBound) return;
        window.__gsMenuBound = true;
        const header = document.querySelector('.topbar');
        const toggle = document.querySelector('.nav-toggle');
        if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
        const setMenu = (isOpen) => {
          header.dataset.menuOpen = String(isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
        };
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('.nav-toggle')) return setMenu(header.dataset.menuOpen !== 'true');
          if (target.closest('#mobile-navigation a')) return setMenu(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenu(false);
        });
      };
      const bindAdminAccessLinks = () => {
        document.querySelectorAll('[data-admin-access-link]').forEach((link) => {
          link.setAttribute('href', 'https://admin.goldshore.ai/');
        });
      };
      bindMenu();
      bindAdminAccessLinks();
    </script>
    <script>
      import '../scripts/page-motion';
    </script>
  </body>
</html>
