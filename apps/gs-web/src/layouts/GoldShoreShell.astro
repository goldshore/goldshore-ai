---
import '../styles/global.css';

const navLinks = [
  { href: '/platform/', label: 'Platform' },
  { href: '/risk-radar/', label: 'Risk Radar' },
  { href: '/services/', label: 'Services' },
  { href: '/developer/', label: 'Developer' },
  { href: '/about/', label: 'About' },
  { href: '/team/', label: 'Team' },
  { href: '/contact/', label: 'Contact' },
];

const footerColumns = [
  {
    title: 'Platform',
    links: [
      { href: '/risk-radar/', label: 'Risk Radar' },
      { href: '/platform/financial-signals', label: 'Financial Signals' },
      { href: '/platform/workflow-engine', label: 'Workflow Engine' },
      { href: '/platform/sentinel', label: 'Sentinel' },
      { href: '/platform/ai-oracle', label: 'AI Oracle' },
    ],
  },
  {
    title: 'Services',
    links: [
      { href: '/services/digital-strategy', label: 'Digital Strategy' },
      { href: '/services/ai-implementation', label: 'AI Implementation' },
      { href: '/services/systems-integration', label: 'Systems Integration' },
      { href: '/services/design-dev', label: 'Design & Development' },
      { href: '/services/consulting', label: 'Enterprise Consulting' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/team/', label: 'Team' },
      { href: '/developer/', label: 'Developer Hub' },
      { href: '/status/', label: 'Status' },
      { href: '/contact/', label: 'Contact' },
    ],
  },
];

const {
  title = 'GoldShore',
  description = 'GoldShore AI',
  canonicalPath = Astro.url.pathname,
  ogTitle = title,
  ogDescription = description,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, 'https://goldshore.ai').toString();
const activePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => activePath === href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
    <meta name="google-adsense-account" content="ca-pub-5105781580031290" />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="gs-page-shell gs-shell-v284">
      <header class="topbar" data-menu-open="false">
        <div class="topbar-inner">
          <a class="brand-text" href="/" aria-label="GoldShore home">GoldShore</a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Toggle menu"><span></span><span></span><span></span></button>
          <nav class="main-nav" aria-label="Primary navigation">
            {navLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
            <a href="/admin/lead-submissions" class="nav-login">Access →</a>
            <a href="/contact/" class="nav-cta">Request Briefing</a>
          </nav>
        </div>
        <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation">
          {navLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
          <a href="/admin/lead-submissions">Access →</a>
          <a href="/contact/">Request Briefing</a>
        </nav>
      </header>

      <main id="content" class="gs-page-content"><slot /></main>

      <footer class="site-footer">
        <div class="footer-brand">
          <h2>GoldShore</h2>
          <p>Applied Intelligence · Digital Systems · Consulting</p>
          <p>Institutional AI systems, risk tooling, and resilient operator infrastructure. Cross-sector. Full-stack. Built to last.</p>
        </div>
        {footerColumns.map((column) => (
          <div>
            <h3>{column.title}</h3>
            {column.links.map((link) => <p><a href={link.href}>{link.label}</a></p>)}
          </div>
        ))}
        <div class="footer-meta-block">
          <span>40°42′45″N</span>
          <span>74°00′21″W</span>
          <span>GS·LAB·V2.84</span>
        </div>
        <small>© 2026 Gold Shore Labs. All rights reserved. goldshore.ai · <a href="/legal/privacy">Privacy</a> · <a href="/legal/">Security</a> · <a href="/legal/terms">Terms</a></small>
      </footer>
    </div>

    <script is:inline>
      const bindMenu = () => {
        if (window.__gsMenuBound) return;
        window.__gsMenuBound = true;
        const header = document.querySelector('.topbar');
        const toggle = document.querySelector('.nav-toggle');
        if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
        const setMenu = (isOpen) => {
          header.dataset.menuOpen = String(isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
        };
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('.nav-toggle')) return setMenu(header.dataset.menuOpen !== 'true');
          if (target.closest('#mobile-navigation a')) return setMenu(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenu(false);
        });
      };
      bindMenu();
    </script>
  </body>
</html>
