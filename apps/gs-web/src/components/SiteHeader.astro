---
const {
  currentPath = Astro.url.pathname,
  navLinks = [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/services', label: 'Services' },
    { href: '/team', label: 'Team' },
    { href: '/contact', label: 'Contact' }
  ]
} = Astro.props;
---

<header class="gs-header" data-menu-open="false">
  <button
    id="menu-toggle"
    class="gs-nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-navigation"
  >
    <span class="sr-only">Toggle menu</span>
    <span class="gs-nav-toggle__bar" aria-hidden="true"></span>
    <span class="gs-nav-toggle__bar" aria-hidden="true"></span>
    <span class="gs-nav-toggle__bar" aria-hidden="true"></span>
  </button>

  <nav class="gs-nav" id="primary-navigation" aria-label="Primary">
    {
      navLinks.map((link) => (
        <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script is:inline>
  const header = document.querySelector('.gs-header');
  const toggle = document.querySelector('#menu-toggle');
  const menu = document.querySelector('#primary-navigation');

  const firstMobileLink = () => menu?.querySelector('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])');

  const setMenuState = (isOpen, options = { restoreFocus: false }) => {
    if (!header || !toggle || !menu) {
      return;
    }

    const value = isOpen ? 'true' : 'false';
    header.setAttribute('data-menu-open', value);
    toggle.setAttribute('aria-expanded', value);
    menu.toggleAttribute('hidden', !isOpen);

    if (isOpen) {
      firstMobileLink()?.focus();
    } else if (options.restoreFocus) {
      toggle.focus();
    }
  };

  const closeMenu = (options) => setMenuState(false, { restoreFocus: true, ...options });

  toggle?.addEventListener('click', (event) => {
    event.stopPropagation();

    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMenu({ restoreFocus: true });
    } else {
      setMenuState(true);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu({ restoreFocus: true });
    }
  });

  document.addEventListener('click', (event) => {
    if (
      toggle?.getAttribute('aria-expanded') === 'true' &&
      header &&
      event.target instanceof Node &&
      !header.contains(event.target)
    ) {
      closeMenu({ restoreFocus: true });
    }
  });

  setMenuState(false);
</script>

<style>
  .gs-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    min-height: 44px;
    padding: 0.72rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    background: transparent;
    color: var(--gs-text-dim);
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .gs-nav-toggle:hover,
  .gs-nav-toggle:focus-visible {
    border-color: rgba(220, 120, 60, 0.6);
    background: rgba(220, 120, 60, 0.08);
    color: var(--gs-text);
  }

  .gs-nav-toggle__bar {
    position: absolute;
    width: 20px;
    height: 1px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 180ms ease, opacity 140ms ease;
  }

  .gs-nav-toggle__bar:nth-of-type(2) { transform: translateY(-6px); }
  .gs-nav-toggle__bar:nth-of-type(3) { transform: translateY(0); }
  .gs-nav-toggle__bar:nth-of-type(4) { transform: translateY(6px); }

  .gs-nav-toggle[aria-expanded='true'] .gs-nav-toggle__bar:nth-of-type(2) {
    transform: rotate(45deg);
  }

  .gs-nav-toggle[aria-expanded='true'] .gs-nav-toggle__bar:nth-of-type(3) {
    opacity: 0;
  }

  .gs-nav-toggle[aria-expanded='true'] .gs-nav-toggle__bar:nth-of-type(4) {
    transform: rotate(-45deg);
  }

  @media (max-width: 639px) {
    .gs-nav-toggle { display: flex; }
  }

  @media (min-width: 1024px) {
    .gs-nav-toggle { display: none; }
  }
</style>
