---
const {
  currentPath = '',
  logoSrc = '/logo.svg'
} = Astro.props;
---

<footer class="gs-footer">
  <div class="gs-section gs-section--padded">
    <div class="gs-grid columns-2">
      <div>
        <div class="gs-logo" style="gap: var(--gs-space-2);">
          <img src={logoSrc} alt="GoldShore logo" width="24" height="32" loading="lazy" decoding="async" />
        </div>
        <p>Applied intelligence, resilient infrastructure, and responsive operations.</p>
      </div>
      <div class="gs-grid columns-4" style="gap: var(--gs-space-2);">
        <div class="gs-nav gs-nav--vertical">
          <strong>Company</strong>
          <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a>
          <button
            type="button"
            id="footer-contact-trigger"
            class="gs-footer-contact-btn"
          >Contact</button>
        </div>
        <div class="gs-nav gs-nav--vertical">
          <strong>Product</strong>
          <a href="/services" aria-current={currentPath === '/services' ? 'page' : undefined}>Services</a>
          <a href="/services#sel">SEL Signal Feed</a>
          <a href="/developer" aria-current={currentPath === '/developer' ? 'page' : undefined}>Developer Hub</a>
          <a href="/developer/api" aria-current={currentPath === '/developer/api' ? 'page' : undefined}>API Docs</a>
          <a href="https://gw.goldshore.ai/status" target="_blank" rel="noopener noreferrer">Status</a>
        </div>
        <div class="gs-nav gs-nav--vertical">
          <strong>Platform</strong>
          <a href="https://admin.goldshore.ai" target="_blank" rel="noopener noreferrer">Admin Login</a>
          <a href="/intake">Sign up</a>
          <a href="https://trading.goldshore.ai" target="_blank" rel="noopener noreferrer">Trading</a>
        </div>
        <div class="gs-nav gs-nav--vertical">
          <strong>Legal</strong>
          <a href="/legal/privacy" aria-current={currentPath === '/legal/privacy' ? 'page' : undefined}>Privacy</a>
          <a href="/legal/terms" aria-current={currentPath === '/legal/terms' ? 'page' : undefined}>Terms</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('footer-contact-trigger')?.addEventListener('click', () => {
    const modal = document.getElementById('contact-modal');
    const openBtn = document.getElementById('contact-modal-trigger');
    if (modal) {
      modal.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      modal.querySelector('input, textarea')?.focus();
    } else if (openBtn) {
      openBtn.click();
    }
  });
</script>

<style>
  .gs-footer-contact-btn {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0;
    text-align: left;
    font: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 140ms;
  }
  .gs-footer-contact-btn:hover {
    text-decoration-color: currentColor;
  }
</style>
