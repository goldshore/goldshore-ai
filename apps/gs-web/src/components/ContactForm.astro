---
const { heading = 'Contact operations', compact = false } = Astro.props;
const turnstileSiteKey = Astro.locals.TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<form data-contact-form class:list={['contact-form', compact && 'contact-form--compact']} action="/api/contact" method="post">
  <input type="hidden" name="formType" value="contact" />
  <input type="hidden" name="redirectTo" value="/thank-you" />
  <input type="hidden" name="formStartedAt" value="" />
  <input type="hidden" name="cf-turnstile-response" value="" />

  <div class="contact-form__header">
    <p class="gs-eyebrow">Direct channel</p>
    <h2>{heading}</h2>
    <p>Share your brief. GoldShore responds with scope, next steps, and operating cadence.</p>
  </div>

  <div class="contact-form__honeypot" aria-hidden="true">
    <label>
      <span>Company website</span>
      <input name="companyWebsite" type="text" autocomplete="off" tabindex="-1" />
    </label>
  </div>

  <div class="contact-form__grid">
    <label>
      <span>Name</span>
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label>
      <span>Work email</span>
      <input name="email" type="email" autocomplete="email" spellcheck="false" required />
    </label>
    <label>
      <span>Inquiry type</span>
      <select name="inquiry">
        <option value="general">General inquiry</option>
        <option value="strategy-call">Strategy call</option>
        <option value="project-scope">Project scoping</option>
        <option value="support">Support</option>
      </select>
    </label>
    <label>
      <span>Timeline</span>
      <input name="timeline" type="text" placeholder="2-6 weeks" />
    </label>
    <label class="contact-form__message">
      <span>Project brief</span>
      <textarea
        name="message"
        rows="6"
        placeholder="Outline the system, risk, or AI workflow you need to operationalize."
        required
      ></textarea>
    </label>
  </div>

  {turnstileSiteKey && (
    <div class="contact-form__turnstile" data-contact-form-turnstile>
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
    </div>
  )}

  <div class="contact-form__footer">
    <div data-contact-form-status class="contact-form__status" aria-live="polite" role="status"></div>
    <button type="submit" class="contact-form__submit">
      <span data-contact-form-submit-text>Send brief</span>
    </button>
  </div>

  <div class="contact-form__success" aria-hidden="true" data-contact-form-success>
    <div class="contact-form__success-inner">
      <div class="contact-form__success-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2"/>
          <path d="M14 24l8 8 12-14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3>Brief received</h3>
      <p>We'll follow up within one business day with scope, next steps, and operating cadence.</p>
      <button type="button" class="contact-form__reset" data-contact-form-reset>Send another brief</button>
    </div>
  </div>
</form>

<script is:inline define:vars={{turnstileSiteKey}}>
  const contactFormGlobal = window;

  // Load Turnstile script if site key is configured
  if (turnstileSiteKey && !window.turnstile) {
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  }

  const initContactForm = (form) => {
    if (form.dataset.contactFormBound === 'true') return;
    form.dataset.contactFormBound = 'true';

    const status = form.querySelector('[data-contact-form-status]');
    const button = form.querySelector('button[type="submit"]');
    const submitText = form.querySelector('[data-contact-form-submit-text]');
    const successPanel = form.querySelector('[data-contact-form-success]');
    const resetBtn = form.querySelector('[data-contact-form-reset]');
    if (!(button instanceof HTMLButtonElement)) return;

    const setStatus = (message, type) => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.className = 'contact-form__status';
      if (type) status.classList.add(`contact-form__status--${type}`);
    };

    const showSuccess = () => {
      if (successPanel instanceof HTMLElement) {
        successPanel.removeAttribute('aria-hidden');
        successPanel.setAttribute('aria-live', 'polite');
      }
    };

    const resetForm = () => {
      if (successPanel instanceof HTMLElement) {
        successPanel.setAttribute('aria-hidden', 'true');
        successPanel.removeAttribute('aria-live');
      }
      form.reset();
      button.disabled = false;
      button.removeAttribute('aria-busy');
      if (submitText instanceof HTMLElement) submitText.textContent = 'Send brief';
      setStatus('', null);
      const startedAtField = form.querySelector('[name="formStartedAt"]');
      if (startedAtField instanceof HTMLInputElement) {
        startedAtField.value = String(Date.now());
      }
    };

    resetBtn?.addEventListener('click', resetForm);

    const startedAtField = form.querySelector('[name="formStartedAt"]');
    if (startedAtField instanceof HTMLInputElement) {
      startedAtField.value = String(Date.now());
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        setStatus('Please complete the required fields before sending.', 'error');
        return;
      }

      // Verify Turnstile if enabled
      if (turnstileSiteKey && window.turnstile) {
        const turnstileToken = window.turnstile.getResponse();
        if (!turnstileToken) {
          setStatus('Please complete the Turnstile verification.', 'error');
          return;
        }
        const tokenInput = form.querySelector('[name="cf-turnstile-response"]');
        if (tokenInput instanceof HTMLInputElement) {
          tokenInput.value = turnstileToken;
        }
      }

      const originalText = submitText instanceof HTMLElement ? submitText.textContent ?? 'Send brief' : 'Send brief';
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      if (submitText instanceof HTMLElement) submitText.textContent = 'Sending…';
      setStatus('Sending your brief…', 'progress');

      try {
        const response = await fetch(form.getAttribute('action') || '/api/contact', {
          method: form.getAttribute('method') || 'POST',
          headers: { 'x-gs-request-mode': 'spa' },
          body: new FormData(form),
        });

        if (!response.ok) {
          throw new Error(`Submission failed: ${response.status}`);
        }

        const data = await response.json();
        if (!data.ok) {
          throw new Error(data.error?.message || 'Submission failed');
        }

        setStatus('', null);
        showSuccess();

        // Reset Turnstile if enabled
        if (turnstileSiteKey && window.turnstile) {
          window.turnstile.reset();
        }
      } catch (error) {
        console.error(error);
        button.disabled = false;
        button.removeAttribute('aria-busy');
        if (submitText instanceof HTMLElement) submitText.textContent = originalText;
        setStatus('Unable to send right now. Please email hello@goldshore.ai.', 'error');

        // Reset Turnstile on error
        if (turnstileSiteKey && window.turnstile) {
          window.turnstile.reset();
        }
      }
    });
  };

  const bindContactForms = () => {
    document.querySelectorAll('[data-contact-form]').forEach((node) => {
      if (node instanceof HTMLFormElement) {
        initContactForm(node);
      }
    });
  };

  if (!contactFormGlobal.__gsContactFormsBound) {
    contactFormGlobal.__gsContactFormsBound = true;
    document.addEventListener('astro:page-load', bindContactForms);
  }

  bindContactForms();
</script>

<style>
  .contact-form {
    position: relative;
    display: grid;
    gap: 1.4rem;
    padding: clamp(1.4rem, 2vw, 2rem);
    border-radius: 2px;
    background: rgba(18, 18, 26, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: none;
    backdrop-filter: blur(18px);
  }

  .contact-form--compact {
    gap: 1rem;
  }

  .contact-form__header h2 {
    margin: 0.35rem 0 0.75rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .contact-form__header p {
    margin: 0;
    color: var(--gs-text-dim);
    line-height: 1.7;
  }

  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-form label {
    display: grid;
    gap: 0.45rem;
  }

  .contact-form label span {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gs-text-dim);
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--gs-text);
    padding: 0.95rem 1rem;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: rgba(211, 116, 62, 0.52);
    box-shadow: none;
    background: rgba(255, 255, 255, 0.06);
  }

  .contact-form textarea {
    min-height: 168px;
    resize: vertical;
  }

  .contact-form__message {
    grid-column: 1 / -1;
  }

  .contact-form__turnstile {
    display: flex;
    justify-content: center;
    margin: 0.5rem 0;
  }

  .contact-form__footer {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
  }

  .contact-form__status {
    min-height: 1.2rem;
    color: var(--gs-text-dim);
    font-size: 0.94rem;
  }

  .contact-form__status--progress {
    color: #bcd4ff;
  }

  .contact-form__status--error {
    color: #ffb4b4;
  }

  .contact-form__submit {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 2px;
    background: transparent;
    color: var(--gs-text);
    padding: 0.9rem 1.35rem;
    min-width: 140px;
    cursor: pointer;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .contact-form__submit:hover,
  .contact-form__submit:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(211, 116, 62, 0.52);
    background: rgba(211, 116, 62, 0.08);
  }

  .contact-form__submit[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* ── Success overlay ── */
  .contact-form__success {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    background: rgba(18, 18, 26, 0.98);
    backdrop-filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 280ms ease;
    z-index: 2;
  }

  .contact-form__success:not([aria-hidden='true']) {
    opacity: 1;
    pointer-events: auto;
  }

  .contact-form__success-inner {
    display: grid;
    gap: 1rem;
    text-align: center;
    padding: 2rem;
    max-width: 28rem;
  }

  .contact-form__success-icon {
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto;
    color: #47e3a7;
  }

  .contact-form__success:not([aria-hidden='true']) .contact-form__success-icon {
    animation: successIconPop 420ms 80ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .contact-form__success-icon svg {
    width: 100%;
    height: 100%;
  }

  .contact-form__success h3 {
    margin: 0;
    font-size: 1.5rem;
    color: #fff;
  }

  .contact-form__success p {
    margin: 0;
    color: var(--gs-text-dim);
    line-height: 1.7;
  }

  .contact-form__reset {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    margin: 0.5rem auto 0;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: transparent;
    color: var(--gs-text-dim);
    cursor: pointer;
    font-size: 0.9rem;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .contact-form__reset:hover,
  .contact-form__reset:focus-visible {
    color: var(--gs-text);
    border-color: rgba(255, 255, 255, 0.26);
  }

  @keyframes successIconPop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 720px) {
    .contact-form__grid {
      grid-template-columns: 1fr;
    }

    .contact-form__footer {
      flex-direction: column;
      align-items: stretch;
    }

    .contact-form__submit {
      width: 100%;
    }
  }
</style>
