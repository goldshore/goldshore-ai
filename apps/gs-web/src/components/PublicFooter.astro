---
import { platformLinks, serviceLinks, companyLinks, adminLinks } from '../config/navigation';

const footerColumns = [
  { title: 'Platform', links: platformLinks },
  { title: 'Services', links: serviceLinks },
  { title: 'Company', links: companyLinks },
  { title: 'Admin', links: adminLinks },
];
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <img src="/assets/penrose-logo.png" alt="GS Labs" class="footer-brand-logo" />
      <div><h2>GOLDSHORE</h2><p>Applied Intelligence · Digital Systems · Consulting</p></div>
    </div>
    <div class="footer-columns">
      {footerColumns.map((column) => (
        <div class="footer-column">
          <h3>{column.title}</h3>
          {column.links.map((link) => <p><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a></p>)}
        </div>
      ))}
    </div>
    <div class="footer-meta-block"><div>40°42′45″N</div><div>74°00′21″W</div></div>
  </div>
  <div class="footer-credits">
    <small>© 2026 Gold Shore Labs. All rights reserved. goldshore.ai · <a href="/legal/privacy">Privacy</a> · <a href="/legal/">Security</a> · <a href="/legal/terms">Terms</a></small>
  </div>
</footer>
