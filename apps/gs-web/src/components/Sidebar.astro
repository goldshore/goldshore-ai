---
import { getPublicSiteOrigin } from '../utils/public-site';

type NavLink = { href: string; label: string; permission?: string };
type NavGroup = { label: string; links: NavLink[]; permission?: string };

const groups: NavGroup[] = [
  { label: 'Governance', links: [
    { href: '/admin/merge-cockpit', label: 'PR Merge Cockpit' },
    { href: '/admin/repo-health', label: 'Repo Health' },
    { href: '/admin/governance', label: 'Governance' },
    { href: '/admin/projects', label: 'Projects' },
    { href: '/admin/mcp-access', label: 'MCP Access' },
  ]},
  { label: 'Operations', links: [
    { href: '/admin/platform', label: 'Control Plane' },
    { href: '/admin/analytics', label: 'Analytics' },
    { href: '/content', label: 'Content Studio' },
    { href: '/admin/integrations/all', label: 'Integrations' },
    { href: '/admin/ads', label: 'Ad Integrator' },
    { href: '/admin/lead-submissions', label: 'Lead Submissions' },
    { href: '/sites', label: 'Sites' },
    { href: '/admin/workflows', label: 'API Workflows' },
    { href: '/admin/customer-email', label: 'Customer Email' },
    { href: '/admin/subscribers', label: 'Email Audiences' },
    { href: '/admin/mailboxes', label: 'Mailboxes' },
    { href: '/admin/sql-sync', label: 'SQL Sync' },
    { href: '/admin/subscribe', label: 'Subscribe CTA' },
    { href: '/admin/contact-forms', label: 'Contact Forms' },
    { href: '/admin/pages', label: 'Custom Pages' },
  ]},
  { label: 'Workers', permission: 'cloudflare_inventory:read', links: [
    { href: '/admin/workers', label: 'Workers' },
  ]},
  { label: 'System', links: [
    { href: '/admin/system', label: 'System & Infra', permission: 'cloudflare_inventory:read' },
    { href: '/admin/users', label: 'Users', permission: 'users:read' },
  ]},
];

const { logo, permissions = [] } = Astro.props;
const PUBLIC_SITE_ORIGIN = getPublicSiteOrigin(Astro.url.hostname);
const can = (permission?: string) => !permission || permissions.includes(permission);
const normalize = (path: string) => path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
const isActive = (href: string) => {
  const current = normalize(Astro.url.pathname);
  const target = normalize(href);
  return current === target || current.startsWith(`${target}/`);
};
const visibleGroups = groups
  .filter((group) => can(group.permission))
  .map((group) => ({ ...group, links: group.links.filter((link) => can(link.permission)) }))
  .filter((group) => group.links.length > 0);
---

<aside class="gs-admin-sidebar" id="admin-sidebar" aria-label="Admin navigation">
  <div class="gs-sidebar-brand">
    <a href={PUBLIC_SITE_ORIGIN} class="gs-sidebar-logo" aria-label="GoldShore public site">
      <img src={logo?.src || logo || '/assets/penrose-logo.png'} alt="" />
      <span>GOLDSHORE</span>
    </a>
    <button id="sidebar-close" class="sidebar-close" type="button" aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </div>

  <div class="gs-sidebar-status"><i></i><span>System status</span><strong>Operational</strong></div>

  <nav class="gs-sidebar-links">
    <a class={`gs-nav-block gs-nav-dashboard ${isActive('/app/dashboard') ? 'active' : ''}`} href="/app/dashboard" aria-current={isActive('/app/dashboard') ? 'page' : undefined}>
      <span class="gs-nav-icon" aria-hidden="true">⌂</span><span>Dashboard</span>
    </a>
    {visibleGroups.map((group) => (
      <details class="gs-nav-group" open>
        <summary><span>{group.label}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
        <div class="gs-nav-group-items">
          {group.links.map((link) => (
            <a class={`gs-nav-block gs-nav-block--sub ${isActive(link.href) ? 'active' : ''}`} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              <span>{link.label}</span><span class="gs-nav-arrow" aria-hidden="true">›</span>
            </a>
          ))}
        </div>
      </details>
    ))}
    <div class="gs-nav-standalone">
      {can('api_configuration:read') && <a class={`gs-nav-block ${isActive('/trading') ? 'active' : ''}`} href="/trading" aria-current={isActive('/trading') ? 'page' : undefined}>Trading</a>}
      <a class={`gs-nav-block ${isActive('/app/settings') ? 'active' : ''}`} href="/app/settings" aria-current={isActive('/app/settings') ? 'page' : undefined}>Settings</a>
    </div>
  </nav>

  <div class="gs-sidebar-footer">
    <a href={PUBLIC_SITE_ORIGIN} class="gs-nav-block gs-public-site-btn" rel="noopener">Public site <span aria-hidden="true">↗</span></a>
    <a href="/logout" class="gs-nav-block gs-logout-btn">Logout</a>
  </div>
</aside>

<style>
  .gs-admin-sidebar { box-sizing:border-box; flex:0 0 252px; width:252px; height:100dvh; position:sticky; top:0; z-index:40; display:flex; flex-direction:column; overflow:hidden; border-right:1px solid rgba(255,255,255,.1); background:rgba(8,11,15,.96); backdrop-filter:blur(16px); }
  .gs-sidebar-brand { min-height:64px; display:flex; align-items:center; justify-content:space-between; padding:0 16px; border-bottom:1px solid rgba(255,255,255,.08); }
  .gs-sidebar-logo { display:flex; align-items:center; gap:10px; color:#f4f6f8; font:700 .8rem/1 var(--admin-ui); letter-spacing:.11em; text-decoration:none; }
  .gs-sidebar-logo img { width:28px; height:28px; border-radius:6px; object-fit:cover; }
  .sidebar-close { display:none; width:32px; height:32px; align-items:center; justify-content:center; border:1px solid rgba(255,255,255,.12); border-radius:6px; background:transparent; color:#aeb6be; }
  .sidebar-close svg { width:15px; fill:none; stroke:currentColor; stroke-width:1.5; }
  .gs-sidebar-status { display:grid; grid-template-columns:8px 1fr auto; align-items:center; gap:8px; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,.08); font:600 .62rem/1.2 var(--admin-ui); text-transform:uppercase; letter-spacing:.06em; }
  .gs-sidebar-status i { width:7px; height:7px; border-radius:50%; background:var(--gs-status-success,#22c55e); box-shadow:0 0 11px var(--gs-status-success,#22c55e); }
  .gs-sidebar-status span { color:#69737d; }
  .gs-sidebar-status strong { color:#b9c1c8; font-weight:600; }
  .gs-sidebar-links { flex:1; min-height:0; overflow-y:auto; padding:10px 8px 16px; scrollbar-width:thin; scrollbar-color:#303840 transparent; }
  .gs-nav-block { display:flex; align-items:center; justify-content:space-between; min-height:34px; box-sizing:border-box; padding:7px 10px; border:1px solid transparent; border-radius:6px; color:#9ca5ae; font:500 .75rem/1.25 var(--admin-ui); text-decoration:none; transition:color 140ms ease,background 140ms ease,border-color 140ms ease; }
  .gs-nav-block:hover { color:#fff; background:rgba(255,255,255,.045); border-color:rgba(255,255,255,.06); }
  .gs-nav-block.active { color:#0d1117; background:#f4f4ef; border-color:#fff; box-shadow:0 5px 18px rgba(0,0,0,.2); }
  .gs-nav-dashboard { min-height:38px; margin-bottom:8px; border-color:rgba(255,255,255,.08); }
  .gs-nav-icon { color:currentColor; margin-right:9px; }
  .gs-nav-dashboard > span:nth-child(2) { margin-right:auto; }
  .gs-nav-group { margin:2px 0 5px; }
  .gs-nav-group summary { display:flex; align-items:center; justify-content:space-between; padding:8px 10px 4px; cursor:pointer; list-style:none; color:#6f7881; font:700 .58rem/1 var(--admin-ui); letter-spacing:.12em; text-transform:uppercase; }
  .gs-nav-group summary::-webkit-details-marker { display:none; }
  .gs-nav-group summary svg { width:12px; fill:none; stroke:currentColor; stroke-width:1.4; transition:transform 140ms ease; }
  .gs-nav-group:not([open]) summary svg { transform:rotate(-90deg); }
  .gs-nav-block--sub { padding-left:12px; }
  .gs-nav-arrow { opacity:0; color:currentColor; font-size:.95rem; transition:opacity 140ms ease; }
  .gs-nav-block:hover .gs-nav-arrow,.gs-nav-block.active .gs-nav-arrow { opacity:1; }
  .gs-nav-standalone { margin-top:8px; padding-top:8px; border-top:1px solid rgba(255,255,255,.08); }
  .gs-sidebar-footer { padding:10px 8px 14px; border-top:1px solid rgba(255,255,255,.08); }
  .gs-public-site-btn { color:#c1c7cc; }
  .gs-logout-btn:hover { color:#ffb1ad; background:rgba(239,68,68,.08); }
  /* Matches AdminLayout: (pointer: coarse) so touch devices get the drawer
     whatever width they report — a tablet in landscape is well over 900px. */
  @media (max-width:900px), (pointer:coarse) {
    .gs-admin-sidebar { position:fixed; left:0; transform:translateX(-102%); transition:transform 180ms ease; box-shadow:22px 0 70px rgba(0,0,0,.55); overscroll-behavior:contain; }
    :global(body.gs-sidebar-open) .gs-admin-sidebar { transform:translateX(0); }
    .sidebar-close { display:inline-flex; }
  }

  /* 44px is the WCAG 2.5.5 / iOS HIG floor. These rows were laid out for a
     mouse: 34px tall with 7px of padding, and a 32px close button. */
  @media (pointer:coarse) {
    .gs-nav-block { min-height:44px; padding:11px 12px; }
    .gs-nav-group summary { min-height:44px; padding:12px 10px 8px; }
    .sidebar-close { width:44px; height:44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gs-admin-sidebar { transition:none; }
  }
</style>
