---
import { getPublicSiteOrigin } from '../utils/public-site';

type NavLink = { href: string; label: string; permission?: string };
type NavGroup = { label: string; links: NavLink[]; permission?: string };

const groups: NavGroup[] = [
  {
    label: 'Governance',
    links: [
      { href: '/admin/merge-cockpit', label: 'PR Merge Cockpit' },
      { href: '/admin/repo-health', label: 'Repo Health' },
      { href: '/admin/governance', label: 'Governance' },
      { href: '/admin/projects', label: 'Projects' },
      { href: '/admin/mcp-access', label: 'MCP Access' },
    ],
  },
  {
    label: 'Operations',
    links: [
      { href: '/admin/platform', label: 'Control Plane' },
      { href: '/content', label: 'Content Studio' },
      { href: '/admin/integrations/all', label: 'Integrations' },
      { href: '/admin/lead-submissions', label: 'Lead Submissions' },
      { href: '/sites', label: 'Sites' },
      { href: '/admin/workflows', label: 'API Workflows' },
      { href: '/admin/customer-email', label: 'Customer Email' },
      { href: '/admin/subscribe', label: 'Subscribe CTA' },
      { href: '/admin/contact-forms', label: 'Contact Forms' },
      { href: '/admin/pages', label: 'Custom Pages' },
    ],
  },
  {
    label: 'Workers',
    permission: 'cloudflare_inventory:read',
    links: [
      { href: '/admin/workers/status', label: 'Status' },
      { href: '/admin/workers/bindings', label: 'Bindings' },
      { href: '/admin/workers/routes', label: 'Routes' },
      { href: '/admin/workers/tunnels', label: 'Tunnels' },
    ],
  },
  {
    label: 'System',
    links: [
      { href: '/admin/system/dns', label: 'DNS', permission: 'cloudflare_inventory:read' },
      { href: '/admin/system/secrets', label: 'Secrets', permission: 'secret_metadata:read' },
      { href: '/admin/system/storage', label: 'Storage', permission: 'cloudflare_inventory:read' },
      { href: '/admin/system/pages', label: 'Pages', permission: 'cloudflare_inventory:read' },
      { href: '/admin/users', label: 'Users', permission: 'users:read' },
    ],
  },
];

const { logo, permissions = [] } = Astro.props;
const PUBLIC_SITE_ORIGIN = getPublicSiteOrigin(Astro.url.hostname);
const can = (permission?: string) => !permission || permissions.includes(permission);
const normalize = (path: string) => path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
const isActive = (href: string) => {
  const current = normalize(Astro.url.pathname);
  const target = normalize(href);
  return current === target || current.startsWith(`${target}/`);
};
const visibleGroups = groups
  .filter((group) => can(group.permission))
  .map((group) => ({ ...group, links: group.links.filter((link) => can(link.permission)) }))
  .filter((group) => group.links.length > 0);
---

<aside class="gs-admin-sidebar" id="admin-sidebar" aria-label="Admin navigation">
  <div class="gs-sidebar-brand">
    <a href={PUBLIC_SITE_ORIGIN} class="gs-sidebar-logo" aria-label="GoldShore public site">
      <img src={logo?.src || logo || '/assets/penrose-logo.png'} alt="" />
      <span>GOLDSHORE</span>
    </a>
    <button id="sidebar-close" class="sidebar-close" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </div>

  <div class="gs-sidebar-status"><i></i><span>System status</span><strong>Operational</strong></div>

  <nav class="gs-sidebar-links">
    <a class={`gs-nav-block gs-nav-dashboard ${isActive('/app/dashboard') ? 'active' : ''}`} href="/app/dashboard" aria-current={isActive('/app/dashboard') ? 'page' : undefined}>
      <span class="gs-nav-icon" aria-hidden="true">⌂</span><span>Dashboard</span>
    </a>

    {visibleGroups.map((group) => (
      <details class="gs-nav-group" open>
        <summary><span>{group.label}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
        <div class="gs-nav-group-items">
          {group.links.map((link) => (
            <a class={`gs-nav-block gs-nav-block--sub ${isActive(link.href) ? 'active' : ''}`} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              <span>{link.label}</span><span class="gs-nav-arrow" aria-hidden="true">›</span>
            </a>
          ))}
        </div>
      </details>
    ))}

    <div class="gs-nav-standalone">
      {can('api_configuration:read') && <a class={`gs-nav-block ${isActive('/trading') ? 'active' : ''}`} href="/trading" aria-current={isActive('/trading') ? 'page' : undefined}>Trading</a>}
      <a class={`gs-nav-block ${isActive('/app/settings') ? 'active' : ''}`} href="/app/settings" aria-current={isActive('/app/settings') ? 'page' : undefined}>Settings</a>
    </div>
  </nav>

  <div class="gs-sidebar-footer">
    <a href={PUBLIC_SITE_ORIGIN} class="gs-nav-block gs-public-site-btn" rel="noopener">Public site <span aria-hidden="true">↗</span></a>
    <a href="/logout" class="gs-nav-block gs-logout-btn">Logout</a>
  </div>
</aside>

<style>
  .gs-admin-sidebar { box-sizing: border-box; flex: 0 0 272px; width: 272px; height: 100dvh; position: sticky; top: 0; z-index: 40; display: flex; flex-direction: column; overflow: hidden; border-right: 1px solid var(--admin-line); background: #07111b; }
  .gs-sidebar-brand { min-height: 76px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid var(--admin-line); }
  .gs-sidebar-logo { display: flex; align-items: center; gap: 11px; color: var(--admin-text); font: 700 .86rem/1 var(--admin-ui); letter-spacing: .14em; text-decoration: none; }
  .gs-sidebar-logo img { width: 30px; height: 30px; border-radius: 7px; object-fit: cover; }
  .sidebar-close { display: none; width: 34px; height: 34px; align-items: center; justify-content: center; border: 1px solid var(--admin-line); background: transparent; color: var(--admin-muted); }
  .sidebar-close svg { width: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .gs-sidebar-status { display: grid; grid-template-columns: 8px 1fr auto; align-items: center; gap: 8px; padding: 15px 20px; border-bottom: 1px solid var(--admin-line); font: 500 .66rem/1.2 var(--admin-mono); text-transform: uppercase; letter-spacing: .06em; }
  .gs-sidebar-status i { width: 7px; height: 7px; border-radius: 50%; background: var(--admin-success); }
  .gs-sidebar-status span { color: var(--admin-faint); }
  .gs-sidebar-status strong { color: #a9d9b6; font-weight: 600; }
  .gs-sidebar-links { flex: 1; min-height: 0; overflow-y: auto; padding: 12px 10px 18px; scrollbar-width: thin; scrollbar-color: #283745 transparent; }
  .gs-nav-block { display: flex; align-items: center; justify-content: space-between; min-height: 34px; box-sizing: border-box; padding: 7px 10px; border-left: 2px solid transparent; color: var(--admin-muted); font: 500 .76rem/1.25 var(--admin-ui); text-decoration: none; transition: color 140ms ease, background 140ms ease, border-color 140ms ease; }
  .gs-nav-block:hover { color: var(--admin-text); background: rgba(255,255,255,.035); }
  .gs-nav-block.active { border-left-color: var(--admin-accent); color: #fff; background: rgba(224,139,72,.09); }
  .gs-nav-dashboard { min-height: 40px; margin-bottom: 10px; border: 1px solid var(--admin-line); border-left-width: 2px; }
  .gs-nav-icon { color: var(--admin-accent); margin-right: 10px; }
  .gs-nav-dashboard > span:nth-child(2) { margin-right: auto; }
  .gs-nav-group { margin: 2px 0 6px; }
  .gs-nav-group summary { display: flex; align-items: center; justify-content: space-between; padding: 9px 10px 5px; cursor: pointer; list-style: none; color: var(--admin-accent); font: 700 .61rem/1 var(--admin-mono); letter-spacing: .12em; text-transform: uppercase; }
  .gs-nav-group summary::-webkit-details-marker { display: none; }
  .gs-nav-group summary svg { width: 13px; fill: none; stroke: currentColor; stroke-width: 1.4; transition: transform 140ms ease; }
  .gs-nav-group:not([open]) summary svg { transform: rotate(-90deg); }
  .gs-nav-block--sub { padding-left: 15px; }
  .gs-nav-arrow { opacity: 0; color: var(--admin-accent); font-size: 1rem; transition: opacity 140ms ease; }
  .gs-nav-block:hover .gs-nav-arrow, .gs-nav-block.active .gs-nav-arrow { opacity: 1; }
  .gs-nav-standalone { margin-top: 8px; padding-top: 9px; border-top: 1px solid var(--admin-line); }
  .gs-sidebar-footer { padding: 12px 10px 16px; border-top: 1px solid var(--admin-line); }
  .gs-public-site-btn { color: #b7c4ce; }
  .gs-public-site-btn span { color: var(--admin-accent); }
  .gs-logout-btn:hover { color: #ff9a91; background: rgba(220,80,70,.08); }
  @media (max-width: 900px) {
    .gs-admin-sidebar { position: fixed; left: 0; transform: translateX(-102%); transition: transform 180ms ease; box-shadow: 22px 0 70px rgba(0,0,0,.55); }
    :global(body.gs-sidebar-open) .gs-admin-sidebar { transform: translateX(0); }
    .sidebar-close { display: inline-flex; }
  }
</style>
