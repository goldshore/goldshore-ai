---
import {
  CANONICAL_ADMIN_DASHBOARD_URL,
  CANONICAL_ADMIN_ORIGIN,
  CLOUDFLARE_ACCESS_LOGOUT_PATH,
} from '../utils/admin-access';
import { publicMenuGroups } from '../config/navigation';
import { getPublicSiteUrl } from '../utils/public-site';
import '../styles/global.css';

const adminLogoutUrl = `${CANONICAL_ADMIN_ORIGIN}${CLOUDFLARE_ACCESS_LOGOUT_PATH}`;
const turnstileSiteKey = Astro.locals.TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

const { currentPath = Astro.url.pathname } = Astro.props;
const normalizePath = (path: string) => {
  const normalized = path.startsWith('/') ? path : `/${path}`;
  return normalized === '/' ? '/' : `${normalized.replace(/\/+$/, '')}/`;
};
const activePath = normalizePath(currentPath);
const publicUrl = (href: string) => getPublicSiteUrl(Astro.url.hostname, href);
const isCurrent = (href: string) => {
  const normalizedHref = normalizePath(href);
  return normalizedHref === '/'
    ? activePath === '/'
    : activePath === normalizedHref || activePath.startsWith(normalizedHref);
};
---

<header class="topbar" data-menu-open="false" data-theme-header>
  <a class="brand brand-text" href={publicUrl('/')} aria-label="GoldShore home">
    <img src="/assets/penrose-logo.png" alt="" class="brand-logo" />
    <span class="brand-wordmark brand-text-label">GOLDSHORE</span>
  </a>
  <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle menu"><span></span><span></span><span></span></button>
  <nav id="main-nav" class="main-nav" aria-label="Primary navigation">
    <div class="main-nav__tiers">
      {publicMenuGroups.filter((group) => group.label !== 'Access').map((group) => (
        <details class="main-nav__tier" name="header-tier">
          <summary>{group.label}</summary>
          <div class="main-nav__submenu">
            {group.links.map((link) => <a href={publicUrl(link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
          </div>
        </details>
      ))}
    </div>
    <a
      href={CANONICAL_ADMIN_DASHBOARD_URL}
      class="nav-login"
      data-admin-access-link
      data-auth-modal-open="login"
      data-login-href={CANONICAL_ADMIN_DASHBOARD_URL}
      data-logout-href={adminLogoutUrl}
    >Log in</a>
    <button type="button" class="nav-cta" data-subscribe-open data-account-href={publicUrl('/app/settings/')}>Sign Up</button>
  </nav>
</header>

<dialog class="auth-modal" data-auth-modal="login" aria-labelledby="login-modal-title">
  <button class="auth-modal__close" type="button" data-auth-modal-close aria-label="Close login dialog">Close</button>
  <p class="gs-eyebrow">Protected access</p>
  <h2 id="login-modal-title">Log in to GoldShore</h2>
  <p>Choose the identity route that matches the service you need. Access permissions are still enforced after sign-in.</p>
  <div class="auth-modal__actions">
    <a class="auth-modal__primary" href={CANONICAL_ADMIN_DASHBOARD_URL}>Continue with Cloudflare Access</a>
    <a class="auth-modal__secondary" href="/login?type=github">Continue with GitHub</a>
  </div>
</dialog>

<dialog class="auth-modal subscribe-modal" data-subscribe-modal aria-labelledby="subscribe-modal-title" data-turnstile-site-key={turnstileSiteKey}>
  <button class="auth-modal__close" type="button" data-subscribe-close aria-label="Close subscribe dialog">Close</button>
  <div data-subscribe-step="email">
    <h2 id="subscribe-modal-title">Stay in the loop</h2>
    <p>Receive GoldShore analysis, product updates, and practical notes. Confirm your address before anything is sent.</p>
    <form class="subscribe-form" data-subscribe-form>
      <label>Name <span>Optional</span><input name="name" autocomplete="name" maxlength="120" /></label>
      <label>Email address<input name="email" type="email" autocomplete="email" required /></label>
      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>}
      <label class="subscribe-consent"><input name="consent" type="checkbox" required /> I agree to receive the selected GoldShore emails and can unsubscribe at any time.</label>
      <button class="auth-modal__primary" type="submit">Send verification code</button>
    </form>
  </div>
  <div data-subscribe-step="code" hidden>
    <h2>Check your email</h2>
    <p>Open the activation link or enter the six-digit code sent to <strong data-subscribe-email></strong>.</p>
    <form class="subscribe-form" data-code-form>
      <label>Verification code<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></label>
      <button class="auth-modal__primary" type="submit">Verify subscription</button>
    </form>
    <button class="auth-modal__text" type="button" data-subscribe-back>Use another email</button>
  </div>
  <p class="subscribe-status" data-subscribe-status role="status" aria-live="polite"></p>
</dialog>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import '../scripts/theme-navigation';
  import { useAuthToken } from '../utils/auth';

  // Reflects the existing staff Cloudflare Access session in the header CTA.
  // This is a cosmetic label only — the admin/app routes remain the actual
  // authorization boundary (enforced server-side in middleware.ts) regardless
  // of what this link displays or is clicked while unauthenticated.
  const loginLink = document.querySelector<HTMLElement>('[data-admin-access-link]');
  if (loginLink) {
    try {
      const { isValid } = useAuthToken();
      if (isValid) {
        loginLink.textContent = 'Log out';
        loginLink.dataset.authenticated = 'true';
        loginLink.setAttribute('href', loginLink.dataset.logoutHref ?? '/');
      }
    } catch {
      // No CF-Authorization cookie readable client-side (e.g. cross-subdomain
      // cookie scoping) — leave the default "Log in" state in place.
    }
  }

  const modals = new Map(
    Array.from(document.querySelectorAll<HTMLDialogElement>('[data-auth-modal]'))
      .map((dialog) => [dialog.dataset.authModal ?? '', dialog]),
  );
  const openModal = (name: string) => {
    const modal = modals.get(name);
    if (modal && !modal.open) modal.showModal();
  };
  document.querySelectorAll<HTMLElement>('[data-auth-modal-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      if (trigger.dataset.authenticated === 'true') {
        return;
      }
      event.preventDefault();
      openModal(trigger.dataset.authModalOpen ?? 'login');
    });
  });
  document.querySelectorAll<HTMLElement>('[data-auth-modal-close]').forEach((trigger) => {
    trigger.addEventListener('click', () => trigger.closest<HTMLDialogElement>('dialog')?.close());
  });
  document.querySelectorAll<HTMLElement>('[data-auth-modal-switch]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      trigger.closest<HTMLDialogElement>('dialog')?.close();
      openModal(trigger.dataset.authModalSwitch ?? 'login');
    });
  });
  modals.forEach((modal) => modal.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  }));

  const subscribeModal = document.querySelector<HTMLDialogElement>('[data-subscribe-modal]');
  const subscribeButton = document.querySelector<HTMLButtonElement>('[data-subscribe-open]');
  const subscribeStatus = subscribeModal?.querySelector<HTMLElement>('[data-subscribe-status]');
  const emailStep = subscribeModal?.querySelector<HTMLElement>('[data-subscribe-step="email"]');
  const codeStep = subscribeModal?.querySelector<HTMLElement>('[data-subscribe-step="code"]');
  const emailForm = subscribeModal?.querySelector<HTMLFormElement>('[data-subscribe-form]');
  const codeForm = subscribeModal?.querySelector<HTMLFormElement>('[data-code-form]');
  let pendingEmail = '';

  if (subscribeButton && loginLink?.dataset.authenticated === 'true') {
    subscribeButton.textContent = 'Settings';
    subscribeButton.addEventListener('click', () => { location.href = subscribeButton.dataset.accountHref || '/app/settings/'; });
  } else {
    subscribeButton?.addEventListener('click', () => subscribeModal?.showModal());
  }
  subscribeModal?.querySelector('[data-subscribe-close]')?.addEventListener('click', () => subscribeModal.close());
  subscribeModal?.querySelector('[data-subscribe-back]')?.addEventListener('click', () => {
    if (emailStep) emailStep.hidden = false;
    if (codeStep) codeStep.hidden = true;
    if (subscribeStatus) subscribeStatus.textContent = '';
  });
  subscribeModal?.addEventListener('click', (event) => { if (event.target === subscribeModal) subscribeModal.close(); });

  emailForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = new FormData(emailForm);
    pendingEmail = String(form.get('email') || '').trim().toLowerCase();
    if (subscribeStatus) subscribeStatus.textContent = 'Sending your verification email…';
    const response = await fetch('/api/leads/subscribe', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ email: pendingEmail, name: String(form.get('name') || ''), source: 'header-subscribe', turnstileToken: String(form.get('cf-turnstile-response') || '') }),
    }).catch(() => null);
    const result = await response?.json().catch(() => ({}));
    if (!response?.ok) { if (subscribeStatus) subscribeStatus.textContent = result?.error || 'Unable to send the verification email.'; return; }
    subscribeModal?.querySelector<HTMLElement>('[data-subscribe-email]')?.replaceChildren(pendingEmail);
    if (emailStep) emailStep.hidden = true;
    if (codeStep) codeStep.hidden = false;
    if (subscribeStatus) subscribeStatus.textContent = 'The code expires in 15 minutes.';
  });

  codeForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const code = String(new FormData(codeForm).get('code') || '').trim();
    if (subscribeStatus) subscribeStatus.textContent = 'Verifying…';
    const response = await fetch('/api/leads/confirm', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: pendingEmail, code }) }).catch(() => null);
    const result = await response?.json().catch(() => ({}));
    if (!response?.ok) { if (subscribeStatus) subscribeStatus.textContent = result?.error || 'That code could not be verified.'; return; }
    location.href = result.settingsUrl || '/newsletter/settings/?subscribed=1';
  });
</script>

<style>
  .nav-login, .nav-cta { cursor: pointer; }
  .auth-modal { width: min(34rem, calc(100% - 2rem)); padding: clamp(1.5rem, 5vw, 2.5rem); border: 1px solid rgba(211,116,62,.42); border-radius: 0; background: #111019; color: #f5f1eb; box-shadow: 0 28px 90px rgba(0,0,0,.6); }
  .auth-modal::backdrop { background: rgba(3,3,7,.78); backdrop-filter: blur(8px); }
  .auth-modal h2 { margin: .65rem 0 1rem; font-size: clamp(2rem, 6vw, 3.5rem); line-height: .95; text-transform: uppercase; }
  .auth-modal p { color: var(--gs-text-dim); line-height: 1.7; }
  .auth-modal__close { position: absolute; top: 1rem; right: 1rem; border: 0; background: transparent; color: var(--gs-text-dim); cursor: pointer; text-transform: uppercase; font: 600 .62rem/1 'DM Mono', monospace; letter-spacing: .1em; }
  .auth-modal__actions { display: grid; gap: .75rem; margin-top: 1.5rem; }
  .auth-modal__actions a { display: flex; min-height: 3rem; align-items: center; justify-content: center; padding: .75rem 1rem; text-decoration: none; text-align: center; text-transform: uppercase; font: 600 .68rem/1.3 'DM Mono', monospace; letter-spacing: .08em; }
  .auth-modal__primary { background: #d3743e; color: #09080d; }
  .auth-modal__secondary { border: 1px solid rgba(211,116,62,.42); color: #f5f1eb; }
  .auth-modal__note { margin: 1.25rem 0 0; font-size: .9rem; }
  .auth-modal__note button { border: 0; padding: 0; background: transparent; color: #d3743e; cursor: pointer; font: inherit; }
  .subscribe-form { display:grid; gap:1rem; margin-top:1.5rem; }
  .subscribe-form label { display:grid; gap:.45rem; color:#f5f1eb; font:600 .66rem/1.4 'DM Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
  .subscribe-form label span { color:var(--gs-text-dim); font-weight:400; }
  .subscribe-form input:not([type="checkbox"]) { min-height:3rem; padding:.75rem; border:1px solid rgba(255,255,255,.16); border-radius:0; background:#09090e; color:#fff; }
  .subscribe-form button { min-height:3rem; border:0; cursor:pointer; font:700 .68rem/1.2 'DM Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
  .subscribe-consent { grid-template-columns:auto 1fr!important; align-items:start; color:var(--gs-text-dim)!important; font-family:'DM Sans',sans-serif!important; font-size:.82rem!important; font-weight:400!important; letter-spacing:0!important; text-transform:none!important; }
  .subscribe-consent input { margin-top:.2rem; accent-color:#d3743e; }
  .auth-modal__text { margin-top:1rem; padding:0; border:0; background:transparent; color:#d3743e; cursor:pointer; }
  .subscribe-status { min-height:1.5rem; margin:1rem 0 0!important; color:#d9a47f!important; }
</style>
