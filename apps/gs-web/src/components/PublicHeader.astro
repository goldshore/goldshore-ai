---
import { authLinks, primaryNavLinks } from '../config/navigation';

const { currentPath = Astro.url.pathname } = Astro.props;
const normalizePath = (path: string) => {
  const normalized = path.startsWith('/') ? path : `/${path}`;
  return normalized === '/' ? '/' : `${normalized.replace(/\/+$/, '')}/`;
};
const activePath = normalizePath(currentPath);
const isCurrent = (href: string) => {
  const normalizedHref = normalizePath(href);
  return normalizedHref === '/'
    ? activePath === '/'
    : activePath === normalizedHref || activePath.startsWith(normalizedHref);
};
---

<header class="topbar" data-menu-open="false" data-theme-header>
  <div class="topbar-inner">
    <a class="brand-text" href="/" aria-label="GoldShore home">
      <img src="/assets/penrose-logo.png" alt="GS Labs" class="brand-logo" />
      <span class="brand-text-label">GOLDSHORE</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Toggle menu"><span></span><span></span><span></span></button>
    <nav class="main-nav" aria-label="Primary navigation">
      {primaryNavLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
      {authLinks.map((link) => <a href={link.href} class="nav-login">{link.label} →</a>)}
      <a href="/contact/" class="nav-cta">Request Briefing</a>
    </nav>
  </div>
  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation">
    {primaryNavLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
    {authLinks.map((link) => <a href={link.href}>{link.label} →</a>)}
    <a href="/contact/">Request Briefing</a>
  </nav>
</header>
