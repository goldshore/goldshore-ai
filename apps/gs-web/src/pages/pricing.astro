---
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pricing - GoldShore</title>
  </head>
  <body class="gs-pricing-page">
    <PublicHeader />
    
    <main class="gs-pricing-content">
      <section class="gs-pricing-hero">
        <h1>Simple, Transparent Pricing</h1>
        <p>Choose the plan that fits your trading needs</p>
      </section>

      <section class="gs-pricing-plans">
        <div class="gs-plan">
          <h3>Starter</h3>
          <div class="gs-price">$99<span>/month</span></div>
          <ul class="gs-features">
            <li>Basic market data</li>
            <li>Manual trading</li>
            <li>Email support</li>
          </ul>
          <button class="gs-btn gs-btn-secondary">Choose Plan</button>
        </div>

        <div class="gs-plan gs-plan-featured">
          <div class="gs-badge">Popular</div>
          <h3>Professional</h3>
          <div class="gs-price">$299<span>/month</span></div>
          <ul class="gs-features">
            <li>Advanced analytics</li>
            <li>Automated trading</li>
            <li>Priority support</li>
            <li>API access</li>
          </ul>
          <button class="gs-btn gs-btn-primary">Choose Plan</button>
        </div>

        <div class="gs-plan">
          <h3>Enterprise</h3>
          <div class="gs-price">Custom</div>
          <ul class="gs-features">
            <li>Dedicated infrastructure</li>
            <li>Custom integrations</li>
            <li>24/7 support</li>
            <li>SLA guarantee</li>
          </ul>
          <button class="gs-btn gs-btn-secondary">Contact Sales</button>
        </div>
      </section>
    </main>

    <PublicFooter />

    <style>
      body.gs-pricing-page {
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #050b14 0%, #0f1622 100%);
        color: rgba(226, 232, 240, 0.92);
      }

      .gs-pricing-content {
        min-height: 100vh;
      }

      .gs-pricing-hero {
        padding: 80px 24px;
        text-align: center;
      }

      .gs-pricing-hero h1 {
        font-size: 44px;
        margin: 0 0 16px;
      }

      .gs-pricing-hero p {
        font-size: 20px;
        color: rgba(226, 232, 240, 0.7);
      }

      .gs-pricing-plans {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 32px;
        padding: 64px 24px;
        max-width: 1200px;
        margin: 0 auto;
      }

      .gs-plan {
        padding: 32px;
        border: 1px solid rgba(226, 232, 240, 0.1);
        border-radius: 12px;
        background: rgba(15, 22, 34, 0.5);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
      }

      .gs-plan:hover {
        border-color: rgba(59, 130, 246, 0.5);
        transform: translateY(-4px);
      }

      .gs-plan-featured {
        border-color: #3b82f6;
        transform: scale(1.05);
      }

      .gs-badge {
        display: inline-block;
        padding: 4px 12px;
        background: #3b82f6;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 16px;
      }

      .gs-price {
        font-size: 36px;
        font-weight: 700;
        margin: 16px 0;
      }

      .gs-price span {
        font-size: 16px;
        color: rgba(226, 232, 240, 0.6);
      }

      .gs-features {
        list-style: none;
        padding: 0;
        margin: 24px 0;
      }

      .gs-features li {
        padding: 12px 0;
        border-bottom: 1px solid rgba(226, 232, 240, 0.1);
      }

      .gs-btn {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .gs-btn-primary {
        background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
        color: white;
      }

      .gs-btn-secondary {
        background: transparent;
        border: 1px solid rgba(226, 232, 240, 0.2);
        color: rgba(226, 232, 240, 0.9);
      }
    </style>
  </body>
</html>
