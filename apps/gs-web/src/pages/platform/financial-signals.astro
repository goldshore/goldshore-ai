---
import WebLayout from '../../layouts/WebLayout.astro';

export const prerender = false;

const features = [
  {
    title: 'Volatility Sweeps',
    description: 'Continuously scan across configured bands to detect volatility spikes, compression zones, and regime transitions in real time.',
  },
  {
    title: 'Directional Bias Detection',
    description: 'Adaptive algorithms classify prevailing market direction with confidence scoring — updated continuously as conditions evolve.',
  },
  {
    title: 'Market Regime Classification',
    description: 'Identify trending, ranging, and transitional regimes to align model behavior and execution logic to current conditions.',
  },
  {
    title: 'Signal Aggregation',
    description: 'Merge multi-source financial data into unified signal surfaces with configurable weighting and staleness controls.',
  },
  {
    title: 'Latency-Aware Delivery',
    description: 'Signals are delivered with sub-30ms pipeline latency, designed for time-sensitive operational and decision workflows.',
  },
  {
    title: 'Audit Trail',
    description: 'Every signal emission is logged with timestamp, source, and confidence metadata for compliance and retrospective analysis.',
  },
];
---

<WebLayout
  title="Financial Signals | GoldShore"
  description="Real-time financial signal intelligence — volatility sweeps, directional bias, and market regime detection."
  canonicalPath="/platform/financial-signals"
>
  <section class="page-shell gs-shell-section feature-page">
    <p class="gs-eyebrow">Platform &rsaquo; Financial Signals</p>
    <h1>Financial Signal Intelligence</h1>
    <p class="page-intro">
      Real-time signal detection across volatility, directional bias, and market regime — giving operators
      a continuous, structured view of conditions that matter to decision logic and execution.
    </p>

    <div class="feature-grid">
      {features.map((f) => (
        <article class="feature-card">
          <h2>{f.title}</h2>
          <p>{f.description}</p>
        </article>
      ))}
    </div>

    <aside class="page-cta">
      <p class="gs-eyebrow">Next step</p>
      <h2>Integrate financial signals into your operational stack.</h2>
      <p>
        GoldShore scopes signal integration to your data environment, latency requirements, and downstream decision systems.
      </p>
      <a href="/contact" class="cta-btn">Contact GoldShore</a>
    </aside>
  </section>

  <style>
    .feature-page {
      padding: var(--gs-space-9) 0 calc(var(--gs-space-10) + var(--gs-space-1));
    }

    .feature-page h1 {
      max-width: 16ch;
      margin: 0.75rem 0 1rem;
      font-size: clamp(2.3rem, 5.6vw, 4.2rem);
      line-height: 1;
      letter-spacing: -0.035em;
    }

    .page-intro {
      max-width: 64ch;
      color: var(--gs-text-dim);
      line-height: 1.7;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .feature-card {
      padding: 1.3rem;
      border-radius: 2px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(20, 20, 32, 0.82);
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }

    .feature-card h2 {
      margin: 0 0 0.6rem;
      font-size: 1.1rem;
    }

    .feature-card p {
      margin: 0;
      color: var(--gs-text-dim);
      line-height: 1.65;
      font-size: 0.95rem;
    }

    .page-cta {
      margin-top: 1.4rem;
      padding: 1.35rem;
      border-radius: 2px;
      border: 1px solid rgba(160, 72, 32, 0.18);
      background: rgba(20, 20, 32, 0.82);
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }

    .page-cta h2 {
      margin: 0.45rem 0 0.7rem;
      font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    }

    .page-cta p {
      margin: 0;
      max-width: 66ch;
      color: var(--gs-text-dim);
      line-height: 1.65;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 0.95rem;
      padding: 0.7rem 1.05rem;
      border-radius: 2px;
      background: rgba(160, 72, 32, 0.14);
      border: 1px solid rgba(160, 72, 32, 0.30);
      color: var(--gs-text);
      font-weight: 600;
      text-decoration: none;
      transition: background 120ms ease, border-color 120ms ease;
      font-family: 'DM Mono', ui-monospace, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .cta-btn:hover {
      background: rgba(160, 72, 32, 0.24);
      border-color: rgba(160, 72, 32, 0.50);
    }

    @media (max-width: 900px) {
      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</WebLayout>
