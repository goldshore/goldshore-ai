---
import WebLayout from '../../layouts/WebLayout.astro';

export const prerender = false;

const features = [
  {
    title: 'Pipeline Monitoring',
    description: 'Continuous health checks across AI pipelines — latency, throughput, error rates, and model output drift tracked in real time.',
  },
  {
    title: 'Anomaly Detection',
    description: 'Statistical and rule-based anomaly detection surfaces deviations before they escalate into operational incidents.',
  },
  {
    title: 'Incident Response Playbooks',
    description: 'Pre-configured response sequences route alerts to the right stakeholders with context, severity, and recommended next actions.',
  },
  {
    title: 'Alert Routing',
    description: 'Configurable alert channels with priority tiers — ensuring critical signals reach operators without noise overwhelming the signal.',
  },
  {
    title: 'Historical Baselines',
    description: 'Sentinel builds rolling baselines from pipeline history, enabling adaptive thresholds that evolve with system behavior.',
  },
  {
    title: 'Compliance Logging',
    description: 'All monitoring events and alert responses are logged with immutable timestamps for audit and post-incident review.',
  },
];
---

<WebLayout
  title="Sentinel | GoldShore"
  description="Operational monitoring and alerting for AI pipelines — anomaly detection and incident response playbooks."
  canonicalPath="/platform/sentinel"
>
  <section class="page-shell gs-shell-section feature-page">
    <p class="gs-eyebrow">Platform &rsaquo; Sentinel</p>
    <h1>Sentinel</h1>
    <p class="page-intro">
      Operational monitoring and alerting designed for AI pipeline environments. Sentinel surfaces
      anomalies early, routes incidents to the right responders, and keeps a complete audit record
      of every event.
    </p>

    <div class="feature-grid">
      {features.map((f) => (
        <article class="feature-card">
          <h2>{f.title}</h2>
          <p>{f.description}</p>
        </article>
      ))}
    </div>

    <aside class="page-cta">
      <p class="gs-eyebrow">Next step</p>
      <h2>Add operational intelligence to your AI environment.</h2>
      <p>
        GoldShore scopes Sentinel deployment to your pipeline architecture, alerting requirements, and compliance constraints.
      </p>
      <a href="/contact" class="cta-btn">Contact GoldShore</a>
    </aside>
  </section>

  <style>
    .feature-page {
      padding: var(--gs-space-9) 0 calc(var(--gs-space-10) + var(--gs-space-1));
    }

    .feature-page h1 {
      max-width: 16ch;
      margin: 0.75rem 0 1rem;
      font-size: clamp(2.3rem, 5.6vw, 4.2rem);
      line-height: 1;
      letter-spacing: -0.035em;
    }

    .page-intro {
      max-width: 64ch;
      color: var(--gs-text-dim);
      line-height: 1.7;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .feature-card {
      padding: 1.3rem;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(10, 18, 36, 0.72);
      box-shadow: var(--gs-shadow);
    }

    .feature-card h2 {
      margin: 0 0 0.6rem;
      font-size: 1.1rem;
    }

    .feature-card p {
      margin: 0;
      color: var(--gs-text-dim);
      line-height: 1.65;
      font-size: 0.95rem;
    }

    .page-cta {
      margin-top: 1.4rem;
      padding: 1.35rem;
      border-radius: 22px;
      border: 1px solid rgba(131, 197, 255, 0.28);
      background: linear-gradient(145deg, rgba(12, 28, 56, 0.85), rgba(8, 17, 33, 0.95));
      box-shadow: var(--gs-shadow);
    }

    .page-cta h2 {
      margin: 0.45rem 0 0.7rem;
      font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    }

    .page-cta p {
      margin: 0;
      max-width: 66ch;
      color: var(--gs-text-dim);
      line-height: 1.65;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 0.95rem;
      padding: 0.7rem 1.05rem;
      border-radius: 999px;
      background: rgba(0, 193, 255, 0.16);
      border: 1px solid rgba(145, 222, 255, 0.45);
      color: var(--gs-text);
      font-weight: 600;
      text-decoration: none;
      transition: transform 120ms ease, background 120ms ease;
    }

    .cta-btn:hover {
      transform: translateY(-1px);
      background: rgba(0, 193, 255, 0.24);
    }

    @media (max-width: 900px) {
      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</WebLayout>
