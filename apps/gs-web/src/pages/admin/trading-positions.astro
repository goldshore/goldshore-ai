---
import AdminLayout from '../../layouts/AdminLayout.astro';

interface Position {
  symbol: string;
  quantity: number;
  avgCost: number;
  currentPrice: number;
  marketValue: number;
  unrealizedPL: number;
  unrealizedPLPct: number;
  broker: string;
  assetType: 'EQUITY' | 'OPTION' | 'ETF';
}

const brokerParam = new URL(Astro.request.url).searchParams.get('broker');
const positions: Position[] = [];
let error = '';

// In production, fetch from /api/trading/positions
try {
  const url = `/api/trading/positions${brokerParam ? `?broker=${brokerParam}` : ''}`;
  const response = await fetch(url, { headers: { 'cf-access-client-id': '', 'cf-access-client-secret': '' } }).catch(() => null);
  if (response?.ok) {
    const data = await response.json();
    positions.push(...(data.positions || []));
  }
} catch (e) {
  error = 'Failed to load positions';
}

const totalValue = positions.reduce((sum, p) => sum + p.marketValue, 0);
const totalPL = positions.reduce((sum, p) => sum + p.unrealizedPL, 0);
const totalPLPct = totalValue > 0 ? (totalPL / totalValue) * 100 : 0;
const topPositions = [...positions].sort((a, b) => b.marketValue - a.marketValue).slice(0, 5);
---

<AdminLayout title="Trading Positions">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Trading Positions</h1>
        <p class="text-gray-600 mt-2">Monitor current holdings and unrealized P&L</p>
      </div>
      <a href="/admin/trading-orders" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 font-medium">
        Place Order
      </a>
    </div>

    {error && (
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <p class="text-red-800">{error}</p>
      </div>
    )}

    {!error && positions.length === 0 && (
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-8 text-center">
        <p class="text-gray-600">No open positions</p>
      </div>
    )}

    {positions.length > 0 && (
      <>
        <!-- Summary -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm font-medium text-gray-600">Total Position Value</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">${totalValue.toLocaleString('en-US', { maximumFractionDigits: 2 })}</p>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm font-medium text-gray-600">Unrealized P&L</p>
            <p class={`text-3xl font-bold mt-2 ${totalPL >= 0 ? 'text-green-600' : 'text-red-600'}`}>
              ${totalPL.toLocaleString('en-US', { maximumFractionDigits: 2 })}
            </p>
            <p class={`text-sm mt-1 ${totalPLPct >= 0 ? 'text-green-600' : 'text-red-600'}`}>
              {totalPLPct.toFixed(2)}%
            </p>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <p class="text-sm font-medium text-gray-600">Number of Holdings</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">{positions.length}</p>
          </div>
        </div>

        <!-- Positions Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">All Positions</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Symbol</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Type</th>
                  <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Quantity</th>
                  <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Avg Cost</th>
                  <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Current Price</th>
                  <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Market Value</th>
                  <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Unrealized P&L</th>
                  <th class="px-6 py-3 text-center text-xs font-medium text-gray-600 uppercase">Broker</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                {positions.map((position) => (
                  <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <a href={`/admin/trading-quote?symbol=${position.symbol}`} class="font-semibold text-blue-600 hover:text-blue-800">
                        {position.symbol}
                      </a>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="text-sm text-gray-600">{position.assetType}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900 font-medium">
                      {position.quantity}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-700">
                      ${position.avgCost.toLocaleString('en-US', { maximumFractionDigits: 2 })}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900 font-medium">
                      ${position.currentPrice.toLocaleString('en-US', { maximumFractionDigits: 2 })}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900 font-medium">
                      ${position.marketValue.toLocaleString('en-US', { maximumFractionDigits: 2 })}
                    </td>
                    <td class={`px-6 py-4 whitespace-nowrap text-sm text-right font-medium ${position.unrealizedPL >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                      ${position.unrealizedPL.toLocaleString('en-US', { maximumFractionDigits: 2 })}
                      <span class="text-xs ml-1">({position.unrealizedPLPct.toFixed(2)}%)</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">
                      <span class="text-sm text-gray-600 capitalize">{position.broker === 'tos' ? 'thinkorswim' : position.broker}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Top 5 Positions by Value -->
        {topPositions.length > 0 && (
          <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Concentration: Top 5 Positions</h2>
            <div class="space-y-4">
              {topPositions.map((position, idx) => {
                const pct = (position.marketValue / totalValue) * 100;
                return (
                  <div key={position.symbol} class="flex items-center gap-4">
                    <span class="text-sm font-medium text-gray-600 w-12">#{idx + 1}</span>
                    <div class="flex-1">
                      <div class="flex items-center justify-between mb-1">
                        <span class="font-semibold text-gray-900">{position.symbol}</span>
                        <span class="text-sm text-gray-600">{pct.toFixed(1)}%</span>
                      </div>
                      <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class={`h-2 rounded-full ${pct > 15 ? 'bg-orange-600' : pct > 10 ? 'bg-yellow-600' : 'bg-green-600'}`} style={`width: ${Math.min(pct, 100)}%`} />
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </>
    )}
  </div>
</AdminLayout>
