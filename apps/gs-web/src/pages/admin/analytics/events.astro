---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Event Analytics | GoldShore Admin">
  <main class="container">
    <header>
      <h1>Event Tracking</h1>
      <p>User events with configurable time granularity</p>
    </header>

    <section class="panel">
      <div class="head">
        <div>
          <h2>Event Metrics</h2>
          <p>Aggregated by time period and event type</p>
        </div>
        <div class="controls">
          <select id="granularity">
            <option value="hourly">Hourly</option>
            <option value="daily" selected>Daily</option>
            <option value="monthly">Monthly</option>
          </select>
          <select id="days">
            <option value="7">Last 7 days</option>
            <option value="30" selected>Last 30 days</option>
            <option value="90">Last 90 days</option>
          </select>
          <button id="refresh" type="button">Refresh</button>
        </div>
      </div>
      <div id="events" class="table-wrapper">
        <table class="gs-table">
          <thead>
            <tr>
              <th>Time Period</th>
              <th>Event Type</th>
              <th>Total Events</th>
              <th>Unique Users</th>
            </tr>
          </thead>
          <tbody id="events-tbody">
            <tr><td colspan="4">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <h2>Summary</h2>
      <div id="summary" class="metrics">Loading…</div>
    </section>

    <p id="error" role="alert" style="display: none; color: #d96a32; margin-top: 1rem;"></p>
  </main>

  <script is:inline>
    async function loadEvents() {
      try {
        const granularity = document.getElementById('granularity').value;
        const days = document.getElementById('days').value;

        const response = await fetch(
          `/api/admin/analytics/events-rollup?granularity=${granularity}&days=${days}`,
          { credentials: 'same-origin' }
        );

        if (!response.ok) throw new Error(`Request failed (${response.status})`);

        const data = await response.json();
        if (!data || !data.items) throw new Error('Invalid response');

        const items = data.items || [];

        let totalEvents = 0;
        let totalUsers = 0;
        const eventTypes = new Set();

        const tbody = items.map(item => {
          totalEvents += item.total_events || 0;
          totalUsers += item.unique_users || 0;
          eventTypes.add(item.event_type);

          return `
            <tr>
              <td>${new Date(item.time_period).toLocaleString()}</td>
              <td>${item.event_type || 'Unknown'}</td>
              <td class="number">${(item.total_events || 0).toLocaleString()}</td>
              <td class="number">${(item.unique_users || 0).toLocaleString()}</td>
            </tr>
          `;
        }).join('') || '<tr><td colspan="4">No events recorded</td></tr>';

        document.getElementById('events-tbody').innerHTML = tbody;

        // Summary
        const summaryHtml = `
          <article>
            <b>${totalEvents.toLocaleString()}</b>
            <span>Total Events</span>
          </article>
          <article>
            <b>${totalUsers.toLocaleString()}</b>
            <span>Unique Users</span>
          </article>
          <article>
            <b>${eventTypes.size}</b>
            <span>Event Types</span>
          </article>
          <article>
            <b>${(totalEvents / Math.max(totalUsers, 1)).toFixed(1)}</b>
            <span>Avg Events/User</span>
          </article>
        `;
        document.getElementById('summary').innerHTML = summaryHtml;

        document.getElementById('error').style.display = 'none';
      } catch (err) {
        const errorEl = document.getElementById('error');
        errorEl.textContent = err.message;
        errorEl.style.display = 'block';
      }
    }

    document.getElementById('refresh').addEventListener('click', loadEvents);
    document.getElementById('granularity').addEventListener('change', loadEvents);
    document.getElementById('days').addEventListener('change', loadEvents);
    loadEvents();
  </script>

  <style>
    .container {
      max-width: 78rem;
      margin: auto;
      padding: 2rem;
      display: grid;
      gap: 1.5rem;
    }
    header {
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    h1 {
      font-size: 2rem;
      margin: 0;
    }
    header p {
      opacity: 0.7;
      margin: 0.5rem 0 0 0;
    }
    .panel {
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.04);
      padding: 1.2rem;
    }
    .head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .head div {
      flex: 1;
      min-width: 200px;
    }
    .head h2 {
      margin: 0;
      font-size: 1.1rem;
    }
    .head p {
      margin: 0.3rem 0 0 0;
      opacity: 0.7;
      font-size: 0.9rem;
    }
    .controls {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
    }
    select, button {
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 0.65rem;
      padding: 0.65rem 0.9rem;
      background: #101014;
      color: inherit;
      cursor: pointer;
      font-size: 0.9rem;
    }
    button:hover,
    select:focus {
      border-color: #d96a32;
    }
    .table-wrapper {
      overflow-x: auto;
    }
    .gs-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .gs-table th,
    .gs-table td {
      padding: 0.75rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .gs-table th {
      background: rgba(255, 255, 255, 0.05);
      font-weight: 600;
    }
    .gs-table td.number {
      text-align: right;
      font-family: 'Courier New', monospace;
    }
    .metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .metrics article {
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 0.65rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.02);
    }
    .metrics b {
      display: block;
      font-size: 1.5rem;
    }
    .metrics span {
      display: block;
      opacity: 0.7;
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }
    @media (max-width: 850px) {
      .metrics {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .metrics {
        grid-template-columns: 1fr;
      }
      .controls {
        flex-direction: column;
        width: 100%;
      }
      select, button {
        width: 100%;
      }
      .gs-table {
        font-size: 0.8rem;
      }
      .gs-table th,
      .gs-table td {
        padding: 0.5rem;
      }
    }
  </style>
</AdminLayout>
