---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Market Data | GoldShore Admin">
  <main class="container">
    <header>
      <h1>Market Data</h1>
      <p>Real-time market data feeds by symbol</p>
    </header>

    <section class="panel">
      <div class="head">
        <div>
          <h2>Market Data Feeds</h2>
          <p>Latest price data from market sources</p>
        </div>
        <div class="controls">
          <input type="text" id="symbol" placeholder="Filter by symbol (e.g., AAPL)" />
          <button id="refresh" type="button">Refresh</button>
        </div>
      </div>
      <div id="market" class="table-wrapper">
        <table class="gs-table">
          <thead>
            <tr>
              <th>Symbol</th>
              <th>Price</th>
              <th>Volume</th>
              <th>Source</th>
              <th>Timestamp</th>
            </tr>
          </thead>
          <tbody id="market-tbody">
            <tr><td colspan="5">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <h2>Summary</h2>
      <div id="summary" class="metrics">Loading…</div>
    </section>

    <p id="error" role="alert" style="display: none; color: #d96a32; margin-top: 1rem;"></p>
  </main>

  <script is:inline>
    const formatPrice = (cents) => cents ? `$${(cents / 100).toFixed(2)}` : '$0.00';

    async function loadMarketData() {
      try {
        const symbol = document.getElementById('symbol').value.trim();
        const query = symbol ? `?symbol=${encodeURIComponent(symbol)}` : '';

        const response = await fetch(
          `/api/admin/analytics/market-data${query}`,
          { credentials: 'same-origin' }
        );

        if (!response.ok) throw new Error(`Request failed (${response.status})`);

        const data = await response.json();
        if (!data || !data.items) throw new Error('Invalid response');

        const items = data.items || [];

        const tbody = items.map(item => {
          return `
            <tr>
              <td><strong>${item.symbol || 'N/A'}</strong></td>
              <td class="number">${formatPrice(item.price_cents)}</td>
              <td class="number">${(item.volume || 0).toLocaleString()}</td>
              <td>${item.source || 'Unknown'}</td>
              <td><small>${new Date(item.timestamp).toLocaleString()}</small></td>
            </tr>
          `;
        }).join('') || '<tr><td colspan="5">No market data available</td></tr>';

        document.getElementById('market-tbody').innerHTML = tbody;

        // Summary
        const uniqueSymbols = new Set(items.map(i => i.symbol));
        const totalVolume = items.reduce((sum, i) => sum + (i.volume || 0), 0);
        const avgPrice = items.length > 0
          ? items.reduce((sum, i) => sum + (i.price_cents || 0), 0) / items.length
          : 0;

        const summaryHtml = `
          <article>
            <b>${items.length}</b>
            <span>Data Points</span>
          </article>
          <article>
            <b>${uniqueSymbols.size}</b>
            <span>Unique Symbols</span>
          </article>
          <article>
            <b>${formatPrice(avgPrice)}</b>
            <span>Avg Price</span>
          </article>
          <article>
            <b>${totalVolume.toLocaleString()}</b>
            <span>Total Volume</span>
          </article>
        `;
        document.getElementById('summary').innerHTML = summaryHtml;

        document.getElementById('error').style.display = 'none';
      } catch (err) {
        const errorEl = document.getElementById('error');
        errorEl.textContent = err.message;
        errorEl.style.display = 'block';
      }
    }

    document.getElementById('refresh').addEventListener('click', loadMarketData);
    document.getElementById('symbol').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') loadMarketData();
    });
    loadMarketData();
  </script>

  <style>
    .container {
      max-width: 78rem;
      margin: auto;
      padding: 2rem;
      display: grid;
      gap: 1.5rem;
    }
    header {
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    h1 {
      font-size: 2rem;
      margin: 0;
    }
    header p {
      opacity: 0.7;
      margin: 0.5rem 0 0 0;
    }
    .panel {
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.04);
      padding: 1.2rem;
    }
    .head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .head div {
      flex: 1;
      min-width: 200px;
    }
    .head h2 {
      margin: 0;
      font-size: 1.1rem;
    }
    .head p {
      margin: 0.3rem 0 0 0;
      opacity: 0.7;
      font-size: 0.9rem;
    }
    .controls {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }
    input, button {
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 0.65rem;
      padding: 0.65rem 0.9rem;
      background: #101014;
      color: inherit;
      cursor: pointer;
      font-size: 0.9rem;
    }
    input {
      flex: 1;
      min-width: 200px;
    }
    input::placeholder {
      opacity: 0.5;
    }
    button:hover,
    input:focus {
      border-color: #d96a32;
    }
    .table-wrapper {
      overflow-x: auto;
    }
    .gs-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .gs-table th,
    .gs-table td {
      padding: 0.75rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .gs-table th {
      background: rgba(255, 255, 255, 0.05);
      font-weight: 600;
    }
    .gs-table td.number {
      text-align: right;
      font-family: 'Courier New', monospace;
    }
    .gs-table small {
      opacity: 0.7;
    }
    .metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .metrics article {
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 0.65rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.02);
    }
    .metrics b {
      display: block;
      font-size: 1.5rem;
    }
    .metrics span {
      display: block;
      opacity: 0.7;
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }
    @media (max-width: 850px) {
      .metrics {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .metrics {
        grid-template-columns: 1fr;
      }
      .controls {
        flex-direction: column;
        width: 100%;
      }
      input, button {
        width: 100%;
      }
      .gs-table {
        font-size: 0.8rem;
      }
      .gs-table th,
      .gs-table td {
        padding: 0.5rem;
      }
    }
  </style>
</AdminLayout>
