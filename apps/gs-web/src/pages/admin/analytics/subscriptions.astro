---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Subscription Analytics | GoldShore Admin">
  <main class="container">
    <header>
      <h1>Subscription Analytics</h1>
      <p>Subscriber counts, tier distribution, and churn metrics</p>
    </header>

    <section class="panel">
      <div class="head">
        <div>
          <h2>Subscription Tiers</h2>
          <p>Active subscribers by tier and status</p>
        </div>
        <button id="refresh" type="button">Refresh</button>
      </div>
      <div id="tiers" class="table-wrapper">
        <table class="gs-table">
          <thead>
            <tr>
              <th>Tier</th>
              <th>Price</th>
              <th>Billing</th>
              <th>Active</th>
              <th>Cancelled</th>
              <th>Paused</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody id="tiers-tbody">
            <tr><td colspan="7">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <div class="head">
        <div>
          <h2>Summary</h2>
          <p>Key subscription metrics</p>
        </div>
      </div>
      <div id="summary" class="metrics">Loading…</div>
    </section>

    <p id="error" role="alert" style="display: none; color: #d96a32; margin-top: 1rem;"></p>
  </main>

  <script is:inline>
    const formatCurrency = (cents) => cents ? `$${(cents / 100).toFixed(2)}` : '$0.00';

    async function loadSubscriptions() {
      try {
        const response = await fetch('/api/admin/analytics/subscription-stats', {
          credentials: 'same-origin'
        });

        if (!response.ok) throw new Error(`Request failed (${response.status})`);

        const data = await response.json();
        if (!data || !data.items) throw new Error('Invalid response');

        const items = data.items || [];

        // Calculate totals
        let totalActive = 0;
        let totalCancelled = 0;
        let totalPaused = 0;
        let totalSubscribers = 0;
        let totalMRR = 0;

        // Build table
        const tbody = items.map(tier => {
          const active = tier.active_subscribers || 0;
          const cancelled = tier.cancelled_count || 0;
          const paused = tier.paused_count || 0;
          const total = active + cancelled + paused;
          const mrr = (tier.price_cents || 0) * (tier.billing_period === 'annual' ? 1/12 : 1);

          totalActive += active;
          totalCancelled += cancelled;
          totalPaused += paused;
          totalSubscribers += total;
          totalMRR += mrr * active;

          return `
            <tr>
              <td>${tier.name}</td>
              <td>${formatCurrency(tier.price_cents)}</td>
              <td>${tier.billing_period || 'monthly'}</td>
              <td class="number">${active.toLocaleString()}</td>
              <td class="number">${cancelled.toLocaleString()}</td>
              <td class="number">${paused.toLocaleString()}</td>
              <td class="number">${total.toLocaleString()}</td>
            </tr>
          `;
        }).join('') || '<tr><td colspan="7">No subscription tiers found</td></tr>';

        document.getElementById('tiers-tbody').innerHTML = tbody;

        // Summary metrics
        const summaryHtml = `
          <article>
            <b>${totalActive.toLocaleString()}</b>
            <span>Active Subscribers</span>
          </article>
          <article>
            <b>${totalSubscribers.toLocaleString()}</b>
            <span>Total Subscribers</span>
          </article>
          <article>
            <b>${formatCurrency(totalMRR * 100)}</b>
            <span>Monthly Recurring Revenue</span>
          </article>
          <article>
            <b>${(((totalCancelled + totalPaused) / Math.max(totalSubscribers, 1)) * 100).toFixed(1)}%</b>
            <span>Churn Rate</span>
          </article>
        `;
        document.getElementById('summary').innerHTML = summaryHtml;

        document.getElementById('error').style.display = 'none';
      } catch (err) {
        const errorEl = document.getElementById('error');
        errorEl.textContent = err.message;
        errorEl.style.display = 'block';
      }
    }

    document.getElementById('refresh').addEventListener('click', loadSubscriptions);
    loadSubscriptions();
  </script>

  <style>
    .container {
      max-width: 78rem;
      margin: auto;
      padding: 2rem;
      display: grid;
      gap: 1.5rem;
    }
    header {
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    h1 {
      font-size: 2rem;
      margin: 0;
    }
    header p {
      opacity: 0.7;
      margin: 0.5rem 0 0 0;
    }
    .panel {
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.04);
      padding: 1.2rem;
    }
    .head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .head div {
      flex: 1;
    }
    .head h2 {
      margin: 0;
      font-size: 1.1rem;
    }
    .head p {
      margin: 0.3rem 0 0 0;
      opacity: 0.7;
      font-size: 0.9rem;
    }
    button {
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 0.65rem;
      padding: 0.65rem 0.9rem;
      background: #101014;
      color: inherit;
      cursor: pointer;
    }
    button:hover {
      border-color: #d96a32;
    }
    .table-wrapper {
      overflow-x: auto;
    }
    .gs-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .gs-table th,
    .gs-table td {
      padding: 0.75rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .gs-table th {
      background: rgba(255, 255, 255, 0.05);
      font-weight: 600;
    }
    .gs-table td.number {
      text-align: right;
      font-family: 'Courier New', monospace;
    }
    .metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .metrics article {
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 0.65rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.02);
    }
    .metrics b {
      display: block;
      font-size: 1.5rem;
    }
    .metrics span {
      display: block;
      opacity: 0.7;
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }
    @media (max-width: 850px) {
      .metrics {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .metrics {
        grid-template-columns: 1fr;
      }
      .gs-table {
        font-size: 0.8rem;
      }
      .gs-table th,
      .gs-table td {
        padding: 0.5rem;
      }
    }
  </style>
</AdminLayout>
