---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Opportunities | GoldShore Admin">
  <main class="container">
    <header>
      <h1>Business Opportunities</h1>
      <p>Pipeline view of open, in-progress, and closed opportunities</p>
    </header>

    <section class="panel">
      <div class="head">
        <div>
          <h2>Opportunities</h2>
          <p>Sorted by value and creation date</p>
        </div>
        <div class="controls">
          <select id="status">
            <option value="">All statuses</option>
            <option value="open">Open</option>
            <option value="in_progress">In Progress</option>
            <option value="closed">Closed</option>
            <option value="archived">Archived</option>
          </select>
          <button id="refresh" type="button">Refresh</button>
        </div>
      </div>
      <div id="opps" class="table-wrapper">
        <table class="gs-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Value</th>
              <th>Probability</th>
              <th>Expected Value</th>
              <th>Status</th>
              <th>Close Date</th>
              <th>Assigned To</th>
            </tr>
          </thead>
          <tbody id="opps-tbody">
            <tr><td colspan="7">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <h2>Summary</h2>
      <div id="summary" class="metrics">Loading…</div>
    </section>

    <p id="error" role="alert" style="display: none; color: #d96a32; margin-top: 1rem;"></p>
  </main>

  <script is:inline>
    const formatCurrency = (cents) => cents ? `$${(cents / 100).toFixed(2)}` : '$0.00';
    const formatPercent = (pct) => `${pct?.toFixed(0) || 0}%`;

    const statusColors = {
      open: '#2196f3',
      in_progress: '#ff9800',
      closed: '#4caf50',
      archived: '#9e9e9e'
    };

    async function loadOpportunities() {
      try {
        const status = document.getElementById('status').value;
        const query = status ? `?status=${status}` : '';

        const response = await fetch(
          `/api/admin/analytics/opportunities${query}`,
          { credentials: 'same-origin' }
        );

        if (!response.ok) throw new Error(`Request failed (${response.status})`);

        const data = await response.json();
        if (!data || !data.items) throw new Error('Invalid response');

        const items = data.items || [];

        let totalValue = 0;
        let totalExpectedValue = 0;
        const byStatus = { open: 0, in_progress: 0, closed: 0, archived: 0 };

        const tbody = items.map(opp => {
          const value = opp.value_cents || 0;
          const prob = (opp.probability_percent || 0) / 100;
          const expectedValue = value * prob;

          totalValue += value;
          totalExpectedValue += expectedValue;
          const st = opp.status || 'open';
          if (byStatus.hasOwnProperty(st)) byStatus[st]++;

          const closeDate = opp.target_close_date
            ? new Date(opp.target_close_date).toLocaleDateString()
            : 'No date';

          const color = statusColors[st] || '#999';

          return `
            <tr>
              <td><strong>${opp.title || 'Untitled'}</strong><br><small>${opp.description?.substring(0, 50) || ''}</small></td>
              <td class="number">${formatCurrency(value)}</td>
              <td class="number">${formatPercent(opp.probability_percent)}</td>
              <td class="number">${formatCurrency(expectedValue)}</td>
              <td><span class="badge" style="background-color: ${color}; color: white; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.85rem;">${st.replace(/_/g, ' ').toUpperCase()}</span></td>
              <td><small>${closeDate}</small></td>
              <td>${opp.assigned_to || 'Unassigned'}</td>
            </tr>
          `;
        }).join('') || '<tr><td colspan="7">No opportunities found</td></tr>';

        document.getElementById('opps-tbody').innerHTML = tbody;

        // Summary
        const summaryHtml = `
          <article>
            <b>${items.length}</b>
            <span>Total Opportunities</span>
          </article>
          <article>
            <b>${formatCurrency(totalValue)}</b>
            <span>Total Value</span>
          </article>
          <article>
            <b>${formatCurrency(totalExpectedValue)}</b>
            <span>Expected Value</span>
          </article>
          <article>
            <b>${byStatus.open + byStatus.in_progress}</b>
            <span>Active Opportunities</span>
          </article>
        `;
        document.getElementById('summary').innerHTML = summaryHtml;

        document.getElementById('error').style.display = 'none';
      } catch (err) {
        const errorEl = document.getElementById('error');
        errorEl.textContent = err.message;
        errorEl.style.display = 'block';
      }
    }

    document.getElementById('refresh').addEventListener('click', loadOpportunities);
    document.getElementById('status').addEventListener('change', loadOpportunities);
    loadOpportunities();
  </script>

  <style>
    .container {
      max-width: 78rem;
      margin: auto;
      padding: 2rem;
      display: grid;
      gap: 1.5rem;
    }
    header {
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    h1 {
      font-size: 2rem;
      margin: 0;
    }
    header p {
      opacity: 0.7;
      margin: 0.5rem 0 0 0;
    }
    .panel {
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.04);
      padding: 1.2rem;
    }
    .head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .head div {
      flex: 1;
      min-width: 200px;
    }
    .head h2 {
      margin: 0;
      font-size: 1.1rem;
    }
    .head p {
      margin: 0.3rem 0 0 0;
      opacity: 0.7;
      font-size: 0.9rem;
    }
    .controls {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }
    select, button {
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 0.65rem;
      padding: 0.65rem 0.9rem;
      background: #101014;
      color: inherit;
      cursor: pointer;
      font-size: 0.9rem;
    }
    button:hover,
    select:focus {
      border-color: #d96a32;
    }
    .table-wrapper {
      overflow-x: auto;
    }
    .gs-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .gs-table th,
    .gs-table td {
      padding: 0.75rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .gs-table th {
      background: rgba(255, 255, 255, 0.05);
      font-weight: 600;
    }
    .gs-table td.number {
      text-align: right;
      font-family: 'Courier New', monospace;
    }
    .gs-table small {
      display: block;
      opacity: 0.7;
      margin-top: 0.25rem;
    }
    .metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .metrics article {
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 0.65rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.02);
    }
    .metrics b {
      display: block;
      font-size: 1.5rem;
    }
    .metrics span {
      display: block;
      opacity: 0.7;
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }
    @media (max-width: 850px) {
      .metrics {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .metrics {
        grid-template-columns: 1fr;
      }
      .controls {
        flex-direction: column;
        width: 100%;
      }
      select, button {
        width: 100%;
      }
      .gs-table {
        font-size: 0.8rem;
      }
      .gs-table th,
      .gs-table td {
        padding: 0.5rem;
      }
    }
  </style>
</AdminLayout>
