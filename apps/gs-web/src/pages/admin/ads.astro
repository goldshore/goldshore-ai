---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Ads & Campaigns" requiredPermission="system:read">
  <div class="gs-admin-page">
    <header class="gs-page-header">
      <div><h1>Ads &amp; Campaigns</h1><p>Provider readiness, encrypted account connections, read-only campaign sync, and performance snapshots in one dense workspace.</p></div>
      <div class="gs-toolbar"><button id="refresh-ads" class="gs-button gs-button--secondary" type="button">Refresh</button><button id="add-account" class="gs-button" type="button">+ Add account</button></div>
    </header>

    <section class="provider-rail" id="provider-readiness">
      <article class="provider-card"><span class="provider-mark google">G</span><div><strong>Google Ads</strong><span id="google-readiness" class="gs-status gs-status-pending"><i></i>Checking</span></div><small>Read-only reporting sync</small></article>
      <article class="provider-card"><span class="provider-mark meta">M</span><div><strong>Meta Ads</strong><span id="meta-readiness" class="gs-status gs-status-pending"><i></i>Checking</span></div><small>Setup-only until provider client is enabled</small></article>
      <article class="provider-card"><span class="provider-mark secure">◆</span><div><strong>Credentials</strong><span class="gs-status gs-status-ok"><i></i>Encrypted</span></div><small>Secret values never return to the browser</small></article>
    </section>

    <nav class="gs-tabs" role="tablist" aria-label="Advertising workspace">
      <button class="gs-tab" type="button" data-ads-tab="accounts" aria-selected="true">Accounts</button>
      <button class="gs-tab" type="button" data-ads-tab="campaigns" aria-selected="false">Campaigns</button>
      <button class="gs-tab" type="button" data-ads-tab="providers" aria-selected="false">Provider setup</button>
    </nav>

    <section class="gs-admin-grid ads-panel" data-ads-panel="accounts">
      <article class="gs-module gs-span-12" data-draggable="true" data-resizable="true" data-module-id="ads-accounts">
        <header class="gs-module-header"><div><h2>Connected accounts</h2><p class="gs-text-subtle">Accounts remain read-only. Sync imports reporting data into Gold Shore without modifying provider campaigns.</p></div><span id="account-count" class="gs-status gs-status-pending"><i></i>Loading</span></header>
        <div class="gs-module-body">
          <div class="gs-filterbar"><input id="account-search" class="gs-input" type="search" placeholder="Search account, provider, or ID" /><select id="provider-filter" class="gs-input"><option value="">All providers</option><option value="google_ads">Google Ads</option><option value="meta_ads">Meta Ads</option></select><select id="account-status-filter" class="gs-input"><option value="">All states</option><option value="ready">Ready</option><option value="setup_required">Setup required</option><option value="error">Error</option></select></div>
          <div id="ads-error" class="gs-error-state" hidden></div>
          <div class="gs-data-wrap"><table class="gs-data-table"><thead><tr><th></th><th>Account</th><th>Provider</th><th>Status</th><th>Credential</th><th>Last sync</th><th>Currency</th><th>Actions</th></tr></thead><tbody id="account-rows"><tr><td colspan="8">Loading accounts…</td></tr></tbody></table></div>
          <footer class="gs-table-footer"><span id="account-page-label"></span><div><button id="account-prev" class="gs-button gs-button--secondary" type="button">Previous</button><button id="account-next" class="gs-button gs-button--secondary" type="button">Next</button></div></footer>
        </div>
      </article>
    </section>

    <section class="gs-admin-grid ads-panel" data-ads-panel="campaigns" hidden>
      <article class="gs-module gs-span-12" data-draggable="true" data-resizable="true" data-module-id="ads-campaigns">
        <header class="gs-module-header"><div><h2>Campaign snapshots</h2><p id="campaign-context" class="gs-text-subtle">Choose an account from the Accounts tab to inspect imported campaign performance.</p></div><span id="campaign-count" class="gs-status gs-status-pending"><i></i>No account</span></header>
        <div class="gs-module-body">
          <div class="gs-filterbar"><input id="campaign-search" class="gs-input" type="search" placeholder="Search campaigns" /><button id="sync-selected" class="gs-button gs-button--secondary" type="button" disabled>Sync selected account</button></div>
          <div id="campaign-error" class="gs-error-state" hidden></div>
          <div class="gs-data-wrap"><table class="gs-data-table"><thead><tr><th>Campaign</th><th>Impressions</th><th>Clicks</th><th>CTR</th><th>Conversions</th><th>Cost</th><th>Synced</th></tr></thead><tbody id="campaign-rows"><tr><td colspan="7"><div class="gs-empty"><strong>No account selected</strong><p>Select Campaigns on an account to load snapshots.</p></div></td></tr></tbody></table></div>
        </div>
      </article>
    </section>

    <section class="gs-admin-grid ads-panel" data-ads-panel="providers" hidden>
      <article class="gs-module gs-span-8"><header class="gs-module-header"><div><h2>Provider contract</h2><p class="gs-text-subtle">Current capabilities reflect the real gs-api implementation rather than simulated ad controls.</p></div></header><div class="gs-module-body provider-contract"><div><strong>Google Ads</strong><span>Account registration</span><span>Encrypted OAuth reference</span><span>Read-only campaign sync</span><span>Performance snapshots</span></div><div><strong>Meta Ads</strong><span>Account registration</span><span>Encrypted credential reference</span><span class="muted">Campaign sync not enabled</span></div></div></article>
      <article class="gs-module gs-span-4"><header class="gs-module-header"><div><h2>Credential setup</h2><p class="gs-text-subtle">Create/rotate provider credentials in System &amp; Infra, then attach the secret ID to an ad account.</p></div></header><div class="gs-module-body"><a href="/admin/system?tab=secrets" class="gs-button gs-button--secondary">Open Secrets</a></div></article>
    </section>
  </div>

  <dialog id="account-dialog" class="gs-modal account-modal">
    <form id="account-form" class="account-card">
      <header><div><h2>Add advertising account</h2><p class="gs-text-subtle">Provider changes stay read-only from this control plane.</p></div><button id="close-account" type="button" class="gs-icon-button">×</button></header>
      <div class="account-fields two-col"><label>Provider<select name="provider" class="gs-input"><option value="google_ads">Google Ads</option><option value="meta_ads">Meta Ads (setup only)</option></select></label><label>Display name<input name="displayName" class="gs-input" maxlength="120" required /></label><label>External account ID<input name="externalAccountId" class="gs-input" inputmode="numeric" placeholder="123-456-7890" required /></label><label>Credential secret ID<input name="credentialSecretId" class="gs-input" placeholder="secret_…" /></label><label>Currency<input name="currency" class="gs-input" value="USD" maxlength="3" /></label><label>Timezone<input name="timezone" class="gs-input" value="America/New_York" /></label></div>
      <div id="account-error" class="gs-error-state" hidden></div>
      <footer><button id="cancel-account" class="gs-button gs-button--secondary" type="button">Cancel</button><button class="gs-button" type="submit">Register account</button></footer>
    </form>
  </dialog>
</AdminLayout>

<style>
  .gs-admin-page{max-width:1480px;margin:0 auto;padding:clamp(72px,8vw,96px) clamp(16px,3vw,36px) 48px}.gs-page-header{display:flex;justify-content:space-between;gap:20px;align-items:flex-end;margin-bottom:18px}.gs-page-header h1{margin:0;font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.045em}.gs-page-header p{max-width:760px;margin:.55rem 0 0;color:var(--admin-muted);line-height:1.55}.provider-rail{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:14px}.provider-card{display:grid;grid-template-columns:38px 1fr;gap:10px;align-items:center;background:#f7f6f2;color:#11151a;border:1px solid #dfded9;border-radius:5px;padding:11px 12px;box-shadow:0 8px 26px rgba(0,0,0,.18)}.provider-card small{grid-column:2;color:#737b84;font-size:.68rem}.provider-card>div{display:flex;justify-content:space-between;gap:8px;align-items:center}.provider-mark{width:34px;height:34px;display:grid;place-items:center;border-radius:5px;font-weight:800;background:#fff;border:1px solid #deddd8}.provider-mark.google{color:#4285f4}.provider-mark.meta{color:#0866ff}.provider-mark.secure{color:#7c3aed}.gs-admin-grid{margin-top:14px}.ads-panel[hidden]{display:none!important}.gs-data-table th:first-child,.gs-data-table td:first-child{width:34px}.account-icon{width:23px;height:23px;border-radius:4px;display:grid;place-items:center;background:#eef1f6;border:1px solid rgba(15,17,21,.09);font-weight:800;font-size:.65rem}.account-name strong,.account-name small{display:block}.account-name small{margin-top:3px;color:#757d86;font-size:.68rem}.account-actions{display:flex;gap:5px;white-space:nowrap}.account-actions button{padding:5px 8px;font-size:.68rem}.gs-table-footer{display:flex;justify-content:space-between;gap:12px;padding-top:12px;color:#68717b;font-size:.72rem}.gs-table-footer>div{display:flex;gap:6px}.provider-contract{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.provider-contract>div{display:grid;gap:8px;padding:12px;border:1px solid rgba(15,17,21,.08);background:#f4f3ef}.provider-contract span{font-size:.74rem;color:#59616b}.provider-contract .muted{color:#949aa1}.account-modal{width:min(720px,calc(100vw - 24px));max-width:none;border:0;padding:0;background:transparent}.account-modal::backdrop{background:rgba(0,0,0,.75)}.account-card{display:grid;gap:14px;padding:18px;background:#faf9f6;color:#101318;border:1px solid #deddd8;border-radius:6px;box-shadow:0 28px 90px rgba(0,0,0,.58)}.account-card header,.account-card footer{display:flex;justify-content:space-between;align-items:center;gap:10px}.account-card h2{margin:0}.account-fields{display:grid;gap:12px}.account-fields.two-col{grid-template-columns:repeat(2,minmax(0,1fr))}.account-fields label{display:grid;gap:6px;color:#59616b;font-size:.74rem}.gs-icon-button{border:1px solid rgba(15,17,21,.12);background:transparent;color:#101318;width:32px;height:32px;cursor:pointer}@media(max-width:820px){.provider-rail{grid-template-columns:1fr}.gs-page-header{align-items:flex-start;flex-direction:column}.gs-data-wrap{overflow:auto}.gs-data-table{min-width:900px}.account-fields.two-col,.provider-contract{grid-template-columns:1fr}}
</style>

<script>
  import { adminApi, adminApiMessage } from '../../lib/admin-api-client';
  type Account={id:string;provider:string;external_account_id:string;display_name:string;currency:string;timezone:string;credential:boolean;status:string;read_only:boolean;last_sync_at?:string|null;last_error?:string|null};
  type Campaign={campaign_id:string;campaign_name:string;impressions:number;clicks:number;conversions:number;cost_micros:number;ctr:number;synced_at:string};
  const state={page:1,pages:1,accounts:[] as Account[],selected:null as Account|null,campaigns:[] as Campaign[]};
  const accountRows=document.querySelector<HTMLTableSectionElement>('#account-rows')!;const campaignRows=document.querySelector<HTMLTableSectionElement>('#campaign-rows')!;const accountDialog=document.querySelector<HTMLDialogElement>('#account-dialog')!;
  const setError=(selector:string,message?:string)=>{const el=document.querySelector<HTMLElement>(selector)!;el.hidden=!message;el.textContent=message||'';};
  const setStatus=(selector:string,tone:string,label:string)=>{const el=document.querySelector<HTMLElement>(selector)!;el.className=`gs-status gs-status-${tone}`;el.innerHTML='<i></i>';el.append(document.createTextNode(label));};
  const statusTone=(value:string)=>value==='ready'?'ok':value==='error'?'error':value==='setup_required'?'warning':'pending';
  const providerName=(value:string)=>value==='google_ads'?'Google Ads':value==='meta_ads'?'Meta Ads':value;
  const money=(micros:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(Number(micros||0)/1_000_000);
  const number=(value:number)=>new Intl.NumberFormat('en-US').format(Number(value||0));
  const makeCell=(value:string)=>{const td=document.createElement('td');td.textContent=value;return td;};

  function activateTab(id:string){document.querySelectorAll<HTMLButtonElement>('[data-ads-tab]').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.adsTab===id)));document.querySelectorAll<HTMLElement>('[data-ads-panel]').forEach(p=>p.hidden=p.dataset.adsPanel!==id);}
  document.querySelectorAll<HTMLButtonElement>('[data-ads-tab]').forEach(b=>b.addEventListener('click',()=>activateTab(b.dataset.adsTab||'accounts')));

  async function loadReadiness(){const result=await adminApi<any>('/api/admin/ads/readiness');if(!result.ok){setStatus('#google-readiness','error','Unavailable');setStatus('#meta-readiness','error','Unavailable');return;}setStatus('#google-readiness',result.data.providers.google_ads.developerTokenConfigured?'ok':'warning',result.data.providers.google_ads.developerTokenConfigured?'Sync ready':'Token required');setStatus('#meta-readiness','pending','Setup only');}

  function filteredAccounts(){const q=(document.querySelector<HTMLInputElement>('#account-search')?.value||'').toLowerCase();const provider=document.querySelector<HTMLSelectElement>('#provider-filter')?.value||'';const status=document.querySelector<HTMLSelectElement>('#account-status-filter')?.value||'';return state.accounts.filter(a=>(!provider||a.provider===provider)&&(!status||a.status===status)&&(!q||`${a.display_name} ${a.provider} ${a.external_account_id}`.toLowerCase().includes(q)));}
  function renderAccounts(){const items=filteredAccounts();accountRows.replaceChildren();for(const a of items){const tr=document.createElement('tr');const icon=makeCell('');const mark=document.createElement('span');mark.className='account-icon';mark.textContent=a.provider==='google_ads'?'G':'M';icon.append(mark);const name=makeCell('');name.className='account-name';const strong=document.createElement('strong');strong.textContent=a.display_name;const small=document.createElement('small');small.textContent=a.external_account_id;name.append(strong,small);const provider=makeCell(providerName(a.provider));const statusCell=makeCell('');const signal=document.createElement('span');signal.className=`gs-status gs-status-${statusTone(a.status)}`;signal.innerHTML='<i></i>';signal.append(document.createTextNode(a.status.replaceAll('_',' ')));statusCell.append(signal);const credential=makeCell(a.credential?'Attached':'Missing');const last=makeCell(a.last_sync_at?new Date(a.last_sync_at).toLocaleString():'Never');const currency=makeCell(a.currency||'USD');const action=makeCell('');const wrap=document.createElement('div');wrap.className='account-actions';const campaigns=document.createElement('button');campaigns.type='button';campaigns.className='gs-button gs-button--secondary';campaigns.textContent='Campaigns';campaigns.onclick=()=>void selectAccount(a);const sync=document.createElement('button');sync.type='button';sync.className='gs-button gs-button--secondary';sync.textContent='Sync';sync.disabled=a.provider!=='google_ads';sync.onclick=()=>void syncAccount(a,sync);wrap.append(campaigns,sync);action.append(wrap);tr.append(icon,name,provider,statusCell,credential,last,currency,action);accountRows.append(tr);}if(!items.length){const tr=document.createElement('tr');const td=makeCell('No advertising accounts match the current filters.');td.colSpan=8;tr.append(td);accountRows.append(tr);}setStatus('#account-count','info',`${state.accounts.length} accounts`);document.querySelector<HTMLElement>('#account-page-label')!.textContent=`Page ${state.page} of ${state.pages}`;document.querySelector<HTMLButtonElement>('#account-prev')!.disabled=state.page<=1;document.querySelector<HTMLButtonElement>('#account-next')!.disabled=state.page>=state.pages;}
  async function loadAccounts(){setError('#ads-error');const result=await adminApi<any>(`/api/admin/ads/accounts?page=${state.page}&pageSize=25`);if(!result.ok){setError('#ads-error',adminApiMessage(result));accountRows.innerHTML='<tr><td colspan="8">Account API unavailable.</td></tr>';return;}state.accounts=result.data.items||[];state.pages=result.data.pagination?.pages||1;renderAccounts();}

  function renderCampaigns(){const q=(document.querySelector<HTMLInputElement>('#campaign-search')?.value||'').toLowerCase();const items=state.campaigns.filter(c=>!q||c.campaign_name.toLowerCase().includes(q));campaignRows.replaceChildren();for(const c of items){const tr=document.createElement('tr');tr.append(makeCell(c.campaign_name),makeCell(number(c.impressions)),makeCell(number(c.clicks)),makeCell(`${(Number(c.ctr||0)*100).toFixed(2)}%`),makeCell(number(c.conversions)),makeCell(money(c.cost_micros)),makeCell(c.synced_at?new Date(c.synced_at).toLocaleString():'—'));campaignRows.append(tr);}if(!items.length){const tr=document.createElement('tr');const td=makeCell(state.selected?'No campaign snapshots found. Run a sync if the provider is ready.':'No account selected.');td.colSpan=7;tr.append(td);campaignRows.append(tr);}setStatus('#campaign-count',state.selected?'info':'pending',state.selected?`${state.campaigns.length} campaigns`:'No account');}
  async function selectAccount(account:Account){state.selected=account;activateTab('campaigns');document.querySelector<HTMLElement>('#campaign-context')!.textContent=`${account.display_name} · ${providerName(account.provider)} · ${account.external_account_id}`;const sync=document.querySelector<HTMLButtonElement>('#sync-selected')!;sync.disabled=account.provider!=='google_ads';setError('#campaign-error');const result=await adminApi<any>(`/api/admin/ads/accounts/${encodeURIComponent(account.id)}/campaigns?page=1&pageSize=100`);if(!result.ok){setError('#campaign-error',adminApiMessage(result));state.campaigns=[];renderCampaigns();return;}state.campaigns=result.data.items||[];renderCampaigns();}
  async function syncAccount(account:Account,button?:HTMLButtonElement){if(button){button.disabled=true;button.textContent='Syncing…';}setError('#campaign-error');const result=await adminApi<any>(`/api/admin/ads/accounts/${encodeURIComponent(account.id)}/sync`,{method:'POST'});if(button){button.textContent='Sync';button.disabled=account.provider!=='google_ads';}if(!result.ok){setError('#campaign-error',adminApiMessage(result));return;}await loadAccounts();await selectAccount(state.accounts.find(a=>a.id===account.id)||account);}

  const form=document.querySelector<HTMLFormElement>('#account-form')!;const openAccount=()=>{form.reset();(form.elements.namedItem('currency') as HTMLInputElement).value='USD';(form.elements.namedItem('timezone') as HTMLInputElement).value='America/New_York';setError('#account-error');accountDialog.showModal();};const closeAccount=()=>accountDialog.close();
  form.addEventListener('submit',async event=>{event.preventDefault();const body=Object.fromEntries(new FormData(form));const result=await adminApi('/api/admin/ads/accounts',{method:'POST',body:JSON.stringify(body)});if(!result.ok){setError('#account-error',adminApiMessage(result));return;}closeAccount();state.page=1;await loadAccounts();});

  document.querySelector('#add-account')?.addEventListener('click',openAccount);document.querySelector('#close-account')?.addEventListener('click',closeAccount);document.querySelector('#cancel-account')?.addEventListener('click',closeAccount);document.querySelector('#refresh-ads')?.addEventListener('click',()=>void Promise.all([loadReadiness(),loadAccounts()]));document.querySelector('#account-search')?.addEventListener('input',renderAccounts);document.querySelector('#provider-filter')?.addEventListener('change',renderAccounts);document.querySelector('#account-status-filter')?.addEventListener('change',renderAccounts);document.querySelector('#campaign-search')?.addEventListener('input',renderCampaigns);document.querySelector('#account-prev')?.addEventListener('click',()=>{if(state.page>1){state.page--;void loadAccounts();}});document.querySelector('#account-next')?.addEventListener('click',()=>{if(state.page<state.pages){state.page++;void loadAccounts();}});document.querySelector('#sync-selected')?.addEventListener('click',()=>{if(state.selected)void syncAccount(state.selected,document.querySelector<HTMLButtonElement>('#sync-selected')!);});
  void Promise.all([loadReadiness(),loadAccounts()]);
</script>
