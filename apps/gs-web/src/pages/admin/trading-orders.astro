---
import AdminLayout from '../../layouts/AdminLayout.astro';

interface Order {
  id: string;
  broker: string;
  symbol: string;
  side: 'BUY' | 'SELL';
  quantity: number;
  orderType: 'MARKET' | 'LIMIT' | 'STOP' | 'STOP_LIMIT';
  limitPrice?: number;
  stopPrice?: number;
  status: 'PENDING' | 'OPEN' | 'FILLED' | 'CANCELLED' | 'REJECTED';
  filledQuantity: number;
  filledPrice?: number;
  placedAt: string;
  updatedAt: string;
}

const orders: Order[] = [];
let error = '';
let newOrderSymbol = '';
let newOrderBroker = 'schwab';

// In production, fetch from /api/trading/orders
try {
  const response = await fetch('/api/trading/orders', { headers: { 'cf-access-client-id': '', 'cf-access-client-secret': '' } }).catch(() => null);
  if (response?.ok) {
    const data = await response.json();
    orders.push(...(data.orders || []));
  }
} catch (e) {
  error = 'Failed to load orders';
}

const openOrders = orders.filter(o => ['OPEN', 'PENDING'].includes(o.status));
const filledOrders = orders.filter(o => o.status === 'FILLED');
const cancelledOrders = orders.filter(o => ['CANCELLED', 'REJECTED'].includes(o.status));

const getStatusColor = (status: Order['status']) => {
  switch (status) {
    case 'OPEN': case 'PENDING': return 'bg-blue-100 text-blue-800';
    case 'FILLED': return 'bg-green-100 text-green-800';
    case 'CANCELLED': case 'REJECTED': return 'bg-red-100 text-red-800';
    default: return 'bg-gray-100 text-gray-800';
  }
};
---

<AdminLayout title="Trading Orders">
  <div class="space-y-6">
    <!-- Header -->
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Trading Orders</h1>
      <p class="text-gray-600 mt-2">Place and manage trades across all connected brokers</p>
    </div>

    {error && (
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <p class="text-red-800">{error}</p>
      </div>
    )}

    <!-- Quick Order Form -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Place New Order</h2>
      <form id="new-order-form" class="grid grid-cols-2 md:grid-cols-6 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Broker</label>
          <select name="broker" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="schwab">Schwab</option>
            <option value="tos">thinkorswim</option>
            <option value="robinhood">Robinhood</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Symbol</label>
          <input type="text" name="symbol" placeholder="AAPL" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Side</label>
          <select name="side" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="BUY">Buy</option>
            <option value="SELL">Sell</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Quantity</label>
          <input type="number" name="quantity" placeholder="100" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
          <select name="orderType" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="MARKET">Market</option>
            <option value="LIMIT">Limit</option>
          </select>
        </div>
        <div class="flex items-end gap-2">
          <button type="submit" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 font-medium text-sm">
            Place Order
          </button>
        </div>
      </form>
      <p class="text-xs text-gray-500 mt-4">Orders are subject to risk management rules. Large or concentrated positions may be blocked.</p>
    </div>

    {/* Open Orders Section */}
    {openOrders.length > 0 && (
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-blue-50">
          <h2 class="text-lg font-semibold text-gray-900">Open Orders ({openOrders.length})</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Symbol</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Type</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Quantity</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Limit Price</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Placed</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-600 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {openOrders.map((order) => (
                <tr class="hover:bg-gray-50 transition">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-600">{order.id.slice(-8)}</td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">{order.symbol}</td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <span class={`px-2 py-1 rounded text-xs font-medium ${order.side === 'BUY' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
                      {order.side} {order.orderType}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900 font-medium">{order.quantity}</td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-700">
                    {order.limitPrice ? `$${order.limitPrice.toFixed(2)}` : '—'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={`px-2 py-1 rounded-full text-xs font-medium ${getStatusColor(order.status)}`}>
                      {order.status}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                    {new Date(order.placedAt).toLocaleDateString()} {new Date(order.placedAt).toLocaleTimeString()}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <button class="text-red-600 hover:text-red-800 text-sm font-medium" data-order-id={order.id} data-broker={order.broker}>
                      Cancel
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {/* Filled Orders Section */}
    {filledOrders.length > 0 && (
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-green-50">
          <h2 class="text-lg font-semibold text-gray-900">Filled Orders ({filledOrders.length})</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Symbol</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Type</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Quantity</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-600 uppercase">Filled @ Price</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Filled</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {filledOrders.slice(0, 5).map((order) => (
                <tr class="hover:bg-gray-50 transition">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">{order.symbol}</td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <span class={`px-2 py-1 rounded text-xs font-medium ${order.side === 'BUY' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
                      {order.side}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900 font-medium">{order.filledQuantity}</td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-700">
                    {order.filledPrice ? `$${order.filledPrice.toFixed(2)}` : '—'}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                    {new Date(order.updatedAt).toLocaleDateString()}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {filledOrders.length > 5 && (
          <div class="px-6 py-3 bg-gray-50 border-t border-gray-200 text-sm text-gray-600">
            +{filledOrders.length - 5} more filled orders
          </div>
        )}
      </div>
    )}

    {orders.length === 0 && !error && (
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-8 text-center">
        <p class="text-gray-600">No orders yet. Use the form above to place your first trade.</p>
      </div>
    )}
  </div>

  <script>
    document.getElementById('new-order-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      const order = {
        broker: formData.get('broker'),
        symbol: formData.get('symbol'),
        side: formData.get('side'),
        quantity: parseInt(formData.get('quantity') as string),
        orderType: formData.get('orderType'),
        limitPrice: formData.get('orderType') === 'LIMIT' ? parseFloat(formData.get('limitPrice') as string) : undefined,
      };

      try {
        const response = await fetch('/api/trading/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(order),
        });
        if (response.ok) {
          alert('Order placed successfully!');
          window.location.reload();
        } else {
          const error = await response.json();
          alert(`Order failed: ${error.error}`);
        }
      } catch (err) {
        alert('Failed to place order');
      }
    });

    document.querySelectorAll('[data-order-id]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const orderId = (e.target as HTMLElement).getAttribute('data-order-id');
        const broker = (e.target as HTMLElement).getAttribute('data-broker');

        if (confirm('Are you sure you want to cancel this order?')) {
          try {
            const response = await fetch(`/api/trading/orders/${orderId}?broker=${broker}`, {
              method: 'DELETE',
            });
            if (response.ok) {
              alert('Order cancelled successfully!');
              window.location.reload();
            } else {
              alert('Failed to cancel order');
            }
          } catch (err) {
            alert('Failed to cancel order');
          }
        }
      });
    });
  </script>
</AdminLayout>
