---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Media Storage" requiredPermission="media:read">
  <main class="storage">
    <header><p class="eyebrow">R2 asset operations</p><h1>Media Storage</h1><p>Upload sanitized images to the canonical GS_ASSETS bucket and browse durable D1 metadata.</p></header>
    <section class="panel"><form id="upload"><label>Image file<input id="file" name="file" type="file" accept=".png,.jpg,.jpeg,.svg,image/png,image/jpeg,image/svg+xml" required /></label><button type="submit">Upload image</button></form><p id="message" role="status">PNG, JPEG, or sanitized SVG; maximum 5 MB.</p></section>
    <section class="panel"><div class="head"><div><h2>Assets</h2><p>Newest first. Open an asset to use its authenticated delivery URL.</p></div><button id="refresh" type="button">Refresh</button></div><div id="assets" class="assets">Loading…</div><nav><button id="previous" type="button">Previous</button><span id="page"></span><button id="next" type="button">Next</button></nav></section>
  </main>
  <script is:inline>
    const state={offset:0,limit:24,hasNext:false};const esc=(v)=>String(v??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    async function load(){const response=await fetch(`/api/admin/media?limit=${state.limit}&offset=${state.offset}`,{credentials:'same-origin'});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Asset inventory failed.');state.hasNext=data.items.length===state.limit;document.getElementById('previous').disabled=state.offset===0;document.getElementById('next').disabled=!state.hasNext;document.getElementById('page').textContent=`Items ${state.offset+1}–${state.offset+data.items.length}`;document.getElementById('assets').innerHTML=data.items.length?data.items.map((item)=>`<article><a href="/api/admin/media/${encodeURIComponent(item.id)}" target="_blank" rel="noopener"><img src="/api/admin/media/${encodeURIComponent(item.id)}" alt="${esc(item.filename)}" loading="lazy" /></a><b>${esc(item.filename)}</b><span>${esc(item.type)} · ${(Number(item.size)/1024).toFixed(1)} KB</span><small>${esc(new Date(item.created_at).toLocaleString())}</small></article>`).join(''):'<p>No media assets found.</p>';}
    document.getElementById('upload').onsubmit=async(event)=>{event.preventDefault();const form=event.currentTarget;const message=document.getElementById('message');message.textContent='Uploading and sanitizing…';const response=await fetch('/api/admin/media/upload',{method:'POST',body:new FormData(form),credentials:'same-origin'});const data=await response.json().catch(()=>({}));if(!response.ok){message.textContent=data.error||'Upload failed.';return;}message.textContent=`Uploaded ${data.filename}.`;form.reset();state.offset=0;await load();};
    document.getElementById('refresh').onclick=()=>load().catch((e)=>document.getElementById('message').textContent=e.message);document.getElementById('previous').onclick=()=>{state.offset=Math.max(0,state.offset-state.limit);load()};document.getElementById('next').onclick=()=>{state.offset+=state.limit;load()};load().catch((e)=>document.getElementById('assets').textContent=e.message);
  </script>
</AdminLayout>
<style>
  .storage{max-width:78rem;margin:auto;padding:2rem;display:grid;gap:1.5rem}.eyebrow{color:#d96a32;font-weight:800;text-transform:uppercase;letter-spacing:.12em}h1{font-size:2.5rem;margin:.2rem 0}.panel{border:1px solid rgba(255,255,255,.14);border-radius:1rem;background:rgba(255,255,255,.04);padding:1.2rem}.head,form,nav{display:flex;justify-content:space-between;align-items:center;gap:1rem}label{display:flex;align-items:center;gap:1rem}.assets{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:1rem}.assets article{display:grid;gap:.4rem}.assets img{width:100%;aspect-ratio:4/3;object-fit:cover;background:#08080b;border-radius:.7rem}.assets span,.assets small,#message{opacity:.72}button,input{border:1px solid rgba(255,255,255,.2);border-radius:.65rem;padding:.65rem .9rem;background:#101014;color:inherit}button{cursor:pointer;font-weight:700}button:disabled{opacity:.45}nav{justify-content:flex-end;margin-top:1rem}@media(max-width:900px){.assets{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.assets{grid-template-columns:1fr}.head,form,label{align-items:flex-start;flex-direction:column}}
</style>
