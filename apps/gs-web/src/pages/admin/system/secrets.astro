---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Secrets | GoldShore Admin" requiredPermission="secret_metadata:read">
  <section class="max-w-6xl mx-auto py-16 px-6 space-y-6">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-3xl gs-heading">Secrets and API Keys</h1>
        <p class="gs-text-subtle mt-2">Create, rotate, expire, and revoke encrypted integration credentials.</p>
      </div>
      <button id="new-secret" class="gs-btn-primary px-4 py-2">Create secret</button>
    </div>

    <div class="gs-card border-l-4 border-blue-500 text-sm">
      Secret values are accepted only for create and rotation requests. They are encrypted by gs-api and are never returned to this page.
    </div>

    <div class="gs-card flex gap-3 flex-wrap items-end">
      <label class="space-y-1"><span class="block text-sm">Integration</span><input id="filter-integration" class="gs-input" placeholder="stripe, meta, openai…" /></label>
      <label class="space-y-1"><span class="block text-sm">Key type</span><select id="filter-type" class="gs-input"><option value="">All types</option><option value="apiKey">API key</option><option value="apiSecret">API secret</option><option value="webhook_secret">Webhook secret</option><option value="oauth_token">OAuth token</option></select></label>
      <label class="flex gap-2 items-center pb-2"><input id="include-expired" type="checkbox" /> Include expired</label>
      <button id="apply-filter" class="gs-btn-secondary px-4 py-2">Apply</button>
    </div>

    <div id="notice" class="gs-card text-sm" hidden></div>
    <div class="gs-card overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead><tr class="border-b border-[var(--gs-color-border)]"><th class="p-3">Integration</th><th class="p-3">Type</th><th class="p-3">Identifier</th><th class="p-3">Expires</th><th class="p-3">Rotations</th><th class="p-3">Actions</th></tr></thead>
        <tbody id="secret-rows"><tr><td colspan="6" class="p-6 gs-text-subtle">Loading secret metadata…</td></tr></tbody>
      </table>
      <div class="flex justify-between items-center gap-3 p-3 border-t border-[var(--gs-color-border)]">
        <span id="page-summary" class="text-sm gs-text-subtle"></span>
        <div class="flex gap-2"><button id="previous-page" class="gs-btn-secondary px-3 py-1">Previous</button><button id="next-page" class="gs-btn-secondary px-3 py-1">Next</button></div>
      </div>
    </div>
  </section>

  <dialog id="secret-dialog" class="gs-card max-w-xl w-full backdrop:bg-black/70">
    <form id="secret-form" class="space-y-4">
      <div class="flex justify-between"><h2 id="dialog-title" class="text-xl font-semibold">Create secret</h2><button type="button" id="close-dialog" aria-label="Close">✕</button></div>
      <input id="secret-id" type="hidden" />
      <label class="block space-y-1"><span>Integration ID</span><input id="integration-id" class="gs-input w-full" required pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,63}" placeholder="openai" /></label>
      <label class="block space-y-1"><span>Key type</span><select id="key-type" class="gs-input w-full"><option value="apiKey">API key</option><option value="apiSecret">API secret</option><option value="webhook_secret">Webhook secret</option><option value="oauth_token">OAuth token</option></select></label>
      <label class="block space-y-1"><span id="value-label">Secret value</span><textarea id="secret-value" class="gs-input w-full font-mono" rows="5" minlength="8" maxlength="16384" required autocomplete="new-password"></textarea></label>
      <label id="expiry-field" class="block space-y-1"><span>Expires at (optional)</span><input id="expires-at" type="datetime-local" class="gs-input w-full" /></label>
      <p class="text-xs gs-text-subtle">The value is cleared from this form immediately after the request finishes.</p>
      <div class="flex justify-end gap-3"><button type="button" id="cancel-dialog" class="gs-btn-secondary px-4 py-2">Cancel</button><button class="gs-btn-primary px-4 py-2" type="submit">Save securely</button></div>
    </form>
  </dialog>

  <script>
    type Secret = { id:string; integration_id:string; key_type:string; key_prefix:string; created_at:string; rotated_at:string|null; expires_at:string|null; rotation_count:number };
    const rows = document.querySelector('#secret-rows') as HTMLTableSectionElement;
    const notice = document.querySelector('#notice') as HTMLElement;
    const dialog = document.querySelector('#secret-dialog') as HTMLDialogElement;
    const form = document.querySelector('#secret-form') as HTMLFormElement;
    const integrationInput = document.querySelector('#integration-id') as HTMLInputElement;
    const keyType = document.querySelector('#key-type') as HTMLSelectElement;
    const valueInput = document.querySelector('#secret-value') as HTMLTextAreaElement;
    const expiresInput = document.querySelector('#expires-at') as HTMLInputElement;
    const secretIdInput = document.querySelector('#secret-id') as HTMLInputElement;
    const summary = document.querySelector('#page-summary') as HTMLElement;
    let page = 1;
    let pages = 1;

    const showNotice = (message:string, error = false) => { notice.hidden = false; notice.textContent = message; notice.classList.toggle('gs-text-danger', error); };
    const cell = (text:string) => { const td = document.createElement('td'); td.className = 'p-3'; td.textContent = text; return td; };
    const load = async () => {
      const pageSize = 25;
      const offset = (page - 1) * pageSize;
      const query = new URLSearchParams({ offset:String(offset), limit:String(pageSize) });
      const integration = (document.querySelector('#filter-integration') as HTMLInputElement).value.trim();
      const type = (document.querySelector('#filter-type') as HTMLSelectElement).value;
      if (integration) query.set('integration_id', integration); if (type) query.set('key_type', type);
      if ((document.querySelector('#include-expired') as HTMLInputElement).checked) query.set('include_expired', 'true');
      const response = await fetch(`/api/admin/secrets?${query}`);
      const data = await response.json();
      if (!response.ok) { rows.replaceChildren(); const tr=document.createElement('tr'); tr.append(cell(data.error ?? 'Unable to load secrets.')); rows.append(tr); return; }
      rows.replaceChildren();
      for (const secret of data.items as Secret[]) {
        const tr = document.createElement('tr'); tr.className = 'border-b border-[var(--gs-color-border)]/50';
        tr.append(cell(secret.integration_id), cell(secret.key_type), cell(`${secret.key_prefix}••••`), cell(secret.expires_at ? new Date(secret.expires_at).toLocaleString() : 'Never'), cell(String(secret.rotation_count)));
        const actions = cell('');
        const rotate = document.createElement('button'); rotate.className='gs-btn-secondary px-2 py-1 mr-2'; rotate.textContent='Rotate'; rotate.addEventListener('click',()=>openRotate(secret));
        const revoke = document.createElement('button'); revoke.className='gs-btn-secondary px-2 py-1'; revoke.textContent='Revoke'; revoke.addEventListener('click',()=>revokeSecret(secret));
        actions.append(rotate,revoke); tr.append(actions); rows.append(tr);
      }
      if (!data.items.length) { const tr=document.createElement('tr'); const td=cell('No secret metadata matches this filter.'); td.colSpan=6; tr.append(td); rows.append(tr); }
      pages = data.pagination?.pages || 1;
      summary.textContent = `Page ${data.pagination?.page || 1} of ${pages} · ${data.pagination?.total || 0} secrets`;
      (document.querySelector('#previous-page') as HTMLButtonElement).disabled = page <= 1;
      (document.querySelector('#next-page') as HTMLButtonElement).disabled = page >= pages;
    };
    const openCreate = () => { form.reset(); secretIdInput.value=''; integrationInput.disabled=false; keyType.disabled=false; document.querySelector('#dialog-title')!.textContent='Create secret'; document.querySelector('#value-label')!.textContent='Secret value'; dialog.showModal(); };
    const openRotate = (secret:Secret) => { form.reset(); secretIdInput.value=secret.id; integrationInput.value=secret.integration_id; keyType.value=secret.key_type; integrationInput.disabled=true; keyType.disabled=true; document.querySelector('#dialog-title')!.textContent=`Rotate ${secret.integration_id}`; document.querySelector('#value-label')!.textContent='New secret value'; dialog.showModal(); };
    const close = () => { valueInput.value=''; dialog.close(); };
    const revokeSecret = async (secret:Secret) => { if (!confirm(`Revoke ${secret.key_type} for ${secret.integration_id}? This cannot be undone.`)) return; const response=await fetch(`/api/admin/secrets/${encodeURIComponent(secret.id)}`,{method:'DELETE'}); showNotice(response.ok?'Secret revoked.':(await response.json()).error ?? 'Revoke failed.',!response.ok); if(response.ok) await load(); };
    form.addEventListener('submit', async (event) => { event.preventDefault(); const id=secretIdInput.value; const body=id?{action:'rotate',new_value:valueInput.value}:{integration_id:integrationInput.value.trim(),key_type:keyType.value,value:valueInput.value,expires_at:expiresInput.value?new Date(expiresInput.value).toISOString():undefined}; const response=await fetch(id?`/api/admin/secrets/${encodeURIComponent(id)}`:'/api/admin/secrets',{method:id?'PATCH':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)}); valueInput.value=''; const data=response.status===204?{}:await response.json(); showNotice(response.ok?(id?'Secret rotated.':'Secret created.'):(data.error??'Save failed.'),!response.ok); if(response.ok){close();await load();} });
    document.querySelector('#new-secret')?.addEventListener('click',openCreate); document.querySelector('#close-dialog')?.addEventListener('click',close); document.querySelector('#cancel-dialog')?.addEventListener('click',close);
    document.querySelector('#apply-filter')?.addEventListener('click',()=>{page=1;load();}); document.querySelector('#previous-page')?.addEventListener('click',()=>{if(page>1){page--;load();}}); document.querySelector('#next-page')?.addEventListener('click',()=>{if(page<pages){page++;load();}});
    load().catch(()=>showNotice('The secrets API could not be reached.',true));
  </script>
</AdminLayout>
