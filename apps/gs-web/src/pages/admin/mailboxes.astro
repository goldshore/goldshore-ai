---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Mailboxes | GoldShore Admin" requiredPermission="mailboxes:read">
  <section class="gs-page gs-stack"><div><h1 class="gs-heading">Mailboxes</h1><p class="gs-text-subtle">Manage GoldShore mailbox metadata and inspect archived inbound-message headers. Routing activation remains explicitly verified.</p></div>
    <form id="mailbox-form" class="gs-card gs-grid columns-3"><label><span>Address</span><input id="address" type="email" class="gs-input" required placeholder="sales@goldshore.ai" /></label><label><span>Display name</span><input id="display-name" class="gs-input" required /></label><label><span>Forward to</span><input id="forward-to" type="email" class="gs-input" /></label><button class="gs-button">Create draft mailbox</button></form><p id="message" role="status" class="gs-text-subtle gs-text-sm"></p>
    <div class="gs-grid columns-2"><div class="gs-card"><table><thead><tr><th>Mailbox</th><th>Status</th><th>Messages</th></tr></thead><tbody id="mailboxes"><tr><td colspan="3" >Loading…</td></tr></tbody></table></div><div class="gs-card"><h2  id="inbox-title">Inbound messages</h2><table><thead><tr><th>Received</th><th>From</th><th>Subject</th><th>Status</th></tr></thead><tbody id="messages"><tr><td colspan="4" class="gs-text-subtle">Choose a mailbox.</td></tr></tbody></table></div></div>
  </section>
  <script>
    const mailboxes=document.querySelector('#mailboxes')!;const messages=document.querySelector('#messages')!;const message=document.querySelector('#message')!;const esc=(v:unknown)=>String(v??'').replace(/[&<>'"]/g,c=>({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' }[c]??c));const say=(v:string)=>message.textContent=v;
    async function request(path:string,init?:RequestInit){const response=await fetch(path.startsWith('?')?`/api/admin/mailboxes${path}`:`/api/admin/mailboxes/${path}`,init);const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error??'Request failed.');return data;}
    async function load(){try{const data=await request('?page=1&pageSize=100');mailboxes.innerHTML=data.items.length?data.items.map((m:any)=>`<tr  data-mailbox="${esc(m.id)}" data-address="${esc(m.address)}"><td><strong>${esc(m.display_name)}</strong><small>${esc(m.address)}</small><small class="gs-text-subtle">→ ${esc(m.forward_to??'No forwarding')}</small></td><td>${esc(m.status)}${m.routing_verified?' · verified':''}<select class="gs-input" data-status="${esc(m.id)}"><option value="">Change…</option><option>draft</option><option>active</option><option>paused</option><option>archived</option></select></td><td>${esc(m.message_count)}</td></tr>`).join(''):'<tr><td colspan="3" >No mailboxes configured.</td></tr>';}catch(error){say(error instanceof Error?error.message:'Load failed.');}}
    async function openInbox(id:string,address:string){try{const data=await request(`${encodeURIComponent(id)}/messages?page=1&pageSize=50`);document.querySelector('#inbox-title')!.textContent=`Inbound messages · ${address}`;messages.innerHTML=data.items.length?data.items.map((m:any)=>`<tr><td>${new Date(m.received_at).toLocaleString()}</td><td>${esc(m.envelope_from)}</td><td>${esc(m.subject)}${m.attachment_count?`<small>${esc(m.attachment_count)} attachment(s)</small>`:''}</td><td>${esc(m.status)}</td></tr>`).join(''):'<tr><td colspan="4" >No archived messages.</td></tr>';}catch(error){say(error instanceof Error?error.message:'Inbox load failed.');}}
    document.querySelector('#mailbox-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await request('',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({address:(document.querySelector('#address') as HTMLInputElement).value,displayName:(document.querySelector('#display-name') as HTMLInputElement).value,forwardTo:(document.querySelector('#forward-to') as HTMLInputElement).value})});say('Draft mailbox created. Verify Cloudflare Email Routing before activation.');(e.target as HTMLFormElement).reset();await load();}catch(error){say(error instanceof Error?error.message:'Create failed.');}});
    mailboxes.addEventListener('click',e=>{const row=(e.target as HTMLElement).closest<HTMLElement>('[data-mailbox]');if(row&&!(e.target as HTMLElement).closest('select'))openInbox(row.dataset.mailbox!,row.dataset.address!);});mailboxes.addEventListener('change',async e=>{const select=(e.target as HTMLElement).closest<HTMLSelectElement>('[data-status]');if(!select?.value)return;const active=select.value==='active';if(active&&!confirm('Activate only after verifying the live Cloudflare Email Routing rule. Continue?')){select.value='';return;}try{await request(encodeURIComponent(select.dataset.status!),{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({status:select.value,routingVerified:active?true:undefined,confirm:active})});say('Mailbox updated.');await load();}catch(error){say(error instanceof Error?error.message:'Update failed.');}});load();
  </script>
</AdminLayout>
