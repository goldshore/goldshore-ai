---
export const prerender = false;

import AdminLayout from "../../../../layouts/AdminLayout.astro";
import EmailTemplatesManager from "../../../../components/admin/EmailTemplatesManager";

const jwtToken = Astro.request.headers.get('CF-Access-JWT-Assertion') || '';
const apiBaseUrl = 'https://api.goldshore.ai/admin';

let templates = { items: [], error: null as string | null };

try {
  const res = await fetch(`${apiBaseUrl}/email/templates`, {
    headers: {
      'CF-Authorization': jwtToken,
      'Content-Type': 'application/json',
    },
  });

  if (res.ok) {
    templates = await res.json();
  } else if (res.status === 401 || res.status === 403) {
    templates.error = 'Authentication required. Please ensure you are logged in with the correct credentials.';
  }
} catch (error) {
  templates.error = error instanceof Error ? error.message : 'Failed to load templates';
}
---

<AdminLayout title="Admin | Email Templates">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="space-y-2">
      <h1 class="text-4xl gs-heading gs-text-accent">Email Templates</h1>
      <p class="text-lg gs-text-subtle">Create and manage reusable email templates for your campaigns.</p>
    </div>

    {templates.error && (
      <div class="p-4 bg-red-50 border border-red-200 rounded text-red-700 text-sm">
        {templates.error}
      </div>
    )}

    <EmailTemplatesManager client:load jwtToken={jwtToken} initialTemplates={templates} />
  </div>
</AdminLayout>
