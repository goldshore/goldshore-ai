---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { fetchAdminJson } from '../../../lib/api-proxy';

// Fetch available customers
let customers: any[] = [];
try {
  const result = await fetchAdminJson<{ customers: any[] }>(
    Astro.request,
    '/admin/customers?limit=1000'
  );
  if (result.ok && result.data) {
    customers = result.data.customers || [];
  }
} catch (error) {
  console.error('Failed to fetch customers:', error);
}
---

<AdminLayout title="Create Subscription | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="space-y-2">
      <h1 class="text-4xl gs-heading gs-text-accent">Create New Subscription</h1>
      <p class="text-lg gs-text-subtle">Assign a subscription plan to a customer</p>
    </div>

    <div class="gs-card max-w-2xl">
      <form id="createSubscriptionForm" class="space-y-6">
        <div>
          <label for="customer_id" class="block text-sm font-medium text-gray-700 mb-2">
            Customer *
          </label>
          <select
            id="customer_id"
            name="customer_id"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">-- Select a customer --</option>
            {customers.map((customer) => (
              <option value={customer.id}>{customer.name} ({customer.email})</option>
            ))}
          </select>
          <span class="text-red-500 text-sm mt-1" id="customerError"></span>
        </div>

        <div>
          <label for="plan_id" class="block text-sm font-medium text-gray-700 mb-2">
            Plan ID *
          </label>
          <input
            type="text"
            id="plan_id"
            name="plan_id"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="e.g., pro, enterprise"
          />
          <span class="text-red-500 text-sm mt-1" id="planError"></span>
        </div>

        <div>
          <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
            Status *
          </label>
          <select
            id="status"
            name="status"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="suspended">Suspended</option>
          </select>
        </div>

        <div id="successMessage" class="hidden p-4 bg-green-50 border border-green-200 rounded text-green-700">
          Subscription created successfully! Redirecting...
        </div>

        <div id="errorMessage" class="hidden p-4 bg-red-50 border border-red-200 rounded text-red-700"></div>

        <div class="flex gap-4 pt-6">
          <button
            type="submit"
            class="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 font-medium"
          >
            Create Subscription
          </button>
          <a
            href="/admin/subscriptions"
            class="px-6 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium"
          >
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>

  <script>
    document.getElementById('createSubscriptionForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const form = e.target as HTMLFormElement;
      const customer_id = (form.querySelector('#customer_id') as HTMLSelectElement).value;
      const plan_id = (form.querySelector('#plan_id') as HTMLInputElement).value.trim();
      const status = (form.querySelector('#status') as HTMLSelectElement).value;

      // Clear previous errors
      document.getElementById('customerError')!.textContent = '';
      document.getElementById('planError')!.textContent = '';
      document.getElementById('errorMessage')!.classList.add('hidden');

      // Validate
      if (!customer_id) {
        document.getElementById('customerError')!.textContent = 'Please select a customer';
        return;
      }

      if (!plan_id) {
        document.getElementById('planError')!.textContent = 'Plan ID is required';
        return;
      }

      try {
        const response = await fetch('/api/admin/subscriptions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ customer_id, plan_id, status }),
        });

        if (!response.ok) {
          const data = await response.json();
          throw new Error(data.error || 'Failed to create subscription');
        }

        document.getElementById('successMessage')!.classList.remove('hidden');
        setTimeout(() => {
          window.location.href = '/admin/subscriptions';
        }, 1500);
      } catch (error) {
        const errorMsg = error instanceof Error ? error.message : 'An error occurred';
        document.getElementById('errorMessage')!.textContent = errorMsg;
        document.getElementById('errorMessage')!.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
