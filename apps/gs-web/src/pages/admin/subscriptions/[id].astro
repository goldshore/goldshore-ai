---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { fetchAdminJson } from '../../../lib/api-proxy';

const { id } = Astro.params;

let subscriptionData: { subscription: any; customer: any; error: string | null } = {
  subscription: null,
  customer: null,
  error: null
};

try {
  const result = await fetchAdminJson<{ subscription: any }>(
    Astro.request,
    `/admin/subscriptions/${id}`
  );

  if (result.ok && result.data) {
    subscriptionData.subscription = result.data.subscription;

    // Fetch customer details
    if (result.data.subscription.customer_id) {
      const customerResult = await fetchAdminJson<{ customer: any }>(
        Astro.request,
        `/admin/customers/${result.data.subscription.customer_id}`
      );
      if (customerResult.ok && customerResult.data) {
        subscriptionData.customer = customerResult.data.customer;
      }
    }
  } else if (result.status === 404) {
    subscriptionData.error = 'Subscription not found';
  } else if (result.status === 401 || result.status === 403) {
    subscriptionData.error = 'Authentication required';
  } else if (!result.ok) {
    subscriptionData.error = `Failed to load subscription (status ${result.status})`;
  }
} catch (error) {
  subscriptionData.error = error instanceof Error ? error.message : 'Failed to load subscription';
}
---

<AdminLayout title={`Subscription | GoldShore Admin`}>
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    {subscriptionData.error ? (
      <>
        <div class="space-y-2">
          <h1 class="text-4xl gs-heading gs-text-accent">Subscription Not Found</h1>
        </div>
        <div class="p-4 bg-red-50 border border-red-200 rounded text-red-700">
          {subscriptionData.error}
        </div>
        <a href="/admin/subscriptions" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
          ← Back to Subscriptions
        </a>
      </>
    ) : (
      <>
        <div class="space-y-2">
          <h1 class="text-4xl gs-heading gs-text-accent">Subscription Details</h1>
          {subscriptionData.customer && (
            <p class="text-lg gs-text-subtle">
              Customer: <span class="font-semibold">{subscriptionData.customer.name}</span>
            </p>
          )}
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="md:col-span-2">
            <div class="gs-card space-y-6">
              <form id="updateSubscriptionForm" class="space-y-6">
                <div>
                  <label for="plan_id" class="block text-sm font-medium text-gray-700 mb-2">
                    Plan ID
                  </label>
                  <input
                    type="text"
                    id="plan_id"
                    name="plan_id"
                    value={subscriptionData.subscription?.plan_id}
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
                    Status
                  </label>
                  <select
                    id="status"
                    name="status"
                    value={subscriptionData.subscription?.status}
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  >
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="suspended">Suspended</option>
                  </select>
                </div>

                <div id="successMessage" class="hidden p-4 bg-green-50 border border-green-200 rounded text-green-700">
                  Subscription updated successfully!
                </div>

                <div id="errorMessage" class="hidden p-4 bg-red-50 border border-red-200 rounded text-red-700"></div>

                <div class="flex gap-4 pt-6">
                  <button
                    type="submit"
                    class="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 font-medium"
                  >
                    Save Changes
                  </button>
                  <a
                    href="/admin/subscriptions"
                    class="px-6 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium"
                  >
                    Back
                  </a>
                </div>
              </form>
            </div>
          </div>

          <div>
            <div class="gs-card">
              <h3 class="text-lg font-semibold mb-4">Subscription Details</h3>
              <div class="space-y-3 text-sm">
                <div>
                  <span class="text-gray-600">ID:</span>
                  <p class="font-mono text-xs mt-1 break-all">{subscriptionData.subscription?.id}</p>
                </div>
                <div>
                  <span class="text-gray-600">Customer:</span>
                  {subscriptionData.customer ? (
                    <a
                      href={`/admin/customers/${subscriptionData.customer.id}`}
                      class="text-blue-500 hover:text-blue-700 underline"
                    >
                      {subscriptionData.customer.name}
                    </a>
                  ) : (
                    <p class="font-mono text-xs">{subscriptionData.subscription?.customer_id}</p>
                  )}
                </div>
                <div>
                  <span class="text-gray-600">Created:</span>
                  <p>{new Date(subscriptionData.subscription?.created_at).toLocaleString()}</p>
                </div>
                <div>
                  <span class="text-gray-600">Last Updated:</span>
                  <p>{new Date(subscriptionData.subscription?.updated_at).toLocaleString()}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </div>

  <script define:vars={{ subscriptionId: id }}>
    document.getElementById('updateSubscriptionForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const form = e.target as HTMLFormElement;
      const plan_id = (form.querySelector('#plan_id') as HTMLInputElement).value.trim();
      const status = (form.querySelector('#status') as HTMLSelectElement).value;

      // Clear previous messages
      document.getElementById('successMessage')!.classList.add('hidden');
      document.getElementById('errorMessage')!.classList.add('hidden');

      try {
        const response = await fetch(`/api/admin/subscriptions/${subscriptionId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ plan_id, status }),
        });

        if (!response.ok) {
          const data = await response.json();
          throw new Error(data.error || 'Failed to update subscription');
        }

        document.getElementById('successMessage')!.classList.remove('hidden');
        setTimeout(() => {
          window.location.reload();
        }, 1500);
      } catch (error) {
        const errorMsg = error instanceof Error ? error.message : 'An error occurred';
        document.getElementById('errorMessage')!.textContent = errorMsg;
        document.getElementById('errorMessage')!.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
