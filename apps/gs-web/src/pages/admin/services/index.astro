---
import { env as cloudflareEnv } from 'cloudflare:workers';
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { authorizeAdminRequest, getAdminRouteRule } from '../../../utils/admin-access';

export const prerender = false;

type WorkflowSummary = {
  name: string;
  count: number;
  byStatus: Record<string, number>;
};

type WorkflowRow = {
  id: string;
  form_type: string;
  name: string | null;
  email: string | null;
  company: string | null;
  role: string | null;
  timeline: string | null;
  budget: string | null;
  goals: string | null;
  message: string | null;
  status: string;
  received_at: string;
};

const env = cloudflareEnv as Env;
const rule = getAdminRouteRule('/admin/services', 'GET');

let authError: { status: number; message: string } | null = null;
if (!rule) {
  authError = { status: 404, message: 'Not found.' };
} else {
  const authResult = await authorizeAdminRequest(Astro.request, env as never, rule);
  if (!authResult.ok) {
    authError = { status: authResult.status, message: authResult.error };
  }
}

const url = new URL(Astro.request.url);
const typeFilter = url.searchParams.get('type') ?? '';

let summary: Record<string, WorkflowSummary> = {};
let workflows: WorkflowRow[] = [];
let fetchError = '';

if (!authError) {
  try {
    const apiUrl = new URL('/api/admin/services/workflows', url.origin);
    if (typeFilter) apiUrl.searchParams.set('type', typeFilter);
    const res = await fetch(apiUrl, { headers: Astro.request.headers });
    if (res.ok) {
      const data = await res.json() as {
        success: boolean;
        workflows: WorkflowRow[];
        summary: Record<string, WorkflowSummary>;
      };
      if (data.success) {
        workflows = data.workflows;
        summary = data.summary;
      }
    } else {
      fetchError = `API error: ${res.status}`;
    }
  } catch {
    fetchError = 'Unable to reach storage.';
  }
}

const statusClass = (status: string) => {
  const map: Record<string, string> = {
    approved: 'success',
    new: 'info',
    rejected: 'error',
  };
  return map[status] ?? '';
};

const fmt = (value: string | null | undefined) =>
  value ? new Date(value).toLocaleString() : '—';
---

<AdminLayout
  title="Service Workflows | GoldShore Admin"
>
  <section class="gs-section">
    <div class="gs-grid columns-2">
      <div>
        <h1>Service workflows</h1>
        <p class="gs-text-lg">Manage inquiries and approval status across all service offerings.</p>
      </div>
      <div class="gs-card">
        <h2 class="section-title"><span>◆</span>Quick links</h2>
        <ul>
          <li><a href="/admin/products">Product catalog</a></li>
          <li><a href="/admin/lead-submissions">All lead submissions</a></li>
          <li><a href="/admin/integrations/all">Integrations</a></li>
        </ul>
      </div>
    </div>

    {authError ? (
      <div class="gs-card" style="margin-top: 2rem;">
        <p class="gs-text-lg">{authError.message}</p>
        {authError.status === 401 && (
          <p class="gs-text-sm">Sign in via Cloudflare Access to continue.</p>
        )}
      </div>
    ) : fetchError ? (
      <div class="gs-card" style="margin-top: 2rem;">
        <p class="gs-text-lg">{fetchError}</p>
      </div>
    ) : (
      <>
        {/* Summary cards */}
        <div class="gs-grid columns-2" style="margin-top: 2rem;">
          {Object.entries(summary).map(([type, data]) => (
            <div class={`gs-card${typeFilter === type ? ' gs-card--active' : ''}`}>
              <h2 class="section-title">
                <span>◆</span>{data.name}
              </h2>
              <ul>
                <li>Total: <strong>{data.count}</strong></li>
                {Object.entries(data.byStatus).map(([s, n]) => (
                  <li>
                    <span class={`gs-badge ${statusClass(s)}`}>{s}</span> {n}
                  </li>
                ))}
              </ul>
              <a class="gs-link gs-text-sm" href={`/admin/services?type=${type}`}>
                Filter →
              </a>
            </div>
          ))}
        </div>

        {/* Filter bar */}
        <div style="margin-top: 2rem; display: flex; gap: .75rem; align-items: center; flex-wrap: wrap;">
          <span class="gs-text-sm">Filter:</span>
          <a class={`gs-badge${!typeFilter ? ' success' : ' info'}`} href="/admin/services">All</a>
          {Object.entries(summary).map(([type, data]) => (
            <a
              class={`gs-badge${typeFilter === type ? ' success' : ' info'}`}
              href={`/admin/services?type=${type}`}
            >
              {data.name}
            </a>
          ))}
        </div>

        {/* Workflows table */}
        <div class="gs-card" style="margin-top: 1.5rem; overflow-x: auto;">
          <h2 class="section-title"><span>◆</span>
            {typeFilter ? `${summary[typeFilter]?.name ?? typeFilter} inquiries` : 'All inquiries'}
          </h2>

          {workflows.length === 0 ? (
            <p>No service inquiries yet.</p>
          ) : (
            <table class="gs-table" id="workflows-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Service</th>
                  <th>Timeline</th>
                  <th>Budget</th>
                  <th>Status</th>
                  <th>Received</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {workflows.map((w) => (
                  <tr data-id={w.id}>
                    <td>{w.name ?? '—'}</td>
                    <td class="gs-text-sm">{w.email ?? '—'}</td>
                    <td class="gs-text-sm">{w.form_type}</td>
                    <td class="gs-text-sm">{w.timeline ?? '—'}</td>
                    <td class="gs-text-sm">{w.budget ?? '—'}</td>
                    <td>
                      <span class={`gs-badge ${statusClass(w.status)}`} data-status={w.id}>
                        {w.status}
                      </span>
                    </td>
                    <td class="gs-text-sm">{fmt(w.received_at)}</td>
                    <td class="gs-text-sm" style="white-space: nowrap;">
                      <button
                        class="gs-link"
                        data-action="approve"
                        data-id={w.id}
                        title="Mark approved"
                      >✓ Approve</button>
                      {' · '}
                      <button
                        class="gs-link"
                        data-action="read"
                        data-id={w.id}
                        title="Mark as read"
                      >Read</button>
                      {' · '}
                      <button
                        class="gs-link"
                        data-action="reject"
                        data-id={w.id}
                        title="Mark rejected"
                      >✗ Reject</button>
                      {' · '}
                      <button
                        class="gs-link"
                        data-action="archive"
                        data-id={w.id}
                        title="Archive"
                      >Archive</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </>
    )}
  </section>

  <div id="toast" class="gs-toast" aria-live="polite"></div>

  <script>
    const STATUS_MAP: Record<string, string> = {
      approve: 'approved',
      reject: 'rejected',
      archive: 'archived',
      read: 'read',
    };

    const STATUS_CLASS: Record<string, string> = {
      approved: 'success',
      rejected: 'error',
      new: 'info',
      read: '',
      archived: '',
    };

    const toast = document.getElementById('toast');
    const showToast = (msg: string, ok = true) => {
      if (!toast) return;
      toast.textContent = msg;
      toast.className = `gs-toast ${ok ? 'gs-toast--ok' : 'gs-toast--err'}`;
      setTimeout(() => { toast.className = 'gs-toast'; }, 3000);
    };

    document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const newStatus = STATUS_MAP[btn.dataset.action ?? ''];
        if (!id || !newStatus) return;

        btn.disabled = true;
        try {
          const res = await fetch(`/api/admin/services/workflows/${encodeURIComponent(id)}`, {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ status: newStatus }),
          });

          if (res.ok) {
            const badge = document.querySelector<HTMLElement>(`[data-status="${id}"]`);
            if (badge) {
              badge.textContent = newStatus;
              badge.className = `gs-badge ${STATUS_CLASS[newStatus] ?? ''}`;
            }
            showToast(`Marked as ${newStatus}.`);
          } else {
            const err = await res.text();
            showToast(err || 'Update failed.', false);
          }
        } catch {
          showToast('Network error.', false);
        } finally {
          btn.disabled = false;
        }
      });
    });
  </script>
</AdminLayout>

<style>
  .gs-card--active {
    border-color: var(--gs-accent, #d96a32);
  }
  .gs-toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    padding: .6rem 1.2rem;
    border-radius: .5rem;
    font-size: .85rem;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s;
    z-index: 99;
  }
  .gs-toast--ok {
    background: var(--gs-success-bg, rgba(88,214,141,.15));
    color: var(--gs-success, #58d68d);
    border: 1px solid currentColor;
    opacity: 1;
  }
  .gs-toast--err {
    background: var(--gs-error-bg, rgba(255,100,100,.12));
    color: var(--gs-error, #ff7a7a);
    border: 1px solid currentColor;
    opacity: 1;
  }
</style>
