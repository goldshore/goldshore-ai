---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { GSButton } from '@goldshore/ui';
import { fetchAdminJson } from '../../lib/api-proxy';

interface ScanResult {
  id: string;
  scan_id: string;
  timestamp: string;
  status: 'completed' | 'in_progress' | 'failed';
  total_items_scanned: number;
  pii_found: number;
  categories: {
    email: number;
    phone: number;
    ssn: number;
    credit_card: number;
    api_key: number;
    other: number;
  };
  severity: 'critical' | 'high' | 'medium' | 'low';
  details?: string;
}

let scans: ScanResult[] = [];
let error: string | null = null;
let lastScanTime: string | null = null;
let totalPiiDetected = 0;

const page = Number(Astro.url.searchParams.get('page')) || 1;
const severity = Astro.url.searchParams.get('severity') || '';
const pageSize = 15;

try {
  const params = new URLSearchParams();
  params.append('page', String(page));
  params.append('limit', String(pageSize));
  if (severity) params.append('severity', severity);

  const result = await fetchAdminJson<any>(Astro.request, `/admin/pii-scans?${params}`);

  if (!result.ok) {
    error = `Failed to fetch PII scans: ${result.status}`;
  } else {
    const data = result.data;
    scans = data.data || [];
    lastScanTime = data.last_scan_time || null;
    totalPiiDetected = data.total_pii_detected || 0;
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error fetching PII scans';
}

const totalPages = Math.ceil((scans.length > 0 ? scans.length * 5 : 1) / pageSize);
const severityColors = {
  critical: 'gs-severity-critical',
  high: 'gs-severity-high',
  medium: 'gs-severity-medium',
  low: 'gs-severity-low',
};

const buildQueryString = (newParams: Record<string, string>) => {
  const params = new URLSearchParams();
  params.append('page', String(newParams.page || 1));
  if (newParams.severity) params.append('severity', newParams.severity);
  return params.toString();
};
---

<AdminLayout title="PII Scans | GoldShore Admin">
  <div class="gs-page gs-stack">
    <div class="gs-row gs-row--between gs-row--start">
      <div>
        <h1 class="gs-heading gs-text-accent">PII Scans</h1>
        <p class="gs-text-lg gs-text-subtle">Security scanning results for personally identifiable information across systems.</p>
      </div>
      <GSButton variant="secondary" href="/admin">← Back to Admin</GSButton>
    </div>

    {error && (
      <div class="gs-card">
        <p class="gs-text-danger">Error loading scans</p>
        <p class="gs-text-sm gs-text-subtle">{error}</p>
      </div>
    )}

    {!error && (
      <>
        {/* Summary Stats */}
        <div class="gs-list-grid">
          <div class="gs-card gs-stack-sm">
            <h2 class="gs-text-sm gs-text-subtle">Last Scan</h2>
            <p class="gs-text-lg gs-text-accent">
              {lastScanTime ? new Date(lastScanTime).toLocaleDateString() : 'Never'}
            </p>
            <p class="gs-text-sm gs-text-subtle">Most recent scan date</p>
          </div>

          <div class="gs-card gs-stack-sm">
            <h2 class="gs-text-sm gs-text-subtle">Total PII Found</h2>
            <p class={`gs-stat ${totalPiiDetected > 0 ? 'gs-text-critical' : 'gs-text-accent'}`}>
              {totalPiiDetected}
            </p>
            <p class="gs-text-sm gs-text-subtle">Across all scans</p>
          </div>

          <div class="gs-card gs-stack-sm">
            <h2 class="gs-text-sm gs-text-subtle">Recent Scans</h2>
            <p class="gs-stat gs-text-accent">{scans.length}</p>
            <p class="gs-text-sm gs-text-subtle">On this page</p>
          </div>

          <div class="gs-card gs-stack-sm">
            <h2 class="gs-text-sm gs-text-subtle">Status</h2>
            <p class="gs-text-lg gs-text-accent">Active</p>
            <p class="gs-text-sm gs-text-subtle">Continuous monitoring</p>
          </div>
        </div>

        {/* Filters */}
        <div class="gs-card gs-stack">
          <h2 class="gs-text-lg">Filters</h2>
          <div class="gs-row">
            <div>
              <label class="gs-text-sm gs-text-subtle">Severity</label>
              <select class="gs-text-sm"
                onchange={`window.location.href='?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), severity: this.value || '' })}'`}>
                <option value="">All severities</option>
                <option value="critical" selected={severity === 'critical'}>Critical</option>
                <option value="high" selected={severity === 'high'}>High</option>
                <option value="medium" selected={severity === 'medium'}>Medium</option>
                <option value="low" selected={severity === 'low'}>Low</option>
              </select>
            </div>
          </div>
        </div>

        {/* Scans List */}
        <div class="gs-card gs-stack">
          <h2 class="gs-text-lg">Scans ({scans.length})</h2>

          {scans.length === 0 ? (
            <p class="gs-text-subtle">No scan results available.</p>
          ) : (
            <div class="gs-stack-sm">
              {scans.map((scan) => (
                <div>
                  <div class="gs-row gs-row--between gs-row--start">
                    <div class="gs-row">
                      <span class={`gs-text-sm ${severityColors[scan.severity]}`}>
                        {scan.severity.toUpperCase()}
                      </span>
                      <span class="gs-text-sm gs-text-subtle gs-mono">
                        #{scan.scan_id}
                      </span>
                    </div>
                    <span class={`gs-badge ${
                      scan.status === 'completed' ? 'success' :
                      scan.status === 'in_progress' ? 'warning' :
                      'danger'
                    }`}>
                      {scan.status === 'completed' ? 'Completed' :
                       scan.status === 'in_progress' ? 'In Progress' :
                       'Failed'}
                    </span>
                  </div>

                  <div class="gs-list-grid">
                    <div>
                      <p class="gs-text-sm gs-text-subtle">Items Scanned</p>
                      <p>{scan.total_items_scanned}</p>
                    </div>
                    <div>
                      <p class="gs-text-sm gs-text-subtle">PII Found</p>
                      <p class="gs-text-danger">{scan.pii_found}</p>
                    </div>
                    <div>
                      <p class="gs-text-sm gs-text-subtle">Email Addresses</p>
                      <p>{scan.categories.email}</p>
                    </div>
                    <div>
                      <p class="gs-text-sm gs-text-subtle">Phone Numbers</p>
                      <p>{scan.categories.phone}</p>
                    </div>
                  </div>

                  <div class="gs-list-grid gs-text-sm">
                    <div>
                      <p class="gs-text-subtle">SSNs: <span>{scan.categories.ssn}</span></p>
                    </div>
                    <div>
                      <p class="gs-text-subtle">Cards: <span>{scan.categories.credit_card}</span></p>
                    </div>
                    <div>
                      <p class="gs-text-subtle">Keys: <span>{scan.categories.api_key}</span></p>
                    </div>
                    <div>
                      <p class="gs-text-subtle">Other: <span>{scan.categories.other}</span></p>
                    </div>
                    <div>
                      <p class="gs-text-subtle">Scanned: {new Date(scan.timestamp).toLocaleDateString()}</p>
                    </div>
                  </div>

                  {scan.details && (
                    <p class="gs-text-sm gs-text-subtle">{scan.details}</p>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <div class="gs-card gs-row">
            {page > 1 && (
              <a href={`?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), page: String(page - 1) })}`}>
                ← Previous
              </a>
            )}

            <span class="gs-text-sm gs-text-subtle">
              Page {page} of {totalPages}
            </span>

            {page < totalPages && (
              <a href={`?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), page: String(page + 1) })}`}>
                Next →
              </a>
            )}
          </div>
        )}
      </>
    )}
  </div>
</AdminLayout>

<style>
  .gs-severity-critical {
    @apply bg-red-100 text-red-700 font-semibold;
  }

  .gs-severity-high {
    @apply bg-orange-100 text-orange-700 font-semibold;
  }

  .gs-severity-medium {
    @apply bg-yellow-100 text-yellow-700 font-semibold;
  }

  .gs-severity-low {
    @apply bg-blue-100 text-blue-700 font-semibold;
  }

  .gs-text-critical {
    @apply text-red-600;
  }
</style>
