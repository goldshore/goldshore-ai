---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { fetchAdminJson } from '../../../lib/api-proxy';

const { id } = Astro.params;

let customerData: { customer: any; error: string | null } = {
  customer: null,
  error: null
};

try {
  const result = await fetchAdminJson<{ customer: any }>(
    Astro.request,
    `/admin/customers/${id}`
  );

  if (result.ok && result.data) {
    customerData.customer = result.data.customer;
  } else if (result.status === 404) {
    customerData.error = 'Customer not found';
  } else if (result.status === 401 || result.status === 403) {
    customerData.error = 'Authentication required';
  } else if (!result.ok) {
    customerData.error = `Failed to load customer (status ${result.status})`;
  }
} catch (error) {
  customerData.error = error instanceof Error ? error.message : 'Failed to load customer';
}
---

<AdminLayout title={`Customer: ${customerData.customer?.name || 'Not Found'} | GoldShore Admin`}>
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    {customerData.error ? (
      <>
        <div class="space-y-2">
          <h1 class="text-4xl gs-heading gs-text-accent">Customer Not Found</h1>
        </div>
        <div class="p-4 bg-red-50 border border-red-200 rounded text-red-700">
          {customerData.error}
        </div>
        <a href="/admin/customers" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
          ← Back to Customers
        </a>
      </>
    ) : (
      <>
        <div class="space-y-2">
          <h1 class="text-4xl gs-heading gs-text-accent">{customerData.customer?.name}</h1>
          <p class="text-lg gs-text-subtle">{customerData.customer?.email}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="md:col-span-2">
            <div class="gs-card space-y-6">
              <div>
                <h2 class="text-2xl font-semibold mb-4">Customer Information</h2>
              </div>

              <form id="updateCustomerForm" class="space-y-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                    Name
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    value={customerData.customer?.name}
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                    Email
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    value={customerData.customer?.email}
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
                    Status
                  </label>
                  <select
                    id="status"
                    name="status"
                    value={customerData.customer?.status}
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  >
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="suspended">Suspended</option>
                  </select>
                </div>

                <div>
                  <label for="notes" class="block text-sm font-medium text-gray-700 mb-2">
                    Notes
                  </label>
                  <textarea
                    id="notes"
                    name="notes"
                    rows="4"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  >
                    {customerData.customer?.notes}
                  </textarea>
                </div>

                <div id="successMessage" class="hidden p-4 bg-green-50 border border-green-200 rounded text-green-700">
                  Customer updated successfully!
                </div>

                <div id="errorMessage" class="hidden p-4 bg-red-50 border border-red-200 rounded text-red-700"></div>

                <div class="flex gap-4 pt-6">
                  <button
                    type="submit"
                    class="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 font-medium"
                  >
                    Save Changes
                  </button>
                  <a
                    href="/admin/customers"
                    class="px-6 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium"
                  >
                    Back
                  </a>
                </div>
              </form>
            </div>
          </div>

          <div>
            <div class="gs-card">
              <h3 class="text-lg font-semibold mb-4">Customer Details</h3>
              <div class="space-y-3 text-sm">
                <div>
                  <span class="text-gray-600">ID:</span>
                  <p class="font-mono text-xs mt-1 break-all">{customerData.customer?.id}</p>
                </div>
                <div>
                  <span class="text-gray-600">Created:</span>
                  <p>{new Date(customerData.customer?.created_at).toLocaleString()}</p>
                </div>
                <div>
                  <span class="text-gray-600">Last Updated:</span>
                  <p>{new Date(customerData.customer?.updated_at).toLocaleString()}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </div>

  <script define:vars={{ customerId: id }}>
    document.getElementById('updateCustomerForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const form = e.target as HTMLFormElement;
      const name = (form.querySelector('#name') as HTMLInputElement).value.trim();
      const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
      const status = (form.querySelector('#status') as HTMLSelectElement).value;
      const notes = (form.querySelector('#notes') as HTMLTextAreaElement).value.trim();

      // Clear previous messages
      document.getElementById('successMessage')!.classList.add('hidden');
      document.getElementById('errorMessage')!.classList.add('hidden');

      try {
        const response = await fetch(`/api/admin/customers/${customerId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ name, email, status, notes: notes || undefined }),
        });

        if (!response.ok) {
          const data = await response.json();
          throw new Error(data.error || 'Failed to update customer');
        }

        document.getElementById('successMessage')!.classList.remove('hidden');
        setTimeout(() => {
          window.location.reload();
        }, 1500);
      } catch (error) {
        const errorMsg = error instanceof Error ? error.message : 'An error occurred';
        document.getElementById('errorMessage')!.textContent = errorMsg;
        document.getElementById('errorMessage')!.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
