---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Email Audiences | GoldShore Admin" requiredPermission="email_subscribers:read">
  <section class="gs-page gs-stack">
    <div><p class="gs-text-subtle gs-text-sm">Consent-aware audience operations</p><h1 class="gs-heading">Email audiences</h1><p class="gs-text-subtle">Manage lists and subscription lifecycle without exposing confirmation or unsubscribe tokens.</p></div>
    <div class="gs-grid columns-2">
      <form id="list-form" class="gs-card gs-grid columns-2"><h2>Create list</h2><input id="list-id" class="gs-input" required placeholder="product-updates" /><input id="list-description" class="gs-input" maxlength="500" placeholder="List purpose and consent context" /><button class="gs-button">Create list</button></form>
      <form id="subscriber-form" class="gs-card gs-grid columns-2"><h2>Add pending subscriber</h2><input id="subscriber-email" class="gs-input" type="email" required placeholder="person@example.com" /><input id="subscriber-name" class="gs-input" placeholder="Name" /><select id="subscriber-list" class="gs-input"></select><input id="consent-basis" class="gs-input" required placeholder="documented_event_or_request" /><button class="gs-button">Add pending subscriber</button></form>
    </div>
    <p id="message" role="status" class="gs-text-subtle gs-text-sm"></p>
    <div class="gs-card"><h2>Lists</h2><div id="lists" class="gs-grid columns-3"><p>Loading…</p></div></div>
    <div class="gs-card"><div class="gs-row gs-row--between"><div class="gs-row"><select id="status-filter" class="gs-input"><option value="">All statuses</option><option>pending</option><option>confirmed</option><option>unsubscribed</option><option>suppressed</option><option>invalid</option></select><select id="list-filter" class="gs-input"><option value="">All lists</option></select></div><a id="export" class="gs-button gs-button--secondary" href="/api/admin/audiences/subscribers?format=csv">Export CSV</a></div><table><thead><tr><th>Email</th><th>List</th><th>Status</th><th>Consent</th><th>Subscribed</th><th>Actions</th></tr></thead><tbody id="subscribers"><tr><td colspan="6" >Loading…</td></tr></tbody></table><div class="gs-row gs-row--between"><button id="previous" class="gs-button gs-button--secondary">Previous</button><span id="page-label"></span><button id="next" class="gs-button gs-button--secondary">Next</button></div></div>
  </section>
  <script>
    const listsEl=document.querySelector('#lists')!;const subscribers=document.querySelector('#subscribers')!;const message=document.querySelector('#message')!;let page=1,pages=1,lists:any[]=[];const esc=(v:unknown)=>String(v??'').replace(/[&<>'"]/g,c=>({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' }[c]??c));const say=(v:string)=>message.textContent=v;
    async function request(path:string,init?:RequestInit){const response=await fetch(`/api/admin/audiences/${path}`,init);const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error??'Request failed.');return data;}
    async function loadLists(){const data=await request('lists');lists=data.items;listsEl.innerHTML=lists.map((l:any)=>`<article><strong>${esc(l.name)}</strong><span>${esc(l.status)}</span><p class="gs-text-subtle gs-text-sm">${esc(l.description)}</p><small>${esc(l.confirmed_count??0)} confirmed / ${esc(l.subscriber_count??0)} total</small></article>`).join('')||'<p>No lists.</p>';const options=lists.filter(l=>l.status==='active').map(l=>`<option value="${esc(l.name)}">${esc(l.brand)} / ${esc(l.name)}</option>`).join('');(document.querySelector('#subscriber-list') as HTMLSelectElement).innerHTML=options;(document.querySelector('#list-filter') as HTMLSelectElement).innerHTML='<option value="">All lists</option>'+lists.map(l=>`<option value="${esc(l.name)}">${esc(l.name)}</option>`).join('');}
    async function loadSubscribers(){try{const status=(document.querySelector('#status-filter') as HTMLSelectElement).value;const list=(document.querySelector('#list-filter') as HTMLSelectElement).value;const query=new URLSearchParams({page:String(page),pageSize:'25'});if(status)query.set('status',status);if(list)query.set('list',list);const data=await request(`subscribers?${query}`);pages=data.pagination.pages;subscribers.innerHTML=data.items.length?data.items.map((s:any)=>`<tr><td><strong>${esc(s.name??'Subscriber')}</strong><small>${esc(s.email)}</small></td><td>${esc(s.brand)}/${esc(s.list_name)}</td><td>${esc(s.status)}</td><td>${esc(s.consent_basis)}<small>${esc(s.source)}</small></td><td>${new Date(s.subscribed_at).toLocaleString()}</td><td><select class="gs-input" data-status-for="${esc(s.id)}"><option value="">Change…</option><option>confirmed</option><option>unsubscribed</option><option>suppressed</option><option>invalid</option></select></td></tr>`).join(''):'<tr><td colspan="6" >No matching subscribers.</td></tr>';document.querySelector('#page-label')!.textContent=`Page ${page} of ${pages}`;(document.querySelector('#previous') as HTMLButtonElement).disabled=page<=1;(document.querySelector('#next') as HTMLButtonElement).disabled=page>=pages;const exportQuery=new URLSearchParams({format:'csv'});if(status)exportQuery.set('status',status);if(list)exportQuery.set('list',list);(document.querySelector('#export') as HTMLAnchorElement).href=`/api/admin/audiences/subscribers?${exportQuery}`;}catch(error){say(error instanceof Error?error.message:'Load failed.');}}
    document.querySelector('#list-form')?.addEventListener('submit',async e=>{e.preventDefault();const id=(document.querySelector('#list-id') as HTMLInputElement).value.trim();try{await request('lists',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({id,name:id,brand:'goldshore',description:(document.querySelector('#list-description') as HTMLInputElement).value})});say('List created.');(e.target as HTMLFormElement).reset();await loadLists();}catch(error){say(error instanceof Error?error.message:'Create failed.');}});
    document.querySelector('#subscriber-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await request('subscribers',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({email:(document.querySelector('#subscriber-email') as HTMLInputElement).value,name:(document.querySelector('#subscriber-name') as HTMLInputElement).value,listName:(document.querySelector('#subscriber-list') as HTMLSelectElement).value,brand:'goldshore',consentBasis:(document.querySelector('#consent-basis') as HTMLInputElement).value})});say('Pending subscriber added. Confirmation is still required.');(e.target as HTMLFormElement).reset();await loadSubscribers();}catch(error){say(error instanceof Error?error.message:'Add failed.');}});
    subscribers.addEventListener('change',async e=>{const select=(e.target as HTMLElement).closest<HTMLSelectElement>('[data-status-for]');if(!select?.value)return;const highImpact=['confirmed','suppressed'].includes(select.value);if(highImpact&&!confirm(`Set subscriber status to ${select.value}?`)){select.value='';return;}try{await request(`subscribers/${encodeURIComponent(select.dataset.statusFor!)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({status:select.value,confirm:highImpact})});say('Subscriber status updated.');await loadSubscribers();}catch(error){say(error instanceof Error?error.message:'Update failed.');}});
    document.querySelector('#status-filter')?.addEventListener('change',()=>{page=1;loadSubscribers();});document.querySelector('#list-filter')?.addEventListener('change',()=>{page=1;loadSubscribers();});document.querySelector('#previous')?.addEventListener('click',()=>{if(page>1){page--;loadSubscribers();}});document.querySelector('#next')?.addEventListener('click',()=>{if(page<pages){page++;loadSubscribers();}});loadLists().then(loadSubscribers).catch(error=>say(error.message));
  </script>
</AdminLayout>
