---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { fetchAdminJson } from '../../lib/api-proxy';

const offset = parseInt(Astro.url.searchParams.get('offset') || '0');
const limit = parseInt(Astro.url.searchParams.get('limit') || '25');
const customerId = Astro.url.searchParams.get('customer_id') || '';

let subscriptionsData: { subscriptions: any[]; total: number; offset: number; limit: number; error: string | null } = {
  subscriptions: [],
  total: 0,
  offset,
  limit,
  error: null
};

try {
  const params = new URLSearchParams({
    offset: String(offset),
    limit: String(limit),
    ...(customerId && { customer_id: customerId })
  });

  const result = await fetchAdminJson<{ subscriptions: any[]; total: number }>(
    Astro.request,
    `/admin/subscriptions?${params}`
  );

  if (result.ok && result.data) {
    subscriptionsData = { ...subscriptionsData, ...result.data };
  } else if (result.status === 401 || result.status === 403) {
    subscriptionsData.error = 'Authentication required. Please ensure you are logged in with the correct credentials.';
  } else if (!result.ok) {
    subscriptionsData.error = `Failed to load subscriptions (status ${result.status}).`;
  }
} catch (error) {
  subscriptionsData.error = error instanceof Error ? error.message : 'Failed to load subscriptions';
}
---

<AdminLayout title="Subscriptions | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="space-y-2">
      <h1 class="text-4xl gs-heading gs-text-accent">Subscriptions</h1>
      <p class="text-lg gs-text-subtle">Manage customer subscription plans and billing</p>
    </div>

    {subscriptionsData.error && (
      <div class="p-4 bg-red-50 border border-red-200 rounded text-red-700 text-sm mb-4">
        {subscriptionsData.error}
      </div>
    )}

    <div class="gs-card space-y-6">
      <div class="flex justify-between items-center">
        <h2 class="text-2xl font-semibold">All Subscriptions</h2>
        <a href="/admin/subscriptions/new" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
          + Create New Subscription
        </a>
      </div>

      {subscriptionsData.subscriptions.length === 0 ? (
        <p class="text-gray-500">No subscriptions found</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b">
              <tr>
                <th class="text-left py-3 px-4 font-semibold">Customer ID</th>
                <th class="text-left py-3 px-4 font-semibold">Plan ID</th>
                <th class="text-left py-3 px-4 font-semibold">Status</th>
                <th class="text-left py-3 px-4 font-semibold">Created</th>
                <th class="text-left py-3 px-4 font-semibold">Actions</th>
              </tr>
            </thead>
            <tbody>
              {subscriptionsData.subscriptions.map((subscription: any) => (
                <tr class="border-b hover:bg-gray-50">
                  <td class="py-3 px-4 font-mono text-xs">{subscription.customer_id.slice(0, 8)}...</td>
                  <td class="py-3 px-4">{subscription.plan_id}</td>
                  <td class="py-3 px-4">
                    <span class={`px-2 py-1 rounded text-xs font-medium ${
                      subscription.status === 'active'
                        ? 'bg-green-100 text-green-800'
                        : 'bg-yellow-100 text-yellow-800'
                    }`}>
                      {subscription.status}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-gray-600">
                    {new Date(subscription.created_at).toLocaleDateString()}
                  </td>
                  <td class="py-3 px-4">
                    <a href={`/admin/subscriptions/${subscription.id}`} class="text-blue-500 hover:text-blue-700 underline">
                      View
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {subscriptionsData.subscriptions.length > 0 && (
        <div class="flex justify-between items-center pt-4">
          <div class="text-sm text-gray-600">
            Showing {offset + 1} to {Math.min(offset + limit, subscriptionsData.total)} of {subscriptionsData.total}
          </div>
          <div class="space-x-2">
            {offset > 0 && (
              <a
                href={`/admin/subscriptions?offset=${offset - limit}&limit=${limit}`}
                class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300"
              >
                ← Previous
              </a>
            )}
            {offset + limit < subscriptionsData.total && (
              <a
                href={`/admin/subscriptions?offset=${offset + limit}&limit=${limit}`}
                class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300"
              >
                Next →
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
