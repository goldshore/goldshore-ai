---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { fetchAdminJson } from '../../lib/api-proxy';

const offset = parseInt(Astro.url.searchParams.get('offset') || '0');
const limit = parseInt(Astro.url.searchParams.get('limit') || '25');
const customerId = Astro.url.searchParams.get('customer_id') || '';

let subscriptionsData: { subscriptions: any[]; total: number; offset: number; limit: number; error: string | null } = {
  subscriptions: [],
  total: 0,
  offset,
  limit,
  error: null
};

try {
  const params = new URLSearchParams({
    offset: String(offset),
    limit: String(limit),
    ...(customerId && { customer_id: customerId })
  });

  const result = await fetchAdminJson<{ subscriptions: any[]; total: number }>(
    Astro.request,
    `/admin/subscriptions?${params}`
  );

  if (result.ok && result.data) {
    subscriptionsData = { ...subscriptionsData, ...result.data };
  } else if (result.status === 401 || result.status === 403) {
    subscriptionsData.error = 'Authentication required. Please ensure you are logged in with the correct credentials.';
  } else if (!result.ok) {
    subscriptionsData.error = `Failed to load subscriptions (status ${result.status}).`;
  }
} catch (error) {
  subscriptionsData.error = error instanceof Error ? error.message : 'Failed to load subscriptions';
}
---

<AdminLayout title="Subscriptions | GoldShore Admin">
  <div class="gs-page gs-stack">
    <div class="gs-stack-sm">
      <h1 class="gs-heading gs-text-accent">Subscriptions</h1>
      <p class="gs-text-subtle gs-text-lg">Manage customer subscription plans and billing</p>
    </div>

    {subscriptionsData.error && (
      <div class="gs-alert gs-alert--error gs-text-sm">
        {subscriptionsData.error}
      </div>
    )}

    <div class="gs-card gs-stack">
      <div class="gs-row gs-row--between">
        <h2>All Subscriptions</h2>
        <a href="/admin/subscriptions/new" class="gs-button">
          + Create New Subscription
        </a>
      </div>

      {subscriptionsData.subscriptions.length === 0 ? (
        <p class="gs-text-subtle">No subscriptions found</p>
      ) : (
        <div>
          <table class="gs-text-sm">
            <thead>
              <tr>
                <th>Customer ID</th>
                <th>Plan ID</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {subscriptionsData.subscriptions.map((subscription: any) => (
                <tr>
                  <td class="gs-mono">{subscription.customer_id.slice(0, 8)}...</td>
                  <td>{subscription.plan_id}</td>
                  <td>
                    <span class={`gs-badge ${
                      subscription.status === 'active' ? 'success' : 'warning'
                    }`}>
                      {subscription.status}
                    </span>
                  </td>
                  <td class="gs-text-subtle">
                    {new Date(subscription.created_at).toLocaleDateString()}
                  </td>
                  <td>
                    <a href={`/admin/subscriptions/${subscription.id}`} >
                      View
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {subscriptionsData.subscriptions.length > 0 && (
        <div class="gs-row gs-row--between">
          <div class="gs-text-sm gs-text-subtle">
            Showing {offset + 1} to {Math.min(offset + limit, subscriptionsData.total)} of {subscriptionsData.total}
          </div>
          <div>
            {offset > 0 && (
              <a
                href={`/admin/subscriptions?offset=${offset - limit}&limit=${limit}`}
                class="gs-button gs-button--secondary"
              >
                ← Previous
              </a>
            )}
            {offset + limit < subscriptionsData.total && (
              <a
                href={`/admin/subscriptions?offset=${offset + limit}&limit=${limit}`}
                class="gs-button gs-button--secondary"
              >
                Next →
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
