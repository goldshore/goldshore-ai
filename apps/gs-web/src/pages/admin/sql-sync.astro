---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="HostGator SQL Sync | GoldShore Admin" requiredPermission="system:read">
  <section class="max-w-7xl mx-auto py-24 px-6 space-y-6"><div><p class="text-sm gs-text-subtle">Guarded database operations</p><h1 class="text-3xl gs-heading">HostGator SQL Sync</h1><p class="gs-text-subtle mt-2">Analyze, approve, and execute versioned MySQL plans through a server-only Cloudflare Hyperdrive binding.</p></div>
    <div id="readiness" class="gs-card">Checking Hyperdrive readiness…</div><p id="message" class="text-sm gs-text-subtle" role="status"></p>
    <div class="grid lg:grid-cols-2 gap-6"><form id="profile-form" class="gs-card grid gap-3"><h2 class="text-xl">Database profile</h2><input id="profile-id" class="gs-input" required placeholder="hostgator-goldshore" /><input id="profile-name" class="gs-input" required placeholder="GoldShore HostGator MySQL" /><input id="database-name" class="gs-input" required placeholder="database_name" /><select id="environment" class="gs-input"><option>staging</option><option>production</option></select><textarea id="profile-notes" class="gs-input" rows="3" placeholder="Ownership and recovery notes"></textarea><button class="gs-btn-primary px-4 py-2">Create profile</button></form>
      <form id="plan-form" class="gs-card grid gap-3"><h2 class="text-xl">New SQL plan</h2><select id="plan-profile" class="gs-input" required></select><input id="plan-name" class="gs-input" required placeholder="Add customer indexes" /><textarea id="sql" class="gs-input font-mono text-sm" rows="12" required placeholder="ALTER TABLE customers ADD INDEX idx_email (email);"></textarea><button class="gs-btn-primary px-4 py-2">Analyze and save draft</button></form></div>
    <div class="gs-card overflow-x-auto"><h2 class="text-xl mb-3">Plans</h2><table class="w-full text-left"><thead><tr><th>Plan</th><th>Profile</th><th>Risk</th><th>Status</th><th>Checksum</th><th>Actions</th></tr></thead><tbody id="plans"><tr><td colspan="6" class="py-4">Loading…</td></tr></tbody></table></div>
  </section>
  <script>
    const readiness=document.querySelector('#readiness')!;const plans=document.querySelector('#plans')!;const message=document.querySelector('#message')!;let profiles:any[]=[];const esc=(v:unknown)=>String(v??'').replace(/[&<>'"]/g,c=>({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' }[c]??c));const say=(v:string)=>message.textContent=v;
    async function request(path:string,init?:RequestInit){const response=await fetch(`/api/admin/sql-sync/${path}`,init);const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error??'Request failed.');return data;}
    async function load(){try{const [ready,profileData,planData]=await Promise.all([request('readiness'),request('profiles'),request('plans')]);profiles=profileData.items;readiness.innerHTML=`<div class="flex justify-between"><div><strong>${ready.ready?'Hyperdrive ready':'Setup required'}</strong><p class="text-sm gs-text-subtle">${esc(ready.note)}</p></div><span class="gs-badge">${esc(ready.binding)} · ${esc(ready.driver)}</span></div>`;(document.querySelector('#plan-profile') as HTMLSelectElement).innerHTML=profiles.map(p=>`<option value="${esc(p.id)}">${esc(p.name)} · ${esc(p.environment)}</option>`).join('');plans.innerHTML=planData.items.length?planData.items.map((p:any)=>`<tr class="border-t"><td class="py-3"><strong>${esc(p.name)}</strong><small class="block">${new Date(p.created_at).toLocaleString()}</small></td><td>${esc(p.profile_id)}</td><td>read ${esc(p.analysis.counts.read)} · data ${esc(p.analysis.counts.data)} · schema ${esc(p.analysis.counts.schema)} · destructive ${esc(p.analysis.counts.destructive)}</td><td>${esc(p.status)}</td><td><code>${esc(p.checksum.slice(0,12))}…</code></td><td>${p.status==='draft'?`<button class="gs-btn-secondary px-2" data-approve="${esc(p.id)}" data-checksum="${esc(p.checksum)}" data-destructive="${p.analysis.destructive}">Approve</button>`:''}${p.status==='approved'?`<button class="gs-btn-primary px-2" data-execute="${esc(p.id)}" data-checksum="${esc(p.checksum)}">Execute</button>`:''}</td></tr>`).join(''):'<tr><td colspan="6" class="py-4">No SQL plans.</td></tr>';}catch(error){say(error instanceof Error?error.message:'Load failed.');}}
    document.querySelector('#profile-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await request('profiles',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({id:(document.querySelector('#profile-id') as HTMLInputElement).value,name:(document.querySelector('#profile-name') as HTMLInputElement).value,databaseName:(document.querySelector('#database-name') as HTMLInputElement).value,environment:(document.querySelector('#environment') as HTMLSelectElement).value,notes:(document.querySelector('#profile-notes') as HTMLTextAreaElement).value})});say('Profile created. Credentials were not collected or stored.');(e.target as HTMLFormElement).reset();await load();}catch(error){say(error instanceof Error?error.message:'Create failed.');}});
    document.querySelector('#plan-form')?.addEventListener('submit',async e=>{e.preventDefault();try{const data=await request('plans',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({profileId:(document.querySelector('#plan-profile') as HTMLSelectElement).value,name:(document.querySelector('#plan-name') as HTMLInputElement).value,sql:(document.querySelector('#sql') as HTMLTextAreaElement).value})});say(`Draft analyzed: ${data.analysis.statements.length} statement(s), checksum ${data.checksum.slice(0,12)}…`);(e.target as HTMLFormElement).reset();await load();}catch(error){say(error instanceof Error?error.message:'Analysis failed.');}});
    plans.addEventListener('click',async e=>{const target=e.target as HTMLElement;const approve=target.closest<HTMLButtonElement>('[data-approve]');if(approve){const destructive=approve.dataset.destructive==='true';const phrase=destructive?prompt('Type DELETE HOSTGATOR DATA to approve destructive SQL.')??'':'';if(!destructive&&!confirm('Approve this exact checksummed SQL plan?'))return;try{await request(`plans/${encodeURIComponent(approve.dataset.approve!)}/approve`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({checksum:approve.dataset.checksum,confirmPhrase:phrase})});say('Plan approved.');await load();}catch(error){say(error instanceof Error?error.message:'Approval failed.');}return;}const execute=target.closest<HTMLButtonElement>('[data-execute]');if(!execute)return;const phrase=prompt('Type EXECUTE APPROVED SQL to run this exact checksummed plan through Hyperdrive.');if(phrase!=='EXECUTE APPROVED SQL')return;try{const data=await request(`plans/${encodeURIComponent(execute.dataset.execute!)}/execute`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({checksum:execute.dataset.checksum,confirmPhrase:phrase})});say(`SQL completed: ${data.result.statements.length} statement(s).`);await load();}catch(error){say(error instanceof Error?error.message:'Execution refused or failed.');}});load();
  </script>
</AdminLayout>
