---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import TokensManager from "../../../components/admin/TokensManager";
import { fetchAdminJson } from "../../../lib/api-proxy";

const jwtToken = Astro.request.headers.get('CF-Access-JWT-Assertion') || '';

let tokens = { items: [], total: 0, error: null as string | null };

try {
  const result = await fetchAdminJson<{ items: any[]; total: number }>(Astro.request, '/admin/tokens');

  if (result.ok && result.data) {
    tokens = { ...tokens, ...result.data };
  } else if (result.status === 401 || result.status === 403) {
    tokens.error = 'Authentication required. Please ensure you are logged in with the correct credentials.';
  } else if (result.status === 503) {
    tokens.error = 'Admin API is temporarily unavailable.';
  } else {
    tokens.error = `Failed to load tokens (${result.status}).`;
  }
} catch (error) {
  tokens.error = error instanceof Error ? error.message : 'Failed to load tokens';
}
---

<AdminLayout title="Admin | API Tokens">
  <div class="gs-page gs-stack">
    <div class="gs-stack-sm">
      <h1 class="gs-heading gs-text-accent">API Tokens</h1>
      <p class="gs-text-subtle gs-text-lg">Generate and manage API tokens for programmatic access to your account.</p>
    </div>

    {tokens.error && (
      <div class="gs-alert gs-alert--error gs-text-sm">
        {tokens.error}
      </div>
    )}

    <TokensManager client:load jwtToken={jwtToken} initialTokens={tokens.items || []} />
  </div>
</AdminLayout>
