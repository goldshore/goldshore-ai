---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import SecretsManager from "../../../components/admin/SecretsManager";

const jwtToken = Astro.request.headers.get('CF-Authorization') || '';
const apiBaseUrl = 'https://api.goldshore.ai/admin';

let secrets = { items: [], total: 0, error: null as string | null };

try {
  const res = await fetch(`${apiBaseUrl}/secrets`, {
    headers: {
      'CF-Authorization': jwtToken,
      'Content-Type': 'application/json',
    },
  });

  if (res.ok) {
    secrets = await res.json();
  } else if (res.status === 401 || res.status === 403) {
    secrets.error = 'Authentication required. Please ensure you are logged in with the correct credentials.';
  } else if (res.status === 503) {
    secrets.error = 'Admin API is temporarily unavailable.';
  }
} catch (error) {
  secrets.error = error instanceof Error ? error.message : 'Failed to load secrets';
}
---

<AdminLayout title="Admin | Secrets Management">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="space-y-2">
      <h1 class="text-4xl gs-heading gs-text-accent">Manage Secrets</h1>
      <p class="text-lg gs-text-subtle">Create, rotate, and manage encrypted secrets for your integrations.</p>
    </div>

    {secrets.error && (
      <div class="p-4 bg-red-50 border border-red-200 rounded text-red-700 text-sm">
        {secrets.error}
      </div>
    )}

    <SecretsManager client:load jwtToken={jwtToken} initialSecrets={secrets.items || []} />
  </div>
</AdminLayout>
