---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import SecretsManager from "../../../components/admin/SecretsManager";
import { fetchAdminJson } from "../../../lib/api-proxy";

const jwtToken = Astro.request.headers.get('CF-Access-JWT-Assertion') || '';

let secrets: { items: any[]; total: number; error: string | null } = { items: [], total: 0, error: null };

try {
  const result = await fetchAdminJson<{ items: any[]; pagination: { total: number } }>(
    Astro.request,
    '/admin/secrets',
  );

  if (result.ok && result.data) {
    secrets = { items: result.data.items || [], total: result.data.pagination?.total ?? 0, error: null };
  } else if (result.status === 401 || result.status === 403) {
    secrets.error = 'Authentication required. Please ensure you are logged in with the correct credentials.';
  } else if (result.status === 503) {
    secrets.error = 'Admin API is temporarily unavailable.';
  } else if (!result.ok) {
    // Any other non-ok status (e.g. 500) was previously left as error: null,
    // silently rendering as an empty "No secrets found" state instead of
    // surfacing the real failure.
    secrets.error = `Failed to load secrets (status ${result.status}).`;
  }
} catch (error) {
  secrets.error = error instanceof Error ? error.message : 'Failed to load secrets';
}
---

<AdminLayout title="Admin | Secrets Management">
  <div class="gs-page gs-stack">
    <div class="gs-stack-sm">
      <h1 class="gs-heading gs-text-accent">Manage Secrets</h1>
      <p class="gs-text-subtle gs-text-lg">Create, rotate, and manage encrypted secrets for your integrations.</p>
    </div>

    {secrets.error && (
      <div class="gs-alert gs-alert--error gs-text-sm">
        {secrets.error}
      </div>
    )}

    <SecretsManager client:load jwtToken={jwtToken} initialSecrets={secrets.items || []} />
  </div>
</AdminLayout>
