---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Integrations | GoldShore Admin" requiredPermission="system:read">
  <main class="hub">
    <header><p class="eyebrow">Operations</p><h1>Integrations Hub</h1><p>Provider inventory, health, and secure setup routes. Credentials are created only in encrypted secret storage.</p></header>
    <section class="metrics"><article><b id="total">—</b><span>Total</span></article><article><b id="connected">—</b><span>Connected</span></article><article><b id="attention">—</b><span>Needs attention</span></article><article><b id="errors">—</b><span>Errors</span></article></section>
    <section class="panel"><div class="head"><div><h2>Connected integrations</h2><p>Registry status is redacted before it reaches this page.</p></div><button id="sync" type="button">Sync all</button></div><p id="message" role="status"></p><div id="connected-list">Loading…</div></section>
    <section class="panel"><h2>Provider catalog</h2><p>Choose the purpose-built controller for each provider instead of entering keys into a generic form.</p><div id="catalog" class="catalog">Loading…</div></section>
    <section class="routes"><a href="/admin/ads"><b>Ad Integrator</b><span>Google and Meta account readiness and reporting</span></a><a href="/admin/system/secrets"><b>Secrets</b><span>Encrypted keys, OAuth tokens, rotation, and expiry</span></a><a href="/admin/workflows"><b>API Workflows</b><span>Approved collection and automation jobs</span></a><a href="/admin/customer-email"><b>Customer Email</b><span>Templates, queues, and delivery operations</span></a></section>
  </main>
  <script is:inline>
    const esc=(v)=>String(v??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const target=(id)=>['google_ads','facebook_pixel'].includes(id)?'/admin/ads':id==='whatsapp'?'/admin/customer-email':id==='zapier'||id==='custom'?'/admin/workflows':'/admin/system/secrets';
    const api=async(action,options)=>{const response=await fetch(`/api/admin/integrations?action=${action}`,{credentials:'same-origin',headers:{accept:'application/json',...(options?.body?{'content-type':'application/json'}:{})},...options});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||`Request failed (${response.status})`);return data.data;};
    async function load(){const data=await api('list');document.getElementById('total').textContent=data.totalIntegrations;document.getElementById('connected').textContent=data.connected;document.getElementById('attention').textContent=data.disconnected;document.getElementById('errors').textContent=data.errors;const entries=Object.entries(data.integrations||{});document.getElementById('connected-list').innerHTML=entries.length?entries.map(([name,item])=>`<article class="entry"><div><b>${esc(name)}</b><span>${esc(item.provider)} · ${esc(item.status)} · ${item.lastSync?esc(new Date(item.lastSync).toLocaleString()):'never synced'}</span>${item.error?`<small>${esc(item.error)}</small>`:''}</div><button data-delete="${esc(name)}">Remove</button></article>`).join(''):'<p>No registry integrations are configured.</p>';}
    async function catalog(){const data=await api('definitions');document.getElementById('catalog').innerHTML=Object.values(data).map((item)=>`<article><h3>${esc(item.name)}</h3><p>${esc(item.description)}</p><small>Requires: ${item.requiredFields.map(esc).join(', ')}</small><a href="${target(item.id)}">Configure securely →</a></article>`).join('');}
    document.getElementById('sync').onclick=async(event)=>{const button=event.currentTarget;button.disabled=true;document.getElementById('message').textContent='Syncing integrations…';try{await api('sync');document.getElementById('message').textContent='Sync completed.';await load();}catch(error){document.getElementById('message').textContent=error.message;}finally{button.disabled=false;}};
    document.getElementById('connected-list').onclick=async(event)=>{const button=event.target.closest('[data-delete]');if(!button||!confirm(`Remove integration ${button.dataset.delete}?`))return;try{await api('',{method:'POST',body:JSON.stringify({action:'delete',config:{name:button.dataset.delete}})});await load();}catch(error){document.getElementById('message').textContent=error.message;}};
    Promise.all([load(),catalog()]).catch((error)=>document.getElementById('message').textContent=error.message);
  </script>
</AdminLayout>
<style>
  .hub{max-width:78rem;margin:auto;padding:2rem;display:grid;gap:1.5rem}.eyebrow{color:#d96a32;font-weight:800;text-transform:uppercase;letter-spacing:.12em}h1{font-size:2.5rem;margin:.2rem 0}.metrics,.routes{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.metrics article,.panel,.routes a,.catalog article{border:1px solid rgba(255,255,255,.14);border-radius:1rem;background:rgba(255,255,255,.04);padding:1.2rem}.metrics b{font-size:2rem;display:block}.metrics span,.entry span,.entry small,.routes span,.catalog small{display:block;opacity:.72;margin-top:.35rem}.head,.entry{display:flex;justify-content:space-between;align-items:center;gap:1rem}.entry{padding:1rem 0;border-bottom:1px solid rgba(255,255,255,.1)}button{border:1px solid rgba(255,255,255,.2);border-radius:.65rem;padding:.65rem .9rem;background:#101014;color:inherit;cursor:pointer}.catalog{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1rem}.catalog a{display:block;margin-top:1rem;color:#f5b75c}.routes a{color:inherit;text-decoration:none}.routes a:hover{border-color:#d96a32}@media(max-width:850px){.metrics,.routes,.catalog{grid-template-columns:1fr 1fr}}@media(max-width:560px){.metrics,.routes,.catalog{grid-template-columns:1fr}.head,.entry{align-items:flex-start;flex-direction:column}}
</style>
