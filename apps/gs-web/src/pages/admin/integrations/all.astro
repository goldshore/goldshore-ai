---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";

const apiBase = (import.meta.env.PUBLIC_API || 'https://api.goldshore.ai').replace(/\/$/, '');
---

<AdminLayout
  title="Integrations | GoldShore Admin"
>
  <div class="integrations-page" data-api-base={apiBase}>

  <div class="integrations-shell">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl gs-heading gs-text-accent">Integrations Hub</h1>
        <p class="text-lg gs-text-subtle mt-2">Connect and manage all business tools and APIs</p>
      </div>
      <div class="flex gap-3">
        <button class="gs-admin-button gs-admin-button--secondary" id="sync-all" type="button">Sync All</button>
        <button class="gs-admin-button gs-admin-button--primary" id="add-integration" type="button">Add Integration</button>
      </div>
    </div>

    <div class="grid md:grid-cols-4 gap-6">
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Total Integrations</h2>
        <p id="total-integrations" class="text-3xl font-bold gs-text-info">0</p>
        <p class="text-xs gs-text-subtle">Connected services</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Connected</h2>
        <p id="connected-count" class="text-3xl font-bold gs-text-success">0</p>
        <p class="text-xs gs-text-subtle">Active connections</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Disconnected</h2>
        <p id="disconnected-count" class="text-3xl font-bold gs-text-warning">0</p>
        <p class="text-xs gs-text-subtle">Needs attention</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-sm font-semibold gs-text-subtle">Errors</h2>
        <p id="error-count" class="text-3xl font-bold gs-text-danger">0</p>
        <p class="text-xs gs-text-subtle">Failed connections</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">Connected Integrations</h2>
      <div id="integrations-loading" class="py-8 text-center">
        <p class="gs-text-subtle">Loading integrations...</p>
      </div>

      <div id="integrations-list" class="grid gap-4 md:grid-cols-2" style="display: none;">
      </div>

      <div id="integrations-empty" class="py-8 text-center gs-empty-state" style="display: none;">
        <p>No integrations yet. Click "Add Integration" to get started.</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">Available Integrations</h2>
      <p class="text-sm gs-text-subtle">One-click setup for popular business tools</p>

      <div id="available-integrations" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">LLM Configuration</h2>
      <div class="space-y-4">
        <div>
          <label class="text-sm font-semibold">LLM Provider</label>
          <select id="llm-provider" class="gs-input mt-2 w-full text-sm py-2 px-3">
            <option value="claude">Claude (Anthropic)</option>
            <option value="openai">OpenAI</option>
            <option value="openclaw">OpenClaw (Self-Hosted)</option>
            <option value="local">Local LLM</option>
          </select>
        </div>
        <div>
          <label class="text-sm font-semibold">API Key</label>
          <input
            id="llm-api-key"
            type="password"
            placeholder="Enter API key"
            class="gs-input mt-2 w-full text-sm py-2 px-3"
          />
        </div>
        <div id="llm-base-url-container" style="display: none;">
          <label class="text-sm font-semibold">Base URL (for self-hosted)</label>
          <input
            id="llm-base-url"
            type="text"
            placeholder="http://localhost:8000"
            class="gs-input mt-2 w-full text-sm py-2 px-3"
          />
        </div>
        <div class="flex gap-3">
          <button class="gs-admin-button gs-admin-button--primary" id="save-llm-config" type="button">Save LLM Config</button>
          <button class="gs-admin-button gs-admin-button--secondary" id="test-llm" type="button">Test Connection</button>
        </div>
        <p id="llm-message" class="text-sm gs-text-dim"></p>
      </div>
    </div>
  </div>

  <script is:inline>
    const page = document.querySelector('.integrations-page');
    const apiBase = page?.dataset.apiBase || 'https://api.goldshore.ai';
    const endpoint = (path) => `${apiBase}${path}`;
    document.addEventListener('DOMContentLoaded', async () => {
      const loadIntegrations = async () => {
        const loadingEl = document.getElementById('integrations-loading');
        const listEl = document.getElementById('integrations-list');
        const emptyEl = document.getElementById('integrations-empty');

        const totalEl = document.getElementById('total-integrations');
        const connectedEl = document.getElementById('connected-count');
        const disconnectedEl = document.getElementById('disconnected-count');
        const errorEl = document.getElementById('error-count');

        if (loadingEl) loadingEl.style.display = 'block';
        if (listEl) listEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = 'none';

        try {
          const response = await fetch(endpoint('/integrations?action=list'), { credentials: 'include', headers: { accept: 'application/json' } });
          const data = await response.json();

          if (loadingEl) loadingEl.style.display = 'none';

          if (data.success && data.data) {
            const { totalIntegrations, connected, disconnected, errors, integrations } = data.data;

            if (totalEl) totalEl.textContent = totalIntegrations.toString();
            if (connectedEl) connectedEl.textContent = connected.toString();
            if (disconnectedEl) disconnectedEl.textContent = disconnected.toString();
            if (errorEl) errorEl.textContent = errors.toString();

            if (totalIntegrations === 0) {
              if (emptyEl) emptyEl.style.display = 'block';
            } else {
              if (listEl) {
                listEl.innerHTML = Object.entries(integrations || {})
                  .map(([name, config]) => {
                    const statusClass = {
                      connected: 'gs-status--ok',
                      disconnected: 'gs-status--warn',
                      error: 'gs-status--err',
                    }[config.status] || 'gs-status--info';

                    const lastSync = config.lastSync
                      ? new Date(config.lastSync).toLocaleTimeString()
                      : 'Never';

                    return `
                      <div class="gs-card space-y-3 p-4">
                        <div class="flex items-center justify-between">
                          <h3 class="font-semibold">${name}</h3>
                          <span class="${statusClass} text-xs px-2 py-1 rounded">${config.status}</span>
                        </div>
                        <p class="text-sm gs-text-dim">${config.provider}</p>
                        <p class="text-xs gs-text-subtle">Last sync: ${lastSync}</p>
                        ${config.error ? `<p class="text-xs gs-text-danger">Error: ${config.error}</p>` : ''}
                        <div class="flex gap-2 pt-2">
                          <button class="gs-link text-xs" onclick="editIntegration('${name}')">Edit</button>
                          <button class="gs-link text-xs text-danger" onclick="deleteIntegration('${name}')">Delete</button>
                        </div>
                      </div>
                    `;
                  })
                  .join('');
                if (listEl) listEl.style.display = 'grid';
              }
            }
          }
        } catch (error) {
          console.error('Error loading integrations:', error);
          if (emptyEl) emptyEl.style.display = 'block';
        }
      };

      const loadAvailableIntegrations = async () => {
        try {
          const response = await fetch(endpoint('/integrations?action=definitions'), { credentials: 'include', headers: { accept: 'application/json' } });
          const data = await response.json();

          if (data.success && data.data) {
            const container = document.getElementById('available-integrations');
            if (container) {
              container.innerHTML = Object.values(data.data)
                .map((def) => `
                  <div class="gs-card p-4 space-y-3">
                    <h3 class="font-semibold">${def.name}</h3>
                    <p class="text-sm gs-text-dim">${def.description}</p>
                    <button class="gs-link text-sm" onclick="setupIntegration('${def.id}')">
                      Setup →
                    </button>
                  </div>
                `)
                .join('');
            }
          }
        } catch (error) {
          console.error('Error loading available integrations:', error);
        }
      };

      document.getElementById('sync-all')?.addEventListener('click', async () => {
        try {
          const response = await fetch(endpoint('/integrations?action=sync'), { credentials: 'include', headers: { accept: 'application/json' } });
          const data = await response.json();
          if (data.success) {
            loadIntegrations();
          }
        } catch (error) {
          alert('Sync failed: ' + error);
        }
      });

      document.getElementById('llm-provider')?.addEventListener('change', (e) => {
        const baseUrlContainer = document.getElementById('llm-base-url-container');
        const provider = (e.target).value;
        if (baseUrlContainer) {
          baseUrlContainer.style.display = provider === 'openclaw' || provider === 'local' ? 'block' : 'none';
        }
      });

      window.editIntegration = (name) => {
        alert('Edit form for: ' + name);
      };

      window.deleteIntegration = async (name) => {
        if (confirm('Delete integration: ' + name + '?')) {
          try {
            const response = await fetch(endpoint('/integrations'), {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', accept: 'application/json' },
              credentials: 'include',
              body: JSON.stringify({
                action: 'delete',
                config: { name },
              }),
            });

            if (response.ok) {
              alert('Integration deleted successfully');
              loadIntegrations();
            } else {
              alert('Failed to delete integration');
            }
          } catch (error) {
            alert('Error deleting integration: ' + error);
          }
        }
      };

      window.setupIntegration = (id) => {
        alert('Setup flow for: ' + id);
      };

      loadIntegrations();
      loadAvailableIntegrations();
      setInterval(loadIntegrations, 60000); // Refresh every minute
    });
  </script>


  </div>
</AdminLayout>

<style>
  .integrations-page { min-height: 100vh; background: #050507; color: #f5f3ec; padding: 40px clamp(20px,4vw,56px); }
  .integrations-shell { max-width: 80rem; margin: 0 auto; display: grid; gap: 2rem; }
  .gs-card { border: 1px solid rgba(245, 243, 236, 0.14); border-radius: 1rem; background: rgba(255, 255, 255, 0.045); padding: 1.25rem; box-shadow: 0 18px 50px rgba(0,0,0,.22); }
  .gs-heading, .gs-text-accent { color: #f5b75c; }
  .gs-text-subtle, .gs-text-dim { color: rgba(245,243,236,.72); }
  .gs-text-info { color: #70b7ff; } .gs-text-success { color: #58d68d; } .gs-text-warning { color: #f5b75c; } .gs-text-danger { color: #ff7a7a; }
  .gs-input { border: 1px solid rgba(245,243,236,.2); border-radius: .75rem; background: rgba(5,5,7,.72); color: #f5f3ec; }
  .gs-admin-button { border: 0; border-radius: 999px; padding: .75rem 1rem; font-weight: 800; cursor: pointer; }
  .gs-admin-button--primary { background: #d96a32; color: #050507; }
  .gs-admin-button--secondary { background: rgba(245,243,236,.1); color: #f5f3ec; border: 1px solid rgba(245,243,236,.2); }
  .gs-status--ok { background: rgba(88,214,141,.16); color: #58d68d; } .gs-status--warn { background: rgba(245,183,92,.16); color: #f5b75c; } .gs-status--err { background: rgba(255,122,122,.16); color: #ff7a7a; } .gs-status--info { background: rgba(112,183,255,.16); color: #70b7ff; }
  .space-y-3 > * + * { margin-top: .75rem; } .space-y-4 > * + * { margin-top: 1rem; } .space-y-8 > * + * { margin-top: 2rem; }
  .flex { display: flex; } .items-center { align-items: center; } .items-start { align-items: flex-start; } .justify-between { justify-content: space-between; } .gap-2 { gap: .5rem; } .gap-3 { gap: .75rem; } .gap-4 { gap: 1rem; } .gap-6 { gap: 1.5rem; }
  .grid { display: grid; } @media (min-width: 768px) { .md\:grid-cols-2 { grid-template-columns: repeat(2,minmax(0,1fr)); } .md\:grid-cols-4 { grid-template-columns: repeat(4,minmax(0,1fr)); } } @media (min-width: 1024px) { .lg\:grid-cols-3 { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  .text-4xl { font-size: 2.25rem; } .text-3xl { font-size: 1.875rem; } .text-2xl { font-size: 1.5rem; } .text-lg { font-size: 1.125rem; } .text-sm { font-size: .875rem; } .text-xs { font-size: .75rem; }
  .font-bold { font-weight: 700; } .font-semibold { font-weight: 600; } .mt-2 { margin-top: .5rem; } .w-full { width: 100%; } .py-1 { padding-top: .25rem; padding-bottom: .25rem; } .py-2 { padding-top: .5rem; padding-bottom: .5rem; } .py-8 { padding-top: 2rem; padding-bottom: 2rem; } .px-2 { padding-left: .5rem; padding-right: .5rem; } .px-3 { padding-left: .75rem; padding-right: .75rem; } .p-4 { padding: 1rem; } .rounded { border-radius: .25rem; } .text-center { text-align: center; }
</style>
