---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { fetchAdminJson } from '../../lib/api-proxy';

const jwtToken = Astro.request.headers.get('CF-Access-JWT-Assertion') || '';
const offset = parseInt(Astro.url.searchParams.get('offset') || '0');
const limit = parseInt(Astro.url.searchParams.get('limit') || '25');
const search = Astro.url.searchParams.get('search') || '';

let customersData: { customers: any[]; total: number; offset: number; limit: number; error: string | null } = {
  customers: [],
  total: 0,
  offset,
  limit,
  error: null
};

try {
  const params = new URLSearchParams({
    offset: String(offset),
    limit: String(limit),
    ...(search && { search })
  });

  const result = await fetchAdminJson<{ customers: any[]; total: number }>(
    Astro.request,
    `/admin/customers?${params}`
  );

  if (result.ok && result.data) {
    customersData = { ...customersData, ...result.data };
  } else if (result.status === 401 || result.status === 403) {
    customersData.error = 'Authentication required. Please ensure you are logged in with the correct credentials.';
  } else if (!result.ok) {
    customersData.error = `Failed to load customers (status ${result.status}).`;
  }
} catch (error) {
  customersData.error = error instanceof Error ? error.message : 'Failed to load customers';
}
---

<AdminLayout title="Customers | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="space-y-2">
      <h1 class="text-4xl gs-heading gs-text-accent">Customers</h1>
      <p class="text-lg gs-text-subtle">Manage customer accounts and subscriptions</p>
    </div>

    {customersData.error && (
      <div class="p-4 bg-red-50 border border-red-200 rounded text-red-700 text-sm mb-4">
        {customersData.error}
      </div>
    )}

    <div class="gs-card space-y-6">
      <div class="flex justify-between items-center">
        <h2 class="text-2xl font-semibold">All Customers</h2>
        <a href="/admin/customers/new" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
          + Create New Customer
        </a>
      </div>

      {customersData.customers.length === 0 ? (
        <p class="text-gray-500">No customers found</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b">
              <tr>
                <th class="text-left py-3 px-4 font-semibold">Name</th>
                <th class="text-left py-3 px-4 font-semibold">Email</th>
                <th class="text-left py-3 px-4 font-semibold">Status</th>
                <th class="text-left py-3 px-4 font-semibold">Created</th>
                <th class="text-left py-3 px-4 font-semibold">Actions</th>
              </tr>
            </thead>
            <tbody>
              {customersData.customers.map((customer: any) => (
                <tr class="border-b hover:bg-gray-50">
                  <td class="py-3 px-4">{customer.name}</td>
                  <td class="py-3 px-4">{customer.email}</td>
                  <td class="py-3 px-4">
                    <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs font-medium">
                      {customer.status}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-gray-600">
                    {new Date(customer.created_at).toLocaleDateString()}
                  </td>
                  <td class="py-3 px-4">
                    <a href={`/admin/customers/${customer.id}`} class="text-blue-500 hover:text-blue-700 underline">
                      View
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {customersData.customers.length > 0 && (
        <div class="flex justify-between items-center pt-4">
          <div class="text-sm text-gray-600">
            Showing {offset + 1} to {Math.min(offset + limit, customersData.total)} of {customersData.total}
          </div>
          <div class="space-x-2">
            {offset > 0 && (
              <a
                href={`/admin/customers?offset=${offset - limit}&limit=${limit}`}
                class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300"
              >
                ← Previous
              </a>
            )}
            {offset + limit < customersData.total && (
              <a
                href={`/admin/customers?offset=${offset + limit}&limit=${limit}`}
                class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300"
              >
                Next →
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
