---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { Card, Table } from '@goldshore/ui';
import { ADMIN_ROLES, ROLE_PERMISSIONS, type AdminPermission } from '@goldshore/auth';

const permissionGroups: Array<{ label: string; permissions: AdminPermission[] }> = [
  {
    label: 'Content',
    permissions: ['content:read', 'content:write', 'content:publish']
  },
  {
    label: 'Media',
    permissions: ['media:read', 'media:write', 'media:delete']
  },
  {
    label: 'Forms',
    permissions: ['forms:read', 'forms:write', 'forms:publish']
  },
  {
    label: 'User Management & Audit',
    permissions: ['users:read', 'users:create', 'users:invite', 'users:update', 'users:disable', 'audit:read']
  }
];
---
<AdminLayout title="User Permissions | GoldShore Admin" requiredPermission="users:read">
    <section class="max-w-6xl mx-auto py-16 px-6">
        <h1 class="text-3xl gs-heading mb-4">User Permissions</h1>
        <p class="text-[var(--gs-text-secondary)] mb-8">
            Roles map directly to content, media, and forms access. Admins inherit full control, editors
            can create and update assets, and viewers remain read-only.
        </p>

        <Card class="gs-table-card">
          <Table>
            <thead>
              <tr>
                <th>Permission</th>
                {ADMIN_ROLES.map((role) => (
                  <th class="capitalize">{role}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {permissionGroups.map((group) => (
                <>
                  <tr>
                    <td colspan={ADMIN_ROLES.length + 1} class="text-sm uppercase text-[var(--gs-text-secondary)]">
                      {group.label}
                    </td>
                  </tr>
                  {group.permissions.map((permission) => (
                    <tr>
                      <td>{permission}</td>
                      {ADMIN_ROLES.map((role) => (
                        <td>
                          {ROLE_PERMISSIONS[role].includes(permission) ? '✅' : '—'}
                        </td>
                      ))}
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </Table>
        </Card>

        <Card class="gs-table-card mt-8">
          <div class="p-4">
            <h2 class="text-xl font-semibold">Role assignment updater</h2>
            <p class="text-sm text-[var(--gs-text-secondary)] mt-1">Role changes take effect through the canonical users API and preserve the final active owner safeguard.</p>
          </div>
          <Table>
            <thead><tr><th>User</th><th>Current role</th><th>Status</th><th>Action</th></tr></thead>
            <tbody id="permission-users"><tr><td colspan="4">Loading users…</td></tr></tbody>
          </Table>
          <div class="p-4 flex justify-between"><button id="permission-prev" class="gs-button">Previous</button><span id="permission-page">Page 1</span><button id="permission-next" class="gs-button">Next</button></div>
        </Card>
    </section>
</AdminLayout>

<script>
  type User = { id:string; email:string; name:string|null; role:string|null; status:string };
  const assignableRoles=['viewer','editor','admin','owner'];
  let page=1; let pages=1; const tbody=document.querySelector('#permission-users') as HTMLTableSectionElement;
  const escapeHtml=(value:unknown)=>String(value??'').replace(/[&<>'"]/g,(character)=>({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' })[character]??character);
  const load=async()=>{ const pageSize=25; const offset=(page-1)*pageSize; const response=await fetch(`/api/admin/users?offset=${offset}&limit=${pageSize}`); const data=await response.json(); if(!response.ok){tbody.innerHTML=`<tr><td colspan="4">${escapeHtml(data.error??'Unable to load users.')}</td></tr>`;return;} pages=data.pagination?.pages||1; tbody.innerHTML=(data.items as User[]).map((user)=>`<tr data-user="${escapeHtml(user.id)}"><td><strong>${escapeHtml(user.name||'Unnamed')}</strong><br><small>${escapeHtml(user.email)}</small></td><td><select data-role>${assignableRoles.map((role)=>`<option value="${role}" ${role===user.role?'selected':''}>${role}</option>`).join('')}</select></td><td>${escapeHtml(user.status)}</td><td><button class="gs-button" data-save>Update permissions</button></td></tr>`).join('')||'<tr><td colspan="4">No users found.</td></tr>'; document.querySelector('#permission-page')!.textContent=`Page ${page} of ${pages}`; (document.querySelector('#permission-prev') as HTMLButtonElement).disabled=page<=1; (document.querySelector('#permission-next') as HTMLButtonElement).disabled=page>=pages; };
  tbody.addEventListener('click',async(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-save]');const row=button?.closest<HTMLTableRowElement>('[data-user]');if(!button||!row)return;button.disabled=true;const role=(row.querySelector('[data-role]') as HTMLSelectElement).value;const response=await fetch(`/api/admin/users/${encodeURIComponent(row.dataset.user!)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({role})});if(!response.ok)alert((await response.json()).error??'Role update failed.');await load();});
  document.querySelector('#permission-prev')?.addEventListener('click',()=>{if(page>1){page--;load();}});document.querySelector('#permission-next')?.addEventListener('click',()=>{if(page<pages){page++;load();}});load();
</script>
