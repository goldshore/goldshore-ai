---
import AdminLayout from '../../../layouts/AdminLayout.astro';
if (!Astro.locals.adminSession?.isAuthenticated) return Astro.redirect('/login');
---

<AdminLayout title="User Directory | GoldShore Admin" requiredPermission="users:read">
  <section class="gs-section">
    <div class="gs-grid columns-2">
      <div><h1>User directory</h1><p class="gs-text-lg">Create, invite, update, disable, and review operator access without exposing session credentials.</p></div>
      <form id="user-create" class="gs-card">
        <h2 id="form-title">Invite user</h2>
        <div class="gs-input-group"><label for="user-email">Email</label><input id="user-email" name="email" type="email" required /></div>
        <div class="gs-input-group"><label for="user-name">Display name</label><input id="user-name" name="displayName" /></div>
        <div class="gs-input-group"><label for="user-role">Role</label><select id="user-role" name="role"><option>viewer</option><option>editor</option><option>admin</option><option>owner</option></select></div>
        <label><input id="send-invite" type="checkbox" checked /> Create a pending invitation instead of immediate access</label>
        <p id="create-status" role="status"></p><button class="gs-button" type="submit">Add user</button>
      </form>
    </div>

    <div class="gs-card" style="margin-top:2rem; overflow-x:auto;">
      <div style="display:flex; justify-content:space-between; gap:1rem; align-items:center;"><h2>Operators and sign-ups</h2><button id="refresh-users" class="gs-button" type="button">Refresh</button></div>
      <table class="gs-table"><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody id="users-body"><tr><td colspan="5">Loading users…</td></tr></tbody></table>
      <nav aria-label="User pages" style="display:flex; justify-content:space-between; align-items:center; margin-top:1rem;"><button id="previous-page" class="gs-button" type="button">Previous</button><span id="page-label">Page 1</span><button id="next-page" class="gs-button" type="button">Next</button></nav>
    </div>
  </section>
</AdminLayout>

<script>
  type User = { id:string; email:string; display_name:string|null; role:'owner'|'admin'|'editor'|'viewer'|null; status:string; created_at:string };
  let page = 1; let pages = 1; const pageSize = 25;
  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' })[character] ?? character);
  const body = document.getElementById('users-body') as HTMLElement;
  const status = document.getElementById('create-status') as HTMLElement;
  const loadUsers = async () => {
    body.innerHTML = '<tr><td colspan="5">Loading users…</td></tr>';
    const response = await fetch(`/api/admin/users?page=${page}&pageSize=${pageSize}`);
    if (!response.ok) { body.innerHTML = `<tr><td colspan="5">${escapeHtml(await response.text())}</td></tr>`; return; }
    const payload = await response.json() as { items:User[]; pagination:{ pages:number } }; pages = payload.pagination.pages;
    body.innerHTML = payload.items.length ? payload.items.map((user) => `<tr data-user-id="${escapeHtml(user.id)}"><td><strong>${escapeHtml(user.display_name || 'Unnamed')}</strong><br><small>${escapeHtml(user.email)}</small></td><td><select data-field="role">${['viewer','editor','admin','owner'].map((role) => `<option value="${role}" ${role === user.role ? 'selected' : ''}>${role}</option>`).join('')}</select></td><td><select data-field="status">${['active','invited','disabled'].map((item) => `<option value="${item}" ${item === user.status ? 'selected' : ''}>${item}</option>`).join('')}</select></td><td>${new Date(user.created_at).toLocaleDateString()}</td><td><button class="gs-button" data-action="save" type="button">Save</button> <button class="gs-button" data-action="disable" type="button" ${user.status === 'disabled' ? 'disabled' : ''}>Disable</button></td></tr>`).join('') : '<tr><td colspan="5">No users found.</td></tr>';
    document.getElementById('page-label')!.textContent = `Page ${page} of ${pages}`;
    (document.getElementById('previous-page') as HTMLButtonElement).disabled = page <= 1; (document.getElementById('next-page') as HTMLButtonElement).disabled = page >= pages;
  };
  body.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]'); const row = button?.closest<HTMLTableRowElement>('[data-user-id]'); if (!button || !row) return;
    const id = row.dataset.userId!; button.disabled = true;
    const response = button.dataset.action === 'disable'
      ? await fetch(`/api/admin/users/${encodeURIComponent(id)}/disable`, { method:'POST' })
      : await fetch(`/api/admin/users/${encodeURIComponent(id)}`, { method:'PATCH', headers:{'content-type':'application/json'}, body:JSON.stringify({ role:(row.querySelector('[data-field="role"]') as HTMLSelectElement).value, status:(row.querySelector('[data-field="status"]') as HTMLSelectElement).value }) });
    if (!response.ok) alert((await response.json().catch(() => ({error:'Update failed.'}))).error); await loadUsers();
  });
  document.getElementById('user-create')!.addEventListener('submit', async (event) => {
    event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const data = new FormData(form); const invite = (document.getElementById('send-invite') as HTMLInputElement).checked;
    status.textContent = invite ? 'Creating invitation…' : 'Creating user…';
    const payload = { email:data.get('email'), displayName:data.get('displayName'), role:data.get('role') };
    const response = await fetch(invite ? '/api/admin/users/invite' : '/api/admin/users', { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(payload) });
    const result = await response.json().catch(() => ({})); status.textContent = response.ok ? (result.invitation?.token ? `Invitation created. One-time token: ${result.invitation.token}` : 'User created.') : result.error || 'Create failed.';
    if (response.ok) { form.reset(); (document.getElementById('send-invite') as HTMLInputElement).checked = true; page = 1; await loadUsers(); }
  });
  document.getElementById('refresh-users')!.addEventListener('click', loadUsers); document.getElementById('previous-page')!.addEventListener('click', () => { if (page > 1) { page -= 1; loadUsers(); } }); document.getElementById('next-page')!.addEventListener('click', () => { if (page < pages) { page += 1; loadUsers(); } });
  loadUsers().catch(() => { body.innerHTML = '<tr><td colspan="5">User API unavailable.</td></tr>'; });
</script>
