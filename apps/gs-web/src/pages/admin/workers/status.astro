---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { authorizeAdminRequest, getAdminAuthError, getAdminRouteRule } from '../../../utils/admin-access';

export const prerender = false;

const env = Astro.locals.runtime?.env as Env | undefined;
const rule = getAdminRouteRule('/admin/workers/status', 'GET');

let authError: { status: number; message: string } | null = null;
if (!rule) {
  authError = { status: 404, message: 'Not found.' };
} else {
  const authResult = await authorizeAdminRequest(Astro.request, env as never, rule);
  authError = getAdminAuthError(authResult);
}
---

<BaseLayout title="Worker Status | GoldShore Admin" description="Live status of all Cloudflare Workers in your account">
  <section class="gs-section">
    <div class="gs-grid columns-2">
      <div>
        <h1>Worker status</h1>
        <p class="gs-text-lg">Live status of all Cloudflare Workers in your account.</p>
      </div>
      <div class="gs-card">
        <h2 class="section-title"><span>◆</span>Actions</h2>
        <ul>
          <li><a href="/admin/api-status">API status</a></li>
          <li><a href="/admin/workers/routes">Worker routes</a></li>
          <li><a href="/admin/workers/bindings">Worker bindings</a></li>
        </ul>
      </div>
    </div>

    {authError ? (
      <div class="gs-card" style="margin-top: 2rem;">
        <p class="gs-text-lg">{authError.message}</p>
      </div>
    ) : (
      <div class="gs-card" style="margin-top: 2rem; overflow-x: auto;">
        <table class="gs-table">
          <thead>
            <tr><th>Worker name</th><th>Last modified</th><th>Status</th></tr>
          </thead>
          <tbody id="workers-table-body">
            <tr><td colspan="3">Loading workers…</td></tr>
          </tbody>
        </table>
      </div>
    )}
  </section>

  <script>
    const tableBody = document.getElementById('workers-table-body');

    function renderError(message: string) {
      if (tableBody) {
        tableBody.innerHTML = `<tr><td colspan="3">${message}</td></tr>`;
      }
    }

    async function loadWorkers() {
      try {
        const res = await fetch('/api/admin/cf/workers');
        const data = await res.json();

        if (!res.ok || !data.success) {
          renderError(data.error ?? 'Failed to load workers.');
          return;
        }

        const workers: Array<{ id: string; modified_on: string }> = data.workers ?? [];

        if (!workers.length) {
          renderError('No workers found in this account.');
          return;
        }

        if (tableBody) {
          tableBody.innerHTML = workers
            .map(
              (w) => `
                <tr>
                  <td>${w.id}</td>
                  <td class="gs-text-sm">${w.modified_on ? new Date(w.modified_on).toLocaleString() : 'N/A'}</td>
                  <td><span class="gs-badge success">active</span></td>
                </tr>`,
            )
            .join('');
        }
      } catch {
        renderError('Network error — could not reach /api/admin/cf/workers.');
      }
    }

    loadWorkers();
  </script>
</BaseLayout>
