---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";

const requestedTab = Astro.url.searchParams.get('tab');
const TABS = ['status', 'bindings', 'routes', 'tunnels'] as const;
const initialTab = (TABS as readonly string[]).includes(requestedTab ?? '') ? requestedTab! : 'status';
---
<AdminLayout title="Workers | GoldShore Admin">
  <section class="gs-page gs-stack">
    <div>
      <h1 class="gs-heading">Workers</h1>
      <p class="gs-text-subtle">Live Cloudflare Worker status, bindings, routes, and tunnels — consolidated from four separate pages into one.</p>
    </div>

    <nav class="gs-tabs" role="tablist" aria-label="Worker sections">
      <button type="button" class="gs-tab" data-tab="status" role="tab">Status</button>
      <button type="button" class="gs-tab" data-tab="bindings" role="tab">Bindings</button>
      <button type="button" class="gs-tab" data-tab="routes" role="tab">Routes</button>
      <button type="button" class="gs-tab" data-tab="tunnels" role="tab">Tunnels</button>
    </nav>

    <!-- ============================== Status ============================== -->
    <div class="gs-panel" data-panel="status">
      <div class="gs-row gs-row--between">
        <h2>Deployed Workers</h2>
        <button id="st-refresh-btn" class="gs-button gs-button--secondary gs-text-sm">Refresh</button>
      </div>
      <div class="gs-card gs-stack">
        <div class="gs-table-scroll">
          <table>
            <thead><tr class="gs-text-sm gs-text-subtle"><th>Worker Name</th><th>Last Modified</th><th>Status</th></tr></thead>
            <tbody id="st-workers-table-body"><tr><td class="gs-text-sm gs-text-subtle" colspan="3">Loading workers…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ============================== Bindings ============================== -->
    <div class="gs-panel" data-panel="bindings">
      <h2>Worker Bindings</h2>
      <p class="gs-text-subtle">Resource bindings, environment variables, and secrets mapped to each worker.</p>

      <div class="gs-card gs-stack">
        <div class="gs-row">
          <label for="bd-worker-select" class="gs-text-sm gs-text-subtle">Select worker:</label>
          <select id="bd-worker-select" class="gs-input gs-text-sm" style="min-width: 220px;"><option value="">Loading workers…</option></select>
        </div>
      </div>

      <div id="bd-bindings-section" class="gs-card gs-stack" style="display: none;">
        <h3 class="gs-text-lg">Bindings</h3>
        <form id="bd-binding-form" class="gs-list-grid gs-row--end">
          <label class="gs-stack-sm"><span class="gs-text-sm">Variable name</span><input id="bd-binding-name" class="gs-input gs-mono" required pattern="[A-Za-z_$][A-Za-z0-9_$]{0,63}" placeholder="FEATURE_FLAG" /></label>
          <label class="gs-stack-sm"><span class="gs-text-sm">Type</span><select id="bd-binding-type" class="gs-input"><option value="plain_text">Plain text</option><option value="json">JSON</option></select></label>
          <label class="gs-stack-sm"><span class="gs-text-sm">Value</span><textarea id="bd-binding-value" class="gs-input gs-mono" required maxlength="16384" rows="2"></textarea></label>
          <button class="gs-button" type="submit">Save confirmed binding</button>
        </form>
        <p class="gs-text-sm gs-text-subtle">Secret and resource bindings are read-only here. Use Secrets Management or Wrangler for those types.</p>
        <p id="bd-binding-status" class="gs-text-sm gs-text-subtle" role="status"></p>
        <div class="gs-table-scroll">
          <table>
            <thead><tr class="gs-text-sm gs-text-subtle"><th>Binding Name</th><th>Type</th><th>Resource</th><th>Actions</th></tr></thead>
            <tbody id="bd-bindings-table-body"><tr><td class="gs-text-sm gs-text-subtle" colspan="4">Select a worker to view bindings.</td></tr></tbody>
          </table>
        </div>
      </div>

      <div id="bd-bindings-error" class="gs-card" style="display: none;">
        <p id="bd-bindings-error-msg" class="gs-text-sm gs-text-danger"></p>
        <p class="gs-text-subtle gs-text-sm">Ensure <code>CF_ACCOUNT_ID</code> and <code>CF_TOKEN</code> are configured on gs-api.</p>
      </div>
    </div>

    <!-- ============================== Routes ============================== -->
    <div class="gs-panel" data-panel="routes">
      <h2>Worker Routes</h2>
      <p class="gs-text-subtle">Route tables, domains, and traffic rules for each deployed worker.</p>

      <div class="gs-card gs-stack">
        <div class="gs-row gs-row--between">
          <label for="rt-worker-select" class="gs-text-sm gs-text-subtle">Select worker:</label>
          <select id="rt-worker-select" class="gs-input gs-text-sm" style="min-width: 220px;"><option value="">Loading workers…</option></select>
          <a id="rt-cf-dashboard-link" href="#" target="_blank" rel="noopener noreferrer" class="gs-button gs-button--secondary gs-text-sm" style="display: none;">CF Dashboard ↗</a>
        </div>
        <form id="rt-route-form" class="gs-row gs-row--end">
          <label class="gs-stack-sm gs-fill"><span class="gs-text-sm">New route pattern</span><input id="rt-route-pattern" class="gs-input" required placeholder="api.goldshore.ai/*" /></label>
          <button class="gs-button" type="submit">Add confirmed route</button>
        </form>
        <p id="rt-route-status" class="gs-text-sm gs-text-subtle" role="status"></p>
      </div>

      <div id="rt-routes-section" class="gs-card gs-stack" style="display: none;">
        <h3 class="gs-text-lg">Routes</h3>
        <div class="gs-table-scroll">
          <table>
            <thead><tr class="gs-text-sm gs-text-subtle"><th>Pattern</th><th>Zone</th><th>Created</th><th>Actions</th></tr></thead>
            <tbody id="rt-routes-table-body"><tr><td class="gs-text-sm gs-text-subtle" colspan="4">Select a worker to view routes.</td></tr></tbody>
          </table>
        </div>
      </div>

      <div id="rt-routes-error" class="gs-card" style="display: none;">
        <p id="rt-routes-error-msg" class="gs-text-sm gs-text-danger"></p>
        <p class="gs-text-subtle gs-text-sm">Ensure <code>CF_ACCOUNT_ID</code> and <code>CF_TOKEN</code> are set in your environment.</p>
      </div>
    </div>

    <!-- ============================== Tunnels ============================== -->
    <div class="gs-panel" data-panel="tunnels">
      <h2>Cloudflare Tunnels</h2>
      <p class="gs-text-subtle">Inventory and guarded configuration for GoldShore private origins.</p>

      <form id="tn-create-form" class="gs-card gs-row gs-row--end">
        <label class="gs-stack-sm gs-fill"><span class="gs-text-sm">New remotely managed tunnel</span><input id="tn-tunnel-name" class="gs-input" required maxlength="100" placeholder="goldshore-admin-origin" /></label>
        <button class="gs-button" type="submit">Create tunnel</button>
      </form>
      <p id="tn-status" class="gs-text-sm gs-text-subtle" role="status"></p>
      <div class="gs-card gs-table-scroll">
        <table>
          <thead><tr><th>Name</th><th>Status</th><th>Management</th><th>Last active</th><th>Actions</th></tr></thead>
          <tbody id="tn-rows"><tr><td colspan="5" class="gs-text-subtle">Loading tunnels…</td></tr></tbody>
        </table>
      </div>
      <dialog id="tn-config-dialog" class="gs-card">
        <form method="dialog" class="gs-stack">
          <div class="gs-row gs-row--between"><div><h3>Tunnel ingress</h3><p id="tn-config-name" class="gs-text-sm gs-text-subtle"></p></div><button class="gs-button gs-button--secondary" value="cancel">Close</button></div>
          <p class="gs-text-sm gs-text-subtle">One JSON rule per hostname. Only goldshore.ai and goldshore.org hostnames are accepted. The final rule must be a catch-all such as <code>{`{"service":"http_status:404"}`}</code>.</p>
          <textarea id="tn-ingress" class="gs-input gs-mono gs-text-sm" rows="14" spellcheck="false"></textarea>
          <button id="tn-save-config" class="gs-button" type="button">Save confirmed configuration</button>
        </form>
      </dialog>
    </div>
  </section>

  <style>
    .gs-tabs { display: flex; gap: 8px; flex-wrap: wrap; border-bottom: 1px solid var(--gs-color-border); padding-bottom: 4px; }
    .gs-tab { font: 650 .85rem/1 inherit; padding: 8px 14px; border-radius: var(--gs-radius-pill, 999px) var(--gs-radius-pill, 999px) 0 0; border: 1px solid transparent; background: transparent; color: var(--gs-color-subtle); cursor: pointer; }
    .gs-tab:hover { color: var(--gs-color-text); }
    .gs-tab[aria-selected="true"] { color: var(--gs-color-primary, #d96a32); border-color: var(--gs-color-border); border-bottom-color: transparent; background: var(--gs-color-surface); }
    .gs-panel[hidden] { display: none; }
  </style>

  <script define:vars={{ initialTab }}>
    const tabs = Array.from(document.querySelectorAll('.gs-tab'));
    const panels = Array.from(document.querySelectorAll('.gs-panel'));
    function activate(tab) {
      for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.tab === tab));
      for (const p of panels) p.hidden = p.dataset.panel !== tab;
    }
    for (const t of tabs) {
      t.addEventListener('click', () => {
        const tab = t.dataset.tab;
        activate(tab);
        const url = new URL(window.location.href);
        url.searchParams.set('tab', tab);
        window.history.replaceState({}, '', url);
      });
    }
    activate(initialTab);
  </script>

  <script>
    // ---- Status (ported from the former status.astro) ----
    const stTableBody = document.getElementById('st-workers-table-body');

    function stRenderError(message: string) {
      if (stTableBody) {
        stTableBody.innerHTML = `<tr><td class="gs-text-sm gs-text-danger" colspan="3">${message}<br/><span class="gs-text-subtle gs-text-sm">Set <code>CF_ACCOUNT_ID</code> and <code>CF_TOKEN</code> in your environment to enable this page.</span></td></tr>`;
      }
    }

    async function stLoadWorkers() {
      if (stTableBody) stTableBody.innerHTML = '<tr><td class="gs-text-sm gs-text-subtle" colspan="3">Loading workers…</td></tr>';
      try {
        const res = await fetch('/api/admin/cf/workers');
        const data = await res.json();
        if (!res.ok || data.error) { stRenderError(data.error ?? 'Failed to load workers.'); return; }
        const workers: Array<{ id: string; modified_on: string }> = data.workers ?? [];
        if (!workers.length) {
          if (stTableBody) stTableBody.innerHTML = '<tr><td class="gs-text-sm gs-text-subtle" colspan="3">No workers found in this account.</td></tr>';
          return;
        }
        if (stTableBody) {
          stTableBody.innerHTML = workers.map((w) => `
            <tr>
              <td class="gs-mono gs-text-sm">${w.id}</td>
              <td class="gs-text-sm gs-text-subtle">${w.modified_on ? new Date(w.modified_on).toLocaleString() : 'N/A'}</td>
              <td><span class="gs-badge success">active</span></td>
            </tr>`).join('');
        }
      } catch {
        stRenderError('Network error — could not reach the Worker inventory API.');
      }
    }

    document.getElementById('st-refresh-btn')?.addEventListener('click', stLoadWorkers);
    stLoadWorkers();
  </script>

  <script>
    // ---- Bindings (ported from the former bindings.astro) ----
    const bdWorkerSelect = document.getElementById('bd-worker-select') as HTMLSelectElement | null;
    const bdBindingsSection = document.getElementById('bd-bindings-section');
    const bdBindingsTableBody = document.getElementById('bd-bindings-table-body');
    const bdBindingsError = document.getElementById('bd-bindings-error');
    const bdBindingsErrorMsg = document.getElementById('bd-bindings-error-msg');
    const bdBindingStatus = document.getElementById('bd-binding-status');
    let bdBindingsRevision = '';
    const bdEscapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' })[character] ?? character);

    function bdShowError(msg: string) {
      if (bdBindingsSection) bdBindingsSection.style.display = 'none';
      if (bdBindingsError) bdBindingsError.style.display = 'block';
      if (bdBindingsErrorMsg) bdBindingsErrorMsg.textContent = msg;
    }
    function bdHideError() {
      if (bdBindingsError) bdBindingsError.style.display = 'none';
    }

    async function bdLoadWorkerList() {
      try {
        const res = await fetch('/api/admin/cf/workers');
        const data = await res.json();
        if (!res.ok || data.error) {
          if (bdWorkerSelect) bdWorkerSelect.innerHTML = '<option value="">Failed to load workers</option>';
          bdShowError(data.error ?? 'Could not load worker list.');
          return;
        }
        const workers: Array<{ id: string }> = data.workers ?? [];
        if (bdWorkerSelect) {
          bdWorkerSelect.innerHTML = '<option value="">— choose a worker —</option>' + workers.map((w) => `<option value="${w.id}">${w.id}</option>`).join('');
        }
      } catch {
        if (bdWorkerSelect) bdWorkerSelect.innerHTML = '<option value="">Network error</option>';
        bdShowError('Network error — could not reach the Worker inventory API.');
      }
    }

    async function bdLoadBindings(name: string) {
      bdHideError();
      if (bdBindingsSection) bdBindingsSection.style.display = 'none';
      if (!name) return;
      if (bdBindingsTableBody) bdBindingsTableBody.innerHTML = '<tr><td class="gs-text-sm gs-text-subtle" colspan="4">Loading bindings…</td></tr>';
      if (bdBindingsSection) bdBindingsSection.style.display = 'block';

      try {
        const res = await fetch(`/api/admin/cf/worker-detail?name=${encodeURIComponent(name)}`);
        const data = await res.json();
        if (!res.ok || data.error) {
          bdShowError(data.error ?? 'Failed to load worker detail.');
          if (bdBindingsSection) bdBindingsSection.style.display = 'none';
          return;
        }
        bdBindingsRevision = data.bindingsRevision ?? '';
        const bindings: Array<{ name: string; type: string; resource?: string; editable?: boolean }> = data.bindings ?? [];
        if (!bindings.length) {
          if (bdBindingsTableBody) bdBindingsTableBody.innerHTML = '<tr><td class="gs-text-sm gs-text-subtle" colspan="4">No bindings found for this worker.</td></tr>';
          return;
        }
        if (bdBindingsTableBody) {
          bdBindingsTableBody.innerHTML = bindings.map((b) => `<tr>
              <td class="gs-mono gs-text-sm">${bdEscapeHtml(b.name)}</td>
              <td class="gs-text-sm">${bdEscapeHtml(b.type)}</td>
              <td class="gs-text-sm gs-text-subtle">${bdEscapeHtml(b.resource ?? 'Configured')}</td>
              <td>${b.editable ? `<button class="gs-button gs-button--secondary" data-edit-binding="${bdEscapeHtml(b.name)}" data-binding-type="${bdEscapeHtml(b.type)}">Replace</button><button class="gs-button gs-button--secondary" data-delete-binding="${bdEscapeHtml(b.name)}">Delete</button>` : 'Protected'}</td>
            </tr>`).join('');
        }
      } catch {
        bdShowError('Network error — could not reach the Worker detail API.');
        if (bdBindingsSection) bdBindingsSection.style.display = 'none';
      }
    }

    bdWorkerSelect?.addEventListener('change', () => bdLoadBindings(bdWorkerSelect.value));

    document.getElementById('bd-binding-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!bdWorkerSelect?.value) { if (bdBindingStatus) bdBindingStatus.textContent = 'Choose a Worker first.'; return; }
      const name = (document.getElementById('bd-binding-name') as HTMLInputElement).value.trim();
      const type = (document.getElementById('bd-binding-type') as HTMLSelectElement).value;
      const raw = (document.getElementById('bd-binding-value') as HTMLTextAreaElement).value;
      let value: unknown = raw;
      if (type === 'json') { try { value = JSON.parse(raw); } catch { if (bdBindingStatus) bdBindingStatus.textContent = 'JSON value is invalid.'; return; } }
      if (!confirm(`Save ${name} on ${bdWorkerSelect.value}? This creates a new Worker configuration version.`)) return;
      const mutationQuery = new URLSearchParams({ name: bdWorkerSelect.value, binding: name });
      const response = await fetch(`/api/admin/cf/worker-detail?${mutationQuery}`, { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type, value, expectedRevision: bdBindingsRevision, confirm: true }) });
      const data = await response.json().catch(() => ({}));
      if (bdBindingStatus) bdBindingStatus.textContent = response.ok ? 'Binding saved.' : data.error ?? 'Binding save failed.';
      (document.getElementById('bd-binding-value') as HTMLTextAreaElement).value = '';
      if (response.ok) await bdLoadBindings(bdWorkerSelect.value);
    });

    bdBindingsTableBody?.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const edit = target.closest<HTMLButtonElement>('[data-edit-binding]');
      if (edit) {
        (document.getElementById('bd-binding-name') as HTMLInputElement).value = edit.dataset.editBinding!;
        (document.getElementById('bd-binding-type') as HTMLSelectElement).value = edit.dataset.bindingType!;
        (document.getElementById('bd-binding-value') as HTMLTextAreaElement).focus();
        return;
      }
      const remove = target.closest<HTMLButtonElement>('[data-delete-binding]');
      if (!remove || !bdWorkerSelect?.value) return;
      if (!confirm(`Delete ${remove.dataset.deleteBinding} from ${bdWorkerSelect.value}?`)) return;
      const query = new URLSearchParams({ name: bdWorkerSelect.value, binding: remove.dataset.deleteBinding!, confirm: 'true', expectedRevision: bdBindingsRevision });
      const response = await fetch(`/api/admin/cf/worker-detail?${query}`, { method: 'DELETE' });
      if (bdBindingStatus) bdBindingStatus.textContent = response.ok ? 'Binding deleted.' : (await response.json().catch(() => ({}))).error ?? 'Binding deletion failed.';
      if (response.ok) await bdLoadBindings(bdWorkerSelect.value);
    });

    bdLoadWorkerList();
  </script>

  <script>
    // ---- Routes (ported from the former routes.astro) ----
    const RT_CF_ACCOUNT_ID_PLACEHOLDER = '__CF_ACCOUNT_PLACEHOLDER__';
    const rtWorkerSelect = document.getElementById('rt-worker-select') as HTMLSelectElement | null;
    const rtRoutesSection = document.getElementById('rt-routes-section');
    const rtRoutesTableBody = document.getElementById('rt-routes-table-body');
    const rtRoutesError = document.getElementById('rt-routes-error');
    const rtRoutesErrorMsg = document.getElementById('rt-routes-error-msg');
    const rtCfDashboardLink = document.getElementById('rt-cf-dashboard-link') as HTMLAnchorElement | null;
    let rtCfAccountId = '';
    const rtRouteStatus = document.getElementById('rt-route-status');
    const rtEscapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' })[character] ?? character);

    function rtShowError(msg: string) {
      if (rtRoutesSection) rtRoutesSection.style.display = 'none';
      if (rtRoutesError) rtRoutesError.style.display = 'block';
      if (rtRoutesErrorMsg) rtRoutesErrorMsg.textContent = msg;
    }
    function rtHideError() {
      if (rtRoutesError) rtRoutesError.style.display = 'none';
    }
    function rtUpdateDashboardLink(name: string) {
      if (!rtCfDashboardLink) return;
      if (!name) { rtCfDashboardLink.style.display = 'none'; return; }
      const accountSegment = rtCfAccountId || RT_CF_ACCOUNT_ID_PLACEHOLDER;
      rtCfDashboardLink.href = `https://dash.cloudflare.com/${accountSegment}/workers/services/view/${encodeURIComponent(name)}/production/settings`;
      rtCfDashboardLink.style.display = 'inline-flex';
    }

    async function rtLoadWorkerList() {
      try {
        const res = await fetch('/api/admin/cf/workers');
        const data = await res.json();
        if (!res.ok || data.error) {
          if (rtWorkerSelect) rtWorkerSelect.innerHTML = '<option value="">Failed to load workers</option>';
          rtShowError(data.error ?? 'Could not load worker list.');
          return;
        }
        rtCfAccountId = data.accountId ?? '';
        const workers: Array<{ id: string }> = data.workers ?? [];
        if (rtWorkerSelect) rtWorkerSelect.innerHTML = '<option value="">— choose a worker —</option>' + workers.map((w) => `<option value="${w.id}">${w.id}</option>`).join('');
      } catch {
        if (rtWorkerSelect) rtWorkerSelect.innerHTML = '<option value="">Network error</option>';
        rtShowError('Network error — could not reach the Worker inventory API.');
      }
    }

    async function rtLoadRoutes(name: string) {
      rtHideError();
      if (rtRoutesSection) rtRoutesSection.style.display = 'none';
      rtUpdateDashboardLink(name);
      if (!name) return;
      if (rtRoutesTableBody) rtRoutesTableBody.innerHTML = '<tr><td class="gs-text-sm gs-text-subtle" colspan="4">Loading routes…</td></tr>';
      if (rtRoutesSection) rtRoutesSection.style.display = 'block';

      try {
        const res = await fetch(`/api/admin/cf/worker-detail?name=${encodeURIComponent(name)}`);
        const data = await res.json();
        if (!res.ok || data.error) {
          rtShowError(data.error ?? 'Failed to load worker detail.');
          if (rtRoutesSection) rtRoutesSection.style.display = 'none';
          return;
        }
        const routes: Array<{ id?: string; pattern: string; zone_name?: string; created_on?: string }> = data.routes ?? [];
        if (!routes.length) {
          if (rtRoutesTableBody) rtRoutesTableBody.innerHTML = '<tr><td class="gs-text-sm gs-text-subtle" colspan="4">No routes found for this worker on GoldShore zones.</td></tr>';
          return;
        }
        if (rtRoutesTableBody) {
          rtRoutesTableBody.innerHTML = routes.map((r) => `
            <tr>
              <td class="gs-mono gs-text-sm">${rtEscapeHtml(r.pattern)}</td>
              <td class="gs-text-sm gs-text-subtle">${rtEscapeHtml(r.zone_name ?? 'goldshore.ai')}</td>
              <td class="gs-text-sm gs-text-subtle">${r.created_on ? new Date(r.created_on).toLocaleString() : '—'}</td>
              <td>${r.id ? `<button class="gs-button gs-button--secondary" data-delete-route="${rtEscapeHtml(r.id)}">Delete</button>` : '—'}</td>
            </tr>`).join('');
        }
      } catch {
        rtShowError('Network error — could not reach /api/cf/worker-detail.');
        if (rtRoutesSection) rtRoutesSection.style.display = 'none';
      }
    }

    rtWorkerSelect?.addEventListener('change', () => rtLoadRoutes(rtWorkerSelect.value));

    document.getElementById('rt-route-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const pattern = (document.getElementById('rt-route-pattern') as HTMLInputElement).value.trim();
      if (!rtWorkerSelect?.value) { if (rtRouteStatus) rtRouteStatus.textContent = 'Choose a Worker first.'; return; }
      if (!confirm(`Route ${pattern} to ${rtWorkerSelect.value}? This changes live Cloudflare traffic.`)) return;
      const response = await fetch('/api/admin/cf/routes', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ pattern, script: rtWorkerSelect.value, confirm: true }) });
      const payload = await response.json().catch(() => ({}));
      if (rtRouteStatus) rtRouteStatus.textContent = response.ok ? 'Route created.' : payload.error ?? 'Route creation failed.';
      if (response.ok) { (document.getElementById('rt-route-pattern') as HTMLInputElement).value = ''; await rtLoadRoutes(rtWorkerSelect.value); }
    });

    rtRoutesTableBody?.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-route]');
      if (!button || !rtWorkerSelect?.value) return;
      if (!confirm('Delete this live Worker route? Traffic will stop matching immediately.')) return;
      const response = await fetch(`/api/admin/cf/routes/${encodeURIComponent(button.dataset.deleteRoute!)}?confirm=true`, { method: 'DELETE' });
      if (rtRouteStatus) rtRouteStatus.textContent = response.ok ? 'Route deleted.' : (await response.json().catch(() => ({}))).error ?? 'Route deletion failed.';
      if (response.ok) await rtLoadRoutes(rtWorkerSelect.value);
    });

    rtLoadWorkerList();
  </script>

  <script>
    // ---- Tunnels (ported from the former tunnels.astro) ----
    const tnRows = document.getElementById('tn-rows');
    const tnStatus = document.getElementById('tn-status');
    const tnDialog = document.getElementById('tn-config-dialog') as HTMLDialogElement;
    const tnEscapeHtml = (v: unknown) => String(v ?? '').replace(/[&<>'"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' } as any)[c] ?? c);
    let tnSelected = '';
    const tnMessage = (value: string) => { if (tnStatus) tnStatus.textContent = value; };

    async function tnLoad() {
      try {
        const response = await fetch('/api/admin/cf/tunnels');
        const data = await response.json();
        if (!response.ok) throw new Error(data.error ?? 'Tunnel inventory failed.');
        const tunnels = data.tunnels ?? [];
        if (tnRows) tnRows.innerHTML = tunnels.length ? tunnels.map((t: any) => `<tr><td>${tnEscapeHtml(t.name)}</td><td>${tnEscapeHtml(t.status ?? 'unknown')}</td><td>${tnEscapeHtml(t.configSrc ?? 'local')}</td><td>${t.activeAt ? new Date(t.activeAt).toLocaleString() : 'Never'}</td><td class="gs-row"><button class="gs-button gs-button--secondary" data-config="${tnEscapeHtml(t.id)}" data-name="${tnEscapeHtml(t.name)}" ${t.configSrc === 'cloudflare' ? '' : 'disabled'}>Configure</button><button class="gs-button gs-button--secondary" data-delete="${tnEscapeHtml(t.id)}" data-name="${tnEscapeHtml(t.name)}" ${['inactive', 'down'].includes(t.status) ? '' : 'disabled'}>Delete</button></td></tr>`).join('') : '<tr><td colspan="5" class="gs-text-subtle">No active tunnels found.</td></tr>';
      } catch (error) {
        if (tnRows) tnRows.innerHTML = `<tr><td colspan="5" class="gs-text-danger">${tnEscapeHtml(error instanceof Error ? error.message : 'Network error')}</td></tr>`;
      }
    }

    document.getElementById('tn-create-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = (document.getElementById('tn-tunnel-name') as HTMLInputElement).value.trim();
      if (!confirm(`Create remotely managed Cloudflare Tunnel "${name}"?`)) return;
      const response = await fetch('/api/admin/cf/tunnels', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name, confirm: true }) });
      const data = await response.json().catch(() => ({}));
      tnMessage(response.ok ? 'Tunnel created. Install its connector from the Cloudflare dashboard; credentials are intentionally not exposed here.' : data.error ?? 'Create failed.');
      if (response.ok) { (document.getElementById('tn-tunnel-name') as HTMLInputElement).value = ''; await tnLoad(); }
    });

    tnRows?.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const configure = target.closest<HTMLButtonElement>('[data-config]');
      if (configure) {
        tnSelected = configure.dataset.config!;
        tnMessage('Loading configuration…');
        const response = await fetch(`/api/admin/cf/tunnels/${encodeURIComponent(tnSelected)}/configuration`);
        const data = await response.json();
        if (!response.ok) { tnMessage(data.error ?? 'Load failed.'); return; }
        (document.getElementById('tn-config-name')!).textContent = configure.dataset.name ?? '';
        (document.getElementById('tn-ingress') as HTMLTextAreaElement).value = JSON.stringify(data.config?.ingress ?? [], null, 2);
        tnDialog.showModal();
        tnMessage('');
        return;
      }
      const remove = target.closest<HTMLButtonElement>('[data-delete]');
      if (!remove) return;
      const name = remove.dataset.name!;
      const entered = prompt(`Type ${name} to delete this inactive/down tunnel.`);
      if (entered !== name) return;
      const response = await fetch(`/api/admin/cf/tunnels/${encodeURIComponent(remove.dataset.delete!)}?confirm=true&name=${encodeURIComponent(name)}`, { method: 'DELETE' });
      tnMessage(response.ok ? 'Tunnel deleted.' : (await response.json().catch(() => ({}))).error ?? 'Delete failed.');
      if (response.ok) await tnLoad();
    });

    document.getElementById('tn-save-config')?.addEventListener('click', async () => {
      let ingress;
      try { ingress = JSON.parse((document.getElementById('tn-ingress') as HTMLTextAreaElement).value); } catch { tnMessage('Ingress must be valid JSON.'); return; }
      if (!confirm('Replace the live tunnel ingress configuration?')) return;
      const response = await fetch(`/api/admin/cf/tunnels/${encodeURIComponent(tnSelected)}/configuration`, { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ingress, confirm: true }) });
      const data = await response.json().catch(() => ({}));
      tnMessage(response.ok ? 'Tunnel configuration saved.' : data.error ?? 'Save failed.');
      if (response.ok) tnDialog.close();
    });

    tnLoad();
  </script>
</AdminLayout>
