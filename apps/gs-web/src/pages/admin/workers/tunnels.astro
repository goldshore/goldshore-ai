---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Cloudflare Tunnels | GoldShore Admin" requiredPermission="cloudflare_inventory:read">
  <section class="max-w-6xl mx-auto py-24 px-6 space-y-6">
    <div><h1 class="text-3xl gs-heading">Cloudflare Tunnels</h1><p class="gs-text-subtle mt-2">Inventory and guarded configuration for GoldShore private origins.</p></div>
    <form id="create-form" class="gs-card flex gap-3 items-end flex-wrap">
      <label class="space-y-1 flex-1"><span class="block text-sm">New remotely managed tunnel</span><input id="tunnel-name" class="gs-input w-full" required maxlength="100" placeholder="goldshore-admin-origin" /></label>
      <button class="gs-btn-primary px-4 py-2" type="submit">Create tunnel</button>
    </form>
    <p id="status" class="text-sm gs-text-subtle" role="status"></p>
    <div class="gs-card overflow-x-auto"><table class="w-full text-left"><thead><tr class="border-b"><th class="pb-2">Name</th><th>Status</th><th>Management</th><th>Last active</th><th>Actions</th></tr></thead><tbody id="rows"><tr><td colspan="5" class="py-4 gs-text-subtle">Loading tunnels…</td></tr></tbody></table></div>
    <dialog id="config-dialog" class="gs-card p-6 max-w-3xl w-full backdrop:bg-black/60">
      <form method="dialog" class="space-y-4">
        <div class="flex justify-between"><div><h2 class="text-xl font-semibold">Tunnel ingress</h2><p id="config-name" class="text-sm gs-text-subtle"></p></div><button class="gs-btn-secondary px-3" value="cancel">Close</button></div>
        <p class="text-sm gs-text-subtle">One JSON rule per hostname. Only goldshore.ai and goldshore.org hostnames are accepted. The final rule must be a catch-all such as <code>{`{"service":"http_status:404"}`}</code>.</p>
        <textarea id="ingress" class="gs-input w-full font-mono text-sm" rows="14" spellcheck="false"></textarea>
        <button id="save-config" class="gs-btn-primary px-4 py-2" type="button">Save confirmed configuration</button>
      </form>
    </dialog>
  </section>
  <script>
    const rows = document.getElementById('rows'); const status = document.getElementById('status'); const dialog = document.getElementById('config-dialog') as HTMLDialogElement;
    const escapeHtml=(v:unknown)=>String(v??'').replace(/[&<>'"]/g,c=>({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' }[c]??c)); let selected='';
    const message=(value:string)=>{if(status)status.textContent=value;};
    async function load(){try{const response=await fetch('/api/admin/cf/tunnels');const data=await response.json();if(!response.ok)throw new Error(data.error??'Tunnel inventory failed.');const tunnels=data.tunnels??[];if(rows)rows.innerHTML=tunnels.length?tunnels.map((t:any)=>`<tr class="border-b"><td class="py-3 font-medium">${escapeHtml(t.name)}</td><td>${escapeHtml(t.status??'unknown')}</td><td>${escapeHtml(t.configSrc??'local')}</td><td>${t.activeAt?new Date(t.activeAt).toLocaleString():'Never'}</td><td class="space-x-2"><button class="gs-btn-secondary px-2 py-1" data-config="${escapeHtml(t.id)}" data-name="${escapeHtml(t.name)}" ${t.configSrc==='cloudflare'?'':'disabled'}>Configure</button><button class="gs-btn-secondary px-2 py-1" data-delete="${escapeHtml(t.id)}" data-name="${escapeHtml(t.name)}" ${['inactive','down'].includes(t.status)?'':'disabled'}>Delete</button></td></tr>`).join(''):'<tr><td colspan="5" class="py-4 gs-text-subtle">No active tunnels found.</td></tr>';}catch(error){if(rows)rows.innerHTML=`<tr><td colspan="5" class="py-4 gs-text-danger">${escapeHtml(error instanceof Error?error.message:'Network error')}</td></tr>`;}}
    document.getElementById('create-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const name=(document.getElementById('tunnel-name') as HTMLInputElement).value.trim();if(!confirm(`Create remotely managed Cloudflare Tunnel “${name}”?`))return;const response=await fetch('/api/admin/cf/tunnels',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name,confirm:true})});const data=await response.json().catch(()=>({}));message(response.ok?'Tunnel created. Install its connector from the Cloudflare dashboard; credentials are intentionally not exposed here.':data.error??'Create failed.');if(response.ok){(document.getElementById('tunnel-name') as HTMLInputElement).value='';await load();}});
    rows?.addEventListener('click',async(event)=>{const target=event.target as HTMLElement;const configure=target.closest<HTMLButtonElement>('[data-config]');if(configure){selected=configure.dataset.config!;message('Loading configuration…');const response=await fetch(`/api/admin/cf/tunnels/${encodeURIComponent(selected)}/configuration`);const data=await response.json();if(!response.ok){message(data.error??'Load failed.');return;}(document.getElementById('config-name')!).textContent=configure.dataset.name??'';(document.getElementById('ingress') as HTMLTextAreaElement).value=JSON.stringify(data.config?.ingress??[],null,2);dialog.showModal();message('');return;}const remove=target.closest<HTMLButtonElement>('[data-delete]');if(!remove)return;const name=remove.dataset.name!;const entered=prompt(`Type ${name} to delete this inactive/down tunnel.`);if(entered!==name)return;const response=await fetch(`/api/admin/cf/tunnels/${encodeURIComponent(remove.dataset.delete!)}?confirm=true&name=${encodeURIComponent(name)}`,{method:'DELETE'});message(response.ok?'Tunnel deleted.':(await response.json().catch(()=>({}))).error??'Delete failed.');if(response.ok)await load();});
    document.getElementById('save-config')?.addEventListener('click',async()=>{let ingress;try{ingress=JSON.parse((document.getElementById('ingress') as HTMLTextAreaElement).value);}catch{message('Ingress must be valid JSON.');return;}if(!confirm('Replace the live tunnel ingress configuration?'))return;const response=await fetch(`/api/admin/cf/tunnels/${encodeURIComponent(selected)}/configuration`,{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify({ingress,confirm:true})});const data=await response.json().catch(()=>({}));message(response.ok?'Tunnel configuration saved.':data.error??'Save failed.');if(response.ok)dialog.close();});
    load();
  </script>
</AdminLayout>
