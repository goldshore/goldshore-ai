---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---
<AdminLayout title="Worker Bindings | GoldShore Admin">
    <section class="max-w-5xl mx-auto py-24 px-6 space-y-6">
        <h1 class="text-3xl gs-heading mb-4">Worker Bindings</h1>
        <p class="text-[var(--gs-text-secondary)]">
            Resource bindings, environment variables, and secrets mapped to each worker.
        </p>

        <div class="gs-card space-y-4">
            <div class="flex items-center gap-4 flex-wrap">
                <label for="worker-select" class="text-sm font-medium gs-text-subtle whitespace-nowrap">Select worker:</label>
                <select id="worker-select" class="gs-input text-sm" style="min-width: 220px;">
                    <option value="">Loading workers…</option>
                </select>
            </div>
        </div>

        <div id="bindings-section" class="gs-card space-y-4" style="display: none;">
            <h2 class="text-xl font-semibold">Bindings</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-sm gs-text-subtle border-b border-[var(--gs-color-border)]">
                            <th class="pb-2">Binding Name</th>
                            <th class="pb-2">Type</th>
                            <th class="pb-2">Resource</th>
                        </tr>
                    </thead>
                    <tbody id="bindings-table-body">
                        <tr><td class="py-3 text-sm gs-text-subtle" colspan="3">Select a worker to view bindings.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="bindings-error" class="gs-card" style="display: none;">
            <p id="bindings-error-msg" class="text-sm gs-text-danger"></p>
            <p class="gs-text-subtle text-xs mt-1">Ensure <code>CF_ACCOUNT_ID</code> and <code>CF_API_TOKEN</code> are set in your environment.</p>
        </div>
    </section>

    <script>
        const workerSelect = document.getElementById('worker-select') as HTMLSelectElement | null;
        const bindingsSection = document.getElementById('bindings-section');
        const bindingsTableBody = document.getElementById('bindings-table-body');
        const bindingsError = document.getElementById('bindings-error');
        const bindingsErrorMsg = document.getElementById('bindings-error-msg');

        function showError(msg: string) {
            if (bindingsSection) bindingsSection.style.display = 'none';
            if (bindingsError) bindingsError.style.display = 'block';
            if (bindingsErrorMsg) bindingsErrorMsg.textContent = msg;
        }

        function hideError() {
            if (bindingsError) bindingsError.style.display = 'none';
        }

        async function loadWorkerList() {
            try {
                const res = await fetch('/api/cf/workers');
                const data = await res.json();

                if (!res.ok || data.error) {
                    if (workerSelect) workerSelect.innerHTML = '<option value="">Failed to load workers</option>';
                    showError(data.error ?? 'Could not load worker list.');
                    return;
                }

                const workers: Array<{ id: string }> = data.result ?? [];
                if (workerSelect) {
                    workerSelect.innerHTML = '<option value="">— choose a worker —</option>' +
                        workers.map((w) => `<option value="${w.id}">${w.id}</option>`).join('');
                }
            } catch {
                if (workerSelect) workerSelect.innerHTML = '<option value="">Network error</option>';
                showError('Network error — could not reach /api/cf/workers.');
            }
        }

        async function loadBindings(name: string) {
            hideError();
            if (bindingsSection) bindingsSection.style.display = 'none';
            if (!name) return;

            if (bindingsTableBody) {
                bindingsTableBody.innerHTML = '<tr><td class="py-3 text-sm gs-text-subtle" colspan="3">Loading bindings…</td></tr>';
            }
            if (bindingsSection) bindingsSection.style.display = 'block';

            try {
                const res = await fetch(`/api/cf/worker-detail?name=${encodeURIComponent(name)}`);
                const data = await res.json();

                if (!res.ok || data.error) {
                    showError(data.error ?? 'Failed to load worker detail.');
                    if (bindingsSection) bindingsSection.style.display = 'none';
                    return;
                }

                const bindings: Array<{ name: string; type: string; [key: string]: unknown }> = data.bindings ?? [];

                if (!bindings.length) {
                    if (bindingsTableBody) {
                        bindingsTableBody.innerHTML = '<tr><td class="py-3 text-sm gs-text-subtle" colspan="3">No bindings found for this worker.</td></tr>';
                    }
                    return;
                }

                if (bindingsTableBody) {
                    bindingsTableBody.innerHTML = bindings.map((b) => {
                        const resource = b.namespace_id ?? b.bucket_name ?? b.service ?? b.dataset ?? b.text ?? b.json ?? '—';
                        return `<tr class="border-b border-[var(--gs-color-border)]/50">
                            <td class="py-2 font-mono text-sm">${b.name}</td>
                            <td class="py-2 text-sm">${b.type}</td>
                            <td class="py-2 text-sm gs-text-subtle">${resource}</td>
                        </tr>`;
                    }).join('');
                }
            } catch {
                showError('Network error — could not reach /api/cf/worker-detail.');
                if (bindingsSection) bindingsSection.style.display = 'none';
            }
        }

        workerSelect?.addEventListener('change', () => {
            loadBindings(workerSelect.value);
        });

        loadWorkerList();
    </script>
</AdminLayout>
