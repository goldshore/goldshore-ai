---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { authorizeAdminRequest, getAdminAuthError, getAdminRouteRule } from '../../../utils/admin-access';

export const prerender = false;

const env = Astro.locals.runtime?.env as Env | undefined;
const rule = getAdminRouteRule('/admin/workers/bindings', 'GET');

let authError: { status: number; message: string } | null = null;
if (!rule) {
  authError = { status: 404, message: 'Not found.' };
} else {
  const authResult = await authorizeAdminRequest(Astro.request, env as never, rule);
  authError = getAdminAuthError(authResult);
}
---

<BaseLayout title="Worker Bindings | GoldShore Admin" description="Resource bindings mapped to each Worker">
  <section class="gs-section">
    <div class="gs-grid columns-2">
      <div>
        <h1>Worker bindings</h1>
        <p class="gs-text-lg">Resource bindings mapped to each deployed Worker.</p>
      </div>
      <div class="gs-card">
        <h2 class="section-title"><span>◆</span>Actions</h2>
        <ul>
          <li><a href="/admin/workers/status">Worker status</a></li>
          <li><a href="/admin/workers/routes">Worker routes</a></li>
        </ul>
      </div>
    </div>

    {authError ? (
      <div class="gs-card" style="margin-top: 2rem;">
        <p class="gs-text-lg">{authError.message}</p>
      </div>
    ) : (
      <>
        <div class="gs-card" style="margin-top: 2rem;">
          <div class="gs-input-group">
            <label for="worker-select">Select worker</label>
            <select id="worker-select">
              <option value="">Loading workers…</option>
            </select>
          </div>
        </div>

        <div id="bindings-section" class="gs-card" style="margin-top: 2rem; display: none; overflow-x: auto;">
          <table class="gs-table">
            <thead>
              <tr><th>Binding name</th><th>Type</th><th>Resource</th></tr>
            </thead>
            <tbody id="bindings-table-body">
              <tr><td colspan="3">Select a worker to view bindings.</td></tr>
            </tbody>
          </table>
        </div>

        <div id="bindings-error" class="gs-card" style="margin-top: 2rem; display: none;">
          <p id="bindings-error-msg" class="gs-text-lg"></p>
        </div>
      </>
    )}
  </section>

  <script>
    const workerSelect = document.getElementById('worker-select') as HTMLSelectElement | null;
    const bindingsSection = document.getElementById('bindings-section');
    const bindingsTableBody = document.getElementById('bindings-table-body');
    const bindingsError = document.getElementById('bindings-error');
    const bindingsErrorMsg = document.getElementById('bindings-error-msg');

    function showError(msg: string) {
      if (bindingsSection) bindingsSection.style.display = 'none';
      if (bindingsError) bindingsError.style.display = 'block';
      if (bindingsErrorMsg) bindingsErrorMsg.textContent = msg;
    }

    function hideError() {
      if (bindingsError) bindingsError.style.display = 'none';
    }

    async function loadWorkerList() {
      try {
        const res = await fetch('/api/admin/cf/workers');
        const data = await res.json();

        if (!res.ok || !data.success) {
          if (workerSelect) workerSelect.innerHTML = '<option value="">Failed to load workers</option>';
          showError(data.error ?? 'Could not load worker list.');
          return;
        }

        const workers: Array<{ id: string }> = data.workers ?? [];
        if (workerSelect) {
          workerSelect.innerHTML =
            '<option value="">— choose a worker —</option>' +
            workers.map((w) => `<option value="${w.id}">${w.id}</option>`).join('');
        }
      } catch {
        if (workerSelect) workerSelect.innerHTML = '<option value="">Network error</option>';
        showError('Network error — could not reach /api/admin/cf/workers.');
      }
    }

    async function loadBindings(name: string) {
      hideError();
      if (bindingsSection) bindingsSection.style.display = 'none';
      if (!name) return;

      if (bindingsTableBody) {
        bindingsTableBody.innerHTML = '<tr><td colspan="3">Loading bindings…</td></tr>';
      }
      if (bindingsSection) bindingsSection.style.display = 'block';

      try {
        const res = await fetch(`/api/admin/cf/worker-detail?name=${encodeURIComponent(name)}`);
        const data = await res.json();

        if (!res.ok || !data.success) {
          showError(data.error ?? 'Failed to load worker detail.');
          if (bindingsSection) bindingsSection.style.display = 'none';
          return;
        }

        const bindings: Array<{ name?: string; type: string; [key: string]: unknown }> = data.bindings ?? [];

        if (!bindings.length) {
          if (bindingsTableBody) {
            bindingsTableBody.innerHTML = '<tr><td colspan="3">No bindings found for this worker.</td></tr>';
          }
          return;
        }

        if (bindingsTableBody) {
          bindingsTableBody.innerHTML = bindings
            .map((b) => {
              const resource = b.namespace_id ?? b.bucket_name ?? b.service ?? b.dataset ?? b.class_name ?? '—';
              return `<tr><td>${b.name ?? '—'}</td><td>${b.type}</td><td class="gs-text-sm">${resource}</td></tr>`;
            })
            .join('');
        }
      } catch {
        showError('Network error — could not reach /api/admin/cf/worker-detail.');
        if (bindingsSection) bindingsSection.style.display = 'none';
      }
    }

    workerSelect?.addEventListener('change', () => loadBindings(workerSelect.value));
    loadWorkerList();
  </script>
</BaseLayout>
