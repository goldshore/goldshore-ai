---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---
<AdminLayout title="Worker Routes | GoldShore Admin">
    <section class="max-w-5xl mx-auto py-24 px-6 space-y-6">
        <h1 class="text-3xl gs-heading mb-4">Worker Routes</h1>
        <p class="text-[var(--gs-text-secondary)]">
            Route tables, domains, and traffic rules for each deployed worker.
        </p>

        <div class="gs-card space-y-4">
            <div class="flex items-center gap-4 flex-wrap">
                <label for="worker-select" class="text-sm font-medium gs-text-subtle whitespace-nowrap">Select worker:</label>
                <select id="worker-select" class="gs-input text-sm" style="min-width: 220px;">
                    <option value="">Loading workers…</option>
                </select>
                <a id="cf-dashboard-link" href="#" target="_blank" rel="noopener noreferrer"
                   class="gs-btn-secondary text-sm px-4 py-2 ml-auto"
                   style="display: none;">
                    CF Dashboard ↗
                </a>
            </div>
            <form id="route-form" class="flex items-end gap-3 flex-wrap">
                <label class="space-y-1 flex-1"><span class="block text-sm">New route pattern</span><input id="route-pattern" class="gs-input w-full" required placeholder="api.goldshore.ai/*" /></label>
                <button class="gs-btn-primary px-4 py-2" type="submit">Add confirmed route</button>
            </form>
            <p id="route-status" class="text-sm gs-text-subtle" role="status"></p>
        </div>

        <div id="routes-section" class="gs-card space-y-4" style="display: none;">
            <h2 class="text-xl font-semibold">Routes</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-sm gs-text-subtle border-b border-[var(--gs-color-border)]">
                            <th class="pb-2">Pattern</th>
                            <th class="pb-2">Zone</th>
                            <th class="pb-2">Created</th><th class="pb-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="routes-table-body">
                        <tr><td class="py-3 text-sm gs-text-subtle" colspan="4">Select a worker to view routes.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="routes-error" class="gs-card" style="display: none;">
            <p id="routes-error-msg" class="text-sm gs-text-danger"></p>
            <p class="gs-text-subtle text-xs mt-1">Ensure <code>CF_ACCOUNT_ID</code> and <code>CF_API_TOKEN</code> are set in your environment.</p>
        </div>
    </section>

    <script>
        const CF_ACCOUNT_ID_PLACEHOLDER = '__CF_ACCOUNT_PLACEHOLDER__';

        const workerSelect = document.getElementById('worker-select') as HTMLSelectElement | null;
        const routesSection = document.getElementById('routes-section');
        const routesTableBody = document.getElementById('routes-table-body');
        const routesError = document.getElementById('routes-error');
        const routesErrorMsg = document.getElementById('routes-error-msg');
        const cfDashboardLink = document.getElementById('cf-dashboard-link') as HTMLAnchorElement | null;

        let cfAccountId = '';

        const routeStatus = document.getElementById('route-status');
        const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' })[character] ?? character);
        function showError(msg: string) {
            if (routesSection) routesSection.style.display = 'none';
            if (routesError) routesError.style.display = 'block';
            if (routesErrorMsg) routesErrorMsg.textContent = msg;
        }

        function hideError() {
            if (routesError) routesError.style.display = 'none';
        }

        function updateDashboardLink(name: string) {
            if (!cfDashboardLink) return;
            if (!name) {
                cfDashboardLink.style.display = 'none';
                return;
            }
            const accountSegment = cfAccountId || CF_ACCOUNT_ID_PLACEHOLDER;
            cfDashboardLink.href = `https://dash.cloudflare.com/${accountSegment}/workers/services/view/${encodeURIComponent(name)}/production/settings`;
            cfDashboardLink.style.display = 'inline-flex';
        }

        async function loadWorkerList() {
            try {
                const res = await fetch('/api/admin/cf/workers');
                const data = await res.json();

                if (!res.ok || data.error) {
                    if (workerSelect) workerSelect.innerHTML = '<option value="">Failed to load workers</option>';
                    showError(data.error ?? 'Could not load worker list.');
                    return;
                }

                cfAccountId = data.accountId ?? '';

                const workers: Array<{ id: string }> = data.workers ?? [];
                if (workerSelect) {
                    workerSelect.innerHTML = '<option value="">— choose a worker —</option>' +
                        workers.map((w) => `<option value="${w.id}">${w.id}</option>`).join('');
                }
            } catch {
                if (workerSelect) workerSelect.innerHTML = '<option value="">Network error</option>';
                showError('Network error — could not reach the Worker inventory API.');
            }
        }

        async function loadRoutes(name: string) {
            hideError();
            if (routesSection) routesSection.style.display = 'none';
            updateDashboardLink(name);
            if (!name) return;

            if (routesTableBody) {
                routesTableBody.innerHTML = '<tr><td class="py-3 text-sm gs-text-subtle" colspan="4">Loading routes…</td></tr>';
            }
            if (routesSection) routesSection.style.display = 'block';

            try {
                const res = await fetch(`/api/admin/cf/worker-detail?name=${encodeURIComponent(name)}`);
                const data = await res.json();

                if (!res.ok || data.error) {
                    showError(data.error ?? 'Failed to load worker detail.');
                    if (routesSection) routesSection.style.display = 'none';
                    return;
                }

                const routes: Array<{ id?: string; pattern: string; zone_name?: string; created_on?: string }> = data.routes ?? [];

                if (!routes.length) {
                    if (routesTableBody) {
                        routesTableBody.innerHTML = '<tr><td class="py-3 text-sm gs-text-subtle" colspan="4">No routes found for this worker on GoldShore zones.</td></tr>';
                    }
                    return;
                }

                if (routesTableBody) {
                    routesTableBody.innerHTML = routes.map((r) => `
                        <tr class="border-b border-[var(--gs-color-border)]/50">
                            <td class="py-2 font-mono text-sm">${escapeHtml(r.pattern)}</td>
                            <td class="py-2 text-sm gs-text-subtle">${escapeHtml(r.zone_name ?? 'goldshore.ai')}</td>
                            <td class="py-2 text-sm gs-text-subtle">${r.created_on ? new Date(r.created_on).toLocaleString() : '—'}</td>
                            <td class="py-2">${r.id ? `<button class="gs-btn-secondary px-2 py-1" data-delete-route="${escapeHtml(r.id)}">Delete</button>` : '—'}</td>
                        </tr>`).join('');
                }
            } catch {
                showError('Network error — could not reach /api/cf/worker-detail.');
                if (routesSection) routesSection.style.display = 'none';
            }
        }

        workerSelect?.addEventListener('change', () => {
            loadRoutes(workerSelect.value);
        });

        document.getElementById('route-form')?.addEventListener('submit', async (event) => {
            event.preventDefault();
            const pattern = (document.getElementById('route-pattern') as HTMLInputElement).value.trim();
            if (!workerSelect?.value) { if (routeStatus) routeStatus.textContent = 'Choose a Worker first.'; return; }
            if (!confirm(`Route ${pattern} to ${workerSelect.value}? This changes live Cloudflare traffic.`)) return;
            const response = await fetch('/api/admin/cf/routes', { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify({ pattern, script:workerSelect.value, confirm:true }) });
            const payload = await response.json().catch(() => ({})); if (routeStatus) routeStatus.textContent = response.ok ? 'Route created.' : payload.error ?? 'Route creation failed.';
            if (response.ok) { (document.getElementById('route-pattern') as HTMLInputElement).value=''; await loadRoutes(workerSelect.value); }
        });
        routesTableBody?.addEventListener('click', async (event) => {
            const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-route]'); if (!button || !workerSelect?.value) return;
            if (!confirm('Delete this live Worker route? Traffic will stop matching immediately.')) return;
            const response = await fetch(`/api/admin/cf/routes/${encodeURIComponent(button.dataset.deleteRoute!)}?confirm=true`, { method:'DELETE' });
            if (routeStatus) routeStatus.textContent = response.ok ? 'Route deleted.' : (await response.json().catch(()=>({}))).error ?? 'Route deletion failed.';
            if (response.ok) await loadRoutes(workerSelect.value);
        });

        loadWorkerList();
    </script>
</AdminLayout>
