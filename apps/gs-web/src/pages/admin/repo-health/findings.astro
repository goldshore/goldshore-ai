---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { GSButton } from '@goldshore/ui';
import { fetchAdminJson } from '../../../lib/api-proxy';

interface Finding {
  id: string;
  issue_id: number;
  title: string;
  severity: 'critical' | 'high' | 'medium' | 'low';
  status: 'open' | 'in_progress' | 'resolved';
  url: string;
  labels: string[];
  description?: string;
  created_at: string;
  updated_at: string;
  resolution_date?: string;
}

let findings: Finding[] = [];
let error: string | null = null;
let total = 0;
let criticalCount = 0;
let highCount = 0;

const page = Number(Astro.url.searchParams.get('page')) || 1;
const severity = Astro.url.searchParams.get('severity') || '';
const status = Astro.url.searchParams.get('status') || '';
const pageSize = 25;

try {
  const params = new URLSearchParams();
  params.append('page', String(page));
  params.append('limit', String(pageSize));
  if (severity) params.append('severity', severity);
  if (status) params.append('status', status);

  const result = await fetchAdminJson<any>(Astro.request, `/admin/repo-health/findings?${params}`);

  if (!result.ok) {
    error = `Failed to fetch findings: ${result.status}`;
  } else {
    const data = result.data;
    findings = data.data || [];
    total = data.total || 0;
    criticalCount = data.summary?.critical || 0;
    highCount = data.summary?.high || 0;
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error fetching findings';
}

const totalPages = Math.ceil(total / pageSize);
const severityColors = {
  critical: 'gs-severity-critical',
  high: 'gs-severity-high',
  medium: 'gs-severity-medium',
  low: 'gs-severity-low',
};

const buildQueryString = (newParams: Record<string, string>) => {
  const params = new URLSearchParams();
  params.append('page', String(newParams.page || 1));
  if (newParams.severity) params.append('severity', newParams.severity);
  if (newParams.status) params.append('status', newParams.status);
  return params.toString();
};
---

<AdminLayout title="Repo Health Findings | GoldShore Admin">
  <div class="gs-page gs-stack">
    <div class="gs-row gs-row--between gs-row--start">
      <div>
        <h1 class="gs-heading gs-text-accent">Audit Findings</h1>
        <p class="gs-text-lg gs-text-subtle">Complete list of repository audit findings and security issues.</p>
      </div>
      <GSButton variant="secondary" href="/admin/repo-health">← Back to Summary</GSButton>
    </div>

    {error && (
      <div class="gs-card">
        <p class="gs-text-danger">Error loading findings</p>
        <p class="gs-text-sm gs-text-subtle">{error}</p>
      </div>
    )}

    {!error && (
      <>
        {/* Summary Cards */}
        <div class="gs-list-grid">
          <div class="gs-card gs-stack-sm">
            <h2 class="gs-text-sm gs-text-subtle">Total Findings</h2>
            <p class="gs-stat gs-text-accent">{total}</p>
            <p class="gs-text-sm gs-text-subtle">All issues across severities</p>
          </div>

          <div class="gs-card gs-stack-sm">
            <h2 class="gs-text-sm gs-text-subtle">Critical</h2>
            <p class="gs-stat gs-text-critical">{criticalCount}</p>
            <p class="gs-text-sm gs-text-subtle">Requires immediate action</p>
          </div>

          <div class="gs-card gs-stack-sm">
            <h2 class="gs-text-sm gs-text-subtle">High</h2>
            <p class="gs-stat gs-text-warning">{highCount}</p>
            <p class="gs-text-sm gs-text-subtle">Address this sprint</p>
          </div>

          <div class="gs-card gs-stack-sm">
            <h2 class="gs-text-sm gs-text-subtle">Results</h2>
            <p class="gs-stat gs-text-accent">{findings.length}</p>
            <p class="gs-text-sm gs-text-subtle">On this page</p>
          </div>
        </div>

        {/* Filters */}
        <div class="gs-card gs-stack">
          <h2 class="gs-text-lg">Filters</h2>
          <div class="gs-row">
            <div>
              <label class="gs-text-sm gs-text-subtle">Severity</label>
              <select class="gs-text-sm"
                onchange={`window.location.href='?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), severity: this.value || '' })}'`}>
                <option value="">All severities</option>
                <option value="critical" selected={severity === 'critical'}>Critical</option>
                <option value="high" selected={severity === 'high'}>High</option>
                <option value="medium" selected={severity === 'medium'}>Medium</option>
                <option value="low" selected={severity === 'low'}>Low</option>
              </select>
            </div>
            <div>
              <label class="gs-text-sm gs-text-subtle">Status</label>
              <select class="gs-text-sm"
                onchange={`window.location.href='?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), status: this.value || '' })}'`}>
                <option value="">All statuses</option>
                <option value="open" selected={status === 'open'}>Open</option>
                <option value="in_progress" selected={status === 'in_progress'}>In Progress</option>
                <option value="resolved" selected={status === 'resolved'}>Resolved</option>
              </select>
            </div>
          </div>
        </div>

        {/* Findings List */}
        <div class="gs-card gs-stack">
          <h2 class="gs-text-lg">Issues ({findings.length} of {total})</h2>

          {findings.length === 0 ? (
            <p class="gs-text-subtle">No findings match your filters.</p>
          ) : (
            <div class="gs-stack-sm">
              {findings.map((finding) => (
                <a
                  href={finding.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="gs-row gs-row--between gs-row--start">
                    <div class="gs-row">
                      <span class={`gs-text-sm ${severityColors[finding.severity]}`}>
                        {finding.severity.toUpperCase()}
                      </span>
                      <span class="gs-text-sm gs-text-subtle gs-mono">
                        #{finding.issue_id}
                      </span>
                    </div>
                    <span class={`gs-badge ${
                      finding.status === 'open' ? 'danger' :
                      finding.status === 'in_progress' ? 'warning' :
                      'success'
                    }`}>
                      {finding.status === 'open' ? 'Open' :
                       finding.status === 'in_progress' ? 'In Progress' :
                       'Resolved'}
                    </span>
                  </div>

                  <p class="gs-text-accent">{finding.title}</p>

                  {finding.description && (
                    <p class="gs-text-sm gs-text-subtle">{finding.description}</p>
                  )}

                  <div class="gs-row">
                    {finding.labels.map((label) => (
                      <span class="gs-text-sm gs-text-subtle">
                        {label}
                      </span>
                    ))}
                  </div>

                  <div class="gs-row gs-text-sm gs-text-subtle">
                    <span>Created: {new Date(finding.created_at).toLocaleDateString()}</span>
                    <span>Updated: {new Date(finding.updated_at).toLocaleDateString()}</span>
                    {finding.resolution_date && (
                      <span>Resolved: {new Date(finding.resolution_date).toLocaleDateString()}</span>
                    )}
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <div class="gs-card gs-row">
            {page > 1 && (
              <a href={`?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), page: String(page - 1) })}`}>
                ← Previous
              </a>
            )}

            <span class="gs-text-sm gs-text-subtle">
              Page {page} of {totalPages}
            </span>

            {page < totalPages && (
              <a href={`?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), page: String(page + 1) })}`}>
                Next →
              </a>
            )}
          </div>
        )}
      </>
    )}
  </div>
</AdminLayout>

<style>
  .gs-severity-critical {
    @apply bg-red-100 text-red-700 font-semibold;
  }

  .gs-severity-high {
    @apply bg-orange-100 text-orange-700 font-semibold;
  }

  .gs-severity-medium {
    @apply bg-yellow-100 text-yellow-700 font-semibold;
  }

  .gs-severity-low {
    @apply bg-blue-100 text-blue-700 font-semibold;
  }

  .gs-text-critical {
    @apply text-red-600;
  }

  .gs-text-warning {
    @apply text-yellow-600;
  }
</style>
