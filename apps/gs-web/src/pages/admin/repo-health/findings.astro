---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { GSButton } from '@goldshore/ui';
import { fetchAdminJson } from '../../../lib/api-proxy';

interface Finding {
  id: string;
  issue_id: number;
  title: string;
  severity: 'critical' | 'high' | 'medium' | 'low';
  status: 'open' | 'in_progress' | 'resolved';
  url: string;
  labels: string[];
  description?: string;
  created_at: string;
  updated_at: string;
  resolution_date?: string;
}

let findings: Finding[] = [];
let error: string | null = null;
let total = 0;
let criticalCount = 0;
let highCount = 0;

const page = Number(Astro.url.searchParams.get('page')) || 1;
const severity = Astro.url.searchParams.get('severity') || '';
const status = Astro.url.searchParams.get('status') || '';
const pageSize = 25;

try {
  const params = new URLSearchParams();
  params.append('page', String(page));
  params.append('limit', String(pageSize));
  if (severity) params.append('severity', severity);
  if (status) params.append('status', status);

  const result = await fetchAdminJson<any>(Astro.request, `/admin/repo-health/findings?${params}`);

  if (!result.ok) {
    error = `Failed to fetch findings: ${result.status}`;
  } else {
    const data = result.data;
    findings = data.data || [];
    total = data.total || 0;
    criticalCount = data.summary?.critical || 0;
    highCount = data.summary?.high || 0;
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error fetching findings';
}

const totalPages = Math.ceil(total / pageSize);
const severityColors = {
  critical: 'gs-severity-critical',
  high: 'gs-severity-high',
  medium: 'gs-severity-medium',
  low: 'gs-severity-low',
};

const buildQueryString = (newParams: Record<string, string>) => {
  const params = new URLSearchParams();
  params.append('page', String(newParams.page || 1));
  if (newParams.severity) params.append('severity', newParams.severity);
  if (newParams.status) params.append('status', newParams.status);
  return params.toString();
};
---

<AdminLayout title="Repo Health Findings | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-4xl gs-heading gs-text-accent">Audit Findings</h1>
        <p class="text-lg gs-text-subtle mt-2">Complete list of repository audit findings and security issues.</p>
      </div>
      <GSButton variant="secondary" href="/admin/repo-health">← Back to Summary</GSButton>
    </div>

    {error && (
      <div class="gs-card border-l-4 border-red-500 bg-red-50">
        <p class="gs-text-danger font-semibold">Error loading findings</p>
        <p class="text-sm gs-text-subtle mt-1">{error}</p>
      </div>
    )}

    {!error && (
      <>
        {/* Summary Cards */}
        <div class="grid md:grid-cols-4 gap-6">
          <div class="gs-card space-y-3">
            <h2 class="text-sm font-semibold gs-text-muted uppercase tracking-wider">Total Findings</h2>
            <p class="text-5xl font-bold gs-text-accent">{total}</p>
            <p class="text-xs gs-text-subtle">All issues across severities</p>
          </div>

          <div class="gs-card space-y-3">
            <h2 class="text-sm font-semibold gs-text-muted uppercase tracking-wider">Critical</h2>
            <p class="text-5xl font-bold gs-text-critical">{criticalCount}</p>
            <p class="text-xs gs-text-subtle">Requires immediate action</p>
          </div>

          <div class="gs-card space-y-3">
            <h2 class="text-sm font-semibold gs-text-muted uppercase tracking-wider">High</h2>
            <p class="text-5xl font-bold gs-text-warning">{highCount}</p>
            <p class="text-xs gs-text-subtle">Address this sprint</p>
          </div>

          <div class="gs-card space-y-3">
            <h2 class="text-sm font-semibold gs-text-muted uppercase tracking-wider">Results</h2>
            <p class="text-5xl font-bold gs-text-accent">{findings.length}</p>
            <p class="text-xs gs-text-subtle">On this page</p>
          </div>
        </div>

        {/* Filters */}
        <div class="gs-card space-y-4">
          <h2 class="text-lg font-semibold">Filters</h2>
          <div class="flex flex-wrap gap-4">
            <div>
              <label class="text-sm font-medium gs-text-muted block mb-2">Severity</label>
              <select class="px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm"
                onchange={`window.location.href='?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), severity: this.value || '' })}'`}>
                <option value="">All severities</option>
                <option value="critical" selected={severity === 'critical'}>Critical</option>
                <option value="high" selected={severity === 'high'}>High</option>
                <option value="medium" selected={severity === 'medium'}>Medium</option>
                <option value="low" selected={severity === 'low'}>Low</option>
              </select>
            </div>
            <div>
              <label class="text-sm font-medium gs-text-muted block mb-2">Status</label>
              <select class="px-3 py-2 border border-gray-300 rounded-lg bg-white text-sm"
                onchange={`window.location.href='?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), status: this.value || '' })}'`}>
                <option value="">All statuses</option>
                <option value="open" selected={status === 'open'}>Open</option>
                <option value="in_progress" selected={status === 'in_progress'}>In Progress</option>
                <option value="resolved" selected={status === 'resolved'}>Resolved</option>
              </select>
            </div>
          </div>
        </div>

        {/* Findings List */}
        <div class="gs-card space-y-4">
          <h2 class="text-lg font-semibold">Issues ({findings.length} of {total})</h2>

          {findings.length === 0 ? (
            <p class="gs-text-muted py-8 text-center">No findings match your filters.</p>
          ) : (
            <div class="space-y-3">
              {findings.map((finding) => (
                <a
                  href={finding.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block p-4 border border-gray-200 rounded hover:bg-gray-50 transition-colors"
                >
                  <div class="flex justify-between items-start gap-4 mb-3">
                    <div class="flex items-center gap-2">
                      <span class={`inline-block px-2 py-0.5 text-xs font-semibold rounded ${severityColors[finding.severity]}`}>
                        {finding.severity.toUpperCase()}
                      </span>
                      <span class="text-xs gs-text-muted font-mono">
                        #{finding.issue_id}
                      </span>
                    </div>
                    <span class={`text-xs font-semibold px-2 py-1 rounded whitespace-nowrap ${
                      finding.status === 'open' ? 'bg-red-100 text-red-700' :
                      finding.status === 'in_progress' ? 'bg-yellow-100 text-yellow-700' :
                      'bg-green-100 text-green-700'
                    }`}>
                      {finding.status === 'open' ? 'Open' :
                       finding.status === 'in_progress' ? 'In Progress' :
                       'Resolved'}
                    </span>
                  </div>

                  <p class="font-semibold gs-text-accent mb-2">{finding.title}</p>

                  {finding.description && (
                    <p class="text-sm gs-text-subtle mb-2">{finding.description}</p>
                  )}

                  <div class="flex flex-wrap gap-2 mb-2">
                    {finding.labels.map((label) => (
                      <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded">
                        {label}
                      </span>
                    ))}
                  </div>

                  <div class="flex gap-4 text-xs gs-text-muted">
                    <span>Created: {new Date(finding.created_at).toLocaleDateString()}</span>
                    <span>Updated: {new Date(finding.updated_at).toLocaleDateString()}</span>
                    {finding.resolution_date && (
                      <span>Resolved: {new Date(finding.resolution_date).toLocaleDateString()}</span>
                    )}
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <div class="gs-card flex justify-center items-center gap-2">
            {page > 1 && (
              <a href={`?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), page: String(page - 1) })}`}
                class="px-3 py-2 border border-gray-300 rounded hover:bg-gray-50">
                ← Previous
              </a>
            )}

            <span class="text-sm gs-text-muted">
              Page {page} of {totalPages}
            </span>

            {page < totalPages && (
              <a href={`?${buildQueryString({ ...Object.fromEntries(new URLSearchParams(window.location.search)), page: String(page + 1) })}`}
                class="px-3 py-2 border border-gray-300 rounded hover:bg-gray-50">
                Next →
              </a>
            )}
          </div>
        )}
      </>
    )}
  </div>
</AdminLayout>

<style>
  .gs-severity-critical {
    @apply bg-red-100 text-red-700 font-semibold;
  }

  .gs-severity-high {
    @apply bg-orange-100 text-orange-700 font-semibold;
  }

  .gs-severity-medium {
    @apply bg-yellow-100 text-yellow-700 font-semibold;
  }

  .gs-severity-low {
    @apply bg-blue-100 text-blue-700 font-semibold;
  }

  .gs-text-critical {
    @apply text-red-600;
  }

  .gs-text-warning {
    @apply text-yellow-600;
  }
</style>
