---
import AdminLayout from '../../layouts/AdminLayout.astro';
if (!Astro.locals.adminSession?.isAuthenticated) return Astro.redirect('/login');
---
<AdminLayout title="Automation Workflows | GoldShore Admin" requiredPermission="forms:read">
  <section class="max-w-7xl mx-auto py-16 px-6 space-y-6">
    <div><h1 class="text-3xl gs-heading">Automation workflows</h1><p class="gs-text-subtle mt-2">Queue-backed lead generation, public-list scraping, and structured page collection with durable results.</p></div>
    <div class="gs-card border-l-4 border-blue-500 text-sm">All crawls use HTTPS, remain on the submitted domain, honor robots.txt, cap response size, and process no more than ten pages per domain.</div>
    <form id="job-form" class="gs-card grid gap-4 md:grid-cols-2">
      <label class="space-y-1"><span class="block">Workflow</span><select id="job-kind" class="gs-input w-full"><option value="lead_generator">Lead generator</option><option value="list_scraper">Business list scraper</option><option value="data_collector">Page data collector</option></select></label>
      <label class="space-y-1"><span class="block">Maximum pages per domain</span><input id="max-pages" class="gs-input w-full" type="number" min="1" max="10" value="3" /></label>
      <label class="space-y-1 md:col-span-2"><span class="block">Domains (one per line, maximum 50)</span><textarea id="domains" class="gs-input w-full font-mono" rows="6" required placeholder="example.com&#10;example.org"></textarea></label>
      <label class="flex gap-2 items-center"><input id="respect-robots" type="checkbox" checked disabled /> robots.txt compliance required</label>
      <div class="text-right"><button class="gs-btn-primary px-4 py-2" type="submit">Queue workflow</button></div><p id="form-status" class="md:col-span-2 text-sm gs-text-subtle" role="status"></p>
    </form>
    <div class="gs-card space-y-4">
      <div class="flex gap-3 items-end flex-wrap"><label><span class="block text-sm">Kind</span><select id="filter-kind" class="gs-input"><option value="">All</option><option value="lead_generator">Lead generator</option><option value="list_scraper">List scraper</option><option value="data_collector">Data collector</option></select></label><label><span class="block text-sm">Status</span><select id="filter-status" class="gs-input"><option value="">All</option><option>queued</option><option>running</option><option>completed</option><option>failed</option><option>cancelled</option></select></label><button id="refresh" class="gs-btn-secondary px-4 py-2">Refresh</button></div>
      <div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr><th class="p-3">Workflow</th><th class="p-3">Domains</th><th class="p-3">Status</th><th class="p-3">Results</th><th class="p-3">Requested</th><th class="p-3">Actions</th></tr></thead><tbody id="jobs"><tr><td colspan="6" class="p-6">Loading jobs…</td></tr></tbody></table></div>
      <div class="flex justify-between"><button id="previous" class="gs-btn-secondary px-3 py-1">Previous</button><span id="page-label" class="gs-text-subtle"></span><button id="next" class="gs-btn-secondary px-3 py-1">Next</button></div>
    </div>
  </section>
  <dialog id="details" class="gs-card max-w-4xl w-full backdrop:bg-black/70"><div class="flex justify-between"><h2 class="text-xl">Workflow results</h2><button id="close-details">✕</button></div><div id="detail-summary" class="my-4 text-sm gs-text-subtle"></div><div class="overflow-auto max-h-[60vh]"><table class="w-full text-left text-sm"><thead><tr><th class="p-2">Source</th><th class="p-2">Type</th><th class="p-2">Collected data</th></tr></thead><tbody id="results"></tbody></table></div></dialog>
  <script>
    type Job={id:string;kind:string;status:string;input:{domains:string[];maxPages:number};summary:null|{pagesScanned:number;contactsFound:number;errors:number};created_at:string}; let page=1;let pages=1;
    const jobs=document.querySelector('#jobs') as HTMLTableSectionElement;const status=document.querySelector('#form-status') as HTMLElement;const escapeHtml=(v:unknown)=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]??c));
    const load=async()=>{const q=new URLSearchParams({page:String(page),pageSize:'25'});const kind=(document.querySelector('#filter-kind') as HTMLSelectElement).value;const state=(document.querySelector('#filter-status') as HTMLSelectElement).value;if(kind)q.set('kind',kind);if(state)q.set('status',state);const response=await fetch(`/api/admin/automation/jobs?${q}`);const data=await response.json();if(!response.ok){jobs.innerHTML=`<tr><td colspan="6">${escapeHtml(data.error??'Workflow API unavailable.')}</td></tr>`;return;}pages=data.pagination.pages;jobs.innerHTML=(data.items as Job[]).map(job=>`<tr class="border-t border-[var(--gs-color-border)]" data-job="${escapeHtml(job.id)}"><td class="p-3">${escapeHtml(job.kind.replaceAll('_',' '))}</td><td class="p-3">${job.input.domains.length}</td><td class="p-3">${escapeHtml(job.status)}</td><td class="p-3">${job.summary?`${job.summary.pagesScanned} pages · ${job.summary.contactsFound} contacts · ${job.summary.errors} errors`:'—'}</td><td class="p-3">${new Date(job.created_at).toLocaleString()}</td><td class="p-3"><button class="gs-btn-secondary px-2 py-1 mr-2" data-action="details">Details</button>${['queued','running'].includes(job.status)?'<button class="gs-btn-secondary px-2 py-1" data-action="cancel">Cancel</button>':''}${['failed','cancelled'].includes(job.status)?'<button class="gs-btn-secondary px-2 py-1" data-action="retry">Retry</button>':''}</td></tr>`).join('')||'<tr><td colspan="6" class="p-6">No workflow runs match this filter.</td></tr>';document.querySelector('#page-label')!.textContent=`Page ${page} of ${pages} · ${data.pagination.total} jobs`;(document.querySelector('#previous') as HTMLButtonElement).disabled=page<=1;(document.querySelector('#next') as HTMLButtonElement).disabled=page>=pages;};
    document.querySelector('#job-form')?.addEventListener('submit',async event=>{event.preventDefault();const domains=(document.querySelector('#domains') as HTMLTextAreaElement).value.split(/\r?\n|,/).map(v=>v.trim()).filter(Boolean);status.textContent='Queueing workflow…';const response=await fetch('/api/admin/automation/jobs',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({kind:(document.querySelector('#job-kind') as HTMLSelectElement).value,domains,maxPages:Number((document.querySelector('#max-pages') as HTMLInputElement).value),respectRobots:true})});const data=await response.json();status.textContent=response.ok?`Workflow ${data.id} queued.`:data.error??'Queue failed.';if(response.ok){(document.querySelector('#domains') as HTMLTextAreaElement).value='';page=1;await load();}});
    jobs.addEventListener('click',async event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');const row=button?.closest<HTMLTableRowElement>('[data-job]');if(!button||!row)return;const id=row.dataset.job!;if(button.dataset.action==='details'){const response=await fetch(`/api/admin/automation/jobs/${encodeURIComponent(id)}`);const data=await response.json();if(!response.ok)return alert(data.error??'Details unavailable.');document.querySelector('#detail-summary')!.textContent=JSON.stringify(data.job.summary??{});(document.querySelector('#results') as HTMLElement).innerHTML=data.results.map((result:any)=>`<tr class="border-t border-[var(--gs-color-border)]"><td class="p-2"><a href="${escapeHtml(result.source_url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(result.source_url)}</a></td><td class="p-2">${escapeHtml(result.result_type)}</td><td class="p-2"><pre class="text-xs whitespace-pre-wrap">${escapeHtml(JSON.stringify(result.data,null,2))}</pre></td></tr>`).join('')||'<tr><td colspan="3">No results recorded.</td></tr>'; (document.querySelector('#details') as HTMLDialogElement).showModal();return;}if(!confirm(`${button.dataset.action} workflow ${id}?`))return;const response=await fetch(`/api/admin/automation/jobs/${encodeURIComponent(id)}/${button.dataset.action}`,{method:'POST'});if(!response.ok)alert((await response.json()).error??'Operation failed.');await load();});
    document.querySelector('#close-details')?.addEventListener('click',()=> (document.querySelector('#details') as HTMLDialogElement).close());document.querySelector('#refresh')?.addEventListener('click',()=>{page=1;load();});document.querySelector('#filter-kind')?.addEventListener('change',()=>{page=1;load();});document.querySelector('#filter-status')?.addEventListener('change',()=>{page=1;load();});document.querySelector('#previous')?.addEventListener('click',()=>{if(page>1){page--;load();}});document.querySelector('#next')?.addEventListener('click',()=>{if(page<pages){page++;load();}});load();setInterval(load,30000);
  </script>
</AdminLayout>
