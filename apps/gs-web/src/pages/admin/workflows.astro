---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

const workflows = [
  ['Customer intake', 'Public form → gs-api → D1 → mail queue', 'Lead submissions', '/admin/lead-submissions', 'Monitored'],
  ['Service review', 'Admin review → gs-api → D1 audit record', 'Service workflows', '/admin/services', 'Monitored'],
  ['Content publishing', 'Content studio → gs-web → reviewed deployment', 'Content studio', '/content', 'Review-gated'],
  ['Integration sync', 'Admin control → gs-api → provider API', 'Integrations', '/admin/integrations/all', 'Protected'],
] as const;
---

<AdminLayout title="API Workflows | GoldShore Admin" requiredPermission="forms:read">
  <section class="workflows-page">
    <header class="workflows-page__header">
      <div>
        <p class="workflows-page__eyebrow">Operations / Automated flows</p>
        <h1>API Workflows</h1>
        <p>Observe the customer and operator flows currently managed through the unified backend.</p>
      </div>
      <span class="workflows-page__status"><i></i> Centralized in gs-api</span>
    </header>

    <section class="workflows-page__section" aria-labelledby="active-workflows-title">
      <div class="workflows-page__section-heading">
        <div>
          <p class="workflows-page__eyebrow">Active operational flows</p>
          <h2 id="active-workflows-title">Workflow inventory</h2>
        </div>
      </div>
      <div class="workflow-list">
        {workflows.map(([title, path, destination, href, status], index) => (
          <article class="workflow-card">
            <span class="workflow-card__index">0{index + 1}</span>
            <div>
              <h3>{title}</h3>
              <p>{path}</p>
            </div>
            <span class="workflow-card__status">{status}</span>
            <a href={href}>{destination} <b>→</b></a>
          </article>
        ))}
      </div>
    </section>

    <section class="workflows-page__section" aria-labelledby="workflow-policy-title">
      <div class="workflows-page__section-heading">
        <div>
          <p class="workflows-page__eyebrow">Operating policy</p>
          <h2 id="workflow-policy-title">Design constraints</h2>
        </div>
      </div>
      <div class="workflow-policy-grid">
        <article><strong>One backend</strong><p>Routes, scheduled work, queues, email, and integration handlers run inside gs-api.</p></article>
        <article><strong>Auditable changes</strong><p>Workflow state changes should be recorded by the backend before they are considered complete.</p></article>
        <article><strong>Human approval</strong><p>Production configuration changes remain review-gated instead of being triggered directly from this surface.</p></article>
      </div>
    </section>
  </section>
</AdminLayout>

<style>
  .workflows-page { min-height: 100vh; padding: clamp(2rem, 5vw, 4.5rem) clamp(1.25rem, 5vw, 5rem); background: radial-gradient(circle at 82% 0%, rgba(216, 164, 74, .11), transparent 31rem), #050b14; }
  .workflows-page__header, .workflows-page__section { max-width: 1180px; margin-right: auto; margin-left: auto; }
  .workflows-page__header { display: flex; justify-content: space-between; gap: 2rem; align-items: start; margin-bottom: 3.5rem; }
  .workflows-page__eyebrow { margin: 0 0 .65rem; color: #d8a44a; font: 700 .68rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .16em; text-transform: uppercase; }
  .workflows-page h1, .workflows-page h2, .workflows-page h3, .workflows-page p { margin-top: 0; }
  .workflows-page h1 { margin-bottom: 1rem; color: #e8eef5; font-size: clamp(2.5rem, 6vw, 5.4rem); line-height: .98; letter-spacing: -.065em; }
  .workflows-page__header > div > p:last-child { max-width: 650px; margin-bottom: 0; color: rgba(174, 190, 207, .72); line-height: 1.65; }
  .workflows-page__status { display: inline-flex; align-items: center; gap: .5rem; padding: .55rem .75rem; border: 1px solid rgba(52, 211, 153, .2); border-radius: 999px; color: rgba(187, 247, 208, .82); font: 600 .7rem ui-monospace, monospace; white-space: nowrap; }
  .workflows-page__status i { width: .45rem; height: .45rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 12px rgba(52, 211, 153, .75); }
  .workflows-page__section { margin-bottom: 3.5rem; }
  .workflows-page__section-heading { margin-bottom: 1rem; }
  .workflows-page__section-heading h2 { margin-bottom: 0; color: #e8eef5; font-size: clamp(1.35rem, 2.2vw, 1.8rem); letter-spacing: -.035em; }
  .workflow-list { display: grid; gap: .65rem; }
  .workflow-card { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto auto; gap: 1rem; align-items: center; padding: 1rem 1.15rem; border: 1px solid rgba(114, 185, 255, .1); border-radius: .75rem; background: rgba(10, 22, 39, .54); }
  .workflow-card__index { color: rgba(174, 190, 207, .38); font: .7rem ui-monospace, monospace; }
  .workflow-card h3 { margin-bottom: .3rem; color: #e8eef5; font-size: .9rem; }
  .workflow-card p { margin-bottom: 0; color: rgba(174, 190, 207, .62); font: .72rem ui-monospace, monospace; }
  .workflow-card__status { padding: .3rem .5rem; border: 1px solid rgba(52, 211, 153, .22); border-radius: 999px; color: #86efac; font: .65rem ui-monospace, monospace; }
  .workflow-card a { color: #72b9ff; font-size: .78rem; text-decoration: none; white-space: nowrap; }
  .workflow-card a:hover { color: #fff; }
  .workflow-card a b { font-weight: 400; }
  .workflow-policy-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; }
  .workflow-policy-grid article { min-height: 145px; padding: 1.15rem; border: 1px solid rgba(114, 185, 255, .15); border-radius: .9rem; background: rgba(10, 22, 39, .76); }
  .workflow-policy-grid strong { color: #f1f5f9; font-size: 1rem; }
  .workflow-policy-grid p { margin: .6rem 0 0; color: rgba(174, 190, 207, .68); font-size: .78rem; line-height: 1.55; }
  @media (max-width: 900px) { .workflow-policy-grid { grid-template-columns: 1fr; } .workflow-card { grid-template-columns: 44px minmax(0, 1fr) auto; } .workflow-card a { grid-column: 2 / -1; } }
  @media (max-width: 640px) { .workflows-page__header { flex-direction: column; } .workflow-card { grid-template-columns: 34px minmax(0, 1fr); } .workflow-card__status, .workflow-card a { grid-column: 2; } }
</style>
