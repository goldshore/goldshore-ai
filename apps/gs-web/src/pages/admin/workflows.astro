---
import Layout from '@layouts/Layout.astro';
import WorkflowsClient from '@components/admin/WorkflowsClient';
---

<Layout title="Workflows & Automation">
  <div class="py-8">
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Workflows & Automation</h1>
        <p class="text-gray-600">Create and manage automated workflows for leads generation, data scraping, emails, and more</p>
      </div>
      <WorkflowsClient client:load />
    </div>
  </div>
</Layout>
