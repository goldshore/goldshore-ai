---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Site Builder | GoldShore Admin" requiredPermission="cloudflare_inventory:read">
  <section class="max-w-7xl mx-auto py-24 px-6 space-y-6">
    <div><p class="text-sm gs-text-subtle">Enterprise publishing</p><h1 class="text-3xl gs-heading">Site Builder</h1><p class="gs-text-subtle mt-2">Manage sites, pages, approved plugins, and review-only build plans. Publishing still requires a reviewed PR.</p></div>
    <form id="site-form" class="gs-card grid md:grid-cols-3 gap-3">
      <label><span class="text-sm">Site ID</span><input id="site-id" class="gs-input w-full" required pattern="[a-z0-9][a-z0-9-]+" placeholder="client-site" /></label>
      <label><span class="text-sm">Name</span><input id="site-name" class="gs-input w-full" required placeholder="Client Site" /></label>
      <label><span class="text-sm">Domain</span><input id="site-domain" class="gs-input w-full" required placeholder="client.example.com" /></label>
      <label><span class="text-sm">Framework</span><select id="site-framework" class="gs-input w-full"><option value="astro">Astro</option><option value="static">Static import</option><option value="wordpress-import">WordPress import</option></select></label>
      <label><span class="text-sm">Repository</span><input id="site-repository" class="gs-input w-full" placeholder="owner/repository" /></label>
      <button class="gs-btn-primary self-end px-4 py-2" type="submit">Create draft site</button>
    </form>
    <div class="flex gap-3 items-end"><label><span class="text-sm">Status</span><select id="status-filter" class="gs-input"><option value="">All</option><option>draft</option><option>ready</option><option>archived</option></select></label><button id="refresh" class="gs-btn-secondary px-4 py-2">Refresh</button><span id="message" class="text-sm gs-text-subtle" role="status"></span></div>
    <div class="grid lg:grid-cols-[1fr_1.4fr] gap-6">
      <div class="gs-card overflow-x-auto"><table class="w-full text-left"><thead><tr><th class="pb-2">Site</th><th>Status</th><th>Framework</th></tr></thead><tbody id="sites"><tr><td colspan="3" class="py-4 gs-text-subtle">Loading…</td></tr></tbody></table><div class="flex justify-between mt-4"><button id="prev" class="gs-btn-secondary px-3 py-1">Previous</button><span id="page-label" class="text-sm"></span><button id="next" class="gs-btn-secondary px-3 py-1">Next</button></div></div>
      <section id="workspace" class="gs-card space-y-5"><p class="gs-text-subtle">Choose a site to edit pages and plugins.</p></section>
    </div>
  </section>
  <dialog id="page-dialog" class="gs-card p-6 max-w-4xl w-full backdrop:bg-black/60">
    <form method="dialog" class="space-y-4"><div class="flex justify-between"><h2 class="text-xl">Page editor</h2><button value="cancel" class="gs-btn-secondary px-3">Close</button></div>
      <input id="page-id" type="hidden" /><div class="grid md:grid-cols-3 gap-3"><label><span>Slug</span><input id="page-slug" class="gs-input w-full" /></label><label><span>Title</span><input id="page-title" class="gs-input w-full" /></label><label><span>Status</span><select id="page-status" class="gs-input w-full"><option>draft</option><option>published</option></select></label></div>
      <div class="flex gap-2"><button type="button" class="gs-btn-secondary px-2" data-command="bold">Bold</button><button type="button" class="gs-btn-secondary px-2" data-command="italic">Italic</button><button type="button" class="gs-btn-secondary px-2" data-command="createLink">Link</button><button type="button" class="gs-btn-secondary px-2" data-command="insertUnorderedList">List</button></div>
      <div id="editor" class="gs-input min-h-64" contenteditable="true"></div><button id="save-page" type="button" class="gs-btn-primary px-4 py-2">Save page</button>
    </form>
  </dialog>
  <script>
    const sitesBody=document.querySelector('#sites')!;const workspace=document.querySelector('#workspace')!;const message=document.querySelector('#message')!;const dialog=document.querySelector('#page-dialog') as HTMLDialogElement;let page=1,pages=1,selected='';let catalog:any[]=[];
    const esc=(v:unknown)=>String(v??'').replace(/[&<>'"]/g,c=>({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' }[c]??c));const say=(v:string)=>message.textContent=v;
    async function request(path:string,init?:RequestInit){const response=await fetch(`/api/admin/sites/${path}`,init);const data=response.status===204?{}:await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error??`Request failed (${response.status})`);return data;}
    async function loadSites(){try{const status=(document.querySelector('#status-filter') as HTMLSelectElement).value;const data=await request(`?page=${page}&pageSize=10${status?`&status=${status}`:''}`);pages=data.pagination.pages;document.querySelector('#page-label')!.textContent=`Page ${page} of ${pages}`;(document.querySelector('#prev') as HTMLButtonElement).disabled=page<=1;(document.querySelector('#next') as HTMLButtonElement).disabled=page>=pages;sitesBody.innerHTML=data.items.length?data.items.map((s:any)=>`<tr class="border-t cursor-pointer" data-site="${esc(s.id)}"><td class="py-3"><strong>${esc(s.name)}</strong><small class="block gs-text-subtle">${esc(s.domain)}</small></td><td>${esc(s.status)}</td><td>${esc(s.framework)}</td></tr>`).join(''):'<tr><td colspan="3" class="py-4 gs-text-subtle">No sites found.</td></tr>';}catch(error){say(error instanceof Error?error.message:'Load failed.');}}
    async function openSite(id:string){selected=id;try{const data=await request(encodeURIComponent(id));workspace.innerHTML=`<div class="flex justify-between"><div><h2 class="text-xl">${esc(data.site.name)}</h2><p class="text-sm gs-text-subtle">${esc(data.site.domain)} · ${esc(data.site.repository??'No repository')}</p></div><button id="plan-build" class="gs-btn-primary px-3">Plan build</button></div><div><h3 class="font-semibold">Pages</h3><button id="new-page" class="gs-btn-secondary px-3 my-2">New page</button><div>${data.pages.map((p:any)=>`<button class="block w-full text-left border-t py-2" data-page="${esc(p.id)}"><strong>${esc(p.title)}</strong><small class="float-right">${esc(p.status)}</small><span class="block text-xs gs-text-subtle">/${esc(p.slug==='home'?'':p.slug)}</span></button>`).join('')||'<p class="text-sm gs-text-subtle">No pages yet.</p>'}</div></div><div><h3 class="font-semibold">Approved plugins</h3><div class="flex gap-2 my-2"><select id="plugin-select" class="gs-input flex-1">${catalog.map(p=>`<option value="${esc(p.id)}">${esc(p.name)}</option>`).join('')}</select><button id="install-plugin" class="gs-btn-secondary px-3">Install</button></div><div>${data.plugins.map((p:any)=>`<div class="flex justify-between border-t py-2"><span>${esc(catalog.find(x=>x.id===p.plugin_id)?.name??p.plugin_id)}</span><button data-remove-plugin="${esc(p.plugin_id)}">Remove</button></div>`).join('')||'<p class="text-sm gs-text-subtle">No plugins installed.</p>'}</div></div><div><h3 class="font-semibold">Build plans</h3><pre class="text-xs whitespace-pre-wrap max-h-48 overflow-auto">${esc(data.builds.length?JSON.stringify(data.builds[0],null,2):'No build plan yet.')}</pre></div>`;}catch(error){say(error instanceof Error?error.message:'Site load failed.');}}
    document.querySelector('#site-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await request('',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({id:(document.querySelector('#site-id') as HTMLInputElement).value,name:(document.querySelector('#site-name') as HTMLInputElement).value,domain:(document.querySelector('#site-domain') as HTMLInputElement).value,framework:(document.querySelector('#site-framework') as HTMLSelectElement).value,repository:(document.querySelector('#site-repository') as HTMLInputElement).value})});say('Draft site created.');(e.target as HTMLFormElement).reset();await loadSites();}catch(error){say(error instanceof Error?error.message:'Create failed.');}});
    sitesBody.addEventListener('click',e=>{const row=(e.target as HTMLElement).closest<HTMLElement>('[data-site]');if(row)openSite(row.dataset.site!);});
    workspace.addEventListener('click',async e=>{const target=e.target as HTMLElement;if(target.closest('#new-page')){(document.querySelector('#page-id') as HTMLInputElement).value='';(document.querySelector('#page-slug') as HTMLInputElement).value='';(document.querySelector('#page-title') as HTMLInputElement).value='';document.querySelector('#editor')!.innerHTML='';dialog.showModal();return;}const pageButton=target.closest<HTMLElement>('[data-page]');if(pageButton){try{const data=await request(`${encodeURIComponent(selected)}/pages/${encodeURIComponent(pageButton.dataset.page!)}`);(document.querySelector('#page-id') as HTMLInputElement).value=data.page.id;(document.querySelector('#page-slug') as HTMLInputElement).value=data.page.slug;(document.querySelector('#page-slug') as HTMLInputElement).disabled=true;(document.querySelector('#page-title') as HTMLInputElement).value=data.page.title;(document.querySelector('#page-status') as HTMLSelectElement).value=data.page.status;document.querySelector('#editor')!.innerHTML=data.page.body_html;dialog.showModal();}catch(error){say(error instanceof Error?error.message:'Page load failed.');}return;}if(target.closest('#install-plugin')){const pluginId=(document.querySelector('#plugin-select') as HTMLSelectElement).value;if(!confirm(`Install ${pluginId} on ${selected}?`))return;try{await request(`${encodeURIComponent(selected)}/plugins`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({pluginId,config:{},confirm:true})});say('Plugin installed.');await openSite(selected);}catch(error){say(error instanceof Error?error.message:'Install failed.');}return;}const remove=target.closest<HTMLElement>('[data-remove-plugin]');if(remove&&confirm(`Remove ${remove.dataset.removePlugin}?`)){try{await request(`${encodeURIComponent(selected)}/plugins/${encodeURIComponent(remove.dataset.removePlugin!)}?confirm=true`,{method:'DELETE'});say('Plugin removed.');await openSite(selected);}catch(error){say(error instanceof Error?error.message:'Remove failed.');}return;}if(target.closest('#plan-build')){try{const data=await request(`${encodeURIComponent(selected)}/builds/plan`,{method:'POST'});say(`Build plan ${data.id} created; no deployment was performed.`);await openSite(selected);}catch(error){say(error instanceof Error?error.message:'Plan failed.');}}});
    document.querySelectorAll('[data-command]').forEach(button=>button.addEventListener('click',()=>{const command=(button as HTMLElement).dataset.command!;const value=command==='createLink'?prompt('HTTPS URL')??undefined:undefined;if(command==='createLink'&&value&&!value.startsWith('https://'))return;document.execCommand(command,false,value);}));
    document.querySelector('#save-page')?.addEventListener('click',async()=>{const id=(document.querySelector('#page-id') as HTMLInputElement).value;const payload={slug:(document.querySelector('#page-slug') as HTMLInputElement).value,title:(document.querySelector('#page-title') as HTMLInputElement).value,status:(document.querySelector('#page-status') as HTMLSelectElement).value,bodyHtml:document.querySelector('#editor')!.innerHTML};try{await request(`${encodeURIComponent(selected)}/pages${id?`/${encodeURIComponent(id)}`:''}`,{method:id?'PUT':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});say('Page saved.');dialog.close();await openSite(selected);}catch(error){say(error instanceof Error?error.message:'Save failed.');}});
    dialog.addEventListener('close',()=>{(document.querySelector('#page-slug') as HTMLInputElement).disabled=false;});document.querySelector('#refresh')?.addEventListener('click',loadSites);document.querySelector('#status-filter')?.addEventListener('change',()=>{page=1;loadSites();});document.querySelector('#prev')?.addEventListener('click',()=>{if(page>1){page--;loadSites();}});document.querySelector('#next')?.addEventListener('click',()=>{if(page<pages){page++;loadSites();}});
    request('plugins/catalog').then(data=>{catalog=data.plugins;}).then(loadSites).catch(error=>say(error.message));
  </script>
</AdminLayout>
