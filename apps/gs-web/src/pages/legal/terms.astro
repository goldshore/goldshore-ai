---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;
---
<BaseLayout title="Terms of Service | GoldShore" description="Terms for using GoldShore websites, content, forms, and protected services." canonicalPath="/legal/terms/">
