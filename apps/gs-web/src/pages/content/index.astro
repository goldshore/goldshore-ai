---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
if (!Astro.locals.adminSession?.isAuthenticated) return Astro.redirect('/login');
---
<AdminLayout title="Content Studio" requiredPermission="content:read">
  <main class="studio"><header><div><p class="eyebrow">D1-backed CMS</p><h1>Content Studio</h1><p>Create, preview, save, and publish sanitized GoldShore pages.</p></div><button id="new-page">New page</button></header>
  <div class="layout"><aside><div class="filter"><input id="search" placeholder="Search pages"/><button id="refresh">↻</button></div><div id="pages"><p class="muted">Loading…</p></div></aside>
  <section class="editor"><form id="page-form"><input type="hidden" name="id"/><div class="row"><label>Title<input name="title" required maxlength="160"/></label><label>Slug<input name="slug" required pattern="[a-z0-9][a-z0-9-]*"/></label></div><div class="row"><label>Site<input name="siteId" value="goldshore"/></label><label>Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option><option value="disabled">Disabled</option></select></label></div>
  <div class="toolbar" role="toolbar" aria-label="Formatting"><button type="button" data-command="bold"><b>B</b></button><button type="button" data-command="italic"><i>I</i></button><button type="button" data-command="formatBlock" data-value="h2">H2</button><button type="button" data-command="insertUnorderedList">List</button><button type="button" id="add-link">Link</button><button type="button" id="view-source">HTML</button></div>
  <div id="wysiwyg" contenteditable="true" aria-label="Page content"></div><textarea id="html-source" hidden></textarea>
  <details open><summary>Publishing metadata</summary><div class="row"><label>Format<select name="kind"><option value="article">Article</option><option value="news">News</option><option value="video">Video</option><option value="post">Post</option><option value="social">Social post</option><option value="analysis">GoldShore analysis</option><option value="opinion">Opinion</option></select></label><label>Disclosure<select name="disclosure"><option value="editorial">Editorial</option><option value="sponsored">Sponsored</option><option value="affiliate">Affiliate</option><option value="partner">Partner</option></select></label><label>Author<input name="author" maxlength="120" value="GoldShore Editorial"/></label></div><div class="row"><label>Description<textarea name="description" rows="3" maxlength="300"></textarea></label><label>Source URL<input name="sourceUrl" type="url" placeholder="Required when republishing or analyzing an external source"/></label><label>Media URL<input name="mediaUrl" type="url" placeholder="Image, video, or embed source"/></label></div></details>
  <div class="actions"><button type="button" class="danger" id="delete" disabled>Delete</button><button type="button" id="preview">Preview</button><button type="submit">Save page</button></div><p id="status" class="muted"></p></form></section></div></main>
</AdminLayout>
<script>
  const form=document.querySelector<HTMLFormElement>('#page-form')!,list=document.querySelector<HTMLElement>('#pages')!,editor=document.querySelector<HTMLElement>('#wysiwyg')!,source=document.querySelector<HTMLTextAreaElement>('#html-source')!,status=document.querySelector<HTMLElement>('#status')!,del=document.querySelector<HTMLButtonElement>('#delete')!,search=document.querySelector<HTMLInputElement>('#search')!;let pages:any[]=[];
  const esc=(v:string)=>v.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
  const edit=(p:any={})=>{for(const k of ['id','title','slug','siteId','status','kind','disclosure','author','sourceUrl','mediaUrl']){const el=form.elements.namedItem(k) as HTMLInputElement|HTMLSelectElement;el.value=p[k]||p.metadata?.[k]||({siteId:'goldshore',status:'draft',kind:'article',disclosure:'editorial',author:'GoldShore Editorial'} as any)[k]||'';} (form.elements.namedItem('description') as HTMLTextAreaElement).value=p.metadata?.description||'';editor.innerHTML=p.content||'';source.value=p.content||'';del.disabled=!p.id;status.textContent='';};
  const render=()=>{const q=search.value.toLowerCase();const shown=pages.filter(p=>`${p.title} ${p.slug}`.toLowerCase().includes(q));list.innerHTML=shown.length?shown.map(p=>`<button type="button" data-id="${esc(p.id)}"><strong>${esc(p.title)}</strong><small>/${esc(p.slug)} · ${esc(p.status)}</small></button>`).join(''):'<p class="muted">No pages found.</p>';list.querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.onclick=()=>edit(pages.find(p=>p.id===b.dataset.id)));};
  const load=async()=>{const r=await fetch('/api/admin/pages');const p=await r.json();if(!r.ok)throw new Error(p.error||'Could not load pages');pages=p.pages||[];render();};
  document.querySelectorAll<HTMLButtonElement>('[data-command]').forEach(b=>b.onclick=()=>{document.execCommand(b.dataset.command!,false,b.dataset.value);editor.focus();});document.querySelector<HTMLButtonElement>('#add-link')!.onclick=()=>{const u=prompt('Link URL');if(u)document.execCommand('createLink',false,u)};
  document.querySelector<HTMLButtonElement>('#view-source')!.onclick=()=>{const showing=!source.hidden;if(showing){editor.innerHTML=source.value}else{source.value=editor.innerHTML}source.hidden=showing;editor.hidden=!showing;};
  form.onsubmit=async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(form));const id=String(data.id||'');const payload={title:data.title,slug:data.slug,siteId:data.siteId,status:data.status,content:source.hidden?editor.innerHTML:source.value,metadata:{description:data.description,kind:data.kind,disclosure:data.disclosure,author:data.author,sourceUrl:data.sourceUrl,mediaUrl:data.mediaUrl}};status.textContent='Saving…';const r=await fetch(`/api/admin/pages${id?`/${id}`:''}`,{method:id?'PUT':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const p=await r.json();if(!r.ok){status.textContent=p.error||'Save failed';return;}status.textContent='Saved.';await load();edit(p);};
  del.onclick=async()=>{const id=(form.elements.namedItem('id') as HTMLInputElement).value;if(id&&confirm('Delete this page?')){const r=await fetch(`/api/admin/pages/${id}`,{method:'DELETE'});if(r.ok){edit();await load();}}};document.querySelector<HTMLButtonElement>('#new-page')!.onclick=()=>edit();document.querySelector<HTMLButtonElement>('#refresh')!.onclick=()=>load();document.querySelector<HTMLButtonElement>('#preview')!.onclick=()=>{const w=open('','goldshore-preview');if(w)w.document.write(`<title>Preview</title><body>${editor.innerHTML}</body>`)};search.oninput=render;load().catch(e=>list.innerHTML=`<p class="error">${esc(e.message)}</p>`);
</script>
<style>
  .studio{padding:2rem}.studio>header{display:flex;justify-content:space-between;align-items:end;margin-bottom:1rem}.eyebrow{color:#f5b942;text-transform:uppercase;letter-spacing:.12em;font-size:.72rem}.layout{display:grid;grid-template-columns:300px 1fr;gap:1rem}aside,.editor{background:#081522;border:1px solid #23364d;border-radius:12px;padding:1rem}.filter,.row,.toolbar,.actions{display:flex;gap:.6rem}.filter input{flex:1}#pages{display:grid;gap:.5rem;margin-top:.8rem}#pages button{text-align:left;background:#0c1c2c;color:#edf4fc;border:1px solid #29425f;border-radius:8px;padding:.75rem}#pages small{display:block;color:#8ea2b8;margin-top:.25rem}form{display:grid;gap:.8rem}.row>*{flex:1}label{display:grid;gap:.3rem;color:#9fb1c5}input,select,textarea,#wysiwyg{box-sizing:border-box;width:100%;background:#07111d;color:#fff;border:1px solid #29425f;border-radius:7px;padding:.7rem}#wysiwyg{min-height:360px;overflow:auto}.toolbar{flex-wrap:wrap}.toolbar button{background:#10253a;color:#e4edf7}.actions{justify-content:flex-end}button{background:#d99a20;color:#07111d;border:0;border-radius:7px;padding:.7rem 1rem;font-weight:700}.danger{background:#401c24;color:#fecaca}.muted{color:#8ea2b8}.error{color:#fca5a5}@media(max-width:800px){.layout{grid-template-columns:1fr}.row{flex-direction:column}}
</style>
