---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { GSButton } from '@goldshore/ui';

const title = 'Content Management';
---

<AdminLayout title="Content | GoldShore Admin">
  <div class="max-w-7xl mx-auto p-8 space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl gs-heading gs-text-accent">Content Management</h1>
        <p class="text-lg gs-text-subtle mt-2">Manage articles, pages, and WYSIWYG content via STRAPI</p>
      </div>
      <div class="flex gap-3">
        <GSButton variant="primary" id="create-article">New Article</GSButton>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="gs-card space-y-3">
        <h2 class="text-xl font-semibold">Total Articles</h2>
        <p id="total-articles" class="text-3xl font-bold gs-text-info">0</p>
        <p class="text-sm gs-text-subtle">Published and draft content</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-xl font-semibold">Published</h2>
        <p id="published-articles" class="text-3xl font-bold gs-text-success">0</p>
        <p class="text-sm gs-text-subtle">Live articles</p>
      </div>
      <div class="gs-card space-y-3">
        <h2 class="text-xl font-semibold">Drafts</h2>
        <p id="draft-articles" class="text-3xl font-bold gs-text-warning">0</p>
        <p class="text-sm gs-text-subtle">Unpublished content</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-semibold">Articles</h2>
          <p class="text-sm gs-text-subtle mt-1">Manage content with WYSIWYG editor</p>
        </div>
        <GSButton variant="secondary" id="refresh-articles">Refresh</GSButton>
      </div>

      <div id="articles-loading" class="py-8 text-center">
        <p class="gs-text-subtle">Loading articles...</p>
      </div>

      <table id="articles-table" class="gs-admin-table" style="display: none;">
        <thead>
          <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="articles-tbody">
        </tbody>
      </table>

      <div id="articles-empty" class="py-8 text-center gs-empty-state" style="display: none;">
        <p>No articles yet. Create your first article to get started.</p>
      </div>
    </div>

    <div class="gs-card space-y-4">
      <h2 class="text-2xl font-semibold">STRAPI Configuration</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <label class="flex items-center gap-3 text-sm gs-text-subtle">
          <input type="checkbox" class="h-4 w-4" id="strapi-connected" disabled />
          STRAPI Connection
        </label>
        <label class="flex items-center gap-3 text-sm gs-text-subtle">
          <input type="checkbox" class="h-4 w-4" id="wysiwyg-enabled" checked disabled />
          WYSIWYG Editor
        </label>
      </div>
      <div>
        <p class="text-sm gs-text-subtle">
          STRAPI API URL: <code id="strapi-url" class="text-xs">Not configured</code>
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      const loadArticles = async () => {
        const loadingEl = document.getElementById('articles-loading');
        const tableEl = document.getElementById('articles-table');
        const emptyEl = document.getElementById('articles-empty');
        const tbodyEl = document.getElementById('articles-tbody');
        const totalEl = document.getElementById('total-articles');
        const publishedEl = document.getElementById('published-articles');
        const draftEl = document.getElementById('draft-articles');

        if (loadingEl) loadingEl.style.display = 'block';
        if (tableEl) tableEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = 'none';

        try {
          const response = await fetch('/api/content/articles');
          const data = await response.json();

          if (loadingEl) loadingEl.style.display = 'none';

          if (!data.data || (Array.isArray(data.data) && data.data.length === 0)) {
            if (emptyEl) emptyEl.style.display = 'block';
            if (totalEl) totalEl.textContent = '0';
            return;
          }

          const articles = Array.isArray(data.data) ? data.data : [data.data];
          if (totalEl) totalEl.textContent = articles.length.toString();
          if (publishedEl) publishedEl.textContent = articles.filter(a => a.attributes?.publishedAt).length.toString();
          if (draftEl) draftEl.textContent = articles.filter(a => !a.attributes?.publishedAt).length.toString();

          // Populate table
          if (tbodyEl && articles.length > 0) {
            tbodyEl.innerHTML = articles.slice(0, 50).map((article) => {
              const attrs = article.attributes || {};
              const title = attrs.title || 'Untitled';
              const author = attrs.author?.data?.attributes?.name || 'Unknown';
              const status = attrs.publishedAt ? 'Published' : 'Draft';
              const statusClass = attrs.publishedAt ? 'gs-status--ok' : 'gs-status--warn';
              const createdAt = new Date(attrs.createdAt || '').toLocaleDateString();

              return `
                <tr>
                  <td class="font-semibold">${escapeHtml(title)}</td>
                  <td class="text-sm">${escapeHtml(author)}</td>
                  <td><span class="${statusClass}">${status}</span></td>
                  <td class="text-sm">${createdAt}</td>
                  <td>
                    <button class="gs-link text-xs" onclick="editArticle('${article.id || article.documentId}')">Edit</button>
                    <span class="text-xs gs-text-dim"> | </span>
                    <button class="gs-link text-xs" onclick="deleteArticle('${article.id || article.documentId}')">Delete</button>
                  </td>
                </tr>
              `;
            }).join('');
          }

          if (tableEl) tableEl.style.display = 'table';
        } catch (error) {
          console.error('Error loading articles:', error);
          if (emptyEl) emptyEl.style.display = 'block';
          if (emptyEl) emptyEl.textContent = 'Error loading articles. Please check STRAPI configuration.';
        }
      };

      const escapeHtml = (text) => {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      };

      document.getElementById('refresh-articles')?.addEventListener('click', loadArticles);
      document.getElementById('create-article')?.addEventListener('click', () => {
        alert('Article creation form coming soon. This will open a WYSIWYG editor.');
      });

      window.editArticle = (articleId) => {
        alert('Edit form for article: ' + articleId);
      };

      window.deleteArticle = (articleId) => {
        if (confirm('Are you sure you want to delete this article?')) {
          alert('Deletion endpoint will be implemented.');
        }
      };

      loadArticles();
    });
  </script>
</AdminLayout>
