---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;
---
<BaseLayout title="Integration Options | GoldShore Developer" description="Connect to GoldShore through documented APIs and MCP-compatible tools." canonicalPath="/developer/sdk/">
  <section class="gs-section gs-section--padded">
    <div class="max-w-4xl mx-auto">
      <h1 class="gs-heading text-4xl mb-4">Integration options</h1>
      <p class="text-lg text-[var(--gs-text-secondary)] mb-8">
        Use the documented API or MCP interface today. A separately versioned public SDK is not currently offered.
      </p>

      <div class="p-6 border border-[var(--gs-border-color)] rounded-lg bg-[var(--gs-surface-2)]">
        <h2 class="text-xl font-semibold mb-2">Start with a supported interface</h2>
        <p>Review the API reference for request-based integrations, or use MCP when a compatible AI client needs permissioned GoldShore tools.</p>
        <p><a href="/developer/api/">API reference →</a> &nbsp; <a href="/developer/mcp/">MCP access →</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
