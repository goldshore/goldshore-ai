---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;
const checklist = ['Use the event-specific gs-api endpoint supplied for your provider.','Verify every production signature before parsing or acting on a payload.','Acknowledge quickly, move slow work to a queue, and make retries idempotent.','Log request identifiers and outcomes without recording payload secrets or credentials.','Test failure, duplicate-delivery, and out-of-order event handling before launch.'];
---
<BaseLayout title="Webhooks | GoldShore Developer" description="Secure webhook integration guidance for GoldShore's unified API service." canonicalPath="/developer/webhooks/">
  <section class="gs-section gs-section--padded developer-copy"><p class="gs-eyebrow">Developer hub</p><h1>Webhooks</h1><p class="lead">Inbound provider events are handled by dedicated routes inside the unified <code>gs-api</code> service. Endpoint addresses and signing requirements are integration-specific.</p><ol>{checklist.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><p>{item}</p></li>)}</ol><aside><strong>Need an endpoint?</strong><p>Request integration access with the provider name, event types, expected volume, and target environment. Do not send the signing secret in the request.</p><a href="/contact/?intent=developer-webhook">Request webhook access</a></aside></section>
</BaseLayout>
<style>.developer-copy{max-width:76rem;margin-inline:auto}.developer-copy h1{font-size:clamp(3.5rem,9vw,8rem)}.lead{max-width:68ch;color:var(--gs-text-dim);font-size:1.15rem;line-height:1.7}.developer-copy ol{list-style:none;padding:0;margin:2rem 0;border-top:1px solid rgba(255,255,255,.1)}.developer-copy li{display:grid;grid-template-columns:4rem 1fr;gap:1rem;padding:1.1rem 0;border-bottom:1px solid rgba(255,255,255,.1)}.developer-copy li span{color:#d3743e;font:600 .7rem 'DM Mono',monospace}.developer-copy li p,aside p{margin:0;color:var(--gs-text-dim);line-height:1.7}aside{padding:1.5rem;border:1px solid rgba(211,116,62,.28);background:#111019}aside a{display:inline-block;margin-top:1rem;color:#d3743e}</style>
