---
import MarketingLayout from '../../layouts/MarketingLayout.astro';

export const prerender = true;

const cards = [
  {
    title: 'Documentation',
    body: 'Read the API, gateway, and worker notes that back the platform.',
    href: '/developer/docs',
    cta: 'Open docs',
  },
  {
    title: 'Private MCP Access',
    body: 'Learn how the GoldShore MCP surface stays locked to approved identities and service paths.',
    href: '/developer/mcp',
    cta: 'View MCP access',
  },
  {
    title: 'System Status',
    body: 'Check the current state of the public site and operational services.',
    href: '/status',
    cta: 'Open status',
  },
  {
    title: 'Admin Dashboard',
    body: 'Enter the operator workspace for internal reviews, submissions, and controls.',
    href: 'https://admin.goldshore.ai',
    cta: 'Go to admin',
  },
];
---

<MarketingLayout
  title="Developers | GoldShore"
  description="APIs, gateway routing, workers, private MCP access, and the operational docs that support GoldShore."
>
  <section class="developer-hero gs-shell-section">
    <div class="developer-hero__copy">
      <p class="gs-eyebrow">Developer Hub</p>
      <h1>Tools, routing, and private surfaces for the GoldShore stack.</h1>
      <p class="developer-lead">
        This hub collects the public-facing parts of the platform and the entry points that
        stay behind Cloudflare Access. It is the right place to learn how the MCP offering works
        without exposing a public prompt surface.
      </p>
      <div class="developer-actions">
        <a href="/developer/docs" class="hero-button hero-button--primary">Open docs</a>
        <a href="/developer/mcp" class="hero-button hero-button--secondary">Explore MCP access</a>
      </div>
    </div>

    <aside class="developer-hero__panel">
      <p class="gs-eyebrow">At a glance</p>
      <ul>
        <li>Public site: strategy, docs, and system visibility.</li>
        <li>Private MCP: approved humans and agents only.</li>
        <li>Access gate: Cloudflare Access at the edge.</li>
      </ul>
    </aside>
  </section>

  <section class="gs-section gs-section--padded">
    <div class="developer-grid">
      {cards.map((card) => (
        <article class="developer-card">
          <h2>{card.title}</h2>
          <p>{card.body}</p>
          <a href={card.href} class="developer-card__link">
            {card.cta} &rarr;
          </a>
        </article>
      ))}
    </div>
  </section>

  <style>
    .developer-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
      gap: 1.5rem;
      align-items: start;
      padding-top: 4.5rem;
    }

    .developer-hero h1 {
      margin: 0.75rem 0 1rem;
      font-size: clamp(2.6rem, 5vw, 4.8rem);
      line-height: 0.95;
      letter-spacing: -0.05em;
      max-width: 12ch;
    }

    .developer-lead {
      max-width: 60ch;
      color: var(--gs-text-dim);
      line-height: 1.75;
    }

    .developer-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
      margin-top: 1.5rem;
    }

    .hero-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.8rem 1.25rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 700;
      border: 1px solid transparent;
    }

    .hero-button--primary {
      background: linear-gradient(135deg, #7dd3fc, #2dd4bf);
      color: #04111f;
    }

    .hero-button--secondary {
      border-color: rgba(255, 255, 255, 0.12);
      color: #f4f7fb;
      background: rgba(255, 255, 255, 0.03);
    }

    .developer-hero__panel {
      padding: 1.5rem;
      border-radius: 24px;
      border: 1px solid rgba(159, 220, 255, 0.12);
      background:
        radial-gradient(circle at top left, rgba(66, 153, 225, 0.18), transparent 38%),
        rgba(10, 18, 36, 0.78);
      box-shadow: var(--gs-shadow);
    }

    .developer-hero__panel ul {
      margin: 0;
      padding-left: 1.15rem;
      color: var(--gs-text-dim);
      line-height: 1.75;
      display: grid;
      gap: 0.7rem;
    }

    .developer-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .developer-card {
      padding: 1.4rem;
      border-radius: 22px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(10, 18, 36, 0.72);
      box-shadow: var(--gs-shadow);
      min-height: 220px;
      display: flex;
      flex-direction: column;
    }

    .developer-card h2 {
      margin-top: 0;
      margin-bottom: 0.75rem;
      font-size: 1.4rem;
    }

    .developer-card p {
      color: var(--gs-text-dim);
      line-height: 1.7;
      margin-bottom: 1rem;
      flex: 1 1 auto;
    }

    .developer-card__link {
      align-self: flex-start;
      color: #b2d7ff;
      font-weight: 700;
    }

    .developer-card__link:hover,
    .developer-card__link:focus-visible {
      color: #fff;
    }

    @media (max-width: 960px) {
      .developer-hero,
      .developer-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</MarketingLayout>
