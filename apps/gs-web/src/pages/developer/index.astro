---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { CANONICAL_ADMIN_ORIGIN } from '../../utils/admin-access';

export const prerender = false;

const cards = [
  {
    title: 'Documentation',
    body: 'Read the API, gateway, and worker notes that back the platform.',
    href: '/developer/docs',
    cta: 'Open docs',
  },
  {
    title: 'Private MCP Access',
    body: 'Learn how the GoldShore MCP surface stays locked to approved identities and service paths.',
    href: '/developer/mcp',
    cta: 'View MCP access',
  },
  {
    title: 'System Status',
    body: 'Check the current state of the public site and operational services.',
    href: '/status',
    cta: 'Open status',
  },
  {
    title: 'Admin Dashboard',
    body: 'Enter the operator workspace for internal reviews, submissions, and controls.',
    href: `${CANONICAL_ADMIN_ORIGIN}/admin/lead-submissions`,
    cta: 'Go to admin',
  },
  {
    title: 'Deploy Assistant',
    body: 'Search Cloudflare-native templates, stream ranked recommendations, and stage dry-run deployments.',
    href: '/admin/deploy',
    cta: 'Open assistant',
  },
];
---

<MarketingLayout
  title="Developers | GoldShore"
  description="APIs, gateway routing, workers, private MCP access, and the operational docs that support GoldShore."
>
  <section class="developer-hero gs-shell-section">
    <div class="developer-hero__copy">
      <p class="gs-eyebrow">Developer Hub</p>
      <h1>Tools, routing, and private surfaces for the GoldShore stack.</h1>
      <p class="developer-lead">
        This hub collects the public-facing parts of the platform and the entry points that stay
        behind Cloudflare Access. It is the right place to learn how the MCP offering works
        without exposing a public prompt surface.
      </p>
      <div class="developer-actions">
        <a href="/developer/docs" class="hero-button hero-button--primary">Open docs</a>
        <a href="/developer/api" class="hero-button hero-button--secondary">API reference</a>
      </div>
    </div>

    <aside class="developer-hero__panel">
      <p class="gs-eyebrow">At a glance</p>
      <p>Public site strategy, documentation, and system visibility.</p>
      <p>Private MCP for approved humans and agents only.</p>
      <p>Cloudflare Access enforced at the edge.</p>
      <strong><span></span> api.goldshore.ai · operational</strong>
    </aside>
  </section>

  <section class="gs-section gs-section--padded">
    <div class="developer-grid">
      {cards.map((card, index) => (
        <article class="developer-card">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h2>{card.title}</h2>
          <p>{card.body}</p>
          <a href={card.href} class="developer-card__link">{card.cta} &rarr;</a>
        </article>
      ))}
    </div>
  </section>

  <style>
    .developer-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
      gap: clamp(2rem, 8vw, 8rem);
      align-items: center;
      min-height: 72vh;
      padding-top: 6rem;
    }

    .developer-hero h1 {
      margin: 0.75rem 0 1rem;
      font-family: 'Syne', sans-serif;
      font-size: clamp(3rem, 6.2vw, 6.5rem);
      font-weight: 800;
      line-height: .88;
      letter-spacing: -.065em;
      max-width: 10ch;
      text-transform: uppercase;
    }

    .developer-lead {
      max-width: 60ch;
      color: var(--gs-text-dim);
      line-height: 1.75;
    }

    .developer-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
      margin-top: 1.5rem;
    }

    .hero-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.8rem 1.25rem;
      border-radius: 0;
      text-decoration: none;
      font: 600 .68rem/1 'DM Mono', monospace;
      letter-spacing: .12em;
      text-transform: uppercase;
      border: 1px solid transparent;
    }

    .hero-button--primary {
      background: #d3743e;
      color: #09080d;
    }

    .hero-button--secondary {
      border-color: rgba(211, 116, 62, .42);
      color: #f5f1eb;
      background: transparent;
    }

    .developer-hero__panel {
      position: relative;
      border: 1px solid rgba(211, 116, 62, .28);
      background: #111019;
      padding: 2rem;
    }

    .developer-hero__panel p {
      margin: 0;
      padding: .9rem 0;
      border-bottom: 1px solid rgba(255,255,255,.07);
      color: var(--gs-text-dim);
      line-height: 1.6;
    }
    .developer-hero__panel strong { display:flex; align-items:center; gap:.55rem; margin-top:1.5rem; color:#5ddb9a; font:500 .66rem/1 'DM Mono',monospace; letter-spacing:.1em; text-transform:uppercase; }
    .developer-hero__panel strong span { width:.45rem; height:.45rem; border-radius:50%; background:#5ddb9a; box-shadow:0 0 12px #5ddb9a; }
    }

    .developer-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1px;
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.08);
    }

    .developer-card {
      display: flex;
      flex-direction: column;
      gap: .75rem;
      min-height: 100%;
      padding: 1.5rem;
      border: 0;
      border-radius: 0;
      background: #0d0c13;
    }

    .developer-card h2 {
      margin-top: 0;
      margin-bottom: 0.75rem;
      font: 700 1.15rem/1.05 'Syne', sans-serif;
      text-transform: uppercase;
    }

    .developer-card p {
      color: var(--gs-text-dim);
      line-height: 1.7;
      margin-bottom: 1rem;
      flex: 1 1 auto;
    }

    .developer-card__link {
      align-self: flex-start;
      color: #d3743e;
      font: 500 .68rem/1 'DM Mono', monospace;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .developer-card__link:hover,
    .developer-card__link:focus-visible {
      color: #fff;
    }

    @media (max-width: 960px) {
      .developer-hero {
        grid-template-columns: 1fr;
      }
      .developer-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    }
    @media (max-width: 620px) {
      .developer-grid { grid-template-columns: 1fr; }
    }
  </style>
</MarketingLayout>
