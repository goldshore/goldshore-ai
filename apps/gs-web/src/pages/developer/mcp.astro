---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Logo from '../../components/brand/Logo.astro';

export const prerender = false;

const accessItems = [
  {
    title: 'Who can use it',
    body: 'Only you, approved operators, and a dedicated agent/service identity path.',
  },
  {
    title: 'How it is gated',
    body: 'Cloudflare Access sits in front of the host so the endpoint does not accept anonymous use.',
  },
  {
    title: 'What it is for',
    body: 'Controlled prompts, read/write actions, and internal tool calls that support the GoldShore stack.',
  },
  {
    title: 'What stays out',
    body: 'Public prompt boxes, open registrations, and broad anonymous tooling access.',
  },
];

const connectionSteps = [
  ['1', 'Request approval', 'Account and tool permissions are granted to a named human or service identity.'],
  ['2', 'Authenticate at the edge', 'Cloudflare Access validates the identity before the request reaches gs-api.'],
  ['3', 'Initialize the client', 'Connect with Streamable HTTP and negotiate the supported protocol version.'],
  ['4', 'Review available tools', 'The live tools/list response and protected admin console share one canonical catalog.'],
];
---

<MarketingLayout
  title="GoldShore MCP | Private Access"
  description="GoldShore MCP is a private surface for approved humans and agents. Cloudflare Access gates the endpoint before any private tool loads."
>
  <section class="mcp-hero gs-shell-section">
    <div class="mcp-hero__copy">
      <p class="gs-eyebrow">GoldShore MCP</p>
      <h1>Private tooling for approved humans and agents.</h1>
      <p class="mcp-lead">
        The public site can explain the offering, but <code>mcp.goldshore.ai</code> itself is reserved
        for identities that have already been approved. That keeps the surface useful for the
        team without turning it into an open prompt endpoint.
      </p>
      <div class="mcp-actions">
        <a href="https://admin.goldshore.ai/admin/mcp-access" class="hero-button hero-button--primary">Open MCP admin</a>
        <a href="/contact/?intent=mcp-access" class="hero-button hero-button--secondary">Request access</a>
      </div>
    </div>

    <aside class="mcp-hero__panel">
      <div class="mcp-brand">
        <Logo class="mcp-brand__logo" title="GoldShore" variant="lockup" />
        <div>
          <p class="mcp-brand__eyebrow">Access overview</p>
          <strong>Cloudflare Access enforced</strong>
        </div>
      </div>

      <dl class="mcp-stats">
        <div>
          <dt>Endpoint</dt>
          <dd>mcp.goldshore.ai</dd>
        </div>
        <div>
          <dt>Model</dt>
          <dd>Streamable HTTP</dd>
        </div>
        <div>
          <dt>Audience</dt>
          <dd>Approved humans + agents</dd>
        </div>
        <div>
          <dt>Gate</dt>
          <dd>Identity and service auth</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="gs-section gs-section--padded">
    <div class="mcp-connection">
      <div>
        <p class="gs-eyebrow">Actual connection</p>
        <h2>One endpoint. One server. Permission-gated tools.</h2>
        <p>The production surface is mounted inside the unified <code>gs-api</code> Worker. The protected admin console reads the same live tool catalog and executes through the same implementation—there is no simulated server list or separate MCP Worker.</p>
      </div>
      <div class="mcp-config" aria-label="MCP client configuration">
        <span>Streamable HTTP client</span>
        <pre><code>{`[mcp_servers."mcp.goldshore.ai"]
url = "https://mcp.goldshore.ai/mcp"
bearer_token_env_var = "MCP_GOLDSHORE_TOKEN"`}</code></pre>
        <p>Cloudflare Access service identities may also require <code>CF-Access-Client-Id</code> and <code>CF-Access-Client-Secret</code> headers. Keep all values in an encrypted secret store.</p>
      </div>
    </div>
    <div class="connection-steps">{connectionSteps.map(([number,title,body]) => <article><span>{number}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
  </section>

  <section class="gs-section gs-section--padded">
    <div class="gs-grid columns-2">
      {accessItems.map((item) => (
        <article class="mcp-card">
          <h2>{item.title}</h2>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="gs-section gs-section--padded">
    <div class="mcp-policy">
      <div>
        <p class="gs-eyebrow">Policy</p>
        <h2>Public explanation, private execution.</h2>
      </div>
      <p>
        GoldShore can describe the MCP capability on the public site, but the live host stays
        behind Cloudflare Access and does not accept anonymous prompts or changes. That gives
        the product a front door without making the underlying tool surface public.
      </p>
    </div>
  </section>

  <style>
    .mcp-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(290px, 0.8fr);
      gap: 1.5rem;
      align-items: start;
      padding-top: 4.5rem;
      width: min(76rem, calc(100% - 3rem));
      margin-inline: auto;
    }

    .mcp-hero h1 {
      margin: 0.75rem 0 1rem;
      font-family: 'Syne', sans-serif;
      font-size: clamp(2.8rem, 4.6vw, 4.75rem);
      font-weight: 800;
      line-height: 0.9;
      letter-spacing: -0.055em;
      max-width: 12ch;
      text-transform: uppercase;
    }

    .mcp-lead {
      max-width: 62ch;
      color: var(--gs-text-dim);
      line-height: 1.8;
    }

    .mcp-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
      margin-top: 1.5rem;
    }

    .hero-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.8rem 1.25rem;
      border-radius: 0;
      text-decoration: none;
      font-weight: 700;
      border: 1px solid transparent;
    }

    .hero-button--primary {
      background: #d3743e;
      color: #09080d;
    }

    .hero-button--secondary {
      border-color: rgba(211, 116, 62, 0.42);
      color: #f4f7fb;
      background: rgba(255, 255, 255, 0.03);
    }

    .mcp-hero__panel {
      padding: 1.5rem;
      border-radius: 0;
      border: 1px solid rgba(211, 116, 62, 0.28);
      background: #111019;
      box-shadow: var(--gs-shadow);
    }

    .mcp-brand {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .mcp-brand__logo {
      width: 92px;
      height: auto;
      flex: 0 0 auto;
    }

    .mcp-brand__eyebrow {
      margin: 0 0 0.25rem;
      color: rgba(233, 238, 252, 0.68);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
    }

    .mcp-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
      margin: 0;
    }

    .mcp-stats div {
      padding: 1rem;
      border-radius: 0;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(255, 255, 255, 0.03);
    }

    .mcp-stats dt {
      margin-bottom: 0.3rem;
      color: rgba(233, 238, 252, 0.68);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.74rem;
    }

    .mcp-stats dd {
      margin: 0;
      font-weight: 700;
      color: #f7fbff;
    }

    .mcp-card {
      padding: 1.4rem;
      border-radius: 0;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(10, 18, 36, 0.72);
      box-shadow: var(--gs-shadow);
    }

    .mcp-card h2 {
      margin-top: 0;
      margin-bottom: 0.7rem;
      font-size: 1.35rem;
    }

    .mcp-card p {
      margin-bottom: 0;
      color: var(--gs-text-dim);
      line-height: 1.75;
    }

    .mcp-policy {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 1.25rem;
      align-items: start;
      padding: 1.6rem;
      border-radius: 0;
      border: 1px solid rgba(211, 116, 62, 0.24);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)),
        rgba(10, 18, 36, 0.7);
    }

    .mcp-policy h2 {
      margin-top: 0;
      margin-bottom: 0;
    }

    .mcp-policy p {
      margin-bottom: 0;
      color: var(--gs-text-dim);
      line-height: 1.8;
    }

    .mcp-connection { display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,.9fr); gap:1rem; align-items:start; }
    .mcp-connection h2 { max-width:14ch; font-size:clamp(2.2rem,5vw,4.75rem); line-height:.95; }
    .mcp-connection > div > p { color:var(--gs-text-dim); line-height:1.75; }
    .mcp-config { padding:1.5rem; border:1px solid rgba(211,116,62,.28); background:#111019; }
    .mcp-config > span { color:#5ddb9a; font:600 .65rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.08em; }
    .mcp-config pre { overflow-x:auto; margin:1rem 0; padding:1rem; background:#09080d; color:#f5f1eb; }
    .connection-steps { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; margin-top:1rem; background:rgba(255,255,255,.08); }
    .connection-steps article { padding:1.25rem; background:#0d0c13; }
    .connection-steps span { color:#d3743e; font:600 .68rem 'DM Mono',monospace; }
    .connection-steps p { color:var(--gs-text-dim); line-height:1.65; }

    @media (max-width: 960px) {
      .mcp-hero,
      .mcp-policy,
      .mcp-connection {
        grid-template-columns: 1fr;
      }

      .mcp-stats {
        grid-template-columns: 1fr;
      }
      .connection-steps { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 620px) { .connection-steps { grid-template-columns:1fr; } }
  </style>
</MarketingLayout>
