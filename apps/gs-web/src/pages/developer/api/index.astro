---
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
export const prerender = false;
const endpoints = [
  ['GET', '/status', 'Public operational status for the site and API gateway.'],
  ['GET', '/api/status', 'Same-origin status proxy through gs-web to gs-api.'],
  ['GET', '/health', 'Worker liveness response.'],
  ['POST', '/v1/forms/contact/submissions', 'Turnstile-verified contact submission endpoint.'],
];
---
<MarketingLayout title="API Reference | GoldShore Developer" description="GoldShore API routes, status contracts, and gateway reference.">
  <section class="api-shell gs-shell-section">
    <aside class="api-nav"><p>API Reference</p>{endpoints.map(([method,path]) => <a href={`#${path.replace(/\W+/g,'-')}`}><b>{method}</b>{path}</a>)}</aside>
    <main class="api-main">
      <p class="gs-eyebrow">API Reference</p><div class="route-title"><span>GET</span><code>/status</code></div>
      <h1>Get system status</h1>
      <p class="api-lead">Returns the operational state of the public site and every downstream service the gateway resolves. Unauthenticated and safe to poll from status pages.</p>
      <div class="route-meta"><span>No auth</span><span>Cacheable 30s</span><span>Rate limit 120/min</span></div>
      <section><h2>Routes</h2><div class="endpoint-table">{endpoints.map(([method,path,description]) => <article id={path.replace(/\W+/g,'-')}><b class:list={[method === 'POST' && 'post']}>{method}</b><code>{path}</code><p>{description}</p></article>)}</div></section>
      <section><h2>Responses</h2><div class="response-row"><b>200</b><span>System is operational</span></div><div class="response-row error"><b>503</b><span>One or more services degraded</span></div></section>
    </main>
    <aside class="try-panel"><div class="try-tabs"><b>cURL</b><span>JS fetch</span><span>HTTP</span></div><pre><code>curl https://api.goldshore.ai/status</code></pre><label>Base URL<input value="https://api.goldshore.ai" readonly /></label><label>Endpoint<input value="/status" readonly /></label><button type="button" id="send-status-request">Send request</button><p id="status-result" role="status" aria-live="polite">Awaiting request</p></aside>
  </section>
  <script>
    const button=document.querySelector<HTMLButtonElement>('#send-status-request'); const result=document.querySelector<HTMLElement>('#status-result');
    button?.addEventListener('click',async()=>{if(!result)return;button.disabled=true;result.textContent='Requesting…';try{const response=await fetch('/api/status');result.textContent=`${response.status} · ${response.ok?'Operational':'Degraded'}`;result.dataset.state=response.ok?'ok':'error';}catch{result.textContent='Network unavailable';result.dataset.state='error';}finally{button.disabled=false;}});
  </script>
</MarketingLayout>
<style>
  .api-shell{display:grid;grid-template-columns:190px minmax(0,1fr) 320px;gap:clamp(2rem,5vw,5rem);align-items:start;padding-top:5rem;min-height:80vh}.api-nav,.try-panel{position:sticky;top:7rem}.api-nav{display:grid;gap:.45rem}.api-nav>p{color:#d3743e;font:500 .66rem/1 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase}.api-nav a{display:grid;grid-template-columns:34px 1fr;gap:.4rem;padding:.55rem 0;color:var(--gs-text-dim);font:.66rem/1.35 'DM Mono',monospace;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.06)}.api-nav a b{color:#5ddb9a}.api-main{min-width:0}.route-title{display:flex;align-items:center;gap:.8rem;margin:1.25rem 0}.route-title span{padding:.4rem .55rem;border:1px solid #5ddb9a;color:#5ddb9a;font:600 .65rem/1 'DM Mono',monospace}.route-title code{font:500 1rem/1 'DM Mono',monospace}.api-main h1{margin:.7rem 0 1rem;font:800 clamp(2.5rem,5vw,5rem)/.9 'Syne',sans-serif;letter-spacing:-.055em;text-transform:uppercase}.api-lead{max-width:62ch;color:var(--gs-text-dim);line-height:1.75}.route-meta{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.5rem 0 3.5rem}.route-meta span{padding:.45rem .65rem;border:1px solid rgba(255,255,255,.1);font:.62rem/1 'DM Mono',monospace;text-transform:uppercase}.api-main h2{margin:3rem 0 1rem;font:700 1rem/1 'Syne',sans-serif;text-transform:uppercase}.endpoint-table{border-top:1px solid rgba(255,255,255,.1)}.endpoint-table article{display:grid;grid-template-columns:44px minmax(120px,1fr) 1.6fr;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid rgba(255,255,255,.08)}.endpoint-table b,.response-row b{color:#5ddb9a;font:.65rem/1 'DM Mono',monospace}.endpoint-table b.post{color:#d3743e}.endpoint-table code{font:.72rem/1.4 'DM Mono',monospace}.endpoint-table p{margin:0;color:var(--gs-text-dim);font-size:.85rem}.response-row{display:grid;grid-template-columns:60px 1fr;padding:1rem;border:1px solid rgba(255,255,255,.08);background:#0d0c13}.response-row+.response-row{border-top:0}.response-row.error b{color:#ee705b}.try-panel{border:1px solid rgba(211,116,62,.25);background:#111019;padding:1rem}.try-tabs{display:flex;gap:1rem;padding-bottom:.8rem;border-bottom:1px solid rgba(255,255,255,.08);font:.62rem/1 'DM Mono',monospace;text-transform:uppercase}.try-tabs b{color:#d3743e}.try-tabs span{color:var(--gs-text-dim)}.try-panel pre{overflow:auto;margin:1rem 0;padding:1rem;background:#09080d;border:1px solid rgba(255,255,255,.07);font:.68rem/1.6 'DM Mono',monospace}.try-panel label{display:grid;gap:.45rem;margin:.8rem 0;color:var(--gs-text-dim);font:.6rem/1 'DM Mono',monospace;text-transform:uppercase}.try-panel input{width:100%;padding:.75rem;background:#09080d;border:1px solid rgba(255,255,255,.1);color:#f5f1eb;font:.7rem/1 'DM Mono',monospace}.try-panel button{width:100%;padding:.9rem;border:0;background:#d3743e;color:#09080d;font:700 .65rem/1 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}.try-panel button:disabled{opacity:.6}.try-panel #status-result{margin:.9rem 0 0;color:var(--gs-text-dim);font:.64rem/1.4 'DM Mono',monospace}.try-panel #status-result[data-state=ok]{color:#5ddb9a}.try-panel #status-result[data-state=error]{color:#ee705b}@media(max-width:1100px){.api-shell{grid-template-columns:180px minmax(0,1fr)}.try-panel{position:static;grid-column:2}}@media(max-width:760px){.api-shell{grid-template-columns:1fr;padding-top:2rem}.api-nav{position:static}.try-panel{grid-column:auto}.endpoint-table article{grid-template-columns:44px 1fr}.endpoint-table p{grid-column:2}}
</style>
