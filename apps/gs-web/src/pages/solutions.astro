---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowSection from '../components/FlowSection.astro';

export const prerender = false;
---
<BaseLayout title="Solutions | GoldShore" description="Choose a GoldShore engagement across web development, design, marketing, advertising, SaaS, and digital publishing." canonicalPath="/solutions/">
  <FlowSection variant="hero">
    <div>
      <h1>Solutions</h1>
      <p class="gs-text-lg">Start with the outcome. GoldShore connects web development, design, marketing, advertising, SaaS, and publishing so the public experience and its operating system can evolve together.</p>
    </div>
    <div class="gs-card">
      <h2>Choose the right starting point</h2>
      <p>Every engagement begins with scope, evidence, and a delivery boundary. We will tell you when a smaller intervention is the better fit.</p>
    </div>
  </FlowSection>
  <FlowSection>
    <div class="gs-card"><h2>Understand risk sooner</h2><p>Bring fragmented operational or market signals into a reviewable decision surface.</p><a href="/risk-radar/">Explore Risk Radar →</a></div>
    <div class="gs-card"><h2>Automate a workflow</h2><p>Design queue-backed workflows with checkpoints, fallbacks, and an audit trail.</p><a href="/services/ai-implementation/">AI implementation →</a></div>
    <div class="gs-card"><h2>Connect the system</h2><p>Integrate data, APIs, identity, and delivery paths while keeping ownership clear.</p><a href="/services/systems-integration/">Systems integration →</a></div>
    <div class="gs-card"><h2>Ship a digital product</h2><p>Move from product direction to a usable, maintainable web experience.</p><a href="/services/design-dev/">Design and development →</a></div>
  </FlowSection>
</BaseLayout>
