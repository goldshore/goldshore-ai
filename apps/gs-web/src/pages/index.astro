</header>

<main id="main-content">

<!-- ── Hero ────────────────────────────────────────────────────────────────────────── -->
<section class="hero" id="platform">
  <div class="hero-copy">
    <p class="kicker">Gold Shore Labs · Est. 2022 · New York</p>
    <h1>
      <span class="solid">Where</span>
      <span class="outlined">Strategy</span>
      <span class="accent" data-text="Operates.">Operates.</span>
    </h1>
    <p class="lead">Applied intelligence for institutions that need clarity under pressure. We build the software, run the strategy, and deploy the AI — cross-sector, full-stack, end to end.</p>
    <div class="actions">
      <a class="btn primary magnetic" href="#engage">Request Briefing</a>
      <a class="btn magnetic" href="#services">View Platform</a>
      <a class="text-link" href="/developer">Developer Hub →</a>
    </div>
    <div class="metrics">
      {metrics.map(([label,value,sub]) => (
        <div><span>{label}</span><strong>{value}</strong><em>{sub}</em></div>
      ))}
    </div>
  </div>
  <aside class="hero-panel">
    <p class="panel-title">Applied Intelligence · Digital Systems · Consulting</p>
    <div class="status-list">
      {platform.map(([name,state]) => (
        <div><span>{name}</span><b class={state.toLowerCase()}>{state}</b></div>
      ))}
    </div>
    <div class="panel-columns">
      <div><p class="panel-col-heading">Services</p>{services.map((s) => <p>{s}</p>)}</div>
      <div><p class="panel-col-heading">Sectors</p>{sectors.map((s) => <p>{s}</p>)}</div>
