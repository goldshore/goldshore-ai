const services  = ['Digital Strategy','AI Implementation','Systems Integration','Design & Development','Enterprise Consulting'];
const sectors   = ['Financial Services','Operations & Logistics','Media & Communications','Healthcare Systems','Public Sector'];
const platform  = [['Risk Radar','Live'],['Financial Signals','Live'],['Workflow Engine','Live'],['Sentiment Engine','Beta'],['AI Oracle','Soon']];
const metrics   = [['Uptime','99.98%','30-day avg'],['Signal Events','4.8B','Per month'],['Latency P99','<45ms','Gateway'],['Deploys','48/d','Verified']];
const sectorCards = [['Financial Services','Risk · Signals · Trading'],['Operations & Logistics','Workflow · Automation'],['Media & Comms','Content · Analytics'],['Healthcare Systems','Compliance · AI'],['Public Sector','Gov · Infrastructure'],['Enterprise Tech','Dev · Design · Systems']];
const telemetry = [['Platform Uptime','99.98%','30-day rolling'],['Signal Events/mo','4.8B','Validated telemetry'],['Operator Latency','<45ms','P99 gateway'],['Deploy Cadence','48/day','Verified releases']];
const capabilities = [
  ['Risk Intelligence & Financial Signals','Continuous surveillance across positions, portfolios, and market conditions. Anomaly detection, threshold alerting, operator-in-loop review — built for institutions that cannot afford surprises.',['Risk Radar','Sentiment Engine','Market Feeds','Alpaca','Bloomberg']],
  ['AI Systems & Workflow Automation',"End-to-end workflow design and execution with AI at every node. Queue-backed, auditable, with fallback paths and operator checkpoints. We don't deploy AI that cannot explain itself.",['Gemini','GPT-4','Workflow Engine','Cloudflare AI']],
  ['Digital Strategy & Systems Consulting','Architecture planning, vendor evaluation, capability mapping — the upstream work that makes everything downstream coherent. Strategy that ships, not slides.',['Strategy','Architecture','Due Diligence','Roadmapping']],
  ['Design, Development & Product','Full-cycle product and software delivery. Brand identity, design systems, Astro frontends, Cloudflare Workers, React Native — shipped on time, built to last.',['Astro','React Native','CF Workers','Design Systems']],
  ['Resilient Infrastructure & Observability','Production-grade infrastructure with full observability. Cloudflare Access, D1 databases, KV audit trails, R2 storage — secure by default, traceable at every layer.',['Cloudflare','D1','Hono','JWKS Auth']],
import Logo from '../components/brand/Logo.astro';
import ParallaxHero from '../components/hero/ParallaxHero.astro';
import RiskRadar from '../components/RiskRadar.astro';
import WebLayout from '../layouts/WebLayout.astro';

export const prerender = true;

const trustMetrics = [
  {
    label: 'Audit readiness',
    value: '100%',
    context: 'Control workflows mapped',
    detail:
      'Decision checkpoints, reviewer ownership, and evidence logs are defined from day one.',
  },
  {
    label: 'Incident response',
    value: '< 15 min',
    context: 'Mean triage handoff',
    detail:
      'Risk, compliance, and operations teams share the same runtime timeline and escalation logic.',
  },
  {
    label: 'Decision evidence',
    value: '7 years',
    context: 'Trace retention policy',
    detail:
      'Every critical AI action is preserved for regulatory review and internal post-incident analysis.',
  },
];
const stackRows = [['gs-gateway','Ingress, CORS, auth, integration routing','Mar 29','Live'],['gs-agent','Autonomous processor, queue consumer','Mar 19','Live'],['gs-api','Core API, data access layer','Mar 22','Live'],['gs-mail','Transactional mail service','Mar 29','Live'],['gs-control','Control plane, operator interface','Mar 22','Live']];
const anomalies = [['ALGO-DRIFT — Position delta exceeds 3σ','High','00:42'],['SENTIMENT — NVDA neg. velocity +18%','Med','01:14'],['LATENCY — GW P99 at 42ms','Low','02:07'],['CORRELATION — BTC/SPX decoupling','Med','03:55']];
const tickers   = [['SPY','S&P 500 ETF','521.84','+1.24%'],['NVDA','Nvidia Corp','887.22','+2.87%'],['BTC','Bitcoin','68,420','−0.43%'],['GLD','Gold ETF','2,391','+0.61%'],['TLT','20Y Treasury','93.14','−0.18%'],['VIX','Volatility Idx','13.82','−3.20%']];
const principles = [['01','Sector-Agnostic, Systems-First',"We don't specialize in one vertical — we specialize in the architecture that makes any vertical work. Finance, operations, media, healthcare: the discipline is identical."],['02','AI as Infrastructure, Not Feature','Intelligence embedded at the routing layer, not bolted on at the end. Every workflow treats AI as a first-class component with audit trails to match.'],['03','Consulting That Ships','Strategy without delivery is overhead. We provide the advisory and we build the thing — one team, one contract, full accountability from brief to production.']];
const marquee   = ['Risk Intelligence','Financial Signal Analysis','Workflow Automation','AI Implementation','Digital Strategy','Systems Integration','Design & Development','Enterprise Consulting','Sentiment Analysis','Applied Intelligence','Resilient Infrastructure','Cross-Sector Deployment'];
