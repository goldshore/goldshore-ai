      <p class="kicker">Cross-Sector Deployment Surface</p>
      <h2>5 active sectors</h2>
    </div>
  </div>
  <div class="sector-grid">
    {sectorCards.map(([name,desc]) => (
      <article><h3>{name}</h3><p>{desc}</p></article>
