    }
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      stars.forEach(s => {
        s.a += s.s;
        const alpha = 0.2 + 0.5 * Math.abs(Math.sin(s.a));
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(236,234,228,${alpha})`;
        ctx.fill();
      });
      requestAnimationFrame(draw);
    }
    resize(); init(); draw();
    window.addEventListener('resize', () => { resize(); init(); }, { passive: true });
  })();

  /* Magnetic buttons */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.magnetic').forEach(el => {
      el.addEventListener('pointermove', e => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${(e.clientX - r.left - r.width  / 2) * 0.12}px`);
        el.style.setProperty('--my', `${(e.clientY - r.top  - r.height / 2) * 0.12}px`);
      });
      el.addEventListener('pointerleave', () => {
        el.style.setProperty('--mx', '0px');
        el.style.setProperty('--my', '0px');
      });
    });
  }

  /* Ping on click */
  document.querySelectorAll('.ticker-item, .anomaly, .metrics div').forEach(el => {
    el.addEventListener('click', () => {
      el.classList.remove('is-pinged');
      void el.offsetWidth;
      el.classList.add('is-pinged');
    });
  });

}, { once: true, passive: true });
</script>

</body>
