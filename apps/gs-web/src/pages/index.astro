<!-- CONTACT -->
<div id="contact-section">
  <div class="inner">
    <div class="contact-meta">
      <p class="section-label">Contact</p>
      <h2 class="section-title">Work with<br>Gold Shore Labs.</h2>
      <p class="contact-intro">
        We take on a small number of engagements. If what you're building sits at the edge of AI capability and production systems, we want to hear about it.
      </p>
      <div class="contact-links">
        <div class="contact-link-row">
          <span class="contact-link-label">General</span>
          <a href="mailto:hello@goldshore.ai" class="contact-link-value">hello@goldshore.ai</a>
        </div>
        <div class="contact-link-row">
          <span class="contact-link-label">Gateway</span>
          <a href="https://gw.goldshore.ai" class="contact-link-value" id="gw-link">gw.goldshore.ai</a>
        </div>
        <div class="contact-link-row">
          <span class="contact-link-label">API</span>
          <a href="https://api.goldshore.ai" class="contact-link-value" id="api-link">api.goldshore.ai</a>
        </div>
        <div class="contact-link-row">
          <span class="contact-link-label">Admin</span>
          <a href="https://admin.goldshore.ai" class="contact-link-value" id="admin-contact-link">admin.goldshore.ai</a>
        </div>
      </div>
    </div>

    <!--
      Contact form — Cloudflare bindings:
        POST /api/contact
        Bindings used (set in wrangler.jsonc):
          DB  = PLATFORM_DB (D1: 9703574e-adb7-481e-8d98-96f8ce5f8a90) — stores lead_submissions
          KV  = GS_CONFIG (KV: 5f13370575784c9dacff522121104cb3) — stores contact TTL cache
          MAILCHANNELS_SENDER_EMAIL (secret) — from address
          MAILCHANNELS_API_URL (var) — https://api.mailchannels.net/tx/v1/send
          CONTACT_NOTIFICATION_EMAILS (secret) — notification recipients
    -->
    <form
      class="contact-form"
      id="contactForm"
      method="POST"
      action="/api/contact"
      novalidate
    >
      <!-- Honeypot — bots fill this, humans don't see it -->
      <div class="hp-field" aria-hidden="true">
        <input type="text" name="companyWebsite" tabindex="-1" autocomplete="off" />
      </div>
      <!-- Timing — submission too fast = spam -->
      <input type="hidden" name="formStartedAt" id="formStartedAt" />
      <input type="hidden" name="formType" value="contact" />
      <input type="hidden" name="dedupeKey" id="dedupeKey" />

      <div class="form-row">
        <div class="field">
          <label for="gs-name">Name *</label>
          <input type="text" id="gs-name" name="name" required minlength="2" maxlength="120" autocomplete="name" />
        </div>
        <div class="field">
          <label for="gs-email">Email *</label>
          <input type="email" id="gs-email" name="email" required autocomplete="email" />
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="gs-company">Organization</label>
          <input type="text" id="gs-company" name="company" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="gs-inquiry">Inquiry type *</label>
          <select id="gs-inquiry" name="inquiry" required>
            <option value="" disabled selected>Select</option>
            <option value="strategy-call">Strategy call</option>
            <option value="project-scope">Project scope</option>
            <option value="general">General</option>
            <option value="support">Support</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="gs-message">Message * <span style="color:var(--faint)">(20–4000 chars)</span></label>
        <textarea id="gs-message" name="message" required minlength="20" maxlength="4000"></textarea>
      </div>
      <div class="form-submit-row">
        <button type="submit" class="btn-submit" id="submitBtn">Send →</button>
        <p class="form-notice" id="formNotice" aria-live="polite" role="status"></p>
      </div>
    </form>
  </div>
</div>

