<!-- STATUS BAR -->
<div class="status-bar" id="systemStatus">
  <span class="dot-live"></span>
  <span id="statusText">Checking systems…</span>
</div>

<script>
  // ── Mobile menu ──
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileClose = document.getElementById('mobile-close');
  hamburger.addEventListener('click', () => mobileMenu.classList.add('open'));
  mobileClose.addEventListener('click', closeMobile);
  function closeMobile() { mobileMenu.classList.remove('open'); }

  // ── Smooth scroll nav offset ──
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const t = document.querySelector(a.getAttribute('href'));
      if (!t) return;
      e.preventDefault();
      window.scrollTo({ top: t.getBoundingClientRect().top + scrollY - 80, behavior: 'smooth' });
      closeMobile();
    });
  });

  // ── Contact form ──
  const form = document.getElementById('contactForm');
  const notice = document.getElementById('formNotice');
  const submitBtn = document.getElementById('submitBtn');

  // Set timing and dedupe fields
  document.getElementById('formStartedAt').value = Date.now();
  document.getElementById('dedupeKey').value = crypto.randomUUID().replace(/-/g,'') + crypto.randomUUID().replace(/-/g,'');

  form.addEventListener('submit', async e => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';
    notice.textContent = '';
    notice.style.color = '';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: {
          'x-gs-request-mode': 'spa',
          'accept': 'application/json',
        },
        body: new FormData(form),
      });

      const data = await res.json();

      if (data.ok) {
        notice.textContent = 'Received. We\'ll be in touch.';
        notice.style.color = '#4ade80';
        form.reset();
        document.getElementById('formStartedAt').value = Date.now();
        document.getElementById('dedupeKey').value = crypto.randomUUID().replace(/-/g,'') + crypto.randomUUID().replace(/-/g,'');
      } else {
        const msg = data.error?.message || 'Something went wrong.';
        notice.textContent = msg;
        notice.style.color = '#f87171';
      }
    } catch {
      notice.textContent = 'Network error. Try emailing hello@goldshore.ai';
      notice.style.color = '#f87171';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send →';
    }
  });

  // ── System status check via gateway health endpoint ──
  async function checkStatus() {
    try {
      const res = await fetch('https://gw.goldshore.ai/health', { signal: AbortSignal.timeout(4000) });
      const data = await res.json();
      const el = document.getElementById('statusText');
      if (data.status === 'ok') {
        el.textContent = 'All systems operational';
      } else {
        el.textContent = 'Degraded — check status';
      }
    } catch {
      document.getElementById('statusText').textContent = 'Gateway unreachable';
    }
  }
  checkStatus();

  // ── Admin link — update with correct admin URL from gateway ──
  const ADMIN_URL = 'https://admin.goldshore.ai';
  const GW_URL = 'https://gw.goldshore.ai';
  const API_URL = 'https://api.goldshore.ai';

  document.getElementById('admin-link').href = ADMIN_URL;
  document.getElementById('admin-product-link').href = ADMIN_URL;
  document.getElementById('admin-contact-link').href = ADMIN_URL;
  document.getElementById('gw-link').href = GW_URL;
  document.getElementById('api-link').href = API_URL;
</script>

