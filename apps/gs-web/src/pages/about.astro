---
import { GSButton } from '@goldshore/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowSection from '../components/FlowSection.astro';

export const prerender = false;

const values = [
  {
    title: 'Transparency',
    body: 'Clear engagement scopes, plain-language reporting, and no hidden fees in how we price or deliver work.',
  },
  {
    title: 'Operational rigor',
    body: 'Every system we run ships with observability, audit trails, and human checkpoints — nothing operates as a black box.',
  },
  {
    title: 'Security by default',
    body: 'Enterprise-grade encryption, least-privilege access, and Cloudflare Access-gated operator tooling across every environment we touch.',
  },
  {
    title: 'Built to explain itself',
    body: 'We don’t deploy AI or automation that can’t justify its own decisions to the operators responsible for them.',
  },
];
---

<BaseLayout
  title="About GoldShore | Applied Intelligence"
  description="GoldShore is an applied intelligence partner for institutions that need clarity under pressure — risk tooling, AI systems, and resilient infrastructure, built and operated end to end."
  canonicalPath="/about"
>
  <FlowSection variant="hero">
    <div>
      <p class="gs-eyebrow">About</p>
      <h1>About GoldShore</h1>
      <p class="gs-text-lg">Applied intelligence for institutions that need clarity under pressure.</p>
    </div>
    <div class="gs-card">
      <h3 class="section-title">Our mission</h3>
      <p>
        GoldShore builds and operates the software, risk tooling, and AI systems that institutions rely on when they
        cannot afford surprises — cross-sector, full-stack, end to end.
      </p>
    </div>
  </FlowSection>

  <FlowSection>
    <div class="gs-grid columns-2">
      {values.map((value) => (
        <div class="gs-card">
          <h3 class="section-title">{value.title}</h3>
          <p>{value.body}</p>
        </div>
      ))}
    </div>
  </FlowSection>

  <FlowSection>
    <div>
      <h2>Our team</h2>
      <p class="gs-text-lg">
        GoldShore is built by operators focused on resilient systems, applied intelligence, and high-trust execution
        — combining decades of experience across financial markets, software engineering, and production infrastructure.
      </p>
      <GSButton href="/team">Meet the team</GSButton>
    </div>
  </FlowSection>

  <FlowSection variant="hero">
    <div>
      <h2>Ready to operationalize?</h2>
      <p class="gs-text-lg">GoldShore engagements are scoped to your operational constraints, with clear milestones and measurable outcomes.</p>
      <GSButton href="/contact" data-analytics-id="about-cta">Request a briefing</GSButton>
    </div>
  </FlowSection>
</BaseLayout>
