---
import { GSButton } from '@goldshore/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowSection from '../components/FlowSection.astro';

export const prerender = false;
---

<BaseLayout
  title="Contact GoldShore"
  description="Get in touch with GoldShore for briefings, engagement scoping, or support."
  canonicalPath="/contact"
>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <FlowSection variant="hero">
    <div>
      <p class="gs-eyebrow">Contact</p>
      <h1>Contact GoldShore</h1>
      <p class="gs-text-lg">Tell us about the system, timeline, or risk profile you're working with — we'll scope from there.</p>
    </div>
  </FlowSection>

  <FlowSection>
    <div class="gs-grid columns-2">
      <div class="gs-card">
        <h2 class="section-title">Get in touch</h2>
        <form id="contact-form">
          <div class="gs-form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>

          <div class="gs-form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>

          <div class="gs-form-group">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" required />
          </div>

          <div class="gs-form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          <div class="cf-turnstile" data-sitekey="0x4AAAAAAESEtC0-1kwdI9_7"></div>

          <GSButton type="submit">Send message</GSButton>
        </form>
      </div>

      <div class="gs-card">
        <h2 class="section-title">Contact information</h2>

        <div class="gs-info-block">
          <h3>Briefings &amp; sales</h3>
          <p><a href="mailto:sales@goldshore.ai">sales@goldshore.ai</a></p>
        </div>

        <div class="gs-info-block">
          <h3>Support</h3>
          <p><a href="mailto:support@goldshore.ai">support@goldshore.ai</a></p>
        </div>

        <div class="gs-info-block">
          <h3>Support hours</h3>
          <p>Monday – Friday: 9:00 AM – 5:00 PM UTC<br />Saturday – Sunday: Closed</p>
        </div>

        <div class="gs-info-block">
          <h3>Response time</h3>
          <p>We typically respond within one business day.</p>
        </div>
      </div>
    </div>
  </FlowSection>
</BaseLayout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData);

    const token = (window as any).turnstile?.getResponse?.();
    if (!token) {
      alert('Please complete the bot verification.');
      return;
    }

    data['cf-turnstile-response'] = token;

    try {
      const response = await fetch('/api/forms/contact/submissions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        alert('Thank you! We received your message and will get back to you soon.');
        (window as any).turnstile?.reset?.();
        (e.target as HTMLFormElement).reset();
      } else {
        alert('Failed to send message. Please try again.');
      }
    } catch (error) {
      alert('Error sending message. Please try again later.');
    }
  });
</script>

<style>
  .gs-form-group {
    margin-bottom: 1.5rem;
  }

  .gs-form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .gs-form-group input,
  .gs-form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--gs-surface-2, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--gs-border-color, rgba(255, 255, 255, 0.12));
    border-radius: 8px;
    color: inherit;
    font-family: inherit;
    font-size: 0.9rem;
  }

  .gs-info-block {
    margin-bottom: 2rem;
  }

  .gs-info-block h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
</style>
