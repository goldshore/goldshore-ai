---
import { GSButton } from '@goldshore/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowSection from '../components/FlowSection.astro';

export const prerender = false;
---

<BaseLayout
  title="Contact GoldShore"
  description="Get in touch with GoldShore for briefings, engagement scoping, or support."
  canonicalPath="/contact"
>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <FlowSection variant="hero">
    <div>
      <p class="gs-eyebrow">Contact</p>
      <h1>Contact GoldShore</h1>
      <p class="gs-text-lg">Tell us about the system, timeline, or risk profile you're working with — we'll scope from there.</p>
    </div>
  </FlowSection>

  <FlowSection>
    <div class="gs-grid columns-2">
      <div class="gs-card">
        <h2 class="section-title">Get in touch</h2>
        <form id="contact-form">
          <div class="gs-form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>

          <div class="gs-form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>

          <div class="gs-form-group">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" required />
          </div>

          <div class="gs-form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          <div class="cf-turnstile" data-sitekey="0x4AAAAAAESEtC0-1kwdI9_7"></div>

          <GSButton type="submit">Send message</GSButton>
          <p id="contact-form-status" class="contact-form-status" role="status" aria-live="polite" hidden></p>
        </form>
      </div>

      <div class="gs-card">
        <h2 class="section-title">Contact information</h2>

        <div class="gs-info-block">
          <h3>Briefings &amp; sales</h3>
          <p><a href="mailto:sales@goldshore.ai">sales@goldshore.ai</a></p>
        </div>

        <div class="gs-info-block">
          <h3>Support</h3>
          <p><a href="mailto:support@goldshore.ai">support@goldshore.ai</a></p>
        </div>

        <div class="gs-info-block">
          <h3>Support hours</h3>
          <p>Monday – Friday: 9:00 AM – 5:00 PM UTC<br />Saturday – Sunday: Closed</p>
        </div>

        <div class="gs-info-block">
          <h3>Response time</h3>
          <p>We typically respond within one business day.</p>
        </div>
      </div>
    </div>
  </FlowSection>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formStatus = document.getElementById('contact-form-status');
  const submitButton = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const showStatus = (message: string, state: 'error' | 'success' | 'progress') => {
    if (!formStatus) return;
    formStatus.textContent = message;
    formStatus.dataset.state = state;
    formStatus.hidden = false;
  };

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData);

    const token = (window as any).turnstile?.getResponse?.();
    if (!token) {
      showStatus('Please complete the bot verification before sending your message.', 'error');
      return;
    }

    data['cf-turnstile-response'] = token;
    showStatus('Sending your message…', 'progress');
    if (submitButton) submitButton.disabled = true;

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        showStatus('Thank you! We received your message and will get back to you soon.', 'success');
        (window as any).turnstile?.reset?.();
        contactForm.reset();
      } else {
        const payload = await response.json().catch(() => null) as { error?: string | { message?: string } } | null;
        const serverMessage = typeof payload?.error === 'string' ? payload.error : payload?.error?.message;
        showStatus(serverMessage || 'Failed to send message. Please try again.', 'error');
      }
    } catch (error) {
      showStatus('Unable to reach the message service. Please try again later.', 'error');
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>

<style>
  .gs-form-group {
    margin-bottom: 1.5rem;
  }

  .gs-form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .gs-form-group input,
  .gs-form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--gs-surface-2, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--gs-border-color, rgba(255, 255, 255, 0.12));
    border-radius: 8px;
    color: inherit;
    font-family: inherit;
    font-size: 0.9rem;
  }

  .gs-info-block {
    margin-bottom: 2rem;
  }

  .gs-info-block h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .contact-form-status {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--gs-border-color, rgba(255, 255, 255, 0.12));
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.035);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .contact-form-status[data-state='error'] {
    border-color: rgba(238, 112, 91, 0.55);
    color: #ffb3a6;
  }

  .contact-form-status[data-state='success'] {
    border-color: rgba(82, 200, 120, 0.55);
    color: #a8e4ba;
  }

  #contact-form button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
</style>
