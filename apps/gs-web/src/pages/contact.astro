---
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Get in touch with GoldShore for support, sales, or partnership inquiries." />
    <title>Contact Us - GoldShore</title>
    <link rel="stylesheet" href="../styles/public.css" />
    <link rel="stylesheet" href="../styles/contact.css" />
  </head>
  <body class="gs-public-page">
    <PublicHeader />
    
    <main class="gs-contact-page">
      <section class="gs-hero-section">
        <div class="gs-container">
          <div class="gs-hero-content">
            <h1>Contact Us</h1>
            <p class="gs-hero-subtitle">We'd love to hear from you</p>
          </div>
        </div>
      </section>

      <section class="gs-contact-section">
        <div class="gs-container">
          <div class="gs-contact-grid">
            <div class="gs-contact-form">
              <h2>Get in Touch</h2>
              <form id="contact-form">
                <div class="gs-form-group">
                  <label for="name">Name</label>
                  <input type="text" id="name" name="name" required />
                </div>

                <div class="gs-form-group">
                  <label for="email">Email</label>
                  <input type="email" id="email" name="email" required />
                </div>

                <div class="gs-form-group">
                  <label for="subject">Subject</label>
                  <input type="text" id="subject" name="subject" required />
                </div>

                <div class="gs-form-group">
                  <label for="message">Message</label>
                  <textarea id="message" name="message" rows="6" required></textarea>
                </div>

                <button type="submit" class="gs-btn gs-btn-primary">Send Message</button>
              </form>
            </div>

            <div class="gs-contact-info">
              <h2>Contact Information</h2>
              
              <div class="gs-info-block">
                <h3>Email</h3>
                <p><a href="mailto:support@goldshore.ai">support@goldshore.ai</a></p>
              </div>

              <div class="gs-info-block">
                <h3>Sales</h3>
                <p><a href="mailto:sales@goldshore.ai">sales@goldshore.ai</a></p>
              </div>

              <div class="gs-info-block">
                <h3>Support Hours</h3>
                <p>Monday - Friday: 9:00 AM - 5:00 PM UTC<br />
                   Saturday - Sunday: Closed</p>
              </div>

              <div class="gs-info-block">
                <h3>Response Time</h3>
                <p>We typically respond within 24 hours during business hours.</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <PublicFooter />
  </body>
</html>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData);

    try {
      const response = await fetch('/api/forms/contact/submissions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        alert('Thank you! We received your message and will get back to you soon.');
        (e.target as HTMLFormElement).reset();
      } else {
        alert('Failed to send message. Please try again.');
      }
    } catch (error) {
      alert('Error sending message. Please try again later.');
    }
  });
</script>

<style>
  .gs-contact-page {
    background: linear-gradient(135deg, #050b14 0%, #0f1622 100%);
    color: rgba(226, 232, 240, 0.92);
  }

  .gs-contact-section {
    padding: 80px 20px;
  }

  .gs-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  @media (max-width: 768px) {
    .gs-contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  .gs-contact-form h2,
  .gs-contact-info h2 {
    font-size: 28px;
    margin-bottom: 32px;
  }

  .gs-form-group {
    margin-bottom: 24px;
  }

  .gs-form-group label {
    display: block;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 8px;
    color: rgba(226, 232, 240, 0.9);
  }

  .gs-form-group input,
  .gs-form-group textarea {
    width: 100%;
    padding: 12px 16px;
    background: rgba(15, 22, 34, 0.5);
    border: 1px solid rgba(226, 232, 240, 0.2);
    border-radius: 8px;
    color: rgba(226, 232, 240, 0.92);
    font-family: inherit;
    font-size: 14px;
  }

  .gs-form-group input:focus,
  .gs-form-group textarea:focus {
    outline: none;
    border-color: #3b82f6;
    background: rgba(15, 22, 34, 0.8);
  }

  .gs-info-block {
    margin-bottom: 40px;
  }

  .gs-info-block h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .gs-info-block p {
    color: rgba(226, 232, 240, 0.7);
    font-size: 14px;
    line-height: 1.6;
  }

  .gs-info-block a {
    color: #3b82f6;
    text-decoration: none;
  }

  .gs-info-block a:hover {
    text-decoration: underline;
  }
</style>
