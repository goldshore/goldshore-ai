---
import { GSButton } from '@goldshore/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="Contact GoldShore"
  description="Get in touch with GoldShore for briefings, engagement scoping, or support."
  canonicalPath="/contact"
>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <section class="intake-shell gs-shell-section">
    <div class="intake-copy">
      <p class="gs-eyebrow">Project Intake</p>
      <h1>Tell us what is not working.</h1>
      <p>Briefings run 45 minutes with the people who would do the work. Send the shape of the problem and any constraints you already know about.</p>
      <dl><div><dt>Response time</dt><dd>Within one business day</dd></div><div><dt>Briefing length</dt><dd>45 minutes</dd></div><div><dt>You speak with</dt><dd>The delivery team</dd></div><div><dt>Cost</dt><dd>No charge</dd></div></dl>
    </div>
    <div class="intake-card">
        <form id="contact-form">
          <div class="gs-form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />
          </div>

          <div class="gs-form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>

          <div class="gs-form-group">
            <label for="subject">Project or company</label>
            <input type="text" id="subject" name="subject" required placeholder="Company or agency" />
          </div>

          <div class="gs-form-group">
            <label for="sector">Sector</label>
            <select id="sector" name="sector" required>
              <option value="">Select a sector</option>
              <option>Financial services</option><option>Operations &amp; logistics</option><option>Media &amp; communications</option><option>Healthcare systems</option><option>Public sector</option><option>Enterprise technology</option>
            </select>
          </div>

          <fieldset class="interest-options"><legend>Engagement type</legend><label><input type="radio" name="interest" value="advisory" required />Advisory</label><label><input type="radio" name="interest" value="build" />Build</label><label><input type="radio" name="interest" value="platform" />Platform licence</label><label><input type="radio" name="interest" value="unsure" />Not sure yet</label></fieldset>

          <div class="gs-form-group">
            <label for="message">What is the problem?</label>
            <textarea id="message" name="message" rows="6" required placeholder="Systems, constraints, what has already been tried"></textarea>
          </div>

          <div class="cf-turnstile" data-sitekey="0x4AAAAAAESEtC0-1kwdI9_7"></div>

          <GSButton type="submit">Send message</GSButton>
          <p id="contact-form-status" class="contact-form-status" role="status" aria-live="polite" hidden></p>
        </form>
    </div>
  </section>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formStatus = document.getElementById('contact-form-status');
  const submitButton = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const showStatus = (message: string, state: 'error' | 'success' | 'progress') => {
    if (!formStatus) return;
    formStatus.textContent = message;
    formStatus.dataset.state = state;
    formStatus.hidden = false;
  };

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData);

    const token = (window as any).turnstile?.getResponse?.();
    if (!token) {
      showStatus('Please complete the bot verification before sending your message.', 'error');
      return;
    }

    data['cf-turnstile-response'] = token;
    showStatus('Sending your message…', 'progress');
    if (submitButton) submitButton.disabled = true;

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        showStatus('Thank you! We received your message and will get back to you soon.', 'success');
        (window as any).turnstile?.reset?.();
        contactForm.reset();
      } else {
        const payload = await response.json().catch(() => null) as { error?: string | { message?: string } } | null;
        const serverMessage = typeof payload?.error === 'string' ? payload.error : payload?.error?.message;
        showStatus(serverMessage || 'Failed to send message. Please try again.', 'error');
      }
    } catch (error) {
      showStatus('Unable to reach the message service. Please try again later.', 'error');
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>

<style>
  .intake-shell{display:grid;grid-template-columns:minmax(0,.9fr) minmax(420px,1.1fr);gap:clamp(3rem,8vw,9rem);align-items:start;padding-top:6rem;padding-bottom:7rem}.intake-copy h1{max-width:9ch;margin:1rem 0 1.5rem;font:800 clamp(3.2rem,6vw,6.8rem)/.88 'Syne',sans-serif;letter-spacing:-.065em;text-transform:uppercase}.intake-copy>p:not(.gs-eyebrow){max-width:54ch;color:var(--gs-text-dim);line-height:1.7}.intake-copy dl{margin:3rem 0 0;border-top:1px solid rgba(255,255,255,.08)}.intake-copy dl div{padding:1rem 0;border-bottom:1px solid rgba(255,255,255,.08)}.intake-copy dt{color:#d3743e;font:500 .62rem/1 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase}.intake-copy dd{margin:.45rem 0 0;font:600 1rem/1.3 'Syne',sans-serif}.intake-card{position:relative;padding:clamp(1.5rem,4vw,3rem);border:1px solid rgba(211,116,62,.28);background:#0d0c13}.intake-card::before,.intake-card::after{content:'';position:absolute;width:14px;height:14px;border-color:#d3743e}.intake-card::before{top:-1px;right:-1px;border-top:1px solid;border-right:1px solid}.intake-card::after{bottom:-1px;left:-1px;border-bottom:1px solid;border-left:1px solid}.gs-form-group{margin-bottom:1.25rem}

  .gs-form-group label {
    display: block;
    color:var(--gs-text-dim);font:500 .62rem/1 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;
    margin-bottom: 0.5rem;
  }

  .gs-form-group input,
  .gs-form-group select,
  .gs-form-group textarea {
    width: 100%;
    padding:.9rem 1rem;background:#09080d;border:1px solid rgba(255,255,255,.1);border-radius:0;
    color: inherit;
    font-family: inherit;
    font-size: 0.9rem;
  }

  .contact-form-status {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--gs-border-color, rgba(255, 255, 255, 0.12));
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.035);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .contact-form-status[data-state='error'] {
    border-color: rgba(238, 112, 91, 0.55);
    color: #ffb3a6;
  }

  .contact-form-status[data-state='success'] {
    border-color: rgba(82, 200, 120, 0.55);
    color: #a8e4ba;
  }

  #contact-form button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  .interest-options{margin:0 0 1.25rem;padding:0;border:0}.interest-options legend{margin-bottom:.65rem;color:var(--gs-text-dim);font:500 .62rem/1 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase}.interest-options label{display:inline-flex;align-items:center;margin:0 .45rem .45rem 0;padding:.7rem .8rem;border:1px solid rgba(255,255,255,.1);color:var(--gs-text-dim);font:500 .62rem/1 'DM Mono',monospace;text-transform:uppercase;cursor:pointer}.interest-options input{accent-color:#d3743e;margin:0 .45rem 0 0}.interest-options label:has(input:checked){border-color:#d3743e;color:#d3743e;background:rgba(211,116,62,.08)}
  #contact-form :global(button[type='submit']){width:100%;margin-top:1rem;border-radius:0;background:#d3743e;color:#09080d;font:700 .68rem/1 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase}
  @media(max-width:850px){.intake-shell{grid-template-columns:1fr;padding-top:2.5rem}.intake-copy h1{font-size:clamp(3rem,13vw,5.5rem)}}
</style>
