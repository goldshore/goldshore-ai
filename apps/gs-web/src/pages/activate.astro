---
import BaseLayout from '../layouts/BaseLayout.astro';
const apiOrigin = Astro.locals.PUBLIC_API || import.meta.env.PUBLIC_API || 'https://api.goldshore.ai';
---

<BaseLayout title="Activate your GoldShore account" description="Accept a GoldShore workspace invitation.">
  <main class="activation-shell" data-api-origin={apiOrigin}>
    <section class="activation-card" aria-labelledby="activation-title">
      <p class="eyebrow">GoldShore Access</p>
      <h1 id="activation-title">Accept your invitation</h1>
      <p id="activation-status">Checking your secure invitation…</p>
      <a id="continue-link" href="https://admin.goldshore.ai/" hidden>Continue to the admin workspace</a>
    </section>
  </main>
</BaseLayout>

<script>
  const shell = document.querySelector<HTMLElement>('.activation-shell');
  const status = document.querySelector<HTMLElement>('#activation-status');
  const continueLink = document.querySelector<HTMLAnchorElement>('#continue-link');
  const token = new URLSearchParams(location.hash.slice(1)).get('token');
  history.replaceState(null, '', location.pathname);

  if (!shell || !status || !token) {
    if (status) status.textContent = 'This invitation link is incomplete or expired.';
  } else {
    fetch(`${shell.dataset.apiOrigin}/invitations/accept`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ token }),
    }).then(async (response) => {
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Invitation activation failed.');
      status.textContent = 'Your invitation is active. Sign in with the same email address that received the invitation.';
      if (continueLink) {
        continueLink.href = result.loginUrl || 'https://admin.goldshore.ai/';
        continueLink.hidden = false;
      }
    }).catch((error) => {
      status.textContent = error instanceof Error ? error.message : 'Invitation activation failed.';
    });
  }
</script>

<style>
  .activation-shell{min-height:75vh;display:grid;place-items:center;padding:8rem 1.25rem;background:#07080b;color:#f4f0e8}
  .activation-card{width:min(620px,100%);padding:clamp(2rem,6vw,4rem);border:1px solid #2b2c32;background:#111217}
  .eyebrow{color:#d3743e;font:700 .75rem/1.2 monospace;letter-spacing:.14em;text-transform:uppercase}
  h1{margin:.8rem 0 1rem;font-size:clamp(2.3rem,7vw,4.5rem);line-height:.98;letter-spacing:-.04em}
  #activation-status{color:#b8b8bf;line-height:1.65}
  #continue-link{display:inline-block;margin-top:1.5rem;padding:.9rem 1.1rem;background:#d3743e;color:#09080d;font-weight:700;text-decoration:none}
</style>
