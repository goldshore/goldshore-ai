# ════════════════════════════════════════════════════════════════════════════════
# gs-web/wrangler.toml — Synchronized Binding Configuration
#
# This is the canonical frontend Worker configuration. Copy the sections below
# into your actual wrangler.toml and deploy with:
#   wrangler deploy --env prod
#
# Secrets (dashboard-managed, NOT in this file):
#   wrangler secret put ADMIN_OWNER_EMAILS --env prod
#
# IMPORTANT: gs-web is a THIN frontend Worker. It has NO D1, R2, Queues, or
# service bindings. All data access goes through api.goldshore.ai.
# ════════════════════════════════════════════════════════════════════════════════

name = "gs-web"
main = "./dist/server/entry.mjs"
compatibility_date = "2026-08-12"
compatibility_flags = ["nodejs_compat"]

workers_dev = false

# ── Static Assets (Astro build output) ──
[assets]
directory = "./dist/client"
binding = "ASSETS"
run_worker_first = true
not_found_handling = "404-page"

# ── Cloudflare Images ──
[images]
binding = "IMAGES"

# ── Environment: Production ──
[env.prod]
name = "gs-web"
routes = [
  { pattern = "goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "goldshore.org/*", zone_name = "goldshore.org" },
  { pattern = "www.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "www.goldshore.org/*", zone_name = "goldshore.org" },
  { pattern = "admin.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "admin.goldshore.org/*", zone_name = "goldshore.org" },
  { pattern = "risk.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "risk.goldshore.org/*", zone_name = "goldshore.org" }
]

# ── Static Assets (repeated for env.prod to avoid auto-provisioning) ──
[env.prod.assets]
directory = "./dist/client"
binding = "ASSETS"
run_worker_first = true
not_found_handling = "404-page"

# ── Images (repeated for env.prod) ──
[env.prod.images]
binding = "IMAGES"

# ── Environment Variables ──
[env.prod.vars]
APP_VERSION = "1.0.0"
ENVIRONMENT = "production"
PUBLIC_ENV = "production"
PUBLIC_API_BASE_URL = "https://api.goldshore.ai"
CLOUDFLARE_ACCESS_AUDIENCE = "9b97506a6f0d65a060dda7fa33aa66f6cee4112898fd45e5cf4da1d25db996c0"
CLOUDFLARE_ACCESS_APPLICATION = "admin-production"
CLOUDFLARE_TEAM_DOMAIN = "goldshore.cloudflareaccess.com"
CONTACT_NOTIFICATION_EMAILS = "marstonr6@gmail.com"

# ════════════════════════════════════════════════════════════════════════════════
# BINDING POLICY FOR GS-WEB
# ════════════════════════════════════════════════════════════════════════════════
#
# Allowed bindings:
#   - ASSETS (static files from Astro build)
#   - IMAGES (Cloudflare Images for optimization)
#   - Secrets for admin ACL (ADMIN_OWNER_EMAILS only)
#   - Environment variables (PUBLIC_* only)
#
# FORBIDDEN bindings (remove if present):
#   ✗ D1 databases (all data access → api.goldshore.ai)
#   ✗ KV namespaces (session → Astro adapter, other data → API)
#   ✗ R2 buckets (uploads → API, delivery via CDN)
#   ✗ Queues (messaging → API)
#   ✗ Durable Objects (state → API)
#   ✗ AI (inference → API)
#   ✗ Service bindings (communication → HTTP to api.goldshore.ai)
#
# Rationale: This separation ensures clear API boundaries, single source of truth
# for data, and decoupled deployments. Frontend can scale independently of
# backend infrastructure.
# ════════════════════════════════════════════════════════════════════════════════
