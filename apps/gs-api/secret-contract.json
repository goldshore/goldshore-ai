{
  "schemaVersion": 1,
  "management": "Cloudflare dashboard or approved Cloudflare Secrets Store only",
  "secrets": [
    { "name": "JWT_SECRET", "consumer": "authentication/session signing", "environment": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 90, "failureBehavior": "fail closed; authentication unavailable", "required": true },
    { "name": "ACCESS_CLIENT_SECRET", "consumer": "Cloudflare Access service-token validation", "environment": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 90, "failureBehavior": "fail closed; protected routes reject requests", "required": true },
    { "name": "CONTROL_SYNC_TOKEN", "consumer": "control-plane synchronization", "environment": ["preview", "prod"], "owner": "Platform", "rotationIntervalDays": 90, "failureBehavior": "fail closed; synchronization rejected", "required": true },
    { "name": "INTEGRATION_MASTER_KEY", "consumer": "integration secret encryption", "environment": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 365, "failureBehavior": "fail closed; integration secret operations unavailable", "required": true },
    { "name": "OPENAI_API_KEY", "consumer": "OpenAI provider", "environment": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "failureBehavior": "provider disabled; configured fallback may run", "required": false },
    { "name": "GEMINI_API_KEY", "consumer": "Gemini provider", "environment": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "failureBehavior": "provider disabled; configured fallback may run", "required": false },
    { "name": "ANTHROPIC_API_KEY", "consumer": "Anthropic provider and deployment assistant", "environment": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "failureBehavior": "provider-specific features unavailable", "required": false },
    { "name": "MAILCHANNELS_SENDER_EMAIL", "consumer": "transactional form email", "environment": ["preview", "prod"], "owner": "Platform", "rotationIntervalDays": 365, "failureBehavior": "submission persists but email is not attempted", "required": false },
    { "name": "GITHUB_API_TOKEN", "consumer": "deployment assistant GitHub API", "environment": ["preview", "prod"], "owner": "Platform", "rotationIntervalDays": 90, "failureBehavior": "GitHub-backed assistant operations unavailable", "required": false },
    { "name": "GITHUB_CLIENT_SECRET", "consumer": "GitHub OAuth callback", "environment": ["preview", "prod"], "owner": "Identity", "rotationIntervalDays": 180, "failureBehavior": "GitHub login unavailable", "required": false },
    { "name": "GS_GITHUB_WEBHOOK_SECRET", "consumer": "GitHub repository webhook HMAC verification", "environment": ["prod"], "owner": "Platform", "rotationIntervalDays": 180, "failureBehavior": "GitHub webhooks rejected", "required": false },
    { "name": "GOOGLE_OAUTH_CLIENT_SECRET", "consumer": "Google OAuth callback", "environment": ["preview", "prod"], "owner": "Identity", "rotationIntervalDays": 180, "failureBehavior": "Google login unavailable", "required": false },
    { "name": "TURNSTILE_SECRET_KEY", "consumer": "Turnstile verification", "environment": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 180, "failureBehavior": "protected form verification fails closed", "required": false },
    { "name": "OAUTH_TOKEN_ENCRYPTION_KEY", "consumer": "OAuth token encryption", "environment": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 365, "failureBehavior": "OAuth token persistence fails closed", "required": false },
    { "name": "STRIPE_API_KEY", "consumer": "Stripe integration", "environment": ["preview", "prod"], "owner": "Finance", "rotationIntervalDays": 90, "failureBehavior": "Stripe operations unavailable", "required": false },
    { "name": "STRIPE_WEBHOOK_SECRET", "consumer": "Stripe webhook verification", "environment": ["preview", "prod"], "owner": "Finance", "rotationIntervalDays": 90, "failureBehavior": "webhooks rejected", "required": false },
    { "name": "SENDGRID_API_KEY", "consumer": "SendGrid integration", "environment": ["preview", "prod"], "owner": "Platform", "rotationIntervalDays": 90, "failureBehavior": "SendGrid delivery unavailable", "required": false }
  ]
}
