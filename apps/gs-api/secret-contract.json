{
  "schemaVersion": 1,
  "management": "Cloudflare dashboard or approved Cloudflare Secrets Store only",
  "legacyAliasesInQuarantine": ["GITHUB_TOKEN", "GH_TOKEN"],
  "secrets": [
    { "name": "JWT_SECRET", "consumer": "authentication and session signing", "environments": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 90, "required": true },
    { "name": "ACCESS_CLIENT_SECRET", "consumer": "Cloudflare Access service-token validation", "environments": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 90, "required": true },
    { "name": "CONTROL_SYNC_TOKEN", "consumer": "control-plane synchronization", "environments": ["preview", "prod"], "owner": "Platform", "rotationIntervalDays": 90, "required": true },
    { "name": "INTEGRATION_MASTER_KEY", "consumer": "integration-secret envelope encryption", "environments": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 365, "required": true },
    { "name": "OAUTH_TOKEN_ENCRYPTION_KEY", "consumer": "OAuth refresh-token encryption", "environments": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 365, "required": true },
    { "name": "CLOUDFLARE_API_TOKEN", "consumer": "read-only Cloudflare inventory endpoints", "environments": ["preview", "prod"], "owner": "Platform", "rotationIntervalDays": 90, "required": false, "maximumScope": "read-only" },
    { "name": "OPENAI_API_KEY", "consumer": "OpenAI Responses provider", "environments": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "required": false },
    { "name": "GEMINI_API_KEY", "consumer": "Gemini provider", "environments": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "required": false },
    { "name": "ANTHROPIC_API_KEY", "consumer": "Anthropic Messages provider", "environments": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "required": false },
    { "name": "LLM_API_KEY", "consumer": "approved generic LLM provider", "environments": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "required": false },
    { "name": "OPENCLAW_API_KEY", "consumer": "OpenClaw provider", "environments": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "required": false },
    { "name": "LOCAL_LLM_API_KEY", "consumer": "private LLM provider", "environments": ["preview", "prod"], "owner": "AI Platform", "rotationIntervalDays": 90, "required": false },
    { "name": "GITHUB_API_TOKEN", "consumer": "GitHub deployment-assistant read and draft-PR operations", "environments": ["preview", "prod"], "owner": "Platform", "rotationIntervalDays": 90, "required": false },
    { "name": "GITHUB_CLIENT_SECRET", "consumer": "GitHub OAuth callback", "environments": ["preview", "prod"], "owner": "Identity", "rotationIntervalDays": 180, "required": false },
    { "name": "GOOGLE_OAUTH_CLIENT_SECRET", "consumer": "Google OAuth and Business Profile callback", "environments": ["preview", "prod"], "owner": "Identity", "rotationIntervalDays": 180, "required": false },
    { "name": "GOOGLE_ADS_DEVELOPER_TOKEN", "consumer": "Google Ads API", "environments": ["preview", "prod"], "owner": "Business Integrations", "rotationIntervalDays": 180, "required": false },
    { "name": "META_APP_SECRET", "consumer": "Meta and Instagram OAuth", "environments": ["preview", "prod"], "owner": "Business Integrations", "rotationIntervalDays": 180, "required": false },
    { "name": "X_CLIENT_SECRET", "consumer": "X OAuth", "environments": ["preview", "prod"], "owner": "Business Integrations", "rotationIntervalDays": 180, "required": false },
    { "name": "GOLDCLAW_SANDBOX_API_TOKEN", "consumer": "GoldClaw sandbox connector", "environments": ["preview", "prod"], "owner": "Platform", "rotationIntervalDays": 30, "required": false },
    { "name": "TURNSTILE_SECRET_KEY", "consumer": "Turnstile form verification", "environments": ["preview", "prod"], "owner": "Security", "rotationIntervalDays": 180, "required": false },
    { "name": "MAILCHANNELS_SENDER_EMAIL", "consumer": "transactional form mail sender identity", "environments": ["preview", "prod"], "owner": "Mail Operations", "rotationIntervalDays": 365, "required": false },
    { "name": "SENDGRID_API_KEY", "consumer": "SendGrid delivery", "environments": ["preview", "prod"], "owner": "Mail Operations", "rotationIntervalDays": 90, "required": false },
    { "name": "STRIPE_API_KEY", "consumer": "Stripe server API", "environments": ["preview", "prod"], "owner": "Finance", "rotationIntervalDays": 90, "required": false },
    { "name": "STRIPE_WEBHOOK_SECRET", "consumer": "Stripe webhook verification", "environments": ["preview", "prod"], "owner": "Finance", "rotationIntervalDays": 90, "required": false }
  ]
