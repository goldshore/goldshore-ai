{
  "name": "@goldshore/gs-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "dev:wrangler": "wrangler dev src/index.ts --ip 0.0.0.0",
    "build": "wrangler deploy --env prod --dry-run --outdir=dist",
    "types": "wrangler types --env prod --include-runtime=false",
    "types:check": "wrangler types --env prod --include-runtime=false --check",
    "lint": "eslint .",
    "test": "tsx --test src/routes/*.test.ts src/lib/*.test.ts",
    "test:gateway": "node test-gateway.js"
  },
  "dependencies": {
    "@goldshore/ai-providers": "workspace:^",
    "@goldshore/auth": "workspace:^",
    "@goldshore/integrations": "workspace:^",
    "@goldshore/schema": "workspace:^",
    "@goldshore/shared": "workspace:^",
    "@goldshore/utils": "workspace:^",
    "@types/sanitize-html": "^2.16.0",
    "hono": "^4.13.2",
    "mysql2": "3.23.3",
    "openai": "^7.4.0",
    "postal-mime": "^3.0.0",
    "safe-stable-stringify": "^2.5.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "tsx": "^4.7.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
