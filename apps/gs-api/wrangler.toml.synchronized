# ════════════════════════════════════════════════════════════════════════════════
# gs-api/wrangler.toml — Synchronized Binding Configuration
#
# This is the canonical backend Worker configuration. Copy the sections below
# into your actual wrangler.toml and deploy with:
#   wrangler deploy --env prod
#
# Secrets (dashboard-managed, NOT in this file):
#   wrangler secret put JWT_SECRET --env prod
#   wrangler secret put TURNSTILE_SECRET --env prod
#   wrangler secret put GEMINI_API_KEY --env prod
#   wrangler secret put OPENAI_API_KEY --env prod
#   wrangler secret put GH_PAT --env prod
# ════════════════════════════════════════════════════════════════════════════════

name = "gs-api"
main = "src/index.ts"
compatibility_date = "2026-08-12"
compatibility_flags = ["nodejs_compat"]

workers_dev = false

# ── Environment: Production ──
[env.prod]
name = "gs-api"
routes = [
  { pattern = "api.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "api.goldshore.org/*", zone_name = "goldshore.org" },
  { pattern = "agent.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "agent.goldshore.org/*", zone_name = "goldshore.org" },
  { pattern = "mail.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "mail.goldshore.org/*", zone_name = "goldshore.org" },
  { pattern = "ops.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "trading.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "trading.goldshore.org/*", zone_name = "goldshore.org" },
  { pattern = "dashboard.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "dash.goldshore.ai/*", zone_name = "goldshore.ai" },
  { pattern = "gw.goldshore.ai/*", zone_name = "goldshore.ai" }
]

# ── D1 Databases (6) ──
[[env.prod.d1_databases]]
binding = "GS_PLATFORM"
database_id = "9703574e-adb7-481e-8d98-96f8ce5f8a90"

[[env.prod.d1_databases]]
binding = "GS_AUDIT"
database_id = "1ae71d76-188f-481b-91d9-db2d39013f68"

[[env.prod.d1_databases]]
binding = "GS_SIGNALS"
database_id = "76af4653-7f44-417b-b46e-250143d906fd"

[[env.prod.d1_databases]]
binding = "GS_RISK_RADAR"
database_id = "b0bf3b0e-a7d0-49ae-ac82-4f19450b2ce2"

[[env.prod.d1_databases]]
binding = "GS_JOBS"
database_id = "750c469c-788d-49e8-9254-77231cffd70f"

[[env.prod.d1_databases]]
binding = "GS_PAPER_TRADING"
database_id = "af94f483-b98b-41c5-aa23-3fbed2764b52"

# ── KV Namespaces (4) ──
[[env.prod.kv_namespaces]]
binding = "GS_API_KV"
id = "f18aa1552b6b4239af9ae7486766f502"

[[env.prod.kv_namespaces]]
binding = "GS_ADMIN_KV"
id = "1f71a79b34db4090824954634dbd78c3"

[[env.prod.kv_namespaces]]
binding = "GS_TRADING_KV"
id = "9b331c3b7af40a284a8c9b6e2990709"

[[env.prod.kv_namespaces]]
binding = "GS_CACHE_KV"
id = "895b3586e1ce46c5b33f7a2fdbdad314"

# ── R2 Buckets (4) ──
[[env.prod.r2_buckets]]
binding = "GS_ASSETS"
bucket_name = "gs-assets"

[[env.prod.r2_buckets]]
binding = "MAIL_ARCHIVE"
bucket_name = "gs-assets"

[[env.prod.r2_buckets]]
binding = "GS_TELEMETRY"
bucket_name = "gs-telemetry-storage"

[[env.prod.r2_buckets]]
binding = "GS_RISK_RADAR_RAW"
bucket_name = "gs-risk-radar-raw"

# ── Queues: Producers ──
[[env.prod.queues.producers]]
binding = "GS_JOBS_QUEUE"
queue = "goldshore-jobs"

[[env.prod.queues.producers]]
binding = "GS_EVENTS_QUEUE"
queue = "gs-events"

[[env.prod.queues.producers]]
binding = "GS_MAIL_QUEUE"
queue = "gs-mail-jobs"

# ── Queues: Consumers ──
[[env.prod.queues.consumers]]
queue = "goldshore-jobs"
max_batch_size = 5
max_batch_timeout = 5
max_retries = 5

[[env.prod.queues.consumers]]
queue = "gs-events"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 5

[[env.prod.queues.consumers]]
queue = "gs-mail-jobs"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 5
dead_letter_queue = "gs-mail-dead-letter"

[[env.prod.queues.consumers]]
queue = "gs-mail-dead-letter"
max_batch_size = 1
max_batch_timeout = 1
max_retries = 1

# ── Durable Objects (1) ──
[[env.prod.durable_objects.bindings]]
name = "GS_AUTH_SESSION"
class_name = "AuthSession"
environment = "prod"

[[env.prod.migrations]]
tag = "v1"
new_classes = ["AuthSession"]

# ── Email (Native Cloudflare Email Sending) ──
[[env.prod.send_email]]
name = "EMAIL"
allowed_sender_addresses = [
  "noreply@goldshore.ai",
  "hello@goldshore.ai",
  "support@goldshore.ai",
  "support@goldshore.org"
]

# ── AI (Workers AI) ──
[env.prod.ai]
binding = "AI"

# ── Cron Triggers ──
[env.prod.triggers]
crons = ["0 */6 * * *", "0 0 * * 0"]

# ── Environment Variables ──
[env.prod.vars]
APP_VERSION = "1.0.0"
ENVIRONMENT = "production"
PUBLIC_API_BASE_URL = "https://api.goldshore.ai"
CLOUDFLARE_ACCESS_AUDIENCE = "8510d42c31fc791e295427031ffeef7c7ebc0f1b62d8634fbb284bf82562f528"
CLOUDFLARE_ACCESS_APPLICATION = "api-production"
CLOUDFLARE_TEAM_DOMAIN = "goldshore.cloudflareaccess.com"
GOOGLE_OAUTH_CLIENT_ID = "1054833139648-gt5o3k9uqhltt08nne0sigh8l3vodji7.apps.googleusercontent.com"
GOOGLE_OAUTH_REDIRECT_URI = "https://api.goldshore.ai/goldclaw/oauth/google/callback"
GITHUB_OAUTH_REDIRECT_URI = "https://api.goldshore.ai/auth/github/callback"
CONTACT_NOTIFICATION_EMAILS = "marstonr6@gmail.com"
MAIL_FROM_EMAIL = "noreply@goldshore.ai"
MAIL_FROM_NAME = "GoldShore"
MAIL_FORWARD_TO = "marstonr6@gmail.com"
PUBLIC_SITE_URL = "https://goldshore.ai"
