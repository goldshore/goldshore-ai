  "apply_commands": {
    "_comment": "Apply branch protection via GitHub API for each repo",
    "example": "curl -X PUT https://api.github.com/repos/marzton/{repo}/branches/main/protection -H 'Authorization: Bearer TOKEN' -H 'Accept: application/vnd.github+json' -d @branch-protection.json",

    "delete_branch_on_merge": {
      "_comment": "Apply via PATCH /repos/{owner}/{repo}",
      "body": { "delete_branch_on_merge": true, "allow_squash_merge": true, "allow_merge_commit": false, "allow_rebase_merge": false }
    },

    "secrets_to_add_per_repo": {
      "_comment": "All repos need at minimum CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID for wrangler deploy in CI",
      "shared": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    }
