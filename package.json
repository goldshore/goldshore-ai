{
  "name": "goldshore-ai",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "pnpm build:pages",
    "build:all": "pnpm build:openapi && turbo run build",
    "build:pages": "pnpm build:openapi && pnpm --filter @goldshore/gs-web build && pnpm --dir apps/gs-web verify:dist",
    "build:workers": "turbo run build --filter=@goldshore/gs-api",
    "build:openapi": "node scripts/build-openapi.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check:pages": "tsx scripts/check-pages-200.ts",
    "scan:pii": "node scripts/pii-scan.mjs --mode local --output apps/gs-web/src/data/pii-scan-results.json --summary reports/pii-scan-summary.md",
    "check:docs-consistency": "node scripts/check-doc-consistency.mjs",
    "check:theme-exports": "node scripts/check-theme-exports.mjs",
    "check:naming": "node scripts/lint-naming.mjs",
    "check:workspace-protocol": "node scripts/check-workspace-protocol.mjs",
    "validate:structure": "tsx scripts/validate-worker-structure.ts",
    "validate:names": "tsx scripts/validate-worker-names.ts",
    "validate:workers": "tsx scripts/validate-worker-names.ts",
    "validate:queues": "node scripts/validate-queue-contracts.mjs",
    "validate:workspace": "tsx scripts/validate-workspace-contract.ts",
    "validate": "pnpm check:naming && pnpm check:workspace-protocol && pnpm check:wrangler-placeholders && pnpm validate:workspace && pnpm validate:structure && pnpm validate:names",
    "branch:bootstrap": "bash scripts/branch-bootstrap.sh",
    "scaffold:worker": "node scripts/scaffold-worker.mjs",
    "workspaces:list": "pnpm -r list --depth -1",
    "verify:workspace-filters": "turbo run build --filter=@goldshore/gs-api --dry && turbo run build --filter=@goldshore/gs-web --dry",
    "verify:web-dist": "pnpm --dir apps/gs-web verify:dist",
    "memory:check": "node scripts/validate-canonical-structure.mjs",
    "sync:infra": "tsx scripts/sync-gateway.ts",
    "sync:cf": "echo 'Run codex sync script here' && tsx scripts/sync-gateway.ts",
    "repo:clean": "git clean -xfd -e .env -e env.secrets.runtime.json",
    "repo:install": "pnpm install --no-frozen-lockfile",
    "repo:health": "node scripts/repo-health.mjs",
    "audit": "pnpm run repo:health",
    "build:api": "turbo run build --filter=@goldshore/gs-api",
    "check:banproof-bindings": "node scripts/check-banproof-bindings.mjs",
    "check:wrangler-placeholders": "node scripts/check-wrangler-placeholders.mjs"
  },
  "devDependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/tailwind": "^6.0.2",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.65.0",
    "astro": "^7.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "form-data": "^4.0.6",
    "octokit": "^5.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "svgo": "^4.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.2",
    "wrangler": "^4.112.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "p-limit": "^7.3.1",
    "turbo": "^2.10.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
