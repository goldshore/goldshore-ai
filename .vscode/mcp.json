{
  "servers": {
    "console-ninja": {
      "command": "npx",
      "args": [
        "-y",
        "-c",
        "node ~/.console-ninja/mcp/"
      ],
      "type": "stdio"
    },
    "goldshore": {
      "type": "http",
      "url": "https://mcp.goldshore.ai/mcp",
      "headers": {
        "CF-Access-Client-Id": "${input:GS_MCP_CF_CLIENT_ID}",
        "CF-Access-Client-Secret": "${input:GS_MCP_CF_CLIENT_SECRET}"
      }
    },
    "atlassian-rovo": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-bindings": {
      "type": "http",
      "url": "https://bindings.mcp.cloudflare.com/mcp"
    },
    "cloudflare-builds": {
      "type": "http",
      "url": "https://builds.mcp.cloudflare.com/mcp"
    },
    "cloudflare-observability": {
      "type": "http",
      "url": "https://observability.mcp.cloudflare.com/mcp"
    }
  },
  "inputs": [
    {
      "id": "GS_MCP_CF_CLIENT_ID",
      "type": "promptString",
      "description": "CF Access Service Token — Client ID for mcp.goldshore.ai (Cloudflare Dashboard → Zero Trust → Access → Service Auth)"
    },
    {
      "id": "GS_MCP_CF_CLIENT_SECRET",
      "type": "promptString",
      "description": "CF Access Service Token — Client Secret for mcp.goldshore.ai",
      "password": true
    }
  ]
}
