{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Launch gs-web in Chrome with DevTools",
            "url": "http://127.0.0.1:4321",
            "webRoot": "${workspaceFolder}/apps/gs-web",
            "preLaunchTask": "dev:gs-web",
            "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
            "runtimeArgs": [
                "--auto-open-devtools-for-tabs",
                "--new-window",
                "--user-data-dir=${workspaceFolder}\\.vscode\\chrome-profile"
            ],
            "sourceMaps": true,
            "smartStep": true,
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        },
        {
            "type": "pwa-chrome",
            "request": "attach",
            "name": "Attach to Chrome on 9222",
            "port": 9222,
            "webRoot": "${workspaceFolder}/apps/gs-web",
            "sourceMaps": true,
            "smartStep": true,
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        }
    ]
}
