# ============================================================================
# GoldShore Admin Integration Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual API keys/credentials
# ============================================================================

# ============================================================================
# LLM PROVIDER CONFIGURATION (Required)
# ============================================================================

# Provider selection: claude | openai | openclaw | local
LLM_PROVIDER=openclaw

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# OpenClaw (Self-Hosted) - for business autonomy
OPENCLAW_API_KEY=your-api-key
OPENCLAW_BASE_URL=http://localhost:8000

# Local LLM (Ollama, etc.)
LOCAL_LLM_BASE_URL=http://localhost:11434

# ============================================================================
# CLOUDFLARE BINDINGS (Required for Workers)
# ============================================================================

CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ============================================================================
# FACEBOOK PIXEL & CONVERSIONS API
# ============================================================================

FACEBOOK_PIXEL_ID=your-pixel-id
FACEBOOK_ACCESS_TOKEN=your-access-token
FACEBOOK_BUSINESS_ID=your-business-id
FACEBOOK_API_VERSION=v18.0

# ============================================================================
# WHATSAPP BUSINESS API
# ============================================================================

WHATSAPP_BUSINESS_ACCOUNT_ID=your-account-id
WHATSAPP_PHONE_NUMBER_ID=your-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_BUSINESS_API_URL=https://graph.instagram.com/v18.0

# ============================================================================
# GOOGLE ADS
# ============================================================================

GOOGLE_ADS_CUSTOMER_ID=your-customer-id
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# ============================================================================
# GOOGLE SEARCH CONSOLE
# ============================================================================

GOOGLE_GSC_SITE_URL=https://your-domain.com
GOOGLE_GSC_REFRESH_TOKEN=your-refresh-token

# ============================================================================
# STRIPE PAYMENTS
# ============================================================================

STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# ZAPIER AUTOMATION
# ============================================================================

ZAPIER_API_KEY=your-api-key
ZAPIER_WEBHOOK_URL=https://your-domain.com/api/webhooks/zapier

# ============================================================================
# META BUSINESS (Facebook, Instagram)
# ============================================================================

META_BUSINESS_ACCOUNT_ID=your-business-account-id
META_ACCESS_TOKEN=your-access-token
META_API_VERSION=v18.0

# ============================================================================
# GOOGLE ADSENSE
# ============================================================================

GOOGLE_ADSENSE_CLIENT_ID=your-client-id
GOOGLE_ADSENSE_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADSENSE_API_KEY=your-api-key

# ============================================================================
# STRAPI CMS
# ============================================================================

STRAPI_API_URL=http://localhost:1337
STRAPI_API_KEY=your-api-key

# ============================================================================
# EMAIL & COMMUNICATION
# ============================================================================

SENDGRID_API_KEY=SG.your-api-key
MAILGUN_API_KEY=your-api-key
MAILGUN_DOMAIN=mail.your-domain.com

# ============================================================================
# GENERAL SETTINGS
# ============================================================================

NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# Webhook configuration
WEBHOOK_SECRET=your-secure-webhook-secret
WEBHOOK_BASE_URL=https://your-domain.com

# ============================================================================
# NOTES
# ============================================================================
# - Never commit this file with real secrets to version control
# - Use .gitignore to exclude .env.local, .env.*.local
# - For production, set environment variables in Cloudflare Workers dashboard
# - Rotate API keys regularly
# - Use separate credentials for development and production
